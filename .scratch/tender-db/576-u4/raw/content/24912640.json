ordinal":0,"scheme":null,"type":"id","value":"b9c845e9-d285-428a-99f0-f71e29710ecc"},{"field_id":"BT-05(a)-notice","ordinal":0,"type":"date","value":"2025-08-19T16:44:25+02:00"},{"field_id":"BT-09(a)-Procedure","is_ref":false,"ordinal":0,"scheme":null,"type":"id","value":"CrossBorderLaw"},{"field_id":"BT-09(a)-Procedure","is_ref":false,"ordinal":1,"scheme":null,"type":"id","value":"CrossBorderLaw"},{"field_id":"BT-09(b)-Procedure","lang":"DEU","ordinal":0,"type":"text","value":"gemäß Vergabeunterlagen"},{"field_id":"BT-09(b)-Procedure","lang":"DEU","ordinal":1,"type":"text","value":"gemäß Vergabeunterlagen"},{"code":"open","field_id":"BT-105-Procedure","list":"procurement-procedure-type","ordinal":0,"type":"code"},{"code":"false","field_id":"BT-106-Procedure","list":"accelerated-procedure","ordinal":0,"type":"code"},{"field_id":"BT-21-Procedure","lang":"DEU","ordinal":0,"type":"text","value":"LOS 66 - Gleisbau u. Kabeltiefbau 4. BA"},{"field_id":"BT-22-Procedure","is_ref":false,"ordinal":0,"scheme":"InternalID","type":"id","value":"E-25-7000036447"},{"code":"works","field_id":"BT-23-Lot","list":"contract-nature","ordinal":0,"type":"code"},{"field_id":"BT-24-Procedure","lang":"DEU","ordinal":0,"type":"text","value":"Im Rahmen des Elektrifizierungsprojekts der Strecke A1/S21 zwischen\nEidelstedt und Kaltenkirchen wird das Baulos 66 ausgeschrieben. Die Baumaßnahme ist Teil des 4. Bauabschnitts und trägt zur Realisierung eines durchgängigen S-Bahn-Betriebs zwischen Hamburg und Kaltenkirchen bei. Die Arbeiten erfolgen auf Grundlage eines rechtskräftigen Planfeststellungsbeschlusses und unter Abstimmung mit den weiteren Losen (65–67) des Abschnitts.\nIm Rahmen des 4. Bauabschnitts zwischen Ulzburg Süd und Kaltenkirchen Süd werden Gleis-, Erd- und Kabeltiefbauarbeiten durchgeführt. Die Maßnahme umfasst Gleisabsenkungen in mehreren Bereichen, den Austausch des Oberbaus sowie den Umbau der Weiche 807 in Kaltenkirchen Süd. Parallel dazu erfolgt die Erneuerung und Erweiterung der Kabelinfrastruktur entlang der Strecke. Der Bahnbetrieb wird während der Arbeiten über das Gegengleis aufrechterhalten. Der Materialtransport erfolgt ausschließlich über das Gleis.\ngemäß Vergabeunterlagen"},{"code":"45234100","field_id":"BT-262-Procedure","ordinal":0,"scheme":"cpv","type":"classification"},{"field_id":"BT-300-Procedure","lang":"DEU","ordinal":0,"type":"text","value":"gemäß Vergabeunterlagen"},{"field_id":"BT-634-Procedure","ordinal":0,"type":"integer","value":0},{"field_id":"BT-701-notice","is_ref":false,"ordinal":0,"scheme":"notice-id","type":"id","value":"ed4b72d1-5e45-4e9c-8359-8dcafd2c9106"},{"code":"DEU","field_id":"BT-702(a)-notice","list":null,"ordinal":0,"type":"code"},{"field_id":"BT-738-notice","ordinal":0,"type":"date","value":"2025-08-21"},{"field_id":"BT-757-notice","is_ref":false,"ordinal":0,"scheme":null,"type":"id","value":"01"},{"field_id":"BT-88-Procedure","lang":"DEU","ordinal":0,"type":"text","value":"Aufruf zum Wettbewerb\ngemäß Vergabeunterlagen"},{"field_id":"OPP-010-notice","is_ref":false,"ordinal":0,"scheme":"ojs-notice-id","type":"id","value":"00545905-2025"},{"field_id":"OPP-011-notice","is_ref":false,"ordinal":0,"scheme":"ojs-id","type":"id","value":"159/2025"},{"field_id":"OPP-012-notice","ordinal":0,"type":"date","value":"2025-08-21"},{"code":"17","field_id":"OPP-070-notice","list":"notice-subtype","ordinal":0,"type":"code"},{"field_id":"OPT-001-notice","is_ref":false,"ordinal":0,"scheme":null,"type":"id","value":"2.3"},{"field_id":"OPT-002-notice","is_ref":false,"ordinal":0,"scheme":null,"type":"id","value":"eforms-sdk-1.13"}]},{"kind":"Touchpoint","parent_section_id":"ORG-0001","section_id":"TPO-0002","values":[{"field_id":"BT-16-Organization-TouchPoint","lang":null,"ordinal":0,"type":"text","value":"Vergabekammer"},{"field_id":"BT-500-Organization-TouchPoint","lang":"DEU","ordinal":0,"type":"text","value":"Vergabekammer Schleswig-Holstein\nMinisterium für Wissenschaft, Wirtschaft und Verkehr"},{"field_id":"BT-50