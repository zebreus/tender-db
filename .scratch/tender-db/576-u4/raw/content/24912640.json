{"notice_id":24912640,"sections":[{"kind":"Lot","parent_section_id":"PROCEDURE","section_id":"LOT-0001","values":[{"field_id":"BT-115-Lot","ordinal":0,"type":"integer","value":0},{"field_id":"BT-124-Lot","lang":null,"ordinal":0,"type":"text","value":"https://www.akn.de"},{"field_id":"BT-13(d)-Lot","ordinal":0,"type":"date","value":"2025-09-22T23:45:00+02:00"},{"field_id":"BT-131(d)-Lot","ordinal":0,"type":"date","value":"2025-09-29T14:00:00+02:00"},{"field_id":"BT-132(d)-Lot","ordinal":0,"type":"date","value":"2025-09-29T14:00:00+02:00"},{"field_id":"BT-133-Lot","lang":"DEU","ordinal":0,"type":"text","value":"gemäß Vergabeunterlagen"},{"field_id":"BT-134-Lot","lang":"DEU","ordinal":0,"type":"text","value":"gemäß Vergabeunterlagen"},{"field_id":"BT-137-Lot","is_ref":false,"ordinal":0,"scheme":"Lot","type":"id","value":"LOT-0001"},{"code":"required","field_id":"BT-17-Lot","list":"esubmission","ordinal":0,"type":"code"},{"field_id":"BT-18-Lot","lang":null,"ordinal":0,"type":"text","value":"https://www.subreport.de/E57892172"},{"field_id":"BT-21-Lot","lang":"DEU","ordinal":0,"type":"text","value":"Gleisbau u. Kabeltiefbau"},{"field_id":"BT-22-Lot","is_ref":false,"ordinal":0,"scheme":"InternalID","type":"id","value":"LOT-0001 E-25-7000039067"},{"code":"works","field_id":"BT-23-Lot","list":"contract-nature","ordinal":0,"type":"code"},{"field_id":"BT-24-Lot","lang":"DEU","ordinal":0,"type":"text","value":"gemäß Vergabeunterlagen"},{"code":"45234100","field_id":"BT-262-Lot","ordinal":0,"scheme":"cpv","type":"classification"},{"field_id":"BT-300-Lot","lang":"DEU","ordinal":0,"type":"text","value":"gemäß Vergabeunterlagen"},{"field_id":"BT-536-Lot","ordinal":0,"type":"date","value":"2026-02-02"},{"field_id":"BT-537-Lot","ordinal":0,"type":"date","value":"2027-12-10"},{"field_id":"BT-54-Lot","lang":"DEU","ordinal":0,"type":"text","value":"gemäß Vergabeunterlagen"},{"field_id":"BT-543-Lot","lang":"DEU","ordinal":0,"type":"text","value":"gemäß Vergabeunterlagen"},{"field_id":"BT