r ailleurs confié la réalisation de cette opération à la SPL Nautisme, Mer et Développement à travers une convention de mandat de maitrise d'ouvrage déléguée. Le projet de Halle Technologique consiste à aménager les terrains mis à disposition et réhabiliter un hangar existant."},{"code":"71332000","field_id":"BT-262-Procedure","ordinal":0,"scheme":"cpv","type":"classification"},{"field_id":"BT-701-notice","is_ref":false,"ordinal":0,"scheme":"notice-id","type":"id","value":"8f9ba4ff-c46e-4783-926a-35bb62294c3c"},{"code":"FRA","field_id":"BT-702(a)-notice","list":"language","ordinal":0,"type":"code"},{"field_id":"BT-757-notice","is_ref":false,"ordinal":0,"scheme":null,"type":"id","value":"02"},{"field_id":"OPP-010-notice","is_ref":false,"ordinal":0,"scheme":"ojs-notice-id","type":"id","value":"00638201-2025"},{"field_id":"OPP-011-notice","is_ref":false,"ordinal":0,"scheme":"ojs-id","type":"id","value":"187/2025"},{"field_id":"OPP-012-notice","ordinal":0,"type":"date","value":"2025-09-30"},{"code":"16","field_id":"OPP-070-notice","list":"notice-subtype","ordinal":0,"type":"code"},{"field_id":"OPT-001-notice","is_ref":false,"ordinal":0,"scheme":null,"type":"id","value":"2.3"},{"field_id":"OPT-002-notice","is_ref":false,"ordinal":0,"scheme":null,"type":"id","value":"eforms-sdk-1.13"}]},{"kind":"Touchpoint","parent_section_id":"ORG-0001","section_id":"TPO-0001","values":[{"field_id":"BT-16-Organization-TouchPoint","lang":null,"ordinal":0,"type":"text","value":"Marchés publics"},{"field_id":"BT-500-Organization-TouchPoint","lang":"FRA","ordinal":0,"type":"text","value":"PICON PATRICE"},{"field_id":"BT-502-Organization-TouchPoint","lang":null,"ordinal":0,"type":"text","value":"PICON PATRICE"},{"field_id":"BT-503-Organization-TouchPoint","lang":null,"ordinal":0,"type":"text","value":"0442863911"},{"field_id":"BT-505-Organization-TouchPoint","lang":null,"ordinal":0,"type":"text","value":"https://nautismed.fr/"},{"field_id":"BT-506-Organization-TouchPoint","lang":null,"ordinal