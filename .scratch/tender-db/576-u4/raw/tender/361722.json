jke condities. -"},{"field":"title","lang":"NLD","lot":null,"value":"Gemeente Scherpenzeel, Vijfheerenlanden en Woudenberg - Uitzendkrachten tot en met schaal 8"},{"field":"description","lang":"NLD","lot":"LOT-0000","value":"Zie aanbestedingsdocument inclusief bijlagen."},{"field":"title","lang":"NLD","lot":"LOT-0000","value":"Perceel 1"}],"title":"Gemeente Scherpenzeel, Vijfheerenlanden en Woudenberg - Uitzendkrachten tot en met schaal 8","value":null,"value_derivation":null,"version":3,"versions":[{"caused_by_notice_id":25156204,"dispatched_at":"2025-10-28T16:07:05+01:00","notice_subtype":"16","original_lang":"NLD","publication_id":"00719247-2025","published_at":"2025-10-30","seq":1},{"caused_by_notice_id":25426064,"dispatched_at":"2025-12-02T16:26:00+01:00","notice_subtype":"16","original_lang":"NLD","publication_id":"00805703-2025","published_at":"2025-12-04","seq":2},{"caused_by_notice_id":25651952,"dispatched_at":"2026-03-05T13:04:25+01:00","notice_subtype":"29","original_lang":"NLD","publication_id":"00158018-2026","published_at":"2026-03-06","seq":3}]}