ine hinreichend begründete Dringlichkeit vor."},{"code":"true","field_id":"DE1-TenderingProcess-ProcessJustification-ProcessReasonCode","list":"accelerated-procedure","ordinal":0,"type":"code"}]},{"kind":"ProcurementAdditionalType","parent_section_id":"LOT-0001","section_id":"ND-ProcurementAdditionalType#0","values":[{"code":"soc-obj","field_id":"UBL-ProcurementAdditionalTypeCode","list":"strategic-procurement","ordinal":0,"type":"code"},{"field_id":"UBL-ProcurementTypeLabel","lang":"DEU","ordinal":0,"type":"text","value":"Tariftreueverpflichtung nach HVTG"}]},{"kind":"ProcurementAdditionalType","parent_section_id":"LOT-0001","section_id":"ND-ProcurementAdditionalType#1","values":[{"code":"work-cond","field_id":"UBL-ProcurementAdditionalTypeCode","list":"social-objective","ordinal":0,"type":"code"}]},{"kind":"ProcurementLegislationDocumentReference","parent_section_id":"PROCEDURE","section_id":"ND-ProcurementLegislationDocumentReference#0","values":[{"field_id":"DE1-TenderingTerms-ProcurementLegislationDocumentReference-ID","is_ref":false,"ordinal":0,"scheme":null,"type":"id","value":"vob-a-eu"}]},{"kind":"ProcurementLegislationDocumentReference","parent_section_id":"LOT-0001","section_id":"ND-ProcurementLegislationDocumentReference#1","values":[{"field_id":"DE1-TenderingTerms-ProcurementLegislationDocumentReference-ID","is_ref":false,"ordinal":0,"scheme":null,"type":"id","value":"vob-a-eu"}]},{"kind":"RealizedLocation","parent_section_id":"PROCEDURE","section_id":"ND-RealizedLocation#0","values":[{"field_id":"DE1-ProcurementProject-RealizedLocation-Address-AdditionalStreetName","lang":null,"ordinal":0,"type":"text","value":"Schur 2-4 und Lumdastraße 3"},{"field_id":"DE1-ProcurementProject-RealizedLocation-Address-CityName","lang":null,"ordinal":0,"type":"text","value":"Lollar"},{"code":"DEU","field_id":"DE1-ProcurementProject-RealizedLocation-Address-Country-IdentificationCode","list":null,"ordinal":0,"type":"code"},{"code":"DE721","field_id":"DE1-ProcurementProjec