nal":0,"type":"text","value":"Bebra"},{"code":"DEU","field_id":"DE1-Organizations-Organization-Company-PostalAddress-Country-IdentificationCode","list":null,"ordinal":0,"type":"code"},{"code":"DE721","field_id":"DE1-Organizations-Organization-Company-PostalAddress-CountrySubentityCode","ordinal":0,"scheme":"nuts","type":"classification"},{"field_id":"DE1-Organizations-Organization-Company-PostalAddress-PostalZone","lang":null,"ordinal":0,"type":"text","value":"36179"},{"field_id":"DE1-Organizations-Organization-Company-PostalAddress-StreetName","lang":null,"ordinal":0,"type":"text","value":"Max-Planck-Straße 4"},{"field_id":"DE1-Organizations-Organization-ListedOnRegulatedMarketIndicator","ordinal":0,"type":"integer","value":0}]},{"kind":"Notice","parent_section_id":null,"section_id":"PROCEDURE","values":[{"field_id":"DE1-ContractFolderID","is_ref":false,"ordinal":0,"scheme":null,"type":"id","value":"91757086-9dd5-4cfa-aa13-da6996b8758c"},{"field_id":"DE1-CustomizationID","is_ref":false,"ordinal":0,"scheme":null,"type":"id","value":"eforms-de-1.1"},{"field_id":"DE1-ID","is_ref":false,"ordinal":0,"scheme":"notice-id","type":"id","value":"d95d3813-1ec6-4117-9aac-4fd5b60220fb"},{"field_id":"DE1-IssueDate","ordinal":0,"type":"date","value":"2025-02-04T15:34:26+01:00"},{"code":"DEU","field_id":"DE1-NoticeLanguageCode","list":"eu-official-language","ordinal":0,"type":"code"},{"code":"29","field_id":"DE1-NoticeSubType-SubTypeCode","list":"notice-subtype","ordinal":0,"type":"code"},{"code":"can-standard","field_id":"DE1-NoticeTypeCode","list":"result","ordinal":0,"type":"code"},{"field_id":"DE1-ProcurementProject-ContractExtension-MaximumNumberNumeric","ordinal":0,"type":"number","unit":null,"value":0.0},{"field_id":"DE1-ProcurementProject-Description","lang":"DEU","ordinal":0,"type":"text","value":"Gründungsverbesserungsarbeiten an der Grundschule in Lollar"},{"field_id":"DE1-ProcurementProject-ID","is_ref":false,"ordinal":0,"scheme":"internalID","type":"id","value":"96-41-701-24"},{"code":"45111230","field_id":"DE1-ProcurementProject-MainCommodityClassification-ItemClassificationCode","ordinal":0,"scheme":"cpv","type":"classification"},{"field_id":"DE1-ProcurementProject-Name","lang":"DEU","ordinal":0,"type":"text","value":"GrS Lollar - Ersatzneubau für OFRA-Pavillons - Gründungsverbesserungsarbeiten"},{"field_id":"DE1-ProcurementProject-Note","lang":"DEU","ordinal":0,"type":"text","value":"Bekanntmachungs-ID: CXVTYYDYT6KDXYGS\n\n\nDie von Ihnen erbetenen, personenbezogenen Angaben werden im Rahmen des Vergabeverfahrens verarbeitet und gespeichert. Ihre Angaben sind Voraussetzung für die Teilnahme am Verfahren und Berücksichtigung Ihres Angebotes.\n\nDas Verfahren wird über die vom Landkreis Gießen genutzte elektronische Vergabeplattform Deutsches Vergabeportal (DTVP), URL http://www.dtvp.de, abgewickelt. Es ist daher für alle interessierten Bieter unabdingbar, dass im Projektraum eingestellte Informationen regelmäßig eingesehen werden. Um automatische Nachrichten des Systems zu empfangen, z.B. bei Änderung der Vergabeunterlagen oder beantworteten Bieterfragen, müssen sich Bieter auf der Plattform registriert und für das Verfahren freigeschaltet haben. Das gleiche gilt für die Nutzung der elektronischen Angebotsabgabe."},{"field_id":"DE1-ProcurementProject-PlannedPeriod-EndDate","ordinal":0,"type":"date","value":"2025-04-04"},{"field_id":"DE1-ProcurementProject-PlannedPeriod-StartDate","ordinal":0,"type":"date","value":"2025-03-17"},{"code":"works","field_id":"DE1-ProcurementProject-ProcurementTypeCode","list":"contract-nature","ordinal":0,"type":"code"},{"field_id":"DE1-RegulatoryDomain","lang":null,"ordinal":0,"type":"text","value":"32014L0024"},{"field_id":"DE1-RequestedPublicationDate","ordinal":0,"type":"date","value":"2025-02-04"},{"field_id":"DE1-TenderResult-AwardDate","ordinal":0,"type":"date","value":"2000-01-01"},{"field_id":"DE1-TenderingProcess-AuctionTerms-AuctionConstraintIndicator","ordinal":0,"type":"integer","value":0},{"code":"open","field_id":"DE1-TenderingProcess-ProcedureCode","list":"procurement-procedure-type","ordinal":0,"type":"code"},{"field_id":"DE1-TenderingTerms-AppealTerms-AppealInformationParty-PartyIdentification-ID","is_ref":true,"ordinal":0,"scheme":"organization","type":"id","value":"ORG-0003"},{"field_id":"DE1-TenderingTerms-AppealTerms-AppealReceiverParty-PartyIdentification-ID","is_ref":true,"ordinal":0,"scheme":"organization","type":"id","value":"ORG-0004"},{"field_id":"DE1-TenderingTerms-AppealTerms-MediationParty-PartyIdentification-ID","is_ref":true,"ordinal":0,"scheme":"organization","type":"id","value":"ORG-0005"},{"field_id":"DE1-TenderingTerms-AppealTerms-PresentationPeriod-Description","lang":"DEU","ordinal":0,"type":"text","value":"Nachfolgend ist der Wortlaut im Auszug von § 160 GWB wiedergegeben. Insbesondere wird auf Abs. 3 Nr. 4 hingewiesen. \n\n\"§ 160 GWB - Einleitung, Antrag \n\n(1) Die Vergabekammer leitet ein Nachprüfungsverfahren nur auf Antrag ein. \n(2) Antragsbefugt ist jedes Unternehmen, das ein Interesse an dem öffentlichen Auftrag oder der Konzession hat und eine Verletzung in seinen Rechten nach § 97 Absatz 6 durch Nichtbeachtung von Vergabevorschriften geltend macht. Dabei ist darzulegen, dass dem Unternehmen durch die behauptete Verletzung der Vergabevorschriften ein Schaden entstanden ist oder zu entstehen droht.. \n(3) Der Antrag ist unzulässig, soweit \n1. der Antragsteller den geltend gemachten Verstoß gegen Vergabevorschriften vor Einreichen des Nachprüfungsantrags erkannt und gegenüber dem Auftraggeber nicht innerhalb einer Frist von zehn Kalendertagen gerügt hat; der Ablauf der Frist nach § 134 Absatz 2 bleibt unberührt, \n2. Verstöße gegen Vergabevorschriften, die aufgrund der Bekanntmachung erkennbar sind, nicht spätestens bis zum Ablauf der in der Bekanntmachung benannten Frist zur Bewerbung oder zur Angebotsabgabe gegenüber dem Auftraggeber gerügt werden, \n3. Verstöße gegen Vergabevorschriften, die erst in den Vergabeunterlagen erkennbar sind, nicht spätestens bis zum Ablauf der in der Bekanntmachung benannten Frist zur Bewerbung oder zur Angebotsabgabe gegenüber dem Auftraggeber gerügt werden, \n4. mehr als 15 Kalendertage nach Eingang der Mitteilung des Auftraggebers, einer Rüge nicht abhelfen zu wollen, vergangen sind.\""},{"code":"no-eu-funds","field_id":"DE1-TenderingTerms-FundingProgramCode","list":"eu-funded","ordinal":0,"type":"code"},{"field_id":"DE1-UBLVersionID","is_ref":false,"ordinal":0,"scheme":null,"type":"id","value":"2.3"},{"field_id":"DE1-VersionID","is_ref":false,"ordinal":0,"scheme":null,"type":"id","value":"01"}]},{"kind":"LotResult","parent_section_id":"PROCEDURE","section_id":"RES-0001","values":[{"field_id":"DE1-NoticeResult-LotResult-DPSTerminationIndicator","ordinal":0,"type":"integer","value":0},{"cents":16944555,"currency":"EUR","field_id":"DE1-NoticeResult-LotResult-HigherTenderAmount","ordinal":0,"type":"amount"},{"field_id":"DE1-NoticeResult-LotResult-ID","is_ref":false,"ordinal":0,"scheme":null,"type":"id","value":"RES-0001"},{"cents":9702695,"currency":"EUR","field_id":"DE1-NoticeResult-LotResult-LowerTenderAmount","ordinal":0,"type":"amount"},{"field_id":"DE1-NoticeResult-LotResult-TenderLot-ID","is_ref":false,"ordinal":0,"scheme":"Lot","type":"id","value":"LOT-0001"},{"code":"selec-w","field_id":"DE1-NoticeResult-LotResult-TenderResultCode","list":"winner-selection-status","ordinal":0,"type":"code"}]},{"kind":"LotTender","parent_section_id":"PROCEDURE","section_id":"TEN-0001","values":[{"field_id":"DE1-NoticeResult-LotTender-ID","is_ref":false,"ordinal":0,"scheme":"tender","type":"id","value":"TEN-0001"},{"code":"not-known","field_id":"DE1-NoticeResult-LotTender-SubcontractingTerm-TermCode","list":"applicability","ordinal":0,"type":"code"},{"field_id":"DE1-NoticeResult-LotTender-TenderLot-ID","is_ref":false,"ordinal":0,"scheme":"Lot","type":"id","value":"LOT-0001"},{"field_id":"DE1-NoticeResult-LotTender-TenderVariantIndicator","ordinal":0,"