Code","list":"strategic-procurement","ordinal":0,"type":"code"},{"field_id":"UBL-ProcurementTypeLabel","lang":"DEU","ordinal":0,"type":"text","value":"Euro 6 Motoren"}]},{"kind":"ProcurementAdditionalType","parent_section_id":"LOT-0001","section_id":"ND-ProcurementAdditionalType#1","values":[{"code":"pollu-prev","field_id":"UBL-ProcurementAdditionalTypeCode","list":"environmental-impact","ordinal":0,"type":"code"}]},{"kind":"ProcurementLegislationDocumentReference","parent_section_id":"PROCEDURE","section_id":"ND-ProcurementLegislationDocumentReference#0","values":[{"field_id":"DE1-TenderingTerms-ProcurementLegislationDocumentReference-ID","is_ref":false,"ordinal":0,"scheme":null,"type":"id","value":"vgv"}]},{"kind":"RealizedLocation","parent_section_id":"PROCEDURE","section_id":"ND-RealizedLocation#0","values":[{"field_id":"DE1-ProcurementProject-RealizedLocation-Address-CityName","lang":null,"ordinal":0,"type":"text","value":"Bonn"},{"code":"DEU","field_id":"DE1-ProcurementProject-RealizedLocation-Address-Country-IdentificationCode","list":null,"ordinal":0,"type":"code"},{"code":"DEA22","field_id":"DE1-ProcurementProject-RealizedLocation-Address-CountrySubentityCode","ordinal":0,"scheme":"nuts","type":"classification"},{"field_id":"DE1-ProcurementProject-RealizedLocation-Address-PostalZone","lang":null,"ordinal":0,"type":"text","value":"53119"}]},{"kind":"RealizedLocation","parent_section_id":"LOT-0001","section_id":"ND-RealizedLocation#1","values":[{"field_id":"DE1-ProcurementProject-RealizedLocation-Address-CityName","lang":null,"ordinal":0,"type":"text","value":"Bonn"},{"code":"DEU","field_id":"DE1-ProcurementProject-RealizedLocation-Address-Country-IdentificationCode","list":null,"ordinal":0,"type":"code"},{"code":"DEA22","field_id":"DE1-ProcurementProject-RealizedLocation-Address-CountrySubentityCode","ordinal":0,"scheme":"nuts","type":"classification"},{"field_id":"DE1-ProcurementProject-RealizedLocation-Address-PostalZone","lang":null,"ordinal":0,"type":"text","value":"53119"}]},{"kind":"SelectionCriteria","parent_section_id":"LOT-0001","section_id":"ND-SelectionCriteria#0","values":[{"field_id":"DE1-TenderingTerms-SelectionCriteria-Description","lang":"DEU","ordinal":0,"type":"text","value":"Einzureichende Unterlagen:\n    - Haftpflichtversicherung (UVgO, VgV, VOB) (mit dem Angebot mittels Eigenerklärung vorzulegen): Angabe über eine bestehende angemessene Berufs- oder Betriebshaftpflichtversicherung (mindestens 5 Mio. EUR), oder Erklärung, im Falle der Beauftragung eine solche abzuschließen und nachzuweisen."},{"field_id":"UBL-SelectionCriterionName","lang":"DEU","ordinal":0,"type":"text","value":"Wirtschaftliche und finanzielle Leistungsfähigkeit"},{"code":"ef-stand","field_id":"UBL-SelectionCriterionType","list":"selection-criterion","ordinal":0,"type":"code"}]},{"kind":"SelectionCriteria","parent_section_id":"LOT-0001","section_id":"ND-SelectionCriteria#1","values":[{"field_id":"DE1-TenderingTerms-SelectionCriteria-Description","lang":"DEU","ordinal":0,"type":"text","value":"Einzureichende Unterlagen:\n    - Angebotsschreiben 213 bzw. 324 (UVgO, VgV, VOB, VOB-EU) (mit dem Angebot mittels Eigenerklärung vorzulegen): Bitte das Dokument \"VVB 213 - Angebotsschreiben - Einheitliche Fassung\" oder \"324 - Angebotsschreiben\" verwenden.\n- Bewerber- oder Bietergemeinschaftserklärung 531 bzw. 234 (UVgO, VgV, VOB, VOB-EU) (mit dem Angebot mittels Eigenerklärung vorzulegen): Bitte das Dokument \"531 - Bewerber-_Bietergemeinschaftserklaerung\" oder \"VVB 234 - Erklärung Bieter-_Arbeitsgemeinschaft\" verwenden.\n- Bieterangabenverzeichnis (UVgO, VgV, VOB, VOB-EU) (mit dem Angebot mittels Eigenerklärung vorzulegen): Bitte das Dokument \"Bieterangabenverzeichnis\" verwenden.\n- Eigenerklärung Informationen zum Bieter CSX 59 (VgV, VOB (EU)) (mit dem Angebot mittels Eigenerklärung vorzulegen): Bitte das Dokument \"CSX 59 - Eigenerklaerung Informationen zum Bieter\" verwenden.\n- Fahrzeugprofile inkl. Streuertypen mit Fassungsvermögen und Leistungsdaten sowie den jeweiligen Schneeschildern mit Maßen (mit dem Angebot mittels Eigenerklärung vorzulegen)\n- Muster der Mietvertrages inkl. Angabe der Höhe der Selbstbeteiligung im Schadensfall (mit dem Angebot mittels Eigenerklärung vorzulegen)"},{"field_id":"UBL-SelectionCriterionName","lang":"DEU","ordinal":0,"type":"text","value":"Sonstiges"},{"code":"other","field_id":"UBL-SelectionCriterionType","list":"selection-criterion","ordinal":0,"type":"code"}]},{"kind":"SelectionCriteria","parent_section_id":"LOT-0001","section_id":"ND-SelectionCriteria#2","values":[{"field_id":"DE1-TenderingTerms-SelectionCriteria-Description","lang":"DEU","ordinal":0,"type":"text","value":"Einzureichende Unterlagen:\n    - Ausschlussgründe 521 (UVgO, VgV) (mit dem Angebot mittels Eigenerklärung vorzulegen): Bitte das Dokument \"521\" - Eigenerklaerung Ausschlussgruende\" verwenden.\n- Berufsregister - Eintragung (UVgO, VgV) (mit dem Angebot mittels Eigenerklärung vorzulegen): Angabe über die Eintragung in das Berufsregister (Handelsregister, Handwerksrolle, IHK) ihres Sitzes oder Wohnsitzes oder Nachweis der erlaubten Berufsausübung auf andere Weise oder eine begründende Erklärung zu keiner Eintragung in einem der Register verpflichtet zu sein\n- Sanktionspaket 523 (VgV, VOB-EU) (mit dem Angebot mittels Eigenerklärung vorzulegen): Bitte das Dokument \"523 EU Eigenerklärung Sanktionspaket 5 EU\" verwenden."},{"field_id":"UBL-SelectionCriterionName","lang":"DEU","ordinal":0,"type":"text","value":"Eignung zur Berufsausübung"},{"code":"sui-act","field_id":"UBL-SelectionCriterionType","list":"selection-criterion","ordinal":0,"type":"code"}]},{"kind":"SelectionCriteria","parent_section_id":"LOT-0001","section_id":"ND-SelectionCriteria#3","values":[{"field_id":"DE1-TenderingTerms-SelectionCriteria-Description","lang":"DEU","ordinal":0,"type":"text","value":"Einzureichende Unterlagen:\n    - Erklärung zur Eignungsleihe 534a (UVgO, VgV) (mit dem Angebot mittels Eigenerklärung vorzulegen): Bitte verwenden Sie das Dokument \"534a - Erklaerung Eignungsleihe\".\n- Erklärung zur Eignungsleihe und Haftungserklärung 534b (UVgO, VgV) (mit dem Angebot mittels Eigenerklärung vorzulegen): Bitte verwenden Sie das Dokument \"534b - Erklaerung Eignungsleihe_Haftungserklaerung\" verwenden.\n- Unterauftragnehmer Nachweis 533b (UVgO, VgV) (mit dem Angebot mittels Eigenerklärung vorzulegen): Bitte verwenden Sie das Dokument \" 533b - Nachweis Unterauftragnehmer\".\n- Unteraufträge 533a (UVgO, VgV) (mit dem Angebot mittels Eigenerklärung vorzulegen): Angabe, welche Teile des Auftrags das Unternehmen unter Umständen als Unteraufträge zu vergeben beabsichtigt.\nBitte verwenden Sie das Dokument \"533a - Informationen zu Unterauftraegen bei Angebotsabgabe\"."},{"field_id":"UBL-SelectionCriterionName","lang":"DEU","ordinal":0,"type":"text","value":"Technische und berufliche Leistungsfähigkeit"},{"code":"tp-abil","field_id":"UBL-SelectionCriterionType","list":"selection-criterion","ordinal":0,"type":"code"}]},{"kind":"SpecificTendererRequirement","parent_section_id":"ND-TendererQualificationRequest#0","section_id":"ND-SpecificTendererRequirement#0","values":[{"field_id":"DE1-TenderingTerms-TendererQualificationRequest-SpecificTendererRequirement-Description","lang":"DEU","ordinal":0,"type":"text","value":"Zwingende bzw. fakultative Ausschlussgründe nach §§ 123 bis 126 GWB"},{"code":"bankr-nat","field_id":"DE1-TenderingTerms-TendererQualificationRequest-SpecificTendererRequirement-TendererRequirementTypeCode","list":"exclusion-ground","ordinal":0,"type":"code"}]},{"kind":"SpecificTendererRequirement","parent_section_id":"ND-TendererQualificationRequest#0","section_id":"ND-SpecificTendererRequirement#1","values":[{"field_id":"DE1-TenderingTerms-TendererQualificationRequest-SpecificTendererRequirement-Description","lang":"DEU","ordinal":0,"type":"text","value":"Zwingende bzw. fakultative Ausschlussgründe nach §§ 123 bis 126 GWB"},{"code":"bankruptcy","field_id":