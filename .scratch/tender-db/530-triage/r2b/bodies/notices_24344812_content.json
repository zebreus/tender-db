agen werden nur die über das Vergabeportal erteilten Antworten. Mündliche Auskünfte und Erklärungen haben keine Gültigkeit. \n--------------------------------------------------------------- \nSupport und Beratung zum Vergabeportal: Anleitungen und Tutorials: https://support.cosinex.de/ Beratung: support@cosinex.de \n---------------------------------------------------------------"},{"field_id":"BT-58-Lot","ordinal":0,"type":"integer","value":0},{"code":"no-eu-funds","field_id":"BT-60-Lot","list":"eu-funded","ordinal":0,"type":"code"},{"field_id":"BT-701-notice","is_ref":false,"ordinal":0,"scheme":"notice-id","type":"id","value":"791d58d7-70dd-495d-85fb-45252666d48f"},{"code":"DEU","field_id":"BT-702(a)-notice","list":"eu-official-language","ordinal":0,"type":"code"},{"code":"DEU","field_id":"BT-708-Lot","list":null,"ordinal":0,"type":"code"},{"field_id":"BT-726-Lot","ordinal":0,"type":"integer","value":0},{"code":"no","field_id":"BT-736-Lot","list":"reserved-execution","ordinal":0,"type":"code"},{"field_id":"BT-738-notice","ordinal":0,"type":"date","value":"2024-11-18"},{"code":"false","field_id":"BT-751-Lot","list":"tender-guarantee-required","ordinal":0,"type":"code"},{"field_id":"BT-757-notice","is_ref":false,"ordinal":0,"scheme":null,"type":"id","value":"01"},{"code":"not-allowed","field_id":"BT-764-Lot","list":"ecatalog-submission","ordinal":0,"type":"code"},{"field_id":"BT-767-Lot","ordinal":0,"type":"integer","value":0},{"field_id":"BT-77-Lot","lang":"DEU","ordinal":0,"type":"text","value":"AGB der Universität Stuttgart"},{"code":"DEU","field_id":"BT-97-Lot","list":null,"ordinal":0,"type":"code"},{"field_id":"BT-98-Lot","ordinal":0,"type":"number","unit":"DAY","value":60.0},{"field_id":"OPP-010-notice","is_ref":false,"ordinal":0,"scheme":"ojs-notice-id","type":"id","value":"00706080-2024"},{"field_id":"OPP-011-notice","is_ref":false,"ordinal":0,"scheme":"ojs-id","type":"id","value":"225/2024"},{"field_id":"OPP-012-notice","ordinal":0,"type":"date","value":"202