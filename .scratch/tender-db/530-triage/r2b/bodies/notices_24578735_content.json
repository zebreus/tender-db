rdinal":0,"scheme":"organization","type":"id","value":"ORG-0006"}]},{"kind":"Notice","parent_section_id":null,"section_id":"PROCEDURE","values":[{"code":"32014L0024","field_id":"BT-01-notice","list":null,"ordinal":0,"type":"code"},{"code":"cn-standard","field_id":"BT-02-notice","list":"competition","ordinal":0,"type":"code"},{"field_id":"BT-04-notice","is_ref":false,"ordinal":0,"scheme":null,"type":"id","value":"c5dd945f-d69e-464a-bfb8-0c8403286354"},{"field_id":"BT-05(a)-notice","ordinal":0,"type":"date","value":"2025-02-05T00:00:00+01:00"},{"code":"open","field_id":"BT-105-Procedure","list":"procurement-procedure-type","ordinal":0,"type":"code"},{"code":"false","field_id":"BT-106-Procedure","list":"accelerated-procedure","ordinal":0,"type":"code"},{"field_id":"BT-124-Lot","lang":null,"ordinal":0,"type":"text","value":"https://www.vergaben-wirtschaftsregion-aachen.de/VMPSatellite/notice/CXT2YYBYT6M2RJUZ"},{"code":"non-restricted-document","field_id":"BT-14-Lot","list":null,"ordinal":0,"type":"code"},{"field_id":"BT-21-Procedure","lang":"DEU","ordinal":0,"type":"text","value":"Trockenbauarbeiten - Rhein-Maas-Gymnasium - Sanierung und Aufstockung"},{"field_id":"BT-22-Procedure","is_ref":false,"ordinal":0,"scheme":"internalID","type":"id","value":"FB60/320-2025/087-JK"},{"code":"works","field_id":"BT-23-Lot","list":"contract-nature","ordinal":0,"type":"code"},{"field_id":"BT-24-Procedure","lang":"DEU","ordinal":0,"type":"text","value":"Trockenbauarbeiten - Rhein-Maas-Gymnasium - Sanierung und Aufstockung"},{"field_id":"BT-300-Procedure","lang":"DEU","ordinal":0,"type":"text","value":"Bekanntmachungs-ID: CXT2YYBYT6M2RJUZ\n\n\n1. Es gilt die Lohngleitklausel:                                                                                         \nnein\n\n2. Es besteht eine Bauleistungsversicherung durch die Stadt Aachen:                  \nja\n\n3. Lage der Baustelle:\nRhein-Maas-Gymnasium, Rhein-Maas-Str. 2, 52066 Aachen\n\n4. Lager- u. Arbeitsplätze:\nRhein-Maas-Str. 2, 52066 Aachen\n\n5. Verkehrswege innerhalb des Baugeländes:\ngem. BE-Plan\n\n6. Wasseranschluss:\nvorhanden\n\n7. Stromanschlüsse/Spannung:\nvorhanden\n\n8. Die Rechnung ist in 1-facher Ausfertigung einzureichen.\n- Den Abrechnungen der Neu- / Umbaumaßnahmen sind Zeichnungen im Maßstab 1:100 bis 1:50 zweifach beizufügen.\n\n9. Die Maßnahme ist am 01.09.2025, Aufforderung gem. § 5 Abs. 2 VOB/B, zu beginnen\n\n10. Die Arbeiten sind innerhalb von 132 Werktagen nach Beginn der Ausführung fertigzustellen\n\n11. Folgende Einzelfristen (die in Fällen gemäß § 9 Abs. 1 Nr. 2 VOB / A vereinbart werden) sind Vertragsfristen:\n./.\n\n12. Für die Überschreitung der Fertigstellungsfrist gem. Ziffer 8 bzw. der vereinbarten Einzelfristen gem. Ziffer 9 wird keine Vertragsstrafe vereinbart.\n\n13. Für das Gewerk Lüftung wird eine Gewährleistungsfrist von 4 Jahren vereinbart.\n\n14. Die Mindestdeckungssumme der Haftpflichtversicherung für Personen- und Sachschäden beträgt abweichend von Ziffer 8 der Bewerbungsbedingungen ./. Millionen EUR\n\n15. Die Unterlagen stehen ausschließlich als kostenloser Download unter http://www.vergaben-wirtschaftsregion-aachen.de/VMPSatellite/company/welcome.do zur Verfügung. Die Weitergabe der Ausschreibungsunterlagen an Dritte sowie die gewerbliche Nutzung der Ausschreibungsunterlagen sind nicht gestattet.\n\n16. Auskünfte über die Vergabeunterlagen sind bis zum 03.03.2025 schriftlich über das Vergabeportal der Wirtschaftsregion Aachen zu beantragen!\n\n17. Hinweis: Das Submissionsergebnis wird ausschließlich über das Vergabeportal der Wirtschaftsregion Aachen zur Verfügung gestellt"},{"field_id":"BT-58-Lot","ordinal":0,"type":"integer","value":0},{"code":"no-eu-funds","field_id":"BT-60-Lot","list":"eu-funded","ordinal":0,"type":"code"},{"field_id":"BT-701-notice","is_ref":false,"ordinal":0,"scheme":"notice-id","type":"id","value":"ce6a5e06-9e1c-49a7-ae0f-83ebbdebeb26"},{"code":"DEU","field_id":"BT-702(a)-notice","list":"eu-official-language","ordina