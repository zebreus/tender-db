cutionRequirement#0","values":[{"code":"no","field_id":"DE1-TenderingTerms-ContractExecutionRequirement-ExecutionRequirementCode","list":"reserved-execution","ordinal":0,"type":"code"}]},{"kind":"ContractExecutionRequirement","parent_section_id":"PROCEDURE","section_id":"ND-ContractExecutionRequirement#1","values":[{"code":"not-allowed","field_id":"DE1-TenderingTerms-ContractExecutionRequirement-ExecutionRequirementCode","list":"ecatalog-submission","ordinal":0,"type":"code"}]},{"kind":"ContractExecutionRequirement","parent_section_id":"LOT-0001","section_id":"ND-ContractExecutionRequirement#2","values":[{"code":"no","field_id":"DE1-TenderingTerms-ContractExecutionRequirement-ExecutionRequirementCode","list":"reserved-execution","ordinal":0,"type":"code"}]},{"kind":"ContractExecutionRequirement","parent_section_id":"LOT-0001","section_id":"ND-ContractExecutionRequirement#3","values":[{"code":"not-allowed","field_id":"DE1-TenderingTerms-ContractExecutionRequirement-ExecutionRequirementCode","list":"ecatalog-submission","ordinal":0,"type":"code"}]},{"kind":"ContractExecutionRequirement","parent_section_id":"LOT-0001","section_id":"ND-ContractExecutionRequirement#4","values":[{"code":"required","field_id":"DE1-TenderingTerms-ContractExecutionRequirement-ExecutionRequirementCode","list":"einvoicing","ordinal":0,"type":"code"}]},{"kind":"ContractExecutionRequirement","parent_section_id":"LOT-0001","section_id":"ND-ContractExecutionRequirement#5","values":[{"field_id":"DE1-ProcurementProjectLot-TenderingTerms-ContractExecutionRequirement-Description","lang":"DEU","ordinal":0,"type":"text","value":"A. \nDie Auftragnehmerin / der Auftragnehmer hat bei Auftragserteilung den Nachweis über das wirksame Bestehen einer Betriebshaftpflichtversicherung für die Zeit der Auftragserfüllung für ihren/seinen Betrieb zu erbringen. Die Deckungssummen müssen pro Schadensfall mindestens betragen: \nfür Personenschäden: 1.000.000,00 EUR\nfür sonstige Schäden (Sach- und / oder Vermögensschäden): 500.000,00 EUR\nMitversichert sein müssen allmähliche Einwirkung (§ 415 AHB), Mangelfolgeschäden, Bearbeitungsschäden mit 5.000,00 EUR pro Schadensereignis (§ 416 b AHB). \n\nB.  \nDer Auftragnehmer ist zur Einhaltung der Vorgaben des Tariftreue- und Vergabegesetzes Nordrhein-Westfalen verpflichtet.\n\nC. \nErbringung der Eigenerklärung zur Umsetzung von Artikel 5k Absatz 1 der Verordnung (EU) Nr. 833/2014 in der Fassung des Art. 1 Ziff. 15 der Verordnung (EU) 2022/1269 des Rates vom 21.07.2022.\n\nD. \nErbringung der Eigenerklärung über das Nichtvorliegen von Ausschlussgründen gem. §§ 123 ff GWB"},{"code":"performance","field_id":"OPT-060-Lot","list":"conditions","ordinal":0,"type":"code"}]},{"kind":"ContractingActivity","parent_section_id":"ND-ContractingParty#0","section_id":"ND-ContractingActivity#0","values":[{"code":"gen-pub","field_id":"DE1-ContractingParty-ContractingActivity-ActivityTypeCode","list":"authority-activity","ordinal":0,"type":"code"}]},{"kind":"ContractingParty","parent_section_id":"PROCEDURE","section_id":"ND-ContractingParty#0","values":[{"field_id":"DE1-ContractingParty-BuyerProfileURI","lang":null,"ordinal":0,"type":"text","value":"https://www.bielefeld.de/bekanntmachungen/ausschreibungen"},{"field_id":"DE1-ContractingParty-Party-PartyIdentification-ID","is_ref":true,"ordinal":0,"scheme":null,"type":"id","value":"ORG-0001"}]},{"kind":"ContractingPartyType","parent_section_id":"ND-ContractingParty#0","section_id":"ND-ContractingPartyType#0","values":[{"code":"kommun-beh","field_id":"DE1-ContractingParty-ContractingPartyType-PartyTypeCode","list":"buyer-legal-type","ordinal":0,"type":"code"}]},{"kind":"ContractingSystem","parent_section_id":"LOT-0001","section_id":"ND-ContractingSystem#0","values":[{"code":"none","field_id":"DE1-ProcurementProjectLot-TenderingProcess-ContractingSystem-ContractingSystemTypeCode","list":"framework-agreement","ordinal":0,"type":"code"}]},{"kind":"ContractingSystem","parent_section_id":"LOT-0001","section_id