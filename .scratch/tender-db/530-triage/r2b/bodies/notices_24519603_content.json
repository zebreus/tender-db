gabe gegenüber dem Auftraggeber gerügt werden. Der Nachprüfungsantrag ist gemäß § 160 Abs. 3 Nr. 4 GWB schließlich dann unzulässig, soweit mehr als 15 Kalendertage nach Eingang der Mitteilung des Auftraggebers, einer Rüge nicht abhelfen zu wollen, vergangen sind. Für die weiteren Voraussetzungen der Zulässigkeit wird auf §§ 160 und 161 GWB verwiesen."},{"field_id":"OPT-301-Lot-AddInfo","is_ref":true,"ordinal":0,"scheme":null,"type":"id","value":"ORG-0002"},{"field_id":"OPT-301-Lot-ReviewInfo","is_ref":true,"ordinal":0,"scheme":"organization","type":"id","value":"ORG-0003"},{"field_id":"OPT-301-Lot-ReviewOrg","is_ref":true,"ordinal":0,"scheme":"organization","type":"id","value":"ORG-0004"}]},{"kind":"ContractingParty","parent_section_id":"PROCEDURE","section_id":"ND-ContractingParty#0","values":[{"code":"gen-pub","field_id":"BT-10-Procedure-Buyer","list":"authority-activity","ordinal":0,"type":"code"},{"code":"la","field_id":"BT-11-Procedure-Buyer","list":"buyer-legal-type","ordinal":0,"type":"code"},{"field_id":"OPT-300-Procedure-Buyer","is_ref":true,"ordinal":0,"scheme":null,"type":"id","value":"ORG-0001"}]},{"kind":"LocalLegalBasisWithID","parent_section_id":"PROCEDURE","section_id":"ND-LocalLegalBasisWithID#0","values":[{"field_id":"BT-01(c)-Procedure","is_ref":false,"ordinal":0,"scheme":null,"type":"id","value":"vgv"}]},{"kind":"LotAwardCriterion","parent_section_id":"LOT-0001","section_id":"ND-LotAwardCriterion#0","values":[{"code":"price","field_id":"BT-539-Lot","list":"award-criterion-type","ordinal":0,"type":"code"},{"field_id":"BT-734-Lot","lang":"DEU","ordinal":0,"type":"text","value":"Preis"}]},{"kind":"LotAwardCriterion","parent_section_id":"LOT-0001","section_id":"ND-LotAwardCriterion#1","values":[{"code":"quality","field_id":"BT-539-Lot","list":"award-criterion-type","ordinal":0,"type":"code"},{"field_id":"BT-734-Lot","lang":"DEU","ordinal":0,"type":"text","value":"Qualität"}]},{"kind":"LotAwardCriterion","parent_section_id":"LOT-0002","section_id":"ND