{"code":"DEU","field_id":"BT-97-Lot","list":null,"ordinal":0,"type":"code"},{"field_id":"BT-98-Lot","ordinal":0,"type":"number","unit":"DAY","value":67.0},{"field_id":"BT-99-Lot","lang":"DEU","ordinal":0,"type":"text","value":"Verstöße gegen Vergabebestimmungen sind gegenüber dem Auftraggeber unverzüglich zu rügen. Bei Verstößen, die sich aus der Bekanntmachung oder den Vergabeunterlagen ergeben, bis spätestens zum Ablauf der Angebotsfrist. Teilt der Auftraggeber mit, dass der Rüge nicht abgeholfen wird, kann innerhalb von 15 Kalendertagen ein Nachprüfungsantrag bei der o.a. Vergabekammer des Landes Brandenburg schriftlich gestellt werden."},{"code":"performance","field_id":"OPT-060-Lot","list":"conditions","ordinal":0,"type":"code"},{"field_id":"OPT-301-Lot-AddInfo","is_ref":true,"ordinal":0,"scheme":null,"type":"id","value":"ORG-0003"},{"field_id":"OPT-301-Lot-Mediator","is_ref":true,"ordinal":0,"scheme":"organization","type":"id","value":"ORG-0006"},{"field_id":"OPT-301-Lot-ReviewInfo","is_ref":true,"ordinal":0,"scheme":"organization","type":"id","value":"ORG-0004"},{"field_id":"OPT-301-Lot-ReviewOrg","is_ref":true,"ordinal":0,"scheme":"organization","type":"id","value":"ORG-0005"},{"field_id":"OPT-301-Lot-TenderReceipt","is_ref":true,"ordinal":0,"scheme":null,"type":"id","value":"ORG-0007"},{"field_id":"UBL-ElectronicOrderUsage","ordinal":0,"type":"integer","value":1},{"field_id":"UBL-ElectronicPaymentUsage","ordinal":0,"type":"integer","value":0}]},{"kind":"ContractingParty","parent_section_id":"PROCEDURE","section_id":"ND-ContractingParty#0","values":[{"code":"gen-pub","field_id":"BT-10-Procedure-Buyer","list":"authority-activity","ordinal":0,"type":"code"},{"code":"la","field_id":"BT-11-Procedure-Buyer","list":"buyer-legal-type","ordinal":0,"type":"code"},{"field_id":"OPT-300-Procedure-Buyer","is_ref":true,"ordinal":0,"scheme":null,"type":"id","value":"ORG-0001"}]},{"kind":"ExclusionGrounds","parent_section_id":"PROCEDURE","section_id":"ND-ExclusionGrounds#0"