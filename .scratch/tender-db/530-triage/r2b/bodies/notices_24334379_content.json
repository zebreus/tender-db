dinal":0,"scheme":"nuts","type":"classification"},{"field_id":"BT-512-Organization-Company","lang":null,"ordinal":0,"type":"text","value":"53119"},{"field_id":"BT-513-Organization-Company","lang":null,"ordinal":0,"type":"text","value":"Bonn"},{"code":"DEU","field_id":"BT-514-Organization-Company","list":"country","ordinal":0,"type":"code"},{"field_id":"OPT-200-Organization-Company","is_ref":false,"ordinal":0,"scheme":"organization","type":"id","value":"ORG-0006"}]},{"kind":"Notice","parent_section_id":null,"section_id":"PROCEDURE","values":[{"code":"32014L0024","field_id":"BT-01-notice","list":null,"ordinal":0,"type":"code"},{"code":"cn-standard","field_id":"BT-02-notice","list":"competition","ordinal":0,"type":"code"},{"field_id":"BT-04-notice","is_ref":false,"ordinal":0,"scheme":null,"type":"id","value":"c863c367-344e-4818-9df4-421a8f3ae659"},{"field_id":"BT-05(a)-notice","ordinal":0,"type":"date","value":"2024-11-22T00:56:30+01:00"},{"code":"neg-w-call","field_id":"BT-105-Procedure","list":"procurement-procedure-type","ordinal":0,"type":"code"},{"code":"false","field_id":"BT-106-Procedure","list":"accelerated-procedure","ordinal":0,"type":"code"},{"field_id":"BT-124-Lot","lang":null,"ordinal":0,"type":"text","value":"https://evergabe.blb.nrw.de/Vergabe/notice/CXS7YYXY1TMZM0JW"},{"code":"non-restricted-document","field_id":"BT-14-Lot","list":null,"ordinal":0,"type":"code"},{"field_id":"BT-21-Procedure","lang":"DEU","ordinal":0,"type":"text","value":"BLB NRW D/Wuppertal/D-EWK PPW Sanierung Sport-und Schwimmh.: Fachplanung Technische Ausrüstung 065-24-00398"},{"field_id":"BT-22-Procedure","is_ref":false,"ordinal":0,"scheme":"internalID","type":"id","value":"065-24-00398"},{"code":"services","field_id":"BT-23-Lot","list":"contract-nature","ordinal":0,"type":"code"},{"field_id":"BT-24-Procedure","lang":"DEU","ordinal":0,"type":"text","value":"Fachplanung Technische Ausrüstung für die Maßnahme Sanierung Sport- und Schwimmhalle"},{"field_id":"BT-300-Procedure","lang":"DEU","ordinal":0,"type":"text","value":"Bekanntmachungs-ID: CXS7YYXY1TMZM0JW\n\n\nHingewiesen wird auch auf die Zuschlagkriterien aus der Matrix:\n\nVorgehen im ausgeschriebenen Projekt                                      15 %\n\nProjektablauf\n10 %\n\nErläuterungen zur Kostenplanung und\n-steuerung am ausgeschriebenen Projekt                                   15 %\n\nErläuterungen zur Terminplanung und -steuerung\nam ausgeschriebenen Projekt                                                     10 %\n\nErläuterungen zur Qualitätssteuerung\nam ausgeschriebenen Projekt                                                      10 %\n\nErfahrung des mit der Ausführung\ndes Auftrags betrauten Personals                                                10 %\n\nAngebot                                                                                        30 %\n\nDas Vergabeverfahren wird über den Vergabemarktplatz NRW (VMP NRW) abgewickelt. Unternehmen erhalten bei der Registrierung auf dem VMP NRW einen individuellen Unternehmensaccount. Der Austausch zwischen der Vergabestelle und dem Unternehmen erfolgt elektronisch über diesen Account und den für dieses Vergabeverfahren angelegten Projektraum im Modul \"Kommunikation\". Nur das Unternehmen hat Zugriff auf die über den Unternehmensaccount im Modul \"Kommunikation\" des Projektraums eingegangenen und ausgehenden Nachrichten. Dem Unternehmen werden hierüber auch rechtserhebliche Erklärungen im Vergabeverfahren zugestellt. Innerhalb des Unternehmensaccounts können mehrere Nutzerkonten angelegt werden. Bei der Anlage wird die Verwendung funktionsbezogener E-Mail-Adressen empfohlen. Weitere Informationen und Hilfestellungen zum VMP NRW sowie Anleitungen zum Bietertool für die Angebotsabgabe finden Sie auf der Internetseite des Betreibers cosinex GmbH unter folgendem Link: https://support.cosinex.de/unternehmen/pages/viewpage.action?pageId=28115008. Hingewiesen wird auf die Korruptionspräventionen, denen sich der BLB NRW unterworfen hat; diese finden sich unter: https://www.blb.nrw.de/compliance Einem rechtskonformen Handeln unterwirft sich auch der Bewerber / Auftragnehmer. Datenschutzklausel gem. § 12 Abs. 2 Datenschutzgesetz NRW Die von Ihnen erbetenen, personenbezogenen Angaben werden im Rahmen des Vergabeverfahrens verarbeitet und gespeichert. Ihre Angaben sind Voraussetzung für die Berücksichtigung Ihres Angebotes. Hinweis - Vergaberegister Die Vergabestelle meldet der/dem im Land Nordrhein-Westfalen eingerichteten zentralen Informationsstelle/Vergaberegister beim Finanzministerium NRW solche Bieterinnen/Bieter, die wegen schwerer Verfehlungen von der Teilnahme am Vergabeverfahren zeitlich befristet ausgeschlossen wurden oder bei denen wegen geringfügiger Verfehlungen auf einen Ausschluss verzichtet wurde. Die Vergabestelle fragt bei der v. g. Informationsstelle an, ob hinsichtlich der Bieterin/des Bieters, die/der den Zuschlag erhalten soll, Eintragungen im Vergaberegister vorliegen."},{"field_id":"BT-536-Lot","ordinal":0,"type":"date","value":"2025-06-03"},{"field_id":"BT-537-Lot","ordinal":0,"type":"date","value":"2029-01-04"},{"field_id":"BT-58-Lot","ordinal":0,"type":"integer","value":0},{"code":"no-eu-funds","field_id":"BT-60-Lot","list":"eu-funded","ordinal":0,"type":"code"},{"field_id":"BT-701-notice","is_ref":false,"ordinal":0,"scheme":"notice-id","type":"id","value":"c3f5651a-02da-400c-a722-d09494b91579"},{"code":"DEU","field_id":"BT-702(a)-notice","list":"eu-official-language","ordinal":0,"type":"code"},{"code":"DEU","field_id":"BT-708-Lot","list":null,"ordinal":0,"type":"code"},{"field_id":"BT-726-Lot","ordinal":0,"type":"integer","value":1},{"code":"no","field_id":"BT-736-Lot","list":"reserved-execution","ordinal":0,"type":"code"},{"field_id":"BT-738-notice","ordinal":0,"type":"date","value":"2024-11-22"},{"code":"false","field_id":"BT-751-Lot","list":"tender-guarantee-required","ordinal":0,"type":"code"},{"field_id":"BT-757-notice","is_ref":false,"ordinal":0,"scheme":null,"ty