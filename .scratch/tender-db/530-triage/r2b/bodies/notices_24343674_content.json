rksam machen, dass Sie die elektronischen Angebote über den Bieter-Tool hochladen müssen."},{"field_id":"BT-36-Lot","ordinal":0,"type":"number","unit":"MONTH","value":10.0},{"field_id":"BT-58-Lot","ordinal":0,"type":"integer","value":0},{"code":"no-eu-funds","field_id":"BT-60-Lot","list":"eu-funded","ordinal":0,"type":"code"},{"field_id":"BT-701-notice","is_ref":false,"ordinal":0,"scheme":"notice-id","type":"id","value":"878c7de6-fb31-45b3-afba-23b8f386f92c"},{"code":"DEU","field_id":"BT-702(a)-notice","list":"eu-official-language","ordinal":0,"type":"code"},{"field_id":"BT-738-notice","ordinal":0,"type":"date","value":"2024-11-05"},{"field_id":"BT-757-notice","is_ref":false,"ordinal":0,"scheme":null,"type":"id","value":"01"},{"field_id":"BT-767-Lot","ordinal":0,"type":"integer","value":0},{"field_id":"OPP-010-notice","is_ref":false,"ordinal":0,"scheme":"ojs-notice-id","type":"id","value":"00677752-2024"},{"field_id":"OPP-011-notice","is_ref":false,"ordinal":0,"scheme":"ojs-id","type":"id","value":"217/2024"},{"field_id":"OPP-012-notice","ordinal":0,"type":"date","value":"2024-11-07"},{"code":"29","field_id":"OPP-070-notice","list":"notice-subtype","ordinal":0,"type":"code"},{"field_id":"OPT-001-notice","is_ref":false,"ordinal":0,"scheme":null,"type":"id","value":"2.3"},{"field_id":"OPT-002-notice","is_ref":false,"ordinal":0,"scheme":null,"type":"id","value":"eforms-sdk-1.7"},{"field_id":"OPT-301-Lot-ReviewOrg","is_ref":true,"ordinal":0,"scheme":"organization","type":"id","value":"ORG-0003"},{"field_id":"OPT-999","ordinal":0,"type":"date","value":"2000-01-01"}]},{"kind":"LotResult","parent_section_id":"PROCEDURE","section_id":"RES-0001","values":[{"field_id":"BT-119-LotResult","ordinal":0,"type":"integer","value":0},{"field_id":"BT-13713-LotResult","is_ref":true,"ordinal":0,"scheme":"Lot","type":"id","value":"LOT-0001"},{"code":"selec-w","field_id":"BT-142-LotResult","list":"winner-selection-status","ordinal":0,"type":"code"},{"cents":8310859,"currency":"EUR","field