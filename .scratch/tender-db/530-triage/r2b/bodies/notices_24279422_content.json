-Lot","is_ref":false,"ordinal":0,"scheme":null,"type":"id","value":"SomeTenderDocID1"}]},{"kind":"ProcedureAdditionalCommodityClassification","parent_section_id":"PROCEDURE","section_id":"ND-ProcedureAdditionalCommodityClassification#0","values":[{"code":"71314000","field_id":"BT-263-Procedure","ordinal":0,"scheme":"cpv","type":"classification"}]},{"kind":"ProcedureAdditionalCommodityClassification","parent_section_id":"PROCEDURE","section_id":"ND-ProcedureAdditionalCommodityClassification#1","values":[{"code":"71314300","field_id":"BT-263-Procedure","ordinal":0,"scheme":"cpv","type":"classification"}]},{"kind":"ProcedureMainClassification","parent_section_id":"PROCEDURE","section_id":"ND-ProcedureMainClassification#0","values":[{"code":"71300000","field_id":"BT-262-Procedure","ordinal":0,"scheme":"cpv","type":"classification"}]},{"kind":"ProcedurePlacePerformanceAdditionalInformation","parent_section_id":"PROCEDURE","section_id":"ND-ProcedurePlacePerformanceAdditionalInformation#0","values":[{"code":"DE402","field_id":"BT-5071-Procedure","ordinal":0,"scheme":"nuts","type":"classification"},{"field_id":"BT-5101(a)-Procedure","lang":null,"ordinal":0,"type":"text","value":"Stadt Cottbus"},{"field_id":"BT-5121-Procedure","lang":null,"ordinal":0,"type":"text","value":"03046"},{"field_id":"BT-5131-Procedure","lang":null,"ordinal":0,"type":"text","value":"Cottbus"},{"code":"DEU","field_id":"BT-5141-Procedure","list":null,"ordinal":0,"type":"code"}]},{"kind":"SelectionCriteria","parent_section_id":"LOT-0001","section_id":"ND-SelectionCriteria#0","values":[{"code":"ef-stand","field_id":"BT-747-Lot","list":"selection-criterion","ordinal":0,"type":"code"},{"field_id":"BT-750-Lot","lang":"DEU","ordinal":0,"type":"text","value":"Einzureichende Unterlagen:\n- Nachweis Berufs- oder Betriebshaftpflichtversicherung (nicht älter als ein Jahr) mit Angabe  der Deckungssummen für Personenschäden und Sachschäden (Kopie der Police) (mit dem Teilnahmeantrag mittels Dritterklärung vorzulegen)"},{"field_id":"UBL-SelectionCriterionName","lang":"DEU","ordinal":0,"type":"text","value":"Wirtschaftliche und finanzielle Leistungsfähigkeit"}]},{"kind":"SelectionCriteria","parent_section_id":"LOT-0001","section_id":"ND-SelectionCriteria#1","values":[{"code":"sui-act","field_id":"BT-747-Lot","list":"selection-criterion","ordinal":0,"type":"code"},{"field_id":"BT-750-Lot","lang":"DEU","ordinal":0,"type":"text","value":"Einzureichende Unterlagen:\n - Nachweis der Befähigung zur Berufsausübung einschließlich Auflagen hinsichtlich der Eintragung in einem Berufs- oder Handelsregister (Architektenkammer, Ingenieurkammer etc.) Nachweisführung durch Einreichung der Urkunden als Kopie (mit dem Teilnahmeantrag mittels Dritterklärung vorzulegen)\n- Eigenerklärung zum Nichtvorliegen der Ausschlussgründe i.S.d. § 31 UvgO (mit dem Teilnahmeantrag mittels Eigenerklärung vorzulegen): zwingende und fakultative Ausschlussgründe i.S. Formblatt 124_VHB Bund 2017 sind:\n- Geldwäsche § 123 (1) Nr. 3 GWB\n- Betrug § 123 (1) Nr. 4 GWB\n- Bestechung und Vorteilsgewährung § 123 (1) Nr. 8 GWB\n- Steuerschuld § 123 (4) Nr. 1 GWB\n- Insolvenz § 124 (1) Nr. 2 GWB\n- Verfehlung § 124 (1) Nr. 3 GWB"},{"field_id":"UBL-SelectionCriterionName","lang":"DEU","ordinal":0,"type":"text","value":"Eignung zur Berufsausübung"}]},{"kind":"SelectionCriteria","parent_section_id":"LOT-0001","section_id":"ND-SelectionCriteria#2","values":[{"code":"tp-abil","field_id":"BT-747-Lot","list":"selection-criterion","ordinal":0,"type":"code"},{"field_id":"BT-750-Lot","lang":"DEU","ordinal":0,"type":"text","value":"Einzureichende Unterlagen:\n- Eigenerklärung, dass im Falle der beabsichtigten Vergabe eines Unterauftrages/von Unteraufträgen an (einen) Nachunternehmer hat/haben diese(r) sich schriftlich zu verpflichten, im Auftragsfalle dem Bewerber/Bieter die genannten Auftragsteile... (mit dem Teilnahmeantrag mittels Eigenerklärung vorzulegen): ...zu erbringen und die notwendigen Kapazitäten zur Verfügung zu stellen\n- Benennung und Beschreibung des für den Wärmeplan tätig werdende Projektteam in der beiliegenden Exceltabelle  \"Vergabetabelle_KWP\" (mit dem Teilnahmeantrag mittels Eigenerklärung vorzulegen): Die Prüfung der technischen und beruflichen Leistungsfähigkeit erfolgt anhand der Bewertung des Projektteams. Mindestens dreiviertel des Projektteams müssen einen akademischen Bildungsabschluss besitzen. Die Teammitglieder haben im Durchschnitt an mindestens einer zurückliegenden, der vorliegenden Aufgabenstellung vergleichbaren Studie mitgewirkt (Anzahl Studien pro Projektmitglied)."},{"field_id":"UBL-SelectionCriterionName","lang":"DEU","ordinal":0,"type":"text","value":"Technische und berufliche Leistungsfähigkeit"}]},{"kind":"ServiceProviderParty","parent_section_id":"ND-ContractingParty#0","section_id":"ND-ServiceProviderParty#0","values":[{"code":"ted-esen","field_id":"OPT-030-Procedure-SProvider","list":"organisation-role","ordinal":0,"type":"code"},{"field_id":"OPT-300-Procedure-SProvider","is_ref":true,"ordinal":0,"scheme":"organization","type":"id","value":"ORG-0006"}]},{"kind":"StrategicProcurementType","parent_section_id":"LOT-0001","section_id":"ND-StrategicProcurementType#0","values":[{"code":"none","field_id":"BT-06-Lot","list":"strategic-procurement","ordinal":0,"type":"code"}]},{"kind":"Organization","parent_section_id":"PROCEDURE","section_id":"ORG-0001","values":[{"field_id":"BT-500-Organization-Company","lang":"DEU","ordinal":0,"type":"text","value":"Stadtverwaltung Cottbus"},{"field_id":"BT-501-Organization-Company","is_ref":false,"ordinal":0,"scheme":null,"type":"id","value":"788cce00-e4d4-4106-a6fc-8f881cdf58e7"},{"field_id":"BT-502-Organization-Company","lang":null,"ordinal":0,"type":"text","value":"Zentrales Vergabemanagement"},{"field_id":"BT-503-Organization-Company","lang":null,"ordinal":0,"type":"text","value":"+49 3556122966"},{"field_id":"BT-506-Organization-Company","lang":null,"ordinal":0,"type":"text","value":"ivonne.specht@cottbus.de"},{