dinal":0,"scheme":null,"type":"id","value":"ORG-0005"}]},{"kind":"Organization","parent_section_id":"PROCEDURE","section_id":"ORG-0006","values":[{"field_id":"BT-500-Organization-Company","lang":"DEU","ordinal":0,"type":"text","value":"Datenservice Öffentlicher Einkauf (in Verantwortung des Beschaffungsamts des BMI)"},{"field_id":"BT-501-Organization-Company","is_ref":false,"ordinal":0,"scheme":"002","type":"id","value":"0204:994-DOEVD-83"},{"field_id":"BT-503-Organization-Company","lang":null,"ordinal":0,"type":"text","value":"+49228996100"},{"field_id":"BT-506-Organization-Company","lang":null,"ordinal":0,"type":"text","value":"noreply.esender_hub@bescha.bund.de"},{"code":"DEA22","field_id":"BT-507-Organization-Company","ordinal":0,"scheme":"nuts","type":"classification"},{"field_id":"BT-512-Organization-Company","lang":null,"ordinal":0,"type":"text","value":"53119"},{"field_id":"BT-513-Organization-Company","lang":null,"ordinal":0,"type":"text","value":"Bonn"},{"code":"DEU","field_id":"BT-514-Organization-Company","list":"country","ordinal":0,"type":"code"},{"field_id":"OPT-200-Organization-Company","is_ref":false,"ordinal":0,"scheme":"organization","type":"id","value":"ORG-0006"}]},{"kind":"Notice","parent_section_id":null,"section_id":"PROCEDURE","values":[{"code":"32014L0024","field_id":"BT-01-notice","list":null,"ordinal":0,"type":"code"},{"code":"cn-standard","field_id":"BT-02-notice","list":"competition","ordinal":0,"type":"code"},{"field_id":"BT-04-notice","is_ref":false,"ordinal":0,"scheme":null,"type":"id","value":"bd21b1b2-2b47-43bc-9bc7-7299a6e87b1a"},{"field_id":"BT-05(a)-notice","ordinal":0,"type":"date","value":"2024-10-24T14:40:04+02:00"},{"code":"neg-w-call","field_id":"BT-105-Procedure","list":"procurement-procedure-type","ordinal":0,"type":"code"},{"code":"false","field_id":"BT-106-Procedure","list":"accelerated-procedure","ordinal":0,"type":"code"},{"field_id":"BT-124-Lot","lang":null,"ordinal":0,"type":"text","value":"https://vergabemarktplatz.brandenburg.de/VMPSatellite/notice/CXSGYYDY12DA4W7Z"},{"code":"non-restricted-document","field_id":"BT-14-Lot","list":null,"ordinal":0,"type":"code"},{"field_id":"BT-21-Procedure","lang":"DEU","ordinal":0,"type":"text","value":"Stadt Cottbus - VHVmöTW 222-2024 Erstellung kommunaler Wärmeplan Stadt Cottbus/Chó?ebuz"},{"field_id":"BT-22-Procedure","is_ref":false,"ordinal":0,"scheme":"internalID","type":"id","value":"VHVmöTw 222-2024"},{"code":"services","field_id":"BT-23-Lot","list":"contract-nature","ordinal":0,"type":"code"},{"field_id":"BT-24-Procedure","lang":"DEU","ordinal":0,"type":"text","value":"Die Kommunale Wärmeplanung ist das entscheidende strategische Planungsinstrument, um die Weichen für die Wärmewende in der Kommune im Einklang mit den lokalen Gegebenheiten zu stellen und so das Ziel einer treibhausgasneutralen Wärmeversorgung im Gebäudesektor, entsprechend der Klimaziele des Bundes, zu erreichen.\n\nGrundlegende Aufgabenstellung ist die Entwicklung eines kommunalen Wärmeplans als Basis einer Strategie für die langfristig CO2-neutrale Wärmeversorgung des Gebietes der Kommune bis zum Jahr 2040. Der kommunale Wärmeplan zeigt dafür den aktuellen Sachstand der Wärmeversorgung sowie verschiedenste Perspektiven der Wärmeversorgung aus erneuerbaren Energiequellen, unvermeidlicher Abwärme und KWK auf. Über einen Zwischenstand für das Jahr 2030 ist daraus das klimaneutrale Zielszenario bis 2045 zu entwickeln.\n\nDie genauen Angaben entnehmen Sie bitte der Leistungsbeschreibung."},{"field_id":"BT-300-Procedure","lang":"DEU","ordinal":0,"type":"text","value":"Bekanntmachungs-ID: CXSGYYDY12DA4W7Z\n\n\nDieses Verfahren findet in zwei (2) Stufen statt. In der 1. Stufe - dem Teilnahmewettbewerb - können interessierte Unternehmen einen Teilnahmeantrag (Bewerbung) unter Beifügung der unter Pkt. 5 \"Anschreiben Teilnahmeaufforderung\" genannten Unterlagen einreichen. Anschließend - in der Stufe 2 - der Angebotsphase - werden geeignete Unternehmen aufgefordert ein Angebot einzureichen. Es ist nur die elektronische Abgabe von Teilnahmeunterlagen sowie in der Stufe 2 nur die elektronische Angebotsabgabe zugelassen (keine Briefpost). Die Abgabe von elektronischen Teilnahmeanträgen und Angeboten hat ausschließlich über den Vergabemarktplatz Brandenburg zu erfolgen. Sämtliche Kommunikation erfolgt über den Vergabemarktplatz Brandenburg. Rückfragen zum Teilnahmewettbewerb sind bis 15.11.2024 möglich. Bitte nutzen Sie für Bieteranfragen ausschließlich die Rubrik \"Kommunikation\" auf der elektronischen Plattform des Vergabemarktplatzes Brandenburg. Telefonische Anfragen bzw. Anfragen, die per E-Mail oder Fax eingehen, werden nicht bearbeitet. Antworten werden mit den Anfragen allen Wettbewerbsteilnehmern zur Kenntnis gegeben. Fragestellungen mit Hinweisen auf Ihr Unternehmen sind daher zu vermeiden. Eine Nachricht gilt als zugegangen, wenn sie in den Projektraum eingestellt wurde."},{"field_id":"BT-536-Lot","ordinal":0,"type":"date","value":"2025-03-01"},{"field_id":"BT-537-Lot","ordinal":0,"type":"date","value":"2026-06-30"},{"field_id":"BT-58-Lot","ordinal":0,"type":"integer","value":0},{"code":"no-eu-funds","field_id":"BT-60-Lot","list":"eu-funded","ordinal":0,"type":"code"},{"field_id":"BT-701-notice","is_ref":false,"ordinal":0,"scheme":"notice-id","type":"id","value":"c559d262-cf3a-46b7-aa0a-091e7c4ec599"},{"code":"DEU","field_id":"BT-702(a)-notice","list":"eu-official-language","ordinal":0,"type":"code"},{"code":"DEU","field_id":"BT-708-Lot","list":null,"ordinal":0,"type":"code"},{"field_id":"BT-726-Lot","ordinal":0,"type":"integer","value":1},{"code":"no","field_id":"BT-736-Lot","list":"reserved-execution","ordinal":0,"type":"code"},{"field_id":"BT-738-notice","ordinal":0,"type":"date","value":"2024-10-24"},{"code":"false","field_id":"BT-751-Lot","list":"tender-guarantee-required","ordinal":0,"type":"code"},{"field_id":"BT-757-notice","is_ref":false,"ordinal":0,"scheme":null,"type":"id","value":"01"},{"code":"not-allowed","field_id":"BT-764-Lot","list":"ecatalog-submission","ordinal":0,"type":"code"},{"field_id":"BT-767-Lot","ordinal":0,"type":"integer","value":0},{"code":"DEU","field_id":"BT-97-Lot","list":null,"ordinal":0,"type":"code"},{"field_id":"BT-98-Lot","ordinal":0,"type":"number","unit":"DAY","value":94.0},{"field_id":"BT-99-Lot","lang":"DEU","ordinal":0,"type":"text","value":"Es gelten die Bestimmungen des Gesetzes gegen Wettbewerbsbeschränkungen (GWB). Hinsichtlich der Einleitung von Nachprüfungsverfahren wird auf § 160 GWB verwiesen. Dieser lautet: (1) Die Vergabekammer leitet ein Nachprüfungsverfahren nur auf Antrag ein. (2) Antragsbefugt ist jedes Unternehmen, das ein Interesse an dem öffentlichen Auftrag oder der Konzession hat und eine Verletzung in seinen Rechten nach § 97 Absatz 6 durch Nichtbeachtung von Vergabevorschriften geltend macht. Dabei ist darzulegen dass dem Unternehmen durch die behauptete Verletzung der Vergabevorschriften ein Schaden entstanden ist oder zu entstehen droht. (3) Der Antrag ist unzulässig, soweit: 1) Der Antragsteller den geltend gemachten Verstoß gegen Vergabevorschriften vor Einreichen des Nachprüfungsantrags erkannt und gegenüber dem Auftraggeber nicht innerhalb einer Frist von 10 Kalendertagen gerügt hat, 2) Verstöße gegen Vergabevorschriften, die aufgrund der Bekanntmachung erkennbar sind, nicht spätestens bis zum Ablauf der in der Bekanntmachung benannten Frist zur Bewerbung oder zur Angebotsabgabe gegenüber dem Auftraggeber gerügt werden, 3) Verstöße gegen Vergabevorschriften, die erst in den Vergabeunterlagen erkennbar sind, nicht spätestens bis zum Ablauf der Frist zur Bewerbung oder zur Angebotsabgabe gegenüber dem Auftraggeber gerügt werden, 4) mehr als 15 Kalendertage nach Eingang der Mitteilung des Auftraggebers, einer Rüge nicht abhelfen zu wollen, vergangen sind. Hinsichtlich der Information nicht berücksichtigter Bieter und Bewerber gelten die §§ 134, 135 GWB. Insbesondere gilt: Bieter deren Angebote für den Zuschlag nicht berücksichtigt werden sollen, werden vor dem Zuschlag gemäß§ 134 GWB darüber informiert. Das gilt auch für Bewerber, denen keine Information über die Ablehnung ihrer Bewerbung zur Verfügung gestellt wurde, bevor die Mitteilung über die Zuschlagsentscheidung an die betroffenen Bieter ergangen ist. Ein Vertrag darf erst 15 Kalendertage nach Absendung dieser Information durch den Auftraggeber geschlossen werden; bei Übermittlung per Telefax oder auf elektronischem Wege beträgt diese Frist 10 Kalendertage."},{"field_id":"OPP-010-notice","is_ref":false,"ordinal":0,"scheme":"ojs-notice-id","type":"id","value":"00648547-2024"},{"field_id":"OPP-011-notice","is_ref":false,"ordinal":0,"scheme":"ojs-id","type":"id","value":"209/2024"},{"field_id":"OPP-012-notice","ordinal":0,"type":"date","value":"2024-10-25"},{"code":"16","field_id":"OPP-070-notice","list":"notice-subtype","ordinal":0,"type":"code"},{"field_id":"OPT-001-notice","is_ref":false,"ordinal":0,"scheme":null,"type":"id","value":"2.3"},{"field_id":"OPT-002-notice","is_ref":false,"ordinal":0,"scheme":null,"type":"id","value":"eforms-sdk-1.7"},{"field_id":"OPT-140-Lot","is_ref":false,"ordinal":0,"scheme":null,"type":"id","value":"SomeTenderDocID1"},{"field_id":"OPT-301-Lot-ReviewInfo","is_ref":true,"ordinal":0,"scheme":"organization","type":"id","value":"ORG-0003"},{"field_id":"OPT-301-Lot-ReviewOrg","is_ref":true,"ordinal":0,"scheme":"organization","type":"id","value":"ORG-0004"},{"field_id":"OPT-301-Lot-TenderReceipt","is_ref":true,"ordinal":0,"scheme":null,"type":"id","value":"ORG-0005"}]}]}