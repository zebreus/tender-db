xt","value":"+493556122990"},{"field_id":"DE1-Organizations-Organization-Company-PartyIdentification-ID","is_ref":false,"ordinal":0,"scheme":null,"type":"id","value":"ORG-0005"},{"code":"DEU","field_id":"DE1-Organizations-Organization-Company-PostalAddress-Country-IdentificationCode","list":null,"ordinal":0,"type":"code"},{"code":"DE40E","field_id":"DE1-Organizations-Organization-Company-PostalAddress-CountrySubentityCode","ordinal":0,"scheme":"nuts","type":"classification"},{"field_id":"DE1-Organizations-Organization-Company-PostalAddress-StreetName","lang":null,"ordinal":0,"type":"text","value":"http://vergabemarktplatz.brandenburg.de"}]},{"kind":"Notice","parent_section_id":null,"section_id":"PROCEDURE","values":[{"field_id":"DE1-ContractFolderID","is_ref":false,"ordinal":0,"scheme":null,"type":"id","value":"0453f661-25d7-4c2b-b06a-e9752703e5d4"},{"field_id":"DE1-CustomizationID","is_ref":false,"ordinal":0,"scheme":null,"type":"id","value":"eforms-de-1.1"},{"field_id":"DE1-ID","is_ref":false,"ordinal":0,"scheme":"notice-id","type":"id","value":"6813b45a-a110-4dc1-b5cd-0fb4579cacd9"},{"field_id":"DE1-IssueDate","ordinal":0,"type":"date","value":"2024-12-03T12:36:26+01:00"},{"code":"DEU","field_id":"DE1-NoticeLanguageCode","list":"eu-official-language","ordinal":0,"type":"code"},{"code":"16","field_id":"DE1-NoticeSubType-SubTypeCode","list":"notice-subtype","ordinal":0,"type":"code"},{"code":"cn-standard","field_id":"DE1-NoticeTypeCode","list":"competition","ordinal":0,"type":"code"},{"field_id":"DE1-ProcurementProject-ContractExtension-MaximumNumberNumeric","ordinal":0,"type":"number","unit":null,"value":0.0},{"field_id":"DE1-ProcurementProject-Description","lang":"DEU","ordinal":0,"type":"text","value":"Die Stadt Cottbus beabsichtigt die Aktualisierung eines ELW2. Das Vergabeverfahren umfasst alle notwendigen Schritte und Maßnahmen für den Umbau, Fahrgestell- und Technikrefresh des ELW2 der Stadt Cottbus."},{"field_id":"DE1-ProcurementProject-ID","is_ref":false,"ordinal":0,"scheme":"internalID","type":"id","value":"VHVmöTw 302-2024"},{"code":"50100000","field_id":"DE1-ProcurementProject-MainCommodityClassification-ItemClassificationCode","ordinal":0,"scheme":"cpv","type":"classification"},{"field_id":"DE1-ProcurementProject-Name","lang":"DEU","ordinal":0,"type":"text","value":"Stadt Cottbus - VHVmöTw 302/2024 - Umbau, Fahrgestell- und Technikrefresh Feuerwehr ELW2"},{"field_id":"DE1-ProcurementProject-Note","lang":"DEU","ordinal":0,"type":"text","value":"Bekanntmachungs-ID: CXSGYYDY1T1WD2EY\n\n\nRückfragen sind nur über die Kommunikation des Vergabemarktplatzes Brandenburg bis zum 27.12.2024 möglich.\n\nBitte um Beachtung: Es werden nur elektronische Angebote zugelassen, die über das Bietertool des Vergabemarktplatzes Brandenburg eingehen!\n\nMitteilung von Unklarheiten in den Vergabeunterlagen:\nEnthalten die Vergabeunterlagen nach Auffassung des Bieters/Bewerbers Unklarheiten, so hat der Bieter/Bewerber die Vergabestelle unverzüglich vor Angebotsabgabe in Textform darauf hinzuweisen.\n\nTeilnahme am Verfahren über den Vergabemarktplatz Brandenburg:\nNur durch das Bestätigen der Teilnahme am Verfahren können Sie folgende Vorteile nutzen:\nSie werden über neue Nachrichten der Vergabestelle automatisch per E-Mail informiert (z.B. Änderungen an den Vergabeunterlagen). \nSie können direkt über den Kommunikationsbereich der Vergabestelle eigene Nachrichten zukommen lassen. \nOhne Bestätigung der Teilnahme an diesem Verfahren erfolgt keine E-Mail Benachrichtigung über neue Nachrichten der Vergabestelle (z.B. Aktualisierung der Vergabeunterlagen). \n\nEine Anleitung für die elektronische Angebotsabgabe finden Sie unter folgendem Link: \nhttps://support.cosinex.de/unternehmen/display/company/Tipps+zur+elektronischen+Angebotsabgabe"},{"field_id":"DE1-ProcurementProject-PlannedPeriod-DurationMeasure","ordinal":0,"type":"number","unit":"MONTH","value":6.0},{"code":"services","field_id":"DE1-ProcurementProject-ProcurementTypeCode","list":"contract-nature","ordinal":0,"type":"code"},{"field_id":"DE1-ProcurementProject-SMESuitableIndicator","ordinal":0,"type":"integer","value":1},{"field_id":"DE1-RegulatoryDomain","lang":null,"ordinal":0,"type":"text","value":"32014L0024"},{"field_id":"DE1-RequestedPublicationDate","ordinal":0,"type":"date","value":"2024-12-03"},{"field_id":"DE1-TenderingProcess-AccessToolsURI","lang":null,"ordinal":0,"type":"text","value":"https://vergabemarktplatz.brandenburg.de/VMPSatellite/notice/CXSGYYDY1T1WD2EY"},{"field_id":"DE1-TenderingProcess-AuctionTerms-AuctionConstraintIndicator","ordinal":0,"type":"integer","value":0},{"code":"neg-w-call","field_id":"DE1-TenderingProcess-ProcedureCode","list":"procurement-procedure-type","ordinal":0,"type":"code"},{"field_id":"DE1-TenderingTerms-AppealTerms-AppealInformationParty-PartyIdentification-ID","is_ref":true,"ordinal":0,"scheme":"organization","type":"id","value":"ORG-0003"},{"field_id":"DE1-TenderingTerms-AppealTerms-AppealReceiverParty-PartyIdentification-ID","is_ref":true,"ordinal":0,"scheme":"organization","type":"id","value":"ORG-0004"},{"field_id":"DE1-TenderingTerms-AppealTerms-PresentationPeriod-Description","lang":"DEU","ordinal":0,"type":"text","value":"Auf das Vergabeverfahren findet das Gesetz gegen Wettbewerbsbeschränkungen (GWB) in der Fassung der Bekanntmachung vom 26.06.2013 (BGBl. I, Seite 1750, berichtigt Seite 3245) Anwendung.\n\n§160 GWB lautet auszugsweise:\n(1) Die Vergabekammer leitet ein Nachprüfverfahren nur auf Antrag ein.\n(3) Der Antrag ist unzulässig, soweit\n\n1. der Antragsteller den geltend gemachten Verstoß gegen Vergabevorschriften vor Einreichen des Nachprüfungsantrags erkannt und gegenüber dem Auftraggeber nicht innerhalb einer Frist von 10 Kalendertagen gerügt hat.\n\n2. Verstöße gegen Vergabevorschriften, die aufgrund der Bekanntmachung erkennbar sind, nicht spätestens bis zum Ablauf der in der Bekanntmachung genannten Frist zur Bewerbung oder zur Angebotsabgabe gegenüber dem Auftraggeber gerügt werden. \n\n3. Verstöße gegen Vergabevorschriften, die erst in den Vergabeunterlagen erkennbar sind, nicht spätestens bis zum Ablauf der Frist zur Bewerbung oder Angebotsabgabe gegenüber dem Auftraggeber gerügt werden.\n\n4. mehr als 15 Kalendertage nach Eingang der Mitteilung des Auftraggebers, einer Rüge nicht abhelfen zu wollen, vergangen sind.\n\nAußerdem wird auf § 180 GWB (\"Schadensersatzanspruch bei Rechtsmissbrauch\") in Verbindung mit §§ 160 und 171 GWB verwiesen (besonders § 180 (2) Nr. 2 GWB)."},{"field_id":"DE1-TenderingTerms-CallForTendersDocumentReference-DocumentType","lang":null,"ordinal":0,"type":"text","value":"non-restricted-document"},{"field_id":"DE1-TenderingTerms-CallForTendersDocumentReference-ID","is_ref":false,"ordinal":0,"scheme":null,"type":"id","value":"SomeTenderDocID1"},{"field_id":"DE1-TenderingTerms-CallForTendersDocumentReference-LanguageID","is_ref":false,"ordinal":0,"scheme":null,"type":"id","value":"DEU"},{"code":"no-eu-funds","field_id":"DE1-TenderingTerms-FundingProgramCode","list":"eu-funded","ordinal":0,"type":"code"},{"field_id":"DE1-TenderingTerms-PaymentTerms-Note","lang":"DEU","ordinal":0,"type":"text","value":"Bewerbungsbedingungen und Vertragsbedingungen des Landes Brandenburg"},{"code":"false","field_id":"DE1-TenderingTerms-RequiredFinancialGuarantee-GuaranteeTypeCode","list":"tender-guarantee-required","ordinal":0,"type":"code"},{"field_id":"DE1-TenderingTerms-TenderRecipientParty-PartyIdentification-ID","is_ref":true,"ordinal":0,"scheme":null,"type":"id","value":"ORG-0005"},{"field_id":"DE1-TenderingTerms-TenderValidityPeriod-DurationMeasure","ordinal":0,"type":"number","unit":"DAY","value":63.0},{"field_id":"DE1-UBLVersionID","is_ref":false,"ordinal":0,"scheme":null,"type":"id","value":"2.3"},{"field_id":"DE1-VersionID","is_ref":false,"ordinal":0,"scheme":null,"type":"id","value":"01"}]}]}