":false,"ordinal":0,"scheme":"notice-id","type":"id","value":"a9c1a2ae-ae9b-4ffc-ace0-e18c16eb8361"},{"field_id":"DE1-IssueDate","ordinal":0,"type":"date","value":"2025-01-27T08:22:56+01:00"},{"code":"DEU","field_id":"DE1-NoticeLanguageCode","list":"eu-official-language","ordinal":0,"type":"code"},{"cents":22792260,"currency":"EUR","field_id":"DE1-NoticeResult-TotalAmount","ordinal":0,"type":"amount"},{"code":"29","field_id":"DE1-NoticeSubType-SubTypeCode","list":"notice-subtype","ordinal":0,"type":"code"},{"code":"can-standard","field_id":"DE1-NoticeTypeCode","list":"result","ordinal":0,"type":"code"},{"field_id":"DE1-ProcurementProject-ContractExtension-MaximumNumberNumeric","ordinal":0,"type":"number","unit":null,"value":0.0},{"field_id":"DE1-ProcurementProject-Description","lang":"DEU","ordinal":0,"type":"text","value":"Durchführung einer Befragung zur sozialen Akzeptanz von Geothermie"},{"field_id":"DE1-ProcurementProject-ID","is_ref":false,"ordinal":0,"scheme":"internalID","type":"id","value":"2024-RPTU-3824"},{"code":"79320000","field_id":"DE1-ProcurementProject-MainCommodityClassification-ItemClassificationCode","ordinal":0,"scheme":"cpv","type":"classification"},{"field_id":"DE1-ProcurementProject-Name","lang":"DEU","ordinal":0,"type":"text","value":"Durchführung einer Befragung zur sozialen Akzeptanz von Geothermie"},{"field_id":"DE1-ProcurementProject-Note","lang":"DEU","ordinal":0,"type":"text","value":"Bekanntmachungs-ID: CXTGYYDYT6DB20XQ\n\n\n1. Die Unterlagen werden ausschließlich über das Deutsche Vergabeportal DTVP in elektronischer Form bereitgestellt.\n\n2. Bieterfragen sollen über das Deutsche Vergabeportal DTVP an die ausschreibende Stelle erfolgen. Nur so ist sichergestellt, dass auch bei Abwesenheit des federführenden Sachbearbeiters eine Bearbeitung zeitnah erfolgt.\n\n3. Hinweis zur Mustererklärung 3 LTTG (Landestariftreuegesetz Rheinland-Pfalz). Die Erklärung über die Zahlung des Mindesttariflohns ist nur durch diejenige Bieter einzureichen, die die Arbeitsleistungen in Deutschland ausführen oder durch Subunternehmer mit Sitz in Deutschland ausführen lassen. Bieter, die Ihren Sitz in einem anderen EU-Mitgliedstaat haben oder die die Leistung durch ein Unternehmen mit Sitz in einem anderen EU-Mitgliedstaat ausführen lassen, sind nicht verpflichtet die Erklärung abzugeben."},{"code":"services","field_id":"DE1-ProcurementProject-ProcurementTypeCode","list":"contract-nature","ordinal":0,"type":"code"},{"field_id":"DE1-RegulatoryDomain","lang":null,"ordinal":0,"type":"text","value":"32014L0024"},{"field_id":"DE1-RequestedPublicationDate","ordinal":0,"type":"date","value":"2025-01-27"},{"field_id":"DE1-TenderResult-AwardDate","ordinal":0,"type":"date","value":"2000-01-01"},{"field_id":"DE1-TenderingProcess-AuctionTerms-AuctionConstraintIndicator","ordinal":0,"type":"integer","value":0},{"code":"open","field_id":"DE1-TenderingProcess-ProcedureCode","list":"procurement-procedure-type","ordinal":0,"type":"code"},{"field_id":"DE1-TenderingTerms-AppealTerms-AppealInformationParty-PartyIdentification-ID","is_ref":true,"ordinal":0,"scheme":"organization","type":"id","value":"ORG-0003"},{"field_id":"DE1-TenderingTerms-AppealTerms-AppealReceiverParty-PartyIdentification-ID","is_ref":true,"ordinal":0,"scheme":"organization","type":"id","value":"ORG-0004"},{"field_id":"DE1-TenderingTerms-AppealTerms-MediationParty-PartyIdentification-ID","is_ref":true,"ordinal":0,"scheme":"organization","type":"id","value":"ORG-0005"},{"field_id":"DE1-TenderingTerms-AppealTerms-PresentationPeriod-Description","lang":"DEU","ordinal":0,"type":"text","value":"§ 160 Abs. 3 GWB\nDer Antrag ist unzulässig, soweit \n1. Der Antragsteller den geltend gemachten Verstoß gegen Vergabevorschriften vor Einreichen des Nachprüfungsantrages erkannt und gegenüber dem Auftraggeber nicht innerhalb einer Frist von zehn Kalendertagen gerügt hat; der Ablauf der Frist nach § 134 Abs. 2 bleibt unberührt.\n2. Verstöße gegen Vergabevorschriften, die aufgrund der Bekanntmachung erkennbar sind, nicht spätestens bis zum Ablauf der in der Bekanntmachung benannten First zur Bewerbung oder zur Angebotsabgabe gegenüber dem Auftraggeber gerügt werden,\n3. Verstöße gegen Vergabevorschriften, die erst in den Vergabeunterlagen erkennbar sind, nicht spätestens bis zum Ablauf der Frist zur Bewerbung oder zur Angebotsabgabe gegenüber dem Auftraggeber gerügt werden,\n4. Mehr als 15 Kalendertage nach Eingang der Mitteilung des Auftraggebers, einer Rüge nicht abhelfen zu wollen, vergangen sind."},{"code":"no-eu-funds","field_id":"DE1-TenderingTerms-FundingProgramCode","list":"eu-funded","ordinal":0,"type":"code"},{"field_id":"DE1-UBLVersionID","is_ref":false,"ordinal":0,"scheme":null,"type":"id","value":"2.3"},{"field_id":"DE1-VersionID","is_ref":false,"ordinal":0,"scheme":null,"type":"id","value":"01"}]},{"kind":"LotResult","parent_section_id":"PROCEDURE","section_id":"RES-0001","values":[{"field_id":"DE1-NoticeResult-LotResult-DPSTerminationIndicator","ordinal":0,"type":"integer","value":0},{"cents":27337275,"currency":"EUR","field_id":"DE1-NoticeResult-LotResult-HigherTenderAmount","ordinal":0,"type":"amount"},{"field_id":"DE1-NoticeResult-LotResult-ID","is_ref":false,"ordinal":0,"scheme":null,"type":"id","value":"RES-0001"},{"cents":23335348,"currency":"EUR","field_id":"DE1-NoticeResult-LotResult-LowerTenderAmount","ordinal":0,"type":"amount"},{"field_id":"DE1-NoticeResult-LotResult-TenderLot-ID","is_ref":false,"ordinal":0,"scheme":"Lot","type":"id","value":"LOT-0001"},{"code":"selec-w","field_id":"DE1-NoticeResult-LotResult-TenderResultCode","list":"winner-selection-status","ordinal":0,"type":"code"}]},{"kind":"LotTender","parent_section_id":"PROCEDURE","section_id":"TEN-0001","values":[{"field_id":"DE1-NoticeResult-LotTender-ID","is_ref":false,"ordinal":0,"scheme":"tender","type":"id","value":"TEN-0001"},{"cents":22792260,"currency":"EUR","field_id":"DE1-NoticeResult-LotTender-LegalMonetaryTotal-PayableAmount","ordinal":0,"type":"am