me":null,"type":"id","value":"851f1d7e-6d16-45d2-b0a0-fc9911e23d24"},{"field_id":"BT-05(a)-notice","ordinal":0,"type":"date","value":"2024-11-21T07:55:41+01:00"},{"code":"open","field_id":"BT-105-Procedure","list":"procurement-procedure-type","ordinal":0,"type":"code"},{"code":"false","field_id":"BT-106-Procedure","list":"accelerated-procedure","ordinal":0,"type":"code"},{"field_id":"BT-124-Lot","lang":null,"ordinal":0,"type":"text","value":"https://www.vergabe-westfalen.de/VMPSatellite/notice/CXX0YYDY1TH3KDZW"},{"code":"non-restricted-document","field_id":"BT-14-Lot","list":null,"ordinal":0,"type":"code"},{"field_id":"BT-21-Procedure","lang":"DEU","ordinal":0,"type":"text","value":"Grundschule Plaß - OGS Erweiterung - Trockenbauarbeiten"},{"field_id":"BT-22-Procedure","is_ref":false,"ordinal":0,"scheme":"internalID","type":"id","value":"ZVS 2024 0105"},{"code":"works","field_id":"BT-23-Lot","list":"contract-nature","ordinal":0,"type":"code"},{"field_id":"BT-24-Procedure","lang":"DEU","ordinal":0,"type":"text","value":"Trockenbau: \n- Metallbauständerbauweise\n  - ca. 80qm GKBI Wände und Vorwände\n  - ca. 290 qm GKFI Wände und Vorwände\n  - ca. 130 qm GKF Wände\n  - ca. 38 qm GKF gebogen \n- Holzständerbauweise: ca. 34 qm\n- Rasterdecke: ca. 76 qm, Hygienedecke: ca. 84 qm\n- Lochgipsdecke: 700 qm"},{"field_id":"BT-300-Procedure","lang":"DEU","ordinal":0,"type":"text","value":"Bekanntmachungs-ID: CXX0YYDY1TH3KDZW\n\n\nDer Auftragnehmer ist zur Einhaltung der Vorgaben des Tariftreue- und Vergabegesetzes Nordrhein-Westfalen verpflichtet."},{"field_id":"BT-536-Lot","ordinal":0,"type":"date","value":"2025-02-24"},{"field_id":"BT-537-Lot","ordinal":0,"type":"date","value":"2025-06-30"},{"field_id":"BT-58-Lot","ordinal":0,"type":"integer","value":0},{"code":"no-eu-funds","field_id":"BT-60-Lot","list":"eu-funded","ordinal":0,"type":"code"},{"field_id":"BT-701-notice","is_ref":false,"ordinal":0,"scheme":"notice-id","type":"id","value":"ee4f6e35-64ca-4e6e-b6b5-d4137ef7266b"},{"code":"DEU","field_id":"BT-702(a)-notice","list":"eu-official-language","ordinal":0,"type":"code"},{"code":"DEU","field_id":"BT-708-Lot","list":null,"ordinal":0,"type":"code"},{"field_id":"BT-726-Lot","ordinal":0,"type":"integer","value":1},{"code":"no","field_id":"BT-736-Lot","list":"reserved-execution","ordinal":0,"type":"code"},{"field_id":"BT-738-notice","ordinal":0,"type":"date","value":"2024-11-21"},{"field_id":"BT-75-Lot","lang":"DEU","ordinal":0,"type":"text","value":"Eine Sicherheitsleistung wird vereinbart:\nAls Mängelanspruchsbürgschaft in Höhe von 3 v. H. der Abrechnungssumme. Diese Bürgschaft ist beizubringen, sobald mehr als 97 v. H. des Wertes der jeweils nachgewiesenen vertragsgemäßen Leistungen ausgezahlt werden sollen und der Auftraggeber dieses verlangt, spätestens vor Leistung der Schlusszahlung."},{"code":"true","field_id":"BT-751-Lot","list":"tender-guarantee-required","ordinal":0,"type":"code"},{"field_id":"BT-757-notice","is_ref":false,"ordinal":0,"scheme":null,"type":"id","value":"01"},{"code":"not-allowed","field_id":"BT-764-Lot","list":"ecatalog-submission","ordinal":0,"type":"code"},{"field_id":"BT-767-Lot","ordinal":0,"type":"integer","value":0},{"code":"DEU","field_id":"BT-97-Lot","list":null,"ordinal":0,"type":"code"},{"field_id":"BT-98-Lot","ordinal":0,"type":"number","unit":"DAY","value":49.0},{"field_id":"BT-99-Lot","lang":"DEU","ordinal":0,"type":"text","value":"Gemäß § 160 Abs. 1 GWB leitet die Vergabekammer ein Nachprüfungsverfahren nur auf Antrag ein. Der Antrag ist gemäß § 160 Abs. 3 Nr. 1 GWB unzulässig, wenn der Antragsteller den geltend gemachten Verstoß gegen Vergabevorschriften vor Einreichen des Nachprüfungsantrages erkannt und gegenüber dem Auftraggeber nicht innerhalb einer Frist von 10 Kalendertagen gerügt hat. Des Weiteren ist gemäß § 160 Abs. 3 Nr. 4 GWB der Nachprüfungsantrag unzulässig, wenn mehr als 15 Kalendertage nach Eingang der"},{"field_id":"OPP-010-notice","is_ref":false,"ordinal":0,"scheme":"ojs-notice-id","type":"id","value":"00713972-2024"},{"field_id":"OPP-011-notice","is_ref":false,"ordinal":0,"scheme":"ojs-id","type":"id","value":"228/2024"},{"field_id":"OPP-012-notice","ordinal":0,"type":"date","value":"2024-11-22"},{"code":"16","field_id":"OPP-070-notice","list":"notice-subtype","ordinal":0,"type":"code"},{"field_id":"OPT-001-notice","is_ref":false,"ordinal":0,"scheme":null,"type":"id","value":"2.3"},{"field_id":"OPT-002-notice","is_ref":false,"ordinal":0,"scheme":null,"type":"id","value":"eforms-sdk-1.7"},{"field_id":"OPT-140-Lot","is_ref":false,"ordinal":0,"scheme":null,"type":"id","value":"SomeTenderDocID1"},{"field_id":"OPT-301-Lot-ReviewOrg","is_ref":true,"ordinal":0,"scheme":"organization","type":"id","value":"ORG-0003"},{"field_id":"OPT-301-Lot-TenderReceipt","is_ref":true,"ordinal":0,"scheme":null,"type":"id","value":"ORG-0004"}]}]}