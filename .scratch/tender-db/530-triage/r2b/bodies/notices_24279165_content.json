assification#0","values":[{"code":"45262670","field_id":"BT-262-Procedure","ordinal":0,"scheme":"cpv","type":"classification"}]},{"kind":"ProcedurePlacePerformanceAdditionalInformation","parent_section_id":"PROCEDURE","section_id":"ND-ProcedurePlacePerformanceAdditionalInformation#0","values":[{"code":"DE11D","field_id":"BT-5071-Procedure","ordinal":0,"scheme":"nuts","type":"classification"},{"field_id":"BT-5101(a)-Procedure","lang":null,"ordinal":0,"type":"text","value":"Berufliches Schulzentrum Aalen"},{"field_id":"BT-5101(b)-Procedure","lang":null,"ordinal":0,"type":"text","value":"Steinbeisstraße 6"},{"field_id":"BT-5121-Procedure","lang":null,"ordinal":0,"type":"text","value":"73430"},{"field_id":"BT-5131-Procedure","lang":null,"ordinal":0,"type":"text","value":"Aalen"},{"code":"DEU","field_id":"BT-5141-Procedure","list":null,"ordinal":0,"type":"code"}]},{"kind":"SelectionCriteria","parent_section_id":"LOT-0001","section_id":"ND-SelectionCriteria#0","values":[{"code":"ef-stand","field_id":"BT-747-Lot","list":"selection-criterion","ordinal":0,"type":"code"},{"field_id":"BT-750-Lot","lang":"DEU","ordinal":0,"type":"text","value":"Umsatz des Unternehmens jeweils bezogen auf die letzten drei abgeschlossenen Geschäftsjahre, soweit er Bauleistungen und andere Leistungen betrifft, die mit der zu vergebenden Leistung vergleichbar sind, unter Einschluss des Anteils bei gemeinsam mit anderen Unternehmen ausgeführten Aufträgen"},{"field_id":"UBL-SelectionCriterionName","lang":"DEU","ordinal":0,"type":"text","value":"Wirtschaftliche und finanzielle Leistungsfähigkeit"}]},{"kind":"SelectionCriteria","parent_section_id":"LOT-0001","section_id":"ND-SelectionCriteria#1","values":[{"code":"other","field_id":"BT-747-Lot","list":"selection-criterion","ordinal":0,"type":"code"},{"field_id":"BT-750-Lot","lang":"DEU","ordinal":0,"type":"text","value":"Einzureichende Unterlagen:\n  - Urkalkulation (auf Anforderung der Vergabestelle vorzulegen): (die Urkalkulation wird für die Prüfung der Preise geöffnet, im Anschluss wieder\nverschlossen)"},{"field_id":"UBL-SelectionCriterionName","lang":"DEU","ordinal":0,"type":"text","value":"Sonstiges"}]},{"kind":"SelectionCriteria","parent_section_id":"LOT-0001","section_id":"ND-SelectionCriteria#2","values":[{"code":"sui-act","field_id":"BT-747-Lot","list":"selection-criterion","ordinal":0,"type":"code"},{"field_id":"BT-750-Lot","lang":"DEU","ordinal":0,"type":"text","value":"Zuverlässigkeit:\n- Nichtvorliegen von Ausschlussgründen gemäß § 6a EU VOB/A.\n- Angaben zur Zahlung von Steuern, Abgaben und Beiträgen zur gesetzlichen Sozialversicherung.\n- Angaben zur Mitgliedschaft bei der Berufsgenossenschaft\n- Angabe zu Insolvenzverfahren und Liquidation\n\nBefähigung und Erlaubnis Berufsausübung:\n- Eintragung in das Berufsregister ihres Sitzes oder Wohnsitzes.\n\nFalls das Angebot in die engere Wahl kommt, wird zur Bestätigung die entsprechende Bescheinigung vorgelegt."},{"field_id":"UBL-SelectionCriterionName","lang":"DEU","ordinal":0,"type":"text","value":"Eignung zur Berufsausübung"}]},{"kind":"SelectionCriteria","parent_section_id":"LOT-0001","section_id":"ND-SelectionCriteria#3","values":[{"code":"tp-abil","field_id":"BT-747-Lot","list":"selection-criterion","ordinal":0,"type":"code"},{"field_id":"BT-750-Lot","lang":"DEU","ordinal":0,"type":"text","value":"Referenzen:\nVorlage geeigneter Referenzen über die in den letzten drei Jahre erbrachten vergleichbaren Leistungen.\nEs sind mindestens folgende Angaben zu benennen:\nAnsprechpartner, Art der ausgeführten Leistung, Auftragssumme, Ausführungszeitraum.\n\nAngabe zu Arbeitskräften:\nErklärung, dass die mit der Ausführung der Leistung erforderlichen Beschäftigen zur Verfügung stehen.\n\nFalls das Angebot in die engere Wahl gelangt, ist die Zahl der in den letzten drei abgeschlossenen Kalenderjahren jahresdurchschnittlich beschäftigten Arbeitskräfte gegliedert nach Lohngruppen mit extra ausgewiesenem Leitungspersonal anzugeben."},{"field_id":"UBL-SelectionCriterionName","lang":"DEU","ordinal":0,"type":"text","value":"Technische und berufliche Leistungsfähigkeit"}]},{"kind":"ServiceProviderParty","parent_section_id":"ND-ContractingParty#0","section_id":"ND-ServiceProviderParty#0","values":[{"code":"ted-esen","field_id":"OPT-030-Procedure-SProvider","list":"organisation-role","ordinal":0,"type":"code"},{"field_id":"OPT-300-Procedure-SProvider","is_ref":true,"ordinal":0,"scheme":"organization","type":"id","value":"ORG-0005"}]},{"kind":"StrategicProcurementType","parent_section_id":"LOT-0001","section_id":"ND-StrategicProcurementType#0","values":[{"code":"none","field_id":"BT-06-Lot","list":"strategic-procurement","ordinal":0,"type":"code"}]},{"kind":"Organization","parent_section_id":"PROCEDURE","section_id":"ORG-0001","values":[{"field_id":"BT-500-Organization-Company","lang":"DEU","ordinal":0,"type":"text","value":"Landratsamt Ostalbkreis - Zentrale Vergabestelle"},{"field_id":"BT-501-Organization-Company","is_ref":false,"ordinal":0,"scheme":null,"type":"id","value":"9134cf9a-a8e7-4989-b7c1-9bcb56ef803c"},{"field_id":"BT-503-Organization-Company","lang":null,"ordinal":0,"type":"text","value":"+49 73615031101"},{"field_id":"BT-506-Organization-Company","lang":null,"ordinal":0,"type":"text","value":"zentralevergabestelle@ostalbkreis.de"},{"code":"DE11D","field_id":"BT-507-Organization-Company","ordinal":0,"scheme":"nuts","type":"classification"},{"field_id":"BT-510(a)-Organization-Company","lang":null,"ordinal":0,"type":"text","value":"Stuttgarter Straße 41"},{"field_id":"BT-512-Organization-Company","lang":null,"ordinal":0,"type":"text","value":"73430"},{"field_id":"BT-513-Organization-Company","lang":null,"ordinal":0,"type":"text","value":"Aalen"},{"code":"DEU","field_id":"BT-514-Organization-Company","list":null,"ordinal":0,"type":"code"},{"field_id":"BT-739-Organization-Company","lang":null,"ordinal":0,"type":"text","value":"+49 7361503581101"},{"field_id":"OPT-200-Organization-Company","is_ref":false,"ordinal":0,"s