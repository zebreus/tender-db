ization-Company","lang":null,"ordinal":0,"type":"text","value":"53119"},{"field_id":"BT-513-Organization-Company","lang":null,"ordinal":0,"type":"text","value":"Bonn"},{"code":"DEU","field_id":"BT-514-Organization-Company","list":"country","ordinal":0,"type":"code"},{"field_id":"OPT-200-Organization-Company","is_ref":false,"ordinal":0,"scheme":"organization","type":"id","value":"ORG-0007"}]},{"kind":"Notice","parent_section_id":null,"section_id":"PROCEDURE","values":[{"code":"32014L0024","field_id":"BT-01-notice","list":null,"ordinal":0,"type":"code"},{"code":"can-standard","field_id":"BT-02-notice","list":"result","ordinal":0,"type":"code"},{"field_id":"BT-04-notice","is_ref":false,"ordinal":0,"scheme":null,"type":"id","value":"944fa7d8-295f-4e5b-b8fc-cf72cc0c3946"},{"field_id":"BT-05(a)-notice","ordinal":0,"type":"date","value":"2025-01-27T08:22:56+01:00"},{"code":"open","field_id":"BT-105-Procedure","list":"procurement-procedure-type","ordinal":0,"type":"code"},{"code":"false","field_id":"BT-106-Procedure","list":"accelerated-procedure","ordinal":0,"type":"code"},{"cents":22792260,"currency":"EUR","field_id":"BT-161-NoticeResult","ordinal":0,"type":"amount"},{"field_id":"BT-21-Procedure","lang":"DEU","ordinal":0,"type":"text","value":"Durchführung einer Befragung zur sozialen Akzeptanz von Geothermie"},{"field_id":"BT-22-Procedure","is_ref":false,"ordinal":0,"scheme":"internalID","type":"id","value":"2024-RPTU-3824"},{"code":"services","field_id":"BT-23-Lot","list":"contract-nature","ordinal":0,"type":"code"},{"field_id":"BT-24-Procedure","lang":"DEU","ordinal":0,"type":"text","value":"Durchführung einer Befragung zur sozialen Akzeptanz von Geothermie"},{"field_id":"BT-300-Procedure","lang":"DEU","ordinal":0,"type":"text","value":"Bekanntmachungs-ID: CXTGYYDYT6DB20XQ\n\n\n1. Die Unterlagen werden ausschließlich über das Deutsche Vergabeportal DTVP in elektronischer Form bereitgestellt.\n\n2. Bieterfragen sollen über das Deutsche Vergabeportal DTVP an die ausschreibende Stelle erfolgen. Nur so ist sichergestellt, dass auch bei Abwesenheit des federführenden Sachbearbeiters eine Bearbeitung zeitnah erfolgt.\n\n3. Hinweis zur Mustererklärung 3 LTTG (Landestariftreuegesetz Rheinland-Pfalz). Die Erklärung über die Zahlung des Mindesttariflohns ist nur durch diejenige Bieter einzureichen, die die Arbeitsleistungen in Deutschland ausführen oder durch Subunternehmer mit Sitz in Deutschland ausführen lassen. Bieter, die Ihren Sitz in einem anderen EU-Mitgliedstaat haben oder die die Leistung durch ein Unternehmen mit Sitz in einem anderen EU-Mitgliedstaat ausführen lassen, sind nicht verpflichtet die Erklärung abzugeben."},{"field_id":"BT-58-Lot","ordinal":0,"type":"integer","value":0},{"code":"no-eu-funds","field_id":"BT-60-Lot","list":"eu-funded","ordinal":0,"type":"code"},{"field_id":"BT-701-notice","is_ref":false,"ordinal":0,"scheme":"notice-id","type":"id","value":"a9c1a2ae-ae9b-4ffc-ace0-e18c16eb8361"},{"code":"DEU","field_id":"BT-702(a)-notice","list":"eu-official-language","ordinal":0,"type":"code"},{"field_id":"BT-738-notice","ordinal":0,"type":"date","value":"2025-01-27"},{"field_id":"BT-757-notice","is_ref":false,"ordinal":0,"scheme":null,"type":"id","value":"01"},{"field_id":"BT-767-Lot","ordinal":0,"type":"integer","value":0},{"field_id":"BT-99-Lot","lang":"DEU","ordinal":0,"type":"text","value":"§ 160 Abs. 3 GWB\nDer Antrag ist unzulässig, soweit \n1. Der Antragsteller den geltend gemachten Verstoß gegen Vergabevorschriften vor Einreichen des Nachprüfungsantrages erkannt und gegenüber dem Auftraggeber nicht innerhalb einer Frist von zehn Kalendertagen gerügt hat; der Ablauf der Frist nach § 134 Abs. 2 bleibt unberührt.\n2. Verstöße gegen Vergabevorschriften, die aufgrund der Bekanntmachung erkennbar sind, nicht spätestens bis zum Ablauf der in der Bekanntmachung benannten First zur Bewerbung oder zur Angebotsabgabe gegenüber dem Auftraggeber gerügt werden,\n3. Verstöße gegen Vergabevorschriften, die erst in den Vergabeunterlagen erkennbar sind, nicht spätestens bis zum Ablauf der Frist zur Bewerbung oder zur Angebotsabgabe gegenüber dem Auftraggeber gerügt werden,\n4. Mehr als 15 Kalendertage nach Eingang der Mitteilung des Auftraggebers, einer Rüge nicht abhelfen zu wollen, vergangen sind."},{"field_id":"OPP-010-notice","is_ref":false,"ordinal":0,"scheme":"ojs-notice-id","type":"id","value":"00059167-2025"},{"field_id":"OPP-011-notice","is_ref":false,"ordinal":0,"scheme":"ojs-id","type":"id","value":"19/2025"},{"field_id":"OPP-012-notice","ordinal":0,"type":"date","value":"2025-01-28"},{"code":"29","field_id":"OPP-070-notice","list":"notice-subtype","ordinal":0,"type":"code"},{"field_id":"OPT-001-notice","is_ref":false,"ordinal":0,"scheme":null,"type":"id","value":"2.3"},{"field_id":"OPT-002-notice","is_ref":false,"ordinal":0,"scheme":null,"type":"id","value":"eforms-sdk-1.7"},{"field_id":"OPT-301-Lot-Mediator","is_ref":true,"ordinal":0,"scheme":"organization","type":"id","value":"ORG-0005"},{"field_id":"OPT-301-Lot-ReviewInfo","is_ref":true,"ordinal":0,"scheme":"organization","type":"id","value":"ORG-0003"},{"field_id":"OPT-301-Lot-ReviewOrg","is_ref":true,"ordinal":0,"scheme":"organization","type":"id","value":"ORG-0004"},{"field_id":"OPT-999","ordinal":0,"type":"date","value":"2000-01-01"}]},{"kind":"LotResult","parent_section_id":"PROCEDURE","section_id":"RES-0001","values":[{"field_id":"BT-119-LotResult","ordinal":0,"type":"integer","value":0},{"field_id":"BT-13713-LotResult","is_ref":true,"ordinal":0,"scheme":"Lot","type":"id","value":"LOT-0001"},{"code":"selec-w","field_id":"BT-142-LotResult","list":"winner-selection-status","ordinal":0,"type":"code"},{"cents":23335348,"currency":"EUR","field_id":"BT-710-LotResult","ordinal":0,"type":"amount"},{"cents":27337275,"currency":"EUR","field_id":"BT-711-LotResult","ordinal":0,"type":"amount"},{"code":"false","field_id":"BT-717-Lot","list":"cvd-scope","ordinal":0,"type":"code"},{"field_id":"OPT-315-LotResult","is_ref":true,"ordin