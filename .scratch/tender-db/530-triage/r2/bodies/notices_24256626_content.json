ld_id":"BT-507-Organization-Company","ordinal":0,"scheme":"nuts","type":"classification"},{"field_id":"BT-512-Organization-Company","lang":null,"ordinal":0,"type":"text","value":"53119"},{"field_id":"BT-513-Organization-Company","lang":null,"ordinal":0,"type":"text","value":"Bonn"},{"code":"DEU","field_id":"BT-514-Organization-Company","list":"country","ordinal":0,"type":"code"},{"field_id":"OPT-200-Organization-Company","is_ref":false,"ordinal":0,"scheme":"organization","type":"id","value":"ORG-0005"}]},{"kind":"Notice","parent_section_id":null,"section_id":"PROCEDURE","values":[{"code":"32014L0024","field_id":"BT-01-notice","list":null,"ordinal":0,"type":"code"},{"code":"can-standard","field_id":"BT-02-notice","list":"result","ordinal":0,"type":"code"},{"field_id":"BT-04-notice","is_ref":false,"ordinal":0,"scheme":null,"type":"id","value":"18a1cc0f-fbda-44f7-90c4-3fb5b5847965"},{"field_id":"BT-05(a)-notice","ordinal":0,"type":"date","value":"2024-10-18T08:47:25+02:00"},{"code":"open","field_id":"BT-105-Procedure","list":"procurement-procedure-type","ordinal":0,"type":"code"},{"code":"false","field_id":"BT-106-Procedure","list":"accelerated-procedure","ordinal":0,"type":"code"},{"field_id":"BT-21-Procedure","lang":"DEU","ordinal":0,"type":"text","value":"Grundsanierung Stadtwaage - Rohbauarbeiten"},{"field_id":"BT-22-Procedure","is_ref":false,"ordinal":0,"scheme":"internalID","type":"id","value":"2024-VOBEU-23/5-013"},{"code":"works","field_id":"BT-23-Lot","list":"contract-nature","ordinal":0,"type":"code"},{"field_id":"BT-24-Procedure","lang":"DEU","ordinal":0,"type":"text","value":"Rohbauarbeiten"},{"field_id":"BT-300-Procedure","lang":"DEU","ordinal":0,"type":"text","value":"Bekanntmachungs-ID: CXTBYY6Y1WLHBL99\n\n\nWesentliche Finanzierungs- und Zahlungsbedingungen und/oder Verweis auf die maßgeblichen Vorschriften:\n\nVOB/A; VOB/B; GWB, vierter Teil; VGV; Niedersächsisches Tariftreue- und Vergabegesetz\n\nBieter haben die Vergabeunterlagen unverzüglich auf Vollständigkeit der Unterlagen sowie auf Unklarheiten zu überprüfen. Enthalten die Vergabeunterlagen Nach Auffassung des Bieters Unklarheiten, so hat der Bieter unverzüglich und noch vor Abgabe des Angebotes die Vergabestelle schriftlich darauf hinzuweisen. Die Bieter werden Aufgefordert, frühzeitig Ihre Fragen über den Kommunikationsraum der Vergabeplattform zu übermitteln. Fragen sind spätestens 10 Tage vor Ablauf der Angebotsfrist zu stellen. \n\nFragen zum Vergabeverfahren, die der Vergabestelle nicht bis 10 Tage vor Ablauf der Frist zur Abgabe der Angebote vorliegen, werden nur berücksichtigt, wenn dadurch eine Aufhebung des Verfahrens verhindert werden kann. Auskünfte im Vergabeverfahren werden ausschließlich - im gesetzlichen zulässigen Rahmen - schriftlich per Vergabeplattform erteilt. Telefonische Auskünfte oder per E-Mail werden nicht erteilt."},{"field_id":"BT-58-Lot","ordinal":0,"type":"integer","value":0},{"code":"no-eu-funds","field_id":"BT-60-Lot","list":"eu-funded","ordinal":0,"type":"code"},{"field_id":"BT-701-notice","is_ref":false,"ordinal":0,"scheme":"notice-id","type":"id","value":"d9216250-db34-4ff8-adb6-0801507f4af3"},{"code":"DEU","field_id":"BT-702(a)-notice","list":"eu-official-language","ordinal":0,"type":"code"},{"field_id":"BT-738-notice","ordinal":0,"type":"date","value":"2024-10-18"},{"field_id":"BT-757-notice","is_ref":false,"ordinal":0,"scheme":null,"type":"id","value":"01"},{"field_id":"BT-767-Lot","ordinal":0,"type":"integer","value":0},{"field_id":"BT-99-Lot","lang":"DEU","ordinal":0,"type":"text","value":"Ein Nachprüfungsantrag ist unzulässig, soweit mehr als 15 Kalendertage nach Eingang der Mitteilung des Auftraggebers, einer Rüge nicht abhelfen zu wollen, vergangen sind (§ 160 Abs. 3 Satz 1 Nr. 4 GWB).Ein Nachprüfungsantrag ist zudem unzulässig, wenn der Zuschlag erfolgt ist, bevor die Vergabekammerden Auftraggeber über den Antrag auf Nachprüfung informiert hat (§§ 168 Abs. 2 Satz 1, 169 Abs.1GWB). Die Zuschlagserteilung ist möglich 15 Kalendertage nach Absendung der Bieterinformation nach§134 Abs. 1 GWB. Wird die Information auf elektronischem Weg oder per Fax versendet, verkürzt sich die Frist auf 10 Kalendertage (§ 134 Abs. 2 GWB). Die Frist beginnt am Tag nach der Absendung der Information durch den Auftraggeber; auf den Tag des Zugangs beim betroffenen Bieter und Bewerber kommt es nicht an. Die Zulässigkeit eines Nachprüfungsantrags setzt ferner voraus, dass die geltend gemachten Vergabeverstöße 10 Kalendertage nach Kenntnis gerügt wurden (§ 160 Abs. 3 Satz 1 Nr. 1 GWB). Verstöße gegen Vergabevorschriften, die aufgrund der Bekanntmachung erkennbar sind, müssen spätestens bis zum Ablauf der in der Bekanntmachung benannten Frist zur Bewerbung oder zur Angebotsabgabe gegenüber dem Auftraggeber gerügt werden (§ 160 Abs. 3 Satz 1 Nr. 2 GWB). Verstöße gegen Vergabevorschriften, die erst in den Vergabeunterlagen erkennbar sind, müssen spätestens bis zum Ablauf der Frist zur Bewerbung oder zur Angebotsabgabe gegenüber dem Auftraggeber gerügt werden (§ 160 Abs. 3 Satz 1 Nr. 3 GWB)."},{"field_id":"OPP-010-notice","is_ref":false,"ordinal":0,"scheme":"ojs-notice-id","type":"id","value":"00634094-2024"},{"field_id":"OPP-011-notice","is_ref":false,"ordinal":0,"scheme":"ojs-id","type":"id","value":"205/2024"},{"field_id":"OPP-012-notice","ordinal":0,"type":"date","value":"2024-10-21"},{"code":"29","field_id":"OPP-070-notice","list":"notice-subtype","ordinal":0,"type":"code"},{"field_id":"OPT-001-notice","is_ref":false,"ordinal":0,"scheme":null,"type":"id","value":"2.3"},{"field_id":"OPT-002-notice","is_ref":false,"ordinal":0,"scheme":null,"type":"id","value":"eforms-sdk-1.7"},{"field_id":"OPT-301-Lot-ReviewOrg","is_ref":true,"ordinal":0,"scheme":"organization","type":"id","value":"ORG-0003"},{"field_id":"OPT-999","ordinal":0,"type":"date","value":"2000-01-01"}]},{"kind":"LotResult","parent_section_id":"PROCEDURE","section_id":"RES-0001","values":[{"field_id":"BT-119-LotResult","ordinal":0,"type":"integer","value":0},{"field_id":"BT-13713-LotResult","is_ref":true,"ordinal":0,"scheme":"Lot","type":"id","value":"LOT-0001"},{"code":"selec-w","field_id":"BT-142-LotResult","list":"winner-selection-status","ordinal":0,"type":"code"},{"cents":41257389,"currency":"EUR","field_id":"BT-710-LotResult","ordinal":0,"type":"amount"},{"cents":87032305,"currency":"EUR","field_id":"BT-711-LotResult","ordinal":0,"type":"amount"},{"code":"false","field_id":"BT-717-Lot","list":"cvd-scope","ordinal":0,"type":"code"},{"field_id":"OPT-315-LotResult","is_ref":true,"ordinal":0,"scheme":"contract","type":"id","value":"CON-0001"},{"field_id":"OPT-320-LotResult","is_ref":true,"ordinal":0,"scheme":"tender","type":"id","value":"TEN-0001"},{"field_id":"OPT-322-LotResult","is_ref":false,"ordinal":0,"scheme":null,"type":"id","value":"RES-0001"}]},{"kind":"LotTender","parent_section_id":"PROCEDURE","section_id":"TEN-0001","values":[{"field_id":"BT-13714-Tender","is_ref":true,"ordinal":0,"scheme":"Lot","type":"id","value":"LOT-0001"},{"field_id":"BT-193-Tender","ordinal":0,"type":"integer","value":0},{"cents":34670075,"currency":"EUR","field_id":"BT-720-Tender","ordinal":0,"type":"amount"},{"field_id":"OPT-310-Tender","is_ref":true,"ordinal":0,"scheme":"tenderingparty","type":"id","value":"TPA-0001"},{"field_id":"OPT-321-Tender","is_ref":false,"ordinal":0,"scheme":"tender","type":"id","value":"TEN-0001"}]},{"kind":"TenderingParty","parent_section_id":"PROCEDURE","section_id":"TPA-0001","values":[{"field_id":"OPT-210-Tenderer","is_ref":false,"ordinal":0,"scheme":"tendering-party","type":"id","value":"TPA-0001"}]},{"kind":"UBO","parent_section_id":"PROCEDURE","section_id":"UBO-0001","values":[{"code":"DEU","field_id":"BT-706-UBO","list":null,"ordinal":0,"type":"code"},{"field_id":"OPT-202-UBO","is_ref":false,"ordinal":0,"scheme":null,"type":"id","value":"UBO-0001"}]}]}