ang":null,"ordinal":0,"type":"text","value":"Münster"},{"code":"DEU","field_id":"DE1-ProcurementProject-RealizedLocation-Address-Country-IdentificationCode","list":null,"ordinal":0,"type":"code"},{"code":"DEA33","field_id":"DE1-ProcurementProject-RealizedLocation-Address-CountrySubentityCode","ordinal":0,"scheme":"nuts","type":"classification"},{"field_id":"DE1-ProcurementProject-RealizedLocation-Address-PostalZone","lang":null,"ordinal":0,"type":"text","value":"48143"}]},{"kind":"RealizedLocation","parent_section_id":"LOT-0001","section_id":"ND-RealizedLocation#1","values":[{"field_id":"DE1-ProcurementProject-RealizedLocation-Address-CityName","lang":null,"ordinal":0,"type":"text","value":"Münster"},{"code":"DEU","field_id":"DE1-ProcurementProject-RealizedLocation-Address-Country-IdentificationCode","list":null,"ordinal":0,"type":"code"},{"code":"DEA33","field_id":"DE1-ProcurementProject-RealizedLocation-Address-CountrySubentityCode","ordinal":0,"scheme":"nuts","type":"classification"},{"field_id":"DE1-ProcurementProject-RealizedLocation-Address-PostalZone","lang":null,"ordinal":0,"type":"text","value":"48143"}]},{"kind":"SelectionCriteria","parent_section_id":"LOT-0001","section_id":"ND-SelectionCriteria#0","values":[{"field_id":"DE1-TenderingTerms-SelectionCriteria-Description","lang":"DEU","ordinal":0,"type":"text","value":"Einzureichende Unterlagen:\n- Formular 521 / 521 EU Eigenerklärung Ausschlussgründe (mit dem Angebot mittels Eigenerklärung vorzulegen)\n- Formular 522 / EU Eigenerklärung Mindestlohn (mit dem Angebot mittels Eigenerklärung vorzulegen)\n- Formular 523 EU Eigenerklärung Sanktionspaket 5 (mit dem Angebot mittels Eigenerklärung vorzulegen)\n- Formular CSX 59 (mit dem Angebot mittels Eigenerklärung vorzulegen)\n-Anschreiben mit Nennung von Angaben zum Unternehmen hinsichtlich Unternehmensgröße, Mitarbeiterstruktur und des Leistungsspektrums, Fuhrpark, Angaben zur Herkunft von Lebensmitteln (Bio-Zertifizierung, regionale Lebensmittel)\n- Nachweis Betriebs- / Berufshaftpflichtversicherung (mit dem Angebot mittels Dritterklärung vorzulegen) Geforderte Mindestversicherungssummen:\n   - bei Personen- und Sachschäden mindestens 5.000.000 EUR\n-Formular 531 EU: Bewerber/Bietergemeinschaftserklärung\n-Formular 533a EU: Nachweis Unterauftragsnehmer\n-Formular 533b EU: Erklärung Eignungsleihe\n-Formular 534b EU: Erklärung Eignungsleihe Haftung"},{"field_id":"UBL-SelectionCriterionName","lang":"DEU","ordinal":0,"type":"text","value":"Wirtschaftliche und finanzielle Leistungsfähigkeit"},{"code":"ef-stand","field_id":"UBL-SelectionCriterionType","list":"selection-criterion","ordinal":0,"type":"code"}]},{"kind":"SelectionCriteria","parent_section_id":"LOT-0001","section_id":"ND-SelectionCriteria#1","values":[{"field_id":"DE1-TenderingTerms-SelectionCriteria-Description","lang":"DEU","ordinal":0,"type":"text","value":"Preisblatt"},{"field_id":"UBL-SelectionCriterionName","lang":"DEU","ordinal":0,"type":"text","value":"Sonstiges"},{"code":"other","field_id":"UBL-SelectionCriterionType","list":"selection-criterion","ordinal":0,"type":"code"}]},{"kind":"SelectionCriteria","parent_section_id":"LOT-0001","section_id":"ND-SelectionCriteria#2","values":[{"field_id":"DE1-TenderingTerms-SelectionCriteria-Description","lang":"DEU","ordinal":0,"type":"text","value":"Nachweis der Eintragung in einem Berufs- oder Handelsregister oder Nachweis auf andere Weise über die erlaubte Berufsausübung"},{"field_id":"UBL-SelectionCriterionName","lang":"DEU","ordinal":0,"type":"text","value":"Eignung zur Berufsausübung"},{"code":"sui-act","field_id":"UBL-SelectionCriterionType","list":"selection-criterion","ordinal":0,"type":"code"}]},{"kind":"SelectionCriteria","parent_section_id":"LOT-0001","section_id":"ND-SelectionCriteria#3","values":[{"field_id":"DE1-TenderingTerms-SelectionCriteria-Description","lang":"DEU","ordinal":0,"type":"text","value":"Einzureichende Unterlagen:\n- Referenzliste\n Die fachliche Kompetenz ist durch die Angabe von mindestens einer Referenz mit einem zu dieser Ausschreibung vergleichbaren Leistungsinhalt und -umfang aus den letzten 3 Geschäftsjahren (ab 2021) zu belegen. Folgende Angaben müssen ersichtlich sein: Angaben zu Referenz (Auftraggeber, Ansprechpartner), Beschreibung der erbrachten Leistung, Kalenderjahr.\n-Bescheinigung: Nachweis der Kontrollergebnisse der letzten Begutachtung des zuständigen Lebensmittelüberwachungsamtes"},{"field_id":"UBL-SelectionCriterionName","lang":"DEU","ordinal":0,"type":"text","value":"Technische und berufliche Leistungsfähigkeit"},{"code":"tp-abil","field_id":"UBL-SelectionCriterionType","list":"selection-criterion","ordinal":0,"type":"code"}]},{"kind":"SpecificTendererRequirement","parent_section_id":"ND-TendererQualificationRequest#0","section_id":"ND-SpecificTendererRequirement#0","values":[{"field_id":"DE1-TenderingTerms-TendererQualificationRequest-SpecificTendererRequirement-Description","lang":"DEU","ordinal":0,"type":"text","value":"Zwingende bzw. fakultative Ausschlussgründe nach §§ 123 bis 126 GWB"},{"code":"bankr-nat","field_id":"DE1-TenderingTerms-TendererQualificationRequest-SpecificTendererRequirement-TendererRequirementTypeCode","list":"exclusion-ground","ordinal":0,"type":"code"}]},{"kind":"SpecificTendererRequirement","parent_section_id":"ND-TendererQualificationRequest#0","section_id":"ND-SpecificTendererRequirement#1","values":[{"field_id":"DE1-TenderingTerms-TendererQualificationRequest-SpecificTendererRequirement-Description","lang":"DEU","ordinal":0,"type":"text","value":"Zwingende bzw. fakultative Ausschlussgründe nach §§ 123 bis 126 GWB"},{"code":"bankruptcy","field_id":"DE1-TenderingTerms-TendererQualificationRequest-SpecificTendererRequirement-TendererRequirementTypeCode","list":"exclusion-ground","ordinal":0,"type":"code"}]},{"kind":"SpecificTendererRequirement","parent_section_id":"ND-TendererQualificationRequest#0","section_id":"ND-SpecificTendererRequirement#10","values":[{"field_id":"DE1-TenderingTerms-TendererQu