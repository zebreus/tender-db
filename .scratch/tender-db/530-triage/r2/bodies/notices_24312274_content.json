:0,"scheme":null,"type":"id","value":"UBO-0001"}]},{"kind":"Organization","parent_section_id":"PROCEDURE","section_id":"ORG-0007","values":[{"field_id":"BT-500-Organization-Company","lang":"DEU","ordinal":0,"type":"text","value":"Datenservice Öffentlicher Einkauf (in Verantwortung des Beschaffungsamts des BMI)"},{"field_id":"BT-501-Organization-Company","is_ref":false,"ordinal":0,"scheme":"002","type":"id","value":"0204:994-DOEVD-83"},{"field_id":"BT-503-Organization-Company","lang":null,"ordinal":0,"type":"text","value":"+49228996100"},{"field_id":"BT-506-Organization-Company","lang":null,"ordinal":0,"type":"text","value":"noreply.esender_hub@bescha.bund.de"},{"code":"DEA22","field_id":"BT-507-Organization-Company","ordinal":0,"scheme":"nuts","type":"classification"},{"field_id":"BT-512-Organization-Company","lang":null,"ordinal":0,"type":"text","value":"53119"},{"field_id":"BT-513-Organization-Company","lang":null,"ordinal":0,"type":"text","value":"Bonn"},{"code":"DEU","field_id":"BT-514-Organization-Company","list":"country","ordinal":0,"type":"code"},{"field_id":"OPT-200-Organization-Company","is_ref":false,"ordinal":0,"scheme":"organization","type":"id","value":"ORG-0007"}]},{"kind":"Notice","parent_section_id":null,"section_id":"PROCEDURE","values":[{"code":"32014L0024","field_id":"BT-01-notice","list":null,"ordinal":0,"type":"code"},{"code":"can-standard","field_id":"BT-02-notice","list":"result","ordinal":0,"type":"code"},{"field_id":"BT-04-notice","is_ref":false,"ordinal":0,"scheme":null,"type":"id","value":"dd319005-f522-4e7a-854c-121118251a62"},{"field_id":"BT-05(a)-notice","ordinal":0,"type":"date","value":"2024-10-29T06:08:21+01:00"},{"code":"open","field_id":"BT-105-Procedure","list":"procurement-procedure-type","ordinal":0,"type":"code"},{"code":"false","field_id":"BT-106-Procedure","list":"accelerated-procedure","ordinal":0,"type":"code"},{"field_id":"BT-21-Procedure","lang":"DEU","ordinal":0,"type":"text","value":"Innensanierung Laborgebäude AC - Innenputzarbeiten (2. Verfahren)"},{"field_id":"BT-22-Procedure","is_ref":false,"ordinal":0,"scheme":"internalID","type":"id","value":"51020062_300a-03-01-Hg24"},{"code":"works","field_id":"BT-23-Lot","list":"contract-nature","ordinal":0,"type":"code"},{"field_id":"BT-24-Procedure","lang":"DEU","ordinal":0,"type":"text","value":"Die Hochschule Osnabrück mit Standort an der Albrechtstraße saniert im Zuge der Baumaßnahme den Gebäudeteil AC, der aus den 1960er Jahren stammt.\nDieser diente hauptsächlich der Lehre in Form von Vorlesungsveranstaltungen in den Hörsälen, sowie der Forschung in Laboren und wurde von der Fakultät Ingenieurwissenschaften und Informatik genutzt. Die Nutzung wird in der Form\nbestehen bleiben, ist jedoch aufgrund des Alters nicht mehr zeitgemäß und erfüllt nicht mehr die gesetzlichen sowie sicherheitstechnische Anforderungen, insbesondere an den Brandschutz und die Laborsicherheit."},{"field_id":"BT-300-Procedure","lang":"DEU","ordinal":0,"type":"text","value":"Bekanntmachungs-ID: CXS0Y4FY1WTWTSLL\n\n\nFür die Nutzung der Vergabeplattform https://vergabe.niedersachsen.de gelten die Nutzungsbedingungen des Deutschen Vergabeportals DTVP (https://www.dtvp.de/agb-unternehmen).\n\nBieter, welche ohne eine vorherige Registrierung auf https://vergabe.niedersachsen.de auf die Vergabeunterlagen zugegriffen haben, müssen sich selbstständig informieren, ob Vergabeunterlagen zwischenzeitlich geändert wurden oder ob die öffentlichen Auftraggeber Fragen zum Vergabeverfahren beantwortet haben (Holschuld). Sie tragen das Risiko, einen Teilnahmeantrag, eine Interessensbestätigung oder ein Angebot auf der Grundlage veralteter Vergabeunterlagen erstellt zu haben und daher im weiteren Verlauf vom Verfahren ausgeschlossen zu werden.\n\nBieterfragen sind in Textform über das Vergabeportal vergabe.Niedersachsen zu stellen. Die Fragen und Antworten werden über das Portal allen Bietern durch die ausschreibende Stelle zur Verfügung gestellt.\n\nIm Falle von gleichwertigen Angeboten (gemäß den Wertungskriterien der Ausschreibung) entscheidet in der Wertungsstufe das Los.\n\nBei Vergaben von Bauleistungen wird die VOB/B ebenfalls Vertragsbestandteil.\n\nFür Vergaben von Liefer- und Dienstleistungen unter Einbeziehung der VOL/B als Vertragsbedingungen gelten die Vertragsstrafen nach §11 Nr.2 VOL/B für in den Ausschreibungsunterlagen enthaltenen Ausführungsfristen als vereinbart.\n\nGeschäftsbedingungen des Bieters in den Angebotsunterlagen werden nicht zum Vertragsbestandteil. Stellt ein Bieter mit seinem Angebot abweichende Bedingungen entfalten diese im Falle der Auftragserteilung keine rechtliche Wirkung."},{"field_id":"BT-536-Lot","ordinal":0,"type":"date","value":"2025-01-20"},{"field_id":"BT-537-Lot","ordinal":0,"type":"date","value":"2025-07-11"},{"field_id":"BT-58-Lot","ordinal":0,"type":"integer","value":0},{"code":"no-eu-funds","field_id":"BT-60-Lot","list":"eu-funded","ordinal":0,"type":"code"},{"field_id":"BT-701-notice","is_ref":false,"ordinal":0,"scheme":"notice-id","type":"id","value":"4314f841-ba40-46ea-b675-2b02a4271c74"},{"code":"DEU","field_id":"BT-702(a)-notice","list":"eu-official-language","ordinal":0,"type":"code"},{"field_id":"BT-738-notice","ordinal":0,"type":"date","value":"2024-10-29"},{"field_id":"BT-757-notice","is_ref":false,"ordinal":0,"scheme":null,"type":"id","value":"01"},{"field_id":"BT-767-Lot","ordinal":0,"type":"integer","value":0},{"field_id":"BT-99-Lot","lang":"DEU","ordinal":0,"type":"text","value":"Die Zulässigkeit von Nachprüfungsanträgen richtet sich nach § 160 GWB. Nach § 160 Abs. 3 GWB\nist ein Nachprüfungsantrag unzulässig, soweit\n1. der Antragsteller den geltend gemachten Verstoß gegen Vergabevorschriften vor Einreichen\ndes Nachprüfungsantrags erkannt und gegenüber dem Auftraggeber nicht innerhalb einer Frist\nvon zehn Kalendertagen gerügt hat,\n2. Verstöße gegen Vergabevorschriften, die aufgrund der Bekanntmachung erkennbar sind, nicht\nspätestens bis zum Ablauf der in der Bekanntmachung benannten Frist zur Bewerbung oder zur\nAngebotsabgabe gegenüber dem Auftraggeber gerügt werden,\n3. Verstöße gegen Vergabevorschriften, die erst in den Vergabeunterlagen erkennbar sind, nicht\nspätestens bis zum Ablauf der Frist zur Bewerbung oder zur Angebotsabgabe gegenüber dem\nAuftraggeber gerügt werden,\n4. mehr als 15 Kalendertage nach Eingang der Mitteilung des Auftraggebers, einer Rüge nicht\nabhelfen zu wollen, vergangen sind."},{"field_id":"OPP-010-notice","is_ref":false,"ordinal":0,"scheme":"ojs-notice-id","type":"id","value":"00661336-2024"},{"field_id":"OPP-011-notice","is_ref":false,"ordinal":0,"scheme":"ojs-id","type":"id","value":"212/2024"},{"field_id":"OPP-012-notice","ordinal":0,"type":"date","value":"2024-10-30"},{"code":"29","field_id":"OPP-070-notice","list":"notice-subtype","ordinal":0,"type":"code"},{"field_id":"OPT-001-notice","is_ref":false,"ordinal":0,"scheme":null,"type":"id","value":"2.3"},{"field_id":"OPT-002-notice","is_ref":false,"ordinal":0,"scheme":null,"type":"id","value":"eforms-sdk-1.7"},{"field_id":"OPT-301-Lot-Mediator","is_ref":true,"ordinal":0,"scheme":"organization","type":"id","value":"ORG-0005"},{"field_id":"OPT-301-Lot-ReviewInfo","is_ref":true,"ordinal":0,"scheme":"organization","type":"id","value":"ORG-0003"},{"field_id":"OPT-301-Lot-ReviewOrg","is_ref":true,"ordinal":0,"scheme":"organization","type":"id","value":"ORG-0004"},{"field_id":"OPT-999","ordinal":0,"type":"date","value":"2000-01-01"}]},{"kind":"LotResult","parent_section_id":"PROCEDURE","section_id":"RES-0001","values":[{"field_id":"BT-119-LotResult","ordinal":0,"type":"integer","value":0},{"field_id":"BT-13713-LotResult","is_ref":true,"ordinal":0,"scheme":"Lot","type":"id","value":"LOT-0001"},{"code":"selec-w","field_id":"BT-142-LotResult","list":"winner-selection-status","ordinal":0,"type":"code"},{"cents":26004844,"currency":"EUR","field_id":"BT-710-LotResult","ordinal":0,"type":"amount"},{"cents":87516220,"currency":"EUR","field_id":"BT-711-LotResult",