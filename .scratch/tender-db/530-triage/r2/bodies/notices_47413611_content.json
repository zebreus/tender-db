on-Company","list":"country","ordinal":0,"type":"code"},{"field_id":"OPT-200-Organization-Company","is_ref":false,"ordinal":0,"scheme":"organization","type":"id","value":"ORG-0004"}]},{"kind":"Notice","parent_section_id":null,"section_id":"PROCEDURE","values":[{"code":"32014L0025","field_id":"BT-01-notice","list":null,"ordinal":0,"type":"code"},{"code":"can-standard","field_id":"BT-02-notice","list":"result","ordinal":0,"type":"code"},{"field_id":"BT-04-notice","is_ref":false,"ordinal":0,"scheme":null,"type":"id","value":"92adf2b8-05c5-4cfd-a199-7ec9ccfd07a0"},{"field_id":"BT-05(a)-notice","ordinal":0,"type":"date","value":"2026-10-15T15:44:53+02:00"},{"code":"neg-wo-call","field_id":"BT-105-Procedure","list":"procurement-procedure-type","ordinal":0,"type":"code"},{"cents":-100,"currency":"EUR","field_id":"BT-161-NoticeResult","ordinal":0,"type":"amount"},{"field_id":"BT-21-Procedure","lang":"DEU","ordinal":0,"type":"text","value":"Lieferung von PE-Rohr DA1000 an Lager Bloh"},{"field_id":"BT-22-Procedure","is_ref":false,"ordinal":0,"scheme":"internalID","type":"id","value":"2026-04753"},{"code":"supplies","field_id":"BT-23-Lot","list":"contract-nature","ordinal":0,"type":"code"},{"field_id":"BT-24-Procedure","lang":"DEU","ordinal":0,"type":"text","value":"Beschaffung von PE-Rohr DA1000 als Projektmaterial außerhalb der gängigen Größen der Rahmenvereinbarung."},{"code":"44162500","field_id":"BT-262-Procedure","ordinal":0,"scheme":"cpv","type":"classification"},{"field_id":"BT-300-Procedure","lang":"DEU","ordinal":0,"type":"text","value":"#Bekanntmachungs-ID: CXS0YYFDYHRH5LLR#\n\n\nEs wird ausdrücklich darauf hingewiesen, dass die Kommunikation dieser Ausschreibung über das elektronische Vergabeportal \"Deutsche Vergabeportal\" (https://www.dtvp.de/Center) erfolgt.\n\nFür die bloße Einsicht in das Verfahren ist eine Registrierung nicht notwendig, jedoch wird es angeraten sich kostenfrei zu registrieren und sich zu dem Verfahren freizuschalten. Nur durch eine Freischaltung zu dem Verfahren werden Sie auf sämtliche Bieterinformationen bzw. auf Änderungen an den Vergabeunterlagen oder neu eingestellte Bieterinformationen hingewiesen. Für die Abgabe eines Teilnahmeantrags in elektronischer Form muss jedoch eine Registrierung erfolgen.\n\nDes Weiteren bitten wir darum, von einer Löschung Ihrer Freischaltung zu dem Verfahren abzusehen, bis Sie dazu aufgefordert werden bzw. Sie eine Absage zu dem weiteren Verfahren erhalten, da das anschließende Angebotsverfahren über das Deutsche Vergabeportal fortgeführt werden soll. Genaue Angaben zu den Fristen für die Einlegung von Rechtsbehelfen Enthalten die Vergabeunterlagen nach Auffassung des Bewerbers/Bieters Unklarheiten, so hat der Bewerber/Bieter unverzüglich und noch vor Abgabe des Teilnahmeantrags bzw. des Angebots darauf hinzuweisen.\n\nDie Bewerber/Bieter werden aufgefordert, im Interesse einer schnellen Beseitigung von Unklarheiten, frühzeitig und im gesetzlich zulässigen Rahmen Ihre Fragen über das elektronische Vergabeportal (http://www.dtvp.de/Center) zu übermitteln."},{"code":"no-eu-funds","field_id":"BT-60-Lot","list":"eu-funded","ordinal":0,"type":"code"},{"code":"false","field_id":"BT-684-Lot","list":"ipi-scope","ordinal":0,"type":"code"},{"field_id":"BT-701-notice","is_ref":false,"ordinal":0,"scheme":"notice-id","type":"id","value":"8c652d07-d8ee-47f0-8ea1-b2ef87f2c020"},{"code":"DEU","field_id":"BT-702(a)-notice","list":"eu-official-language","ordinal":0,"type":"code"},{"code":"false","field_id":"BT-717-Lot","list":"cvd-scope","ordinal":0,"type":"code"},{"field_id":"BT-738-notice","ordinal":0,"type":"date","value":"2026-10-15"},{"field_id":"BT-757-notice","is_ref":false,"ordinal":0,"scheme":null,"type":"id","value":"01"},{"field_id":"BT-767-Lot","ordinal":0,"type":"integer","value":0},{"code":"false","field_id":"BT-810-Lot","list":"eed-scope","ordinal":0,"type":"code"},{"field_id":"BT-99-Lot","lang":"DEU","ordinal":0,"type":"text","value":"Bewerber/Bieter haben Verstöße gegen Vergabevorschriften unter Beachtung der Regelungen in § 160 Abs. 3 GWB zu rügen. Ein Nachprüfungsantrag ist nach § 160 Abs. 3 GWB unzulässig, soweit\n\n1. der Antragsteller den geltend gemachten Verstoß gegen Vergabevorschriften vor Einreichen des Nachprüfungsantrags erkannt und gegenüber dem Auftraggeber nicht innerhalb einer Frist von zehn Kalendertagen gerügt hat; der Ablauf der Frist nach § 134 Absatz 2 bleibt unberührt,\n\n2. Verstöße gegen Vergabevorschriften, die aufgrund der Bekanntmachung erkennbar sind, nicht spätestens bis zum Ablauf der in der Bekanntmachung benannten Frist zur Bewerbung oder zur Angebotsabgabe gegenüber dem Auftraggeber gerügt werden,\n\n3. Verstöße gegen Vergabevorschriften, die erst in den Vergabeunterlagen erkennbar sind, nicht spätestens bis zum Ablauf der Frist zur Bewerbung oder zur Angebotsabgabe gegenüber dem Auftraggeber gerügt werden,\n\n4. mehr als 15 Kalendertage nach Eingang der Mitteilung des Auftraggebers, einer Rüge nicht abhelfen zu wollen, vergangen sind."},{"field_id":"OPP-010-notice","is_ref":false,"ordinal":0,"scheme":"ojs-notice-id","type":"id","value":"00720900-2026"},{"field_id":"OPP-011-notice","is_ref":false,"ordinal":0,"scheme":"ojs-id","type":"id","value":"202/2026"},{"field_id":"OPP-012-notice","ordinal":0,"type":"date","value":"2026-10-19"},{"code":"30","field_id":"OPP-070-notice","list":"notice-subtype","ordinal":0,"type":"code"},{"field_id":"OPT-001-notice","is_ref":false,"ordinal":0,"scheme":null,"type":"id","value":"2.3"},{"field_id":"OPT-002-notice","is_ref":false,"ordinal":0,"scheme":null,"type":"id","value":"eforms-sdk-1.13"},{"field_id":"OPT-301-Lot-Mediator","is_ref":true,"ordinal":0,"scheme":"organization","type":"id","value":"ORG-0002"},{"field_id":"OPT-301-Lot-ReviewInfo","is_ref":true,"ordinal":0,"scheme":"organization","type":"id","value":"ORG-0002"},{"field_id":"OPT-301-Lot-ReviewOrg","is_ref":true,"ordinal":0,"scheme":"organization","type":"id","value":"ORG-0002"},{"field_id":"OPT-999","or