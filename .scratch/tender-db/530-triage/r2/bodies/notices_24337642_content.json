anization","type":"id","value":"ORG-0005"}]},{"kind":"Notice","parent_section_id":null,"section_id":"PROCEDURE","values":[{"code":"32014L0024","field_id":"BT-01-notice","list":null,"ordinal":0,"type":"code"},{"code":"cn-standard","field_id":"BT-02-notice","list":"competition","ordinal":0,"type":"code"},{"field_id":"BT-04-notice","is_ref":false,"ordinal":0,"scheme":null,"type":"id","value":"53578a03-3c2a-4383-8992-18c8df932454"},{"field_id":"BT-05(a)-notice","ordinal":0,"type":"date","value":"2024-11-28T11:37:09+01:00"},{"code":"open","field_id":"BT-105-Procedure","list":"procurement-procedure-type","ordinal":0,"type":"code"},{"code":"false","field_id":"BT-106-Procedure","list":"accelerated-procedure","ordinal":0,"type":"code"},{"field_id":"BT-124-Lot","lang":null,"ordinal":0,"type":"text","value":"https://vergabe.niedersachsen.de/Satellite/notice/CXS0YR2Y1WLBNDTP"},{"code":"non-restricted-document","field_id":"BT-14-Lot","list":null,"ordinal":0,"type":"code"},{"field_id":"BT-21-Procedure","lang":"DEU","ordinal":0,"type":"text","value":"Heizungsinstallation - GS Bierden"},{"field_id":"BT-22-Procedure","is_ref":false,"ordinal":0,"scheme":"internalID","type":"id","value":"107592-2024-050"},{"code":"works","field_id":"BT-23-Lot","list":"contract-nature","ordinal":0,"type":"code"},{"field_id":"BT-24-Procedure","lang":"DEU","ordinal":0,"type":"text","value":"Ausgeschrieben wird die Heizungsinstallation für die Erweiterung der Grundschule Bierden zur Ganztagsschule mit Mensa in Achim. Auftraggeber ist die Stadt Achim. Berechtigter und Verpflichteter aus dem Vergabeverfahren ist ausschließlich die Stadt Achim."},{"field_id":"BT-300-Procedure","lang":"DEU","ordinal":0,"type":"text","value":"Bekanntmachungs-ID: CXS0YR2Y1WLBNDTP\n\n\nAuf gesondertes Verlangen des Auftraggebers sind Datenblätter der angebotenen Produkte einzureichen, soweit diese von den vorgegeben Leitfabrikaten abweichen. Bei der elektronischen Angebotsabgabe sollte das ausgefüllte Leistungsverzeichnis als gaeb-Datei (.84) und als PDF-Datei eingereicht werden. Sofern Sie ein bereits eingereichtes Angebot überarbeiten möchten, ziehen Sie dieses bitte zunächst über das Vergabeportal zurück und laden Sie anschließend ein neues, überarbeitetes Angebot über das Bietertool hoch. Auf diese Weise wird eine Doppelabgabe vermieden. Im Rahmen der Vergabe wird ein gewährter Preisnachlass nur dann berücksichtigt und gewertet, wenn er nicht an Bedingungen geknüpft ist.\n\nDer an ein Zahlungsziel geknüpfte Nachlass (Skonto) wird hingegen nicht gewertet."},{"field_id":"BT-536-Lot","ordinal":0,"type":"date","value":"2026-05-05"},{"field_id":"BT-537-Lot","ordinal":0,"type":"date","value":"2026-08-26"},{"field_id":"BT-58-Lot","ordinal":0,"type":"integer","value":0},{"code":"no-eu-funds","field_id":"BT-60-Lot","list":"eu-funded","ordinal":0,"type":"code"},{"field_id":"BT-701-notice","is_ref":false,"ordinal":0,"scheme":"notice-id","type":"id","value":"458ee505-bb77-4bf8-9d72-a5e8c4ca15f5"},{"code":"DEU","field_id":"BT-702(a)-notice","list":"eu-official-language","ordinal":0,"type":"code"},{"code":"DEU","field_id":"BT-708-Lot","list":null,"ordinal":0,"type":"code"},{"field_id":"BT-726-Lot","ordinal":0,"type":"integer","value":1},{"code":"no","field_id":"BT-736-Lot","list":"reserved-execution","ordinal":0,"type":"code"},{"field_id":"BT-738-notice","ordinal":0,"type":"date","value":"2024-11-28"},{"code":"false","field_id":"BT-751-Lot","list":"tender-guarantee-required","ordinal":0,"type":"code"},{"field_id":"BT-757-notice","is_ref":false,"ordinal":0,"scheme":null,"type":"id","value":"01"},{"code":"not-allowed","field_id":"BT-764-Lot","list":"ecatalog-submission","ordinal":0,"type":"code"},{"field_id":"BT-767-Lot","ordinal":0,"type":"integer","value":0},{"code":"DEU","field_id":"BT-97-Lot","list":null,"ordinal":0,"type":"code"},{"field_id":"BT-98-Lot","ordinal":0,"type":"number","unit":"DAY","value":45.0},{"field_id":"OPP-010-notice","is_ref":false,"ordinal":0,"scheme":"ojs-notice-id","type":"i