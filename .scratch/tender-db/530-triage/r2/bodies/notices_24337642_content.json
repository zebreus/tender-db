44115200","field_id":"BT-263-Lot","ordinal":0,"scheme":"cpv","type":"classification"}]},{"kind":"LotAdditionalClassification","parent_section_id":"LOT-0001","section_id":"ND-LotAdditionalClassification#1","values":[{"code":"44115220","field_id":"BT-263-Lot","ordinal":0,"scheme":"cpv","type":"classification"}]},{"kind":"LotAwardCriterion","parent_section_id":"LOT-0001","section_id":"ND-LotAwardCriterion#0","values":[{"code":"price","field_id":"BT-539-Lot","list":"award-criterion-type","ordinal":0,"type":"code"},{"field_id":"BT-734-Lot","lang":"DEU","ordinal":0,"type":"text","value":"Preis"}]},{"kind":"LotAwardCriterionParameter","parent_section_id":"ND-LotAwardCriterion#0","section_id":"ND-LotAwardCriterionParameter#0","values":[{"field_id":"BT-541-Lot","ordinal":0,"type":"number","unit":null,"value":100.0},{"code":"poi-exa","field_id":"BT-5421-Lot","list":"number-weight","ordinal":0,"type":"code"}]},{"kind":"LotMainClassification","parent_section_id":"LOT-0001","section_id":"ND-LotMainClassification#0","values":[{"code":"45315000","field_id":"BT-262-Lot","ordinal":0,"scheme":"cpv","type":"classification"}]},{"kind":"LotPlacePerformance","parent_section_id":"LOT-0001","section_id":"ND-LotPlacePerformance#0","values":[{"code":"DE93B","field_id":"BT-5071-Lot","ordinal":0,"scheme":"nuts","type":"classification"},{"field_id":"BT-5101(a)-Lot","lang":null,"ordinal":0,"type":"text","value":"Grundschule Bierden"},{"field_id":"BT-5121-Lot","lang":null,"ordinal":0,"type":"text","value":"28832"},{"field_id":"BT-5131-Lot","lang":null,"ordinal":0,"type":"text","value":"Achim"},{"code":"DEU","field_id":"BT-5141-Lot","list":null,"ordinal":0,"type":"code"}]},{"kind":"LotProcurementDocument","parent_section_id":"LOT-0001","section_id":"ND-LotProcurementDocument#0","values":[{"code":"non-restricted-document","field_id":"BT-14-Lot","list":null,"ordinal":0,"type":"code"},{"field_id":"BT-15-Lot","lang":null,"ordinal":0,"type":"text","value":"https://vergabe.niedersachsen.de/Satellite/notice/CXS0YR2Y1WLBNDTP/documents"},{"code":"DEU","field_id":"BT-708-Lot","list":null,"ordinal":0,"type":"code"},{"field_id":"OPT-140-Lot","is_ref":false,"ordinal":0,"scheme":null,"type":"id","value":"SomeTenderDocID1"}]},{"kind":"ProcedureAdditionalCommodityClassification","parent_section_id":"PROCEDURE","section_id":"ND-ProcedureAdditionalCommodityClassification#0","values":[{"code":"44115200","field_id":"BT-263-Procedure","ordinal":0,"scheme":"cpv","type":"classification"}]},{"kind":"ProcedureAdditionalCommodityClassification","parent_section_id":"PROCEDURE","section_id":"ND-ProcedureAdditionalCommodityClassification#1","values":[{"code":"44115220","field_id":"BT-263-Procedure","ordinal":0,"scheme":"cpv","type":"classification"}]},{"kind":"ProcedureMainClassification","parent_section_id":"PROCEDURE","section_id":"ND-ProcedureMainClassification#0","values":[{"code":"45315000","field_id":"BT-262-Procedure","ordinal":0,"scheme":"cpv","type":"classification"}]},{"kind":"ProcedurePlacePerformanceAdditionalInformation","parent_section_id":"PROCEDURE","section_id":"ND-ProcedurePlacePerformanceAdditionalInformation#0","values":[{"code":"DE93B","field_id":"BT-5071-Procedure","ordinal":0,"scheme":"nuts","type":"classification"},{"field_id":"BT-5101(a)-Procedure","lang":null,"ordinal":0,"type":"text","value":"Grundschule Bierden"},{"field_id":"BT-5121-Procedure","lang":null,"ordinal":0,"type":"text","value":"28832"},{"field_id":"BT-5131-Procedure","lang":null,"ordinal":0,"type":"text","value":"Achim"},{"code":"DEU","field_id":"BT-5141-Procedure","list":null,"ordinal":0,"type":"code"}]},{"kind":"SelectionCriteria","parent_section_id":"LOT-0001","section_id":"ND-SelectionCriteria#0","values":[{"code":"ef-stand","field_id":"BT-747-Lot","list":"selection-criterion","ordinal":0,"type":"code"},{"field_id":"BT-750-Lot","lang":"DEU","ordinal":0,"type":"text","value":"- Angabe der Umsatz des Unternehmens in den letzten drei abgeschlossenen Geschäftsjahren, soweit er Bauleistungen und andere Leistungen betrifft, die mit der zu vergebenden Leistung vergleichbar sind unter Einschluss des Anteils bei gemeinsam mit anderen Unternehmen ausgeführten Leistungen\n\n- Nachweis über eine gültige Betriebshaftpflichtversicherung"},{"field_id":"UBL-SelectionCriterionName","lang":"DEU","ordinal":0,"type":"text","value":"Wirtschaftliche und finanzielle Leistungsfähigkeit"}]},{"kind":"SelectionCriteria","parent_section_id":"LOT-0001","section_id":"ND-SelectionCriteria#1","values":[{"code":"sui-act","field_id":"BT-747-Lot","list":"selection-criterion","ordinal":0,"type":"code"},{"field_id":"BT-750-Lot","lang":"DEU","ordinal":0,"type":"text","value":"Vom Bieter und deren Nachunternehmer - bei Bietergemeinschaften von jedem Mitglied der Bietergemeinschaft - sind sämtliche Eignungsnachweise und sonstige Erklärungen mit dem Angebot einzureichen.\nDer Nachweis der Eignung und des Nichtvorliegens von Ausschlussgründen kann ganz oder teilweise erbracht werden mit der vom Auftraggeber direkt abrufbaren Eintragung in die allgemein zugängliche Liste des Vereins für die Präqualifikation von Bauunternehmen e. V. (Präqualifikationsverzeichnis) oder unter Verwendung des in den Vergabeunterlagen enthaltenen Formblatts 124 (Eigenerklärung zur Eignung).\n\nErklärung, dass das Unternehmen im Handelsregister, für die ausführenden Leistungen in die Handwerksrolle und bei der Industrie- und Handelskammer eingetragen ist oder das Unternehmen zu keine Eintragungen in die genannten Register verpflichtet ist.\n- Gewerbeanmeldung\n- Handelsregisterauszug\n- Eintragung in der Handwerksrolle (Handwerkskarte) bzw. bei der Industrie- und Handelskammer\n\n- Erklärung, dass ein Insolvenzverfahren oder ein vergleichbares gesetzlich geregeltes Verfahren weder beantragt noch eröffnet wurde, ein Antrag auf Eröffnung nicht mangels Masse abgelehnt wurden und sich das Unternehmen nicht in Liquidation befindet oder ein Insolvenzplan rechtkräftig bestätigt wurde. \n\n- Erklärung, dass für das Unternehmen keine Ausschlussgründe gemäß §  6e  EU VOB/A oder Ausschlussgründe gemäß §  6e EU Absatz 6 VOB/A vorliegen.\n-Erklärung, dass das Unternehmen in den letzten zwei Jahren nicht aufgrund eines Verstoßes gegen Vorschriften, der zu einem Eintrag im Gewerbezentralregister geführt hat, mit einer Freiheitsstrafe von mehr als drei Monaten oder einer Geldstrafe von mehr als 90 Tagessätzen oder einer Geldbuße von mehr als 2.500 Euro belegt worden ist.\n-Erklärung, dass für das Unternehmen ein Ausschlussgrund gemäß §  6e EU Absatz 1 bis 4 VOB/A vorliegt, jedoch für das Unternehmen Maßnahmen zur Selbstreinigung ergriffen wurden,durch die für das Unternehmen die Zuverlässigkeit wieder hergestellt wurde.\n\nErklärung, dass die Verpflichtung zur Zahlung von Steuern und Abgaben sowie der Beiträge zur Sozialversicherung, soweit sie der Pflicht zur Beitragszahlung unterfallen, ordnungsgemäß erfüllt wurden\n- Unbedenklichkeitsbescheinigung der tariflichen Sozialkasse\n- Unbedenklichkeitsbescheinigung des Finanzamtes bzw. Bescheinigung in Steuersachen \n- Freistellungsbescheinigung nach § 48b EStG \n\n-qualifizierte Unbedenklichkeitsbescheinigung der Berufsgenossenschaft des zuständigen Versicherungsträgers mit Angabe der Lohnsummen \n\nAb einer Auftragssumme von 30.000 Euro wird der Auftraggeber für den Bieter, auf dessen Angebot der Zuschlag erteilt werden soll, einen Auszug aus dem Gewerbezentralregister gem. § 150a GewO beim Bundes-amt für Justiz anfordern."},{"field_id":"UBL-SelectionCriterionName","lang":"DEU","ordinal":0,"type":"text","value":"Eignung zur Berufsausübung"}]},{"kind":"SelectionCriteria","parent_section_id":"LOT-0001","section_id":"ND-SelectionCriteria#2","values":[{"code":"tp-abil","field_id":"BT-747-Lot","list":"selection-criterion","ordinal":0,"type":"code"},{"field_id":"BT-750-Lot","lang":"DEU","ordinal":0,"type":"text","value":"Erklärung, dass in den letzten fünf Kalenderjahren bzw. dem in der Auftragsbekanntmachung angegebenen Zeitraum vergleichbare Leistungen ausgeführt wurden. \n- Drei Referenznachweise mit mindestens folgenden Angaben vorlegen: Ansprechpartner; Art der ausgeführten Leistung; Auftragssumme; Ausführungszeitraum; stichwortartige Benennung des mit eigenem Personal ausgeführten maßgeblichen Leistungsumfanges einschl. Angabe der ausgeführten Mengen; Zahl der hierfür durchschnittlich eingesetzten Arbeitnehmer; stichwortartige Beschreibung der besonderen technischen und gerätespezifischen Anforderungen bzw. (bei Komplettleistung) Kurzbeschreibung der Baumaßnahme einschließlich eventueller Besonderheiten der Ausführung; Angabe zur Art der Baumaßnahme (Neubau, Umbau, Denkmal); Angabe zur vertraglichen Bindung (Hauptauftragnehmer, ARGE-Partner, Nachunternehmer); ggf. Angabe der Gewerke, die mit eigenem Leitungspersonal koordiniert wurden; Bestätigung des Auftraggebers über die vertragsgemäße Ausführung der Leistung\n\nErklärung, dass die für die Ausführung der Leistungen erforderlichen Arbeitskräfte zur Verfügung stehen\n- Zahl der in den letzten drei abgeschlossenen Kalenderjahren jahresdurchschnittlich beschäftigten Arbeitskräfte gegliedert nach Lohngruppen mit extra ausgewiesenem Leitungspersonal"},{"field_id":"UBL-SelectionCriterionName","lang":"DEU","ordinal":0,"type":"text","value":"Technische und berufliche Leistungsfähigkeit"}]},{"kind":"ServiceProviderParty","parent_section_id":"ND-ContractingParty#0","section_id":"ND-ServiceProviderParty#0","values":[{"code":"ted-esen","field_id":"OPT-030-Procedure-SProvider","list":"organisation-role","ordinal":0,"type":"code"},{"field_id":"OPT-300-Procedure-SProvider","is_ref":true,"ordinal":0,"scheme":"organization","type":"id","value":"ORG-0005"}]},{"kind":"StrategicProcurementType","parent_section_id":"LOT-0001","section_id":"ND-StrategicProcurementType#0","values":[{"code":"none","field_id":"BT-06-Lot","list":"strategic-procurement","ordinal":0,"type":"code"}]},{"kind":"Organization","parent_section_id":"PROCEDURE","section_id":"ORG-0001","values":[{"field_id":"