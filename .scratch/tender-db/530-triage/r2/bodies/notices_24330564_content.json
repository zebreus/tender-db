schriftlich bei der Vergabekammer einzureichen, unverzüglich zu begründen und soll ein bestimmtes Begehren enthalten (§ 161 GWB)."},{"field_id":"BT-536-Lot","ordinal":0,"type":"date","value":"2025-02-03"},{"field_id":"BT-537-Lot","ordinal":0,"type":"date","value":"2029-09-01"},{"field_id":"BT-58-Lot","ordinal":0,"type":"integer","value":0},{"code":"no-eu-funds","field_id":"BT-60-Lot","list":"eu-funded","ordinal":0,"type":"code"},{"field_id":"BT-701-notice","is_ref":false,"ordinal":0,"scheme":"notice-id","type":"id","value":"932f1091-6444-4ec9-a3c3-fc7aad6e9b92"},{"code":"DEU","field_id":"BT-702(a)-notice","list":"eu-official-language","ordinal":0,"type":"code"},{"code":"DEU","field_id":"BT-708-Lot","list":null,"ordinal":0,"type":"code"},{"field_id":"BT-726-Lot","ordinal":0,"type":"integer","value":1},{"code":"no","field_id":"BT-736-Lot","list":"reserved-execution","ordinal":0,"type":"code"},{"field_id":"BT-738-notice","ordinal":0,"type":"date","value":"2024-10-30"},{"code":"false","field_id":"BT-751-Lot","list":"tender-guarantee-required","ordinal":0,"type":"code"},{"field_id":"BT-757-notice","is_ref":false,"ordinal":0,"scheme":null,"type":"id","value":"01"},{"code":"not-allowed","field_id":"BT-764-Lot","list":"ecatalog-submission","ordinal":0,"type":"code"},{"field_id":"BT-767-Lot","ordinal":0,"type":"integer","value":0},{"code":"DEU","field_id":"BT-97-Lot","list":null,"ordinal":0,"type":"code"},{"field_id":"BT-98-Lot","ordinal":0,"type":"number","unit":"DAY","value":62.0},{"field_id":"OPP-010-notice","is_ref":false,"ordinal":0,"scheme":"ojs-notice-id","type":"id","value":"00662812-2024"},{"field_id":"OPP-011-notice","is_ref":false,"ordinal":0,"scheme":"ojs-id","type":"id","value":"213/2024"},{"field_id":"OPP-012-notice","ordinal":0,"type":"date","value":"2024-10-31"},{"code":"16","field_id":"OPP-070-notice","list":"notice-subtype","ordinal":0,"type":"code"},{"field_id":"OPT-001-notice","is_ref":false,"ordinal":0,"scheme":null,"type":"id","value":"2.3"},{"field_id"