ield_id":"BT-728-Lot","lang":"DEU","ordinal":0,"type":"text","value":"Universitätsklinikum Köln AöR; CLD, Kerpener Straße 62 50937 Köln Gebäude 7 I Wirtschaftsgebäude 1. Obergeschoss"}]},{"kind":"LotProcurementDocument","parent_section_id":"LOT-0001","section_id":"ND-LotProcurementDocument#0","values":[{"code":"non-restricted-document","field_id":"BT-14-Lot","list":null,"ordinal":0,"type":"code"},{"field_id":"BT-15-Lot","lang":null,"ordinal":0,"type":"text","value":"https://www.evergabe.nrw.de/VMPSatellite/notice/CXS0YYLY1T9R0J4Y/documents"},{"code":"DEU","field_id":"BT-708-Lot","list":null,"ordinal":0,"type":"code"},{"field_id":"OPT-140-Lot","is_ref":false,"ordinal":0,"scheme":null,"type":"id","value":"SomeTenderDocID1"}]},{"kind":"ProcedureAdditionalCommodityClassification","parent_section_id":"PROCEDURE","section_id":"ND-ProcedureAdditionalCommodityClassification#0","values":[{"code":"38950000","field_id":"BT-263-Procedure","ordinal":0,"scheme":"cpv","type":"classification"}]},{"kind":"ProcedureMainClassification","parent_section_id":"PROCEDURE","section_id":"ND-ProcedureMainClassification#0","values":[{"code":"38000000","field_id":"BT-262-Procedure","ordinal":0,"scheme":"cpv","type":"classification"}]},{"kind":"ProcedurePlacePerformanceAdditionalInformation","parent_section_id":"PROCEDURE","section_id":"ND-ProcedurePlacePerformanceAdditionalInformation#0","values":[{"code":"DEA23","field_id":"BT-5071-Procedure","ordinal":0,"scheme":"nuts","type":"classification"},{"field_id":"BT-5101(a)-Procedure","lang":null,"ordinal":0,"type":"text","value":"Universitätsklinikum Köln AöR"},{"field_id":"BT-5101(b)-Procedure","lang":null,"ordinal":0,"type":"text","value":"Kerpener Straße 62"},{"field_id":"BT-5121-Procedure","lang":null,"ordinal":0,"type":"text","value":"50937"},{"field_id":"BT-5131-Procedure","lang":null,"ordinal":0,"type":"text","value":"Köln"},{"code":"DEU","field_id":"BT-5141-Procedure","list":null,"ordinal":0,"type":"code"},{"code":"anyw-cou","field_id":"BT-727-Procedure","list":null,"ordinal":0,"type":"code"},{"field_id":"BT-728-Procedure","lang":"DEU","ordinal":0,"type":"text","value":"Universitätsklinikum Köln AöR; CLD, Kerpener Straße 62 50937 Köln Gebäude 7 I Wirtschaftsgebäude 1. Obergeschoss"}]},{"kind":"SelectionCriteria","parent_section_id":"LOT-0001","section_id":"ND-SelectionCriteria#0","values":[{"code":"ef-stand","field_id":"BT-747-Lot","list":"selection-criterion","ordinal":0,"type":"code"},{"field_id":"BT-750-Lot","lang":"DEU","ordinal":0,"type":"text","value":"Einzureichende Unterlagen:\n    - Wirtschaftliche und finanzielle Leistungsfähigkeit (mit dem Angebot mittels Eigenerklärung vorzulegen): - Mindestanforderung: Der Bewerber weist in den letzten drei abgeschlossenen Geschäftsjahren mindestens einen Nettoumsatz mit vergleichbaren Leistungen in Höhe von 21.000 Euro auf. Der Bieter muss diesen Umsatz auf Nachfrage der Vergabestelle durch entsprechende Referenzen nachweisen.\n\n- Anlage 1 Erklärung zur Berufs- oder Betriebshaftpflichtversicherung (§ 122 Abs. 2 Nr. 2 GWB i.V.m. § 45 Abs. 1 Nr. 3 VgV):\nNachweis der aufgeführten Versicherungen durch Eigenerklärung Anlage 2 oder Bescheinigung des Versicherungsgebers oder Bescheinigung eines Versicherungsgebers, dass eine entsprechende Versicherung im Auftragsfall abgeschlossen wird (jeweils Kopie ausreichend).\n\nIm Einzelnen mindestens:\n     - Personenschäden 1.000.000,00 Euro\n     - Sach- und Umweltschäden 1.000.000,00 Euro\n     - Vermögensschäden: 500.000,00 Euro\n     \n\n- Jahresabschlüsse oder Auszüge von Jahresabschlüssen, falls deren Veröffentlichung in dem Land, in dem der Bewerber oder Bieter niedergelassen ist, gesetzlich vorgeschrieben ist, auf Anfrage."},{"field_id":"UBL-SelectionCriterionName","lang":"DEU","ordinal":0,"type":"text","value":"Wirtschaftliche und finanzielle Leistungsfähigkeit"}]},{"kind":"SelectionCriteria","parent_section_id":"LOT-0001","section_id":"ND-SelectionCriteria#1","values":[{"code":"sui-act","field_id":"BT-747-Lot","list":"selection-criterion","ordinal":0,"type":"code"},{"field_id":"BT-750-Lot","lang":"DEU","ordinal":0,"type":"text","value":"Einzureichende Unterlagen:\n    - Persönliche Lage der Wirtschaftsteilnehmer (mit dem Angebot mittels Eigenerklärung vorzulegen): - Eigenerklärung über den Eintrag im Handelsregister\n- Eigenerklärung, das keine Eintragungen im Vergaberegister bzgl. Vergabeverstöße vorliegen\n- Eigenerklärung, aus denen hervorgeht, dass der Bieter seinen Verpflichtungen zur Zahlung der Sozialbeiträge, der Steuern und Abgaben (BG) nachkommt\n- Darstellung des Bewerbers (Leistungsspektrum und Kerngeschäft des Unternehmens) und der Unternehmensorganisation (Hauptsitz, ggf. Niederlassungen, Struktur/Aufbau) sowie - falls zutreffend - ausführliche Darstellung der Konzernverbundenheit/-angehörigkeit mit anderen Unternehmen\n- Konformitätsbescheinigung (nach Bedarf)"},{"field_id":"UBL-SelectionCriterionName","lang":"DEU","ordinal":0,"type":"text","value":"Eignung zur Berufsausübung"}]},{"kind":"SelectionCriteria","parent_section_id":"LOT-0001","section_id":"ND-SelectionCriteria#2","values":[{"code":"tp-abil","field_id":"BT-747-Lot","list":"selection-criterion","ordinal":0,"type":"code"},{"field_id":"BT-750-Lot","lang":"DEU","ordinal":0,"type":"text","value":"Einzureichende Unterlagen:\n    - Technische Leistungsfähigkeit (mit dem Angebot mittels Eigenerklärung vorzulegen): - Anlage 2 Referenzformular\nDer Bewerber weist in den letzten höchstens drei Jahren mindestens drei geeignete vergleichbare Referenzen über früher ausgeführte Liefer- und Dienstleistungsaufträge nach.\nGehen Sie bei der Angabe der Referenzen auf folgende Punkte ein:\n\n        - Umfang, Dauer, Zeitpunkt und Auftragsvolumen\n        - Auftraggeber inkl. Adresse\n        - (detaillierte) Darstellung des Auftragsgegenstands / der Leistungen\n        - Durchführendes Unternehmen: Bieter oder Unterauftragnehmer\n\nAus den Ausführungen muss ersichtlich werden, warum die beschriebenen Projekte aus Ihrer Sicht die genannten Anforderungen erfüllen und somit als Referenz geeignet sind. Die Darstellung sollte eine DIN A4-Seite pro Referenzprojekt umfassen.\n\n- Nachweis nach DIN ISO 9001:2015 (Qualitätsmanagementsystem) oder vergleichbar durch Eigenerklärung des Bieters.\n\n- Erklärung zur beruflichen Leistungsfähigkeit (§ 122 Abs. 2 Nr. 3 GWB i.V.m. § 46 Abs. 3 Nr. 2 VgV) durch Eigenerklärung des Bieters:\nDer Bewerber weist einen Personalstamm und Ausrüstung nach, der die Durchführung der mit diesem Projekt verbundenen Aufgaben sicherstellt. Der Nachweis der erforderlichen Personalkapazität- und -fachlichkeit ist durch geeignete Nachweise zu erbringen.\nSkillprofile der Mitarbeiter weisen mehrjährige Berufserfahrung in Leistungsart, die Gegenstand der Vergabe ist, nach."},{"field_id":"UBL-SelectionCriterionName","lang":"DEU","ordinal":0,"type":"text","value":"Technische und berufliche Leistungsfähigkeit"}]},{"kind":"ServiceProviderParty","parent_section_id":"ND-ContractingParty#0","section_id":"ND-ServiceProviderParty#0","values":[{"code":"ted-esen","field_id":"OPT-030-Procedure-SProvider","list":"organisation-role","ordinal":0,"type":"code"},{"field_id":"OPT-300-Procedure-SProvider","is_ref":true,"ordinal":0,"scheme":"organization","type":"id","value":"ORG-0005"}]},{"kind":"StrategicProcurementType","parent_section_id":"LOT-0001","section_id":"ND-StrategicProcurementType#0","values":[{"code":"env-imp","field_id":"BT-06-Lot","list":"strategic-procurement","ordinal":0,"type":"code"},{"field_id":"BT-777-Lot","lang":"DEU","ordinal":0,"type":"text","value":"Die Kriterien einer nachhaltigen Wirtschaft, ökologische und soziale Belange und ökonomische Ansprüche sollen ebenso, wie eine umweltschonende Produktion berücksichtigt werden. Innerhalb des gesamten Baus dürfen nicht verwendet werden: · asbesthaltige Baustoffe, · unter Einsatz von Fluorchlorkohlenwasserstoff (FCKW, HFCKW, CFC, HFA, FCK) hergestellte Baustoffe, insbesondere Schaumdämmplatten und Ortschäume, · Bauteile aus Tropenhölzern, es sei denn, die Herkunft der Hölzer aus geordneter Plantagen- oder Forstwirtschaft wird eindeutig nachgewiesen. Umweltbezogene Herstellerangaben bzw. Anbietererklärungen und Umweltkennzeichnungen von Produkten gelten nur, wenn sie nach ISO 14020, und darin mind. gemäß Typ I nach EN ISO 14024 erfolgt sind."}]},{"kind":"Organization","parent_section_id":"PROCEDURE","section_id":"ORG-0001","values":[{"field_id":"BT-500-Organization-Company","lang":"DEU","ordinal":0,"type":"text","value":"Universitätsklinikum Köln AöR"},{"field_id":"BT-501-Organization-Company","is_ref":false,"ordinal":0,"scheme":null,"type":"id","value":"901bd6cf-840d-4b99-aec6-9e1fe2ce45e3"},{"field_id":"BT-502-Organization-Company","lang":null,"ordinal":0,"type":"text","value":"Zentrale Beschaffung/Vergabestelle"},{"field_id":"BT-503-Organization-Company","lang":null,"ordinal":0,"type":"text","value":"+49 22147896623"},{"field_id":"BT-506-Organization-Company","lang":null,"ordinal":0,"type":"text","value":"vergabestelle@uk-koeln.de"},{"code":"DEA23","field_id":"BT-507-Organization-Company","ordinal":0,"scheme":"nuts","type":"classification"},{"field_id":"BT-510(a)-Organization-Company","lang":null,"ordinal":0,"type":"text","value":"Kerpener Straße 62"},{"field_id":"BT-512-Organization-Company","lang":null,"ordinal":0,"type":"text","value":"50937"},{"field_id":"BT-513-Organization-Company","lang":null,"ordinal":0,"type":"text","value":"Köln"},{"code":"DEU","field_id":"BT-514-Organization-Company","list":null,"ordinal":0,"type":"code"},{"field_id":"BT-739-Organization-Company","lang":null,"ordinal":0,"type":"text","value":"+49 22147887805"},{"field_id":"OPP-051-Organization","ordinal":0,"type":"integer","value":1},{"field_id":"OPT-200-Organization-Company","is_ref":false,"ordinal":0,"scheme":null,"type":"id","value":"ORG-0001"}]},{"kind":"Organization","parent_section_id":"PROCEDURE","section_id":"ORG-0002","values":[{"field_id":"BT-500-Organization-Company","lang":"DEU","or