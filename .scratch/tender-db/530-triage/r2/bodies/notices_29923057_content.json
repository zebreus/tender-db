d":"BT-05(a)-notice","ordinal":0,"type":"date","value":"2026-09-01T14:46:11+02:00"},{"code":"neg-wo-call","field_id":"BT-105-Procedure","list":"procurement-procedure-type","ordinal":0,"type":"code"},{"cents":21238875,"currency":"EUR","field_id":"BT-161-NoticeResult","ordinal":0,"type":"amount"},{"field_id":"BT-21-Procedure","lang":"DEU","ordinal":0,"type":"text","value":"IT-Roadmap der Sächsischen Krankenhäuser und des Haus am Karswald: Ist-Analyse, Zielbild und Umsetzungskonzept"},{"field_id":"BT-22-Procedure","is_ref":false,"ordinal":0,"scheme":null,"type":"id","value":"47/26"},{"code":"services","field_id":"BT-23-Lot","list":"contract-nature","ordinal":0,"type":"code"},{"field_id":"BT-24-Procedure","lang":"DEU","ordinal":0,"type":"text","value":"Das Projektziel ist die Erhöhung der Effizienz der IT in den Häusern durch Vereinheitlichung der IT der SKH und des HaK.\n\nDer Einsatz der IT wird die Entwicklung der Krankenhauslandschaft zukünftig prägen. Dabei sind Stichworte wie die Weiterentwicklung der IT-Anwendungen, der Einsatz Künstlicher Intelligenz, die Erweiterung der Möglichkeiten der Telemedizin u. a. zu nennen. Zur Vorbereitung der Entscheidung des Trägers der SKH und des HaK ist eine Erhebung zu den in den SKH und HaK vorhandenen IT-Anwendungen notwendig. \n\nUnter Berücksichtigung der prognostizierbaren zukünftigen Entwicklungen soll weiterführend über die Diskussion verschiedener Szenarien bzw. Betriebsformen eine IT-Strategie entwickelt werden, die mit einem Umsetzungskonzept auf die realen Gegebenheiten heruntergebrochen wird.\n \nDiese Strategie muss im Anschluss zu einer Umsetzungsempfehlung gestaltet werden. Diese ist dann in einer späteren, sich an dieses Projekt anschließend, Phase über einen längeren Zeitraum hinweg durchzusetzen. \n\nParallel soll eine Bündelung der Verwaltungsstrukturen und -prozesse der SKH geprüft werden.\n \nEs soll ein Beratungsunternehmen mit nachgewiesener Expertise im Bereich Krankenhaus-IT gewonnen werden, welches weitestgehend selbstständig agiert und die zugehörigen Informationen einholt."},{"code":"72000000","field_id":"BT-262-Procedure","ordinal":0,"scheme":"cpv","type":"classification"},{"field_id":"BT-701-notice","is_ref":false,"ordinal":0,"scheme":"notice-id","type":"id","value":"cf38d6c7-602c-4222-a4f6-4f1171631a3a"},{"code":"DEU","field_id":"BT-702(a)-notice","list":"language","ordinal":0,"type":"code"},{"field_id":"BT-738-notice","ordinal":0,"type":"date","value":"2026-09-01"},{"field_id":"BT-756-Procedure","ordinal":0,"type":"integer","value":0},{"field_id":"BT-757-notice","is_ref":false,"ordinal":0,"scheme":null,"type":"id","value":"01"},{"field_id":"OPP-010-notice","is_ref":false,"ordinal":0,"scheme":"ojs-notice-id","type":"id","value":"00604737-2026"},{"field_id":"OPP-011-notice","is_ref":false,"ordinal":0,"scheme":"ojs-id","type":"id","value":"169/2026"},{"field_id":"OPP-012-notice","ordinal":0,"type":"date","value":"2026-09-02"},{"code":"29","field_id":"OPP-070-notice","list":"notice-subtype","ordinal":0,"type":"code"},{"field_id":"OPT-001-notice","is_ref":false,"ordinal":0,"scheme":null,"type":"id","value":"2.3"},{"field_id":"OPT-002-notice","is_ref":false,"ordinal":0,"scheme":null,"type":"id","value":"eforms-sdk-1.13"},{"field_id":"OPT-999","ordinal":0,"type":"date","value":"2000-01-01"}]},{"kind":"LotResult","parent_section_id":"PROCEDURE","section_id":"RES-0001","values":[{"field_id":"BT-13713-LotResult","is_ref":true,"ordinal":0,"scheme":"Lot","type":"id","value":"LOT-0000"},{"code":"selec-w","field_id":"BT-142-LotResult","list":"winner-selection-status","ordinal":0,"type":"code"},{"field_id":"OPT-322-LotResult","is_ref":false,"ordinal":0,"scheme":"result","type":"id","value":"RES-0001"}]},{"kind":"LotTender","parent_section_id":"PROCEDURE","section_id":"TEN-0001","values":[{"field_id":"BT-13714-Tender","is_ref":true,"ordinal":0,"scheme":"Lot","type":"id","value":"LOT-0000"},{"field_id":"BT-3201-Tender","is_ref":false,"ordinal":0,"scheme":null,"type":"id","va