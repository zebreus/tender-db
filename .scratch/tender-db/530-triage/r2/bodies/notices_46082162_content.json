lt sich um ein Dreiachsfahrgestell mit einem zulässigen Gesamtgewicht von \n26.000 kg automatisierten Schaltgetriebe. Das Fahrzeug soll mit einem Pressaufbau ausgerüstet sein. Das Fahrzeug muss den Vorschriften der StVZO, den Regelwerken der UVV und den einschlägigen DIN-/EN- Normen sowie den \nEG- Richtlinien und den allgemein anerkannten, gültigen, sicherheitstechnischen und arbeitsmedizinischen Regeln entsprechen."},{"code":"34144512","field_id":"BT-262-Lot","ordinal":0,"scheme":"cpv","type":"classification"},{"code":"UNKNOWN","field_id":"BT-538-Lot","list":"timeperiod","ordinal":0,"type":"code"},{"code":"no-eu-funds","field_id":"BT-60-Lot","list":"eu-funded","ordinal":0,"type":"code"},{"code":"not-allowed","field_id":"BT-63-Lot","list":"permission","ordinal":0,"type":"code"},{"code":"false","field_id":"BT-717-Lot","list":"cvd-scope","ordinal":0,"type":"code"},{"field_id":"BT-726-Lot","ordinal":0,"type":"integer","value":0},{"code":"no","field_id":"BT-736-Lot","list":"reserved-execution","ordinal":0,"type":"code"},{"code":"required","field_id":"BT-743-Lot","list":"einvoicing","ordinal":0,"type":"code"},{"code":"required","field_id":"BT-764-Lot","list":"ecatalog-submission","ordinal":0,"type":"code"},{"code":"none","field_id":"BT-765-Lot","list":"framework-agreement","ordinal":0,"type":"code"},{"code":"none","field_id":"BT-766-Lot","list":"dps-usage","ordinal":0,"type":"code"},{"field_id":"BT-767-Lot","ordinal":0,"type":"integer","value":0},{"code":"allowed","field_id":"BT-769-Lot","list":"permission","ordinal":0,"type":"code"},{"code":"late-all","field_id":"BT-771-Lot","list":"missing-info-submission","ordinal":0,"type":"code"},{"field_id":"BT-772-Lot","lang":"DEU","ordinal":0,"type":"text","value":"siehe Ausschreibungsunterlagen"},{"field_id":"BT-94-Lot","ordinal":0,"type":"integer","value":0},{"field_id":"BT-98-Lot","ordinal":0,"type":"number","unit":"DAY","value":95.0},{"field_id":"BT-99-Lot","lang":"DEU","ordinal":0,"type":"text","value":"siehe Ausschreibungs