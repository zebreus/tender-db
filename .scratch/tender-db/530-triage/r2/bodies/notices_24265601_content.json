_id":"BT-01-notice","list":null,"ordinal":0,"type":"code"},{"code":"can-standard","field_id":"BT-02-notice","list":"result","ordinal":0,"type":"code"},{"field_id":"BT-04-notice","is_ref":false,"ordinal":0,"scheme":null,"type":"id","value":"7a74faa2-b2fb-4ebb-93b3-b89c7d242f7e"},{"field_id":"BT-05(a)-notice","ordinal":0,"type":"date","value":"2024-10-28T10:35:21+01:00"},{"code":"open","field_id":"BT-105-Procedure","list":"procurement-procedure-type","ordinal":0,"type":"code"},{"code":"false","field_id":"BT-106-Procedure","list":"accelerated-procedure","ordinal":0,"type":"code"},{"field_id":"BT-21-Procedure","lang":"DEU","ordinal":0,"type":"text","value":"Rahmenvertrag über eine Agenturleistung für die Presse- und Öffentlichkeitsarbeit der Koordinierungsstelle TBB / BfB"},{"field_id":"BT-22-Procedure","is_ref":false,"ordinal":0,"scheme":"internalID","type":"id","value":"V-24/0405"},{"code":"services","field_id":"BT-23-Lot","list":"contract-nature","ordinal":0,"type":"code"},{"field_id":"BT-24-Procedure","lang":"DEU","ordinal":0,"type":"text","value":"Die Koordinierungsstelle \"Tolerantes Brandenburg/Bündnis für Brandenburg\" ist bei der Staatskanzlei angesiedelt und u.a. für die Umsetzung des Handlungskonzeptes der Landesregierung \"Tolerantes Brandenburg\" zuständig. \n\nDamit ist die Koordinierungsstelle auch ein wichtiger Ansprechpartner der Landesregierung für die strategisch wichtigen Politikfelder Demokratiestärkung und zivilgesellschaftliches Engagement im Bereich der Unterstützung von Geflüchteten. Ihr obliegt sowohl die regierungsinterne Abstimmung als auch die partnerschaftliche Zusammenarbeit mit und Beratung von Kommunen, Behörden und zivilgesellschaftlichen Strukturen. \n\nBei der Umsetzung der vielfältigen politischen Projekte und Vorhaben soll die Koordinierungsstelle von einer Agentur begleitet werden. Ebenso bedarf es der Unterstützung einer Agentur auf den unterschiedlichsten Feldern der Öffentlichkeitsarbeit."},{"field_id":"BT-300-Procedure","lang":"DEU","ordinal":0,"type":"text","value":"Bekanntmachungs-ID: CXSDYYDY1W1L40FU\n\n\nAngebote als E-Mail oder Fax gelten nicht als elektronisches Angebot und sind daher aus formellen Gründen auszuschließen."},{"field_id":"BT-57-Lot","lang":"DEU","ordinal":0,"type":"text","value":"3 Verlängerungen um jeweils bis zu 12 Monaten"},{"field_id":"BT-58-Lot","ordinal":0,"type":"integer","value":3},{"code":"no-eu-funds","field_id":"BT-60-Lot","list":"eu-funded","ordinal":0,"type":"code"},{"field_id":"BT-701-notice","is_ref":false,"ordinal":0,"scheme":"notice-id","type":"id","value":"e5c67acc-ba1f-465f-a5a5-e052172c977f"},{"code":"DEU","field_id":"BT-702(a)-notice","list":"eu-official-language","ordinal":0,"type":"code"},{"field_id":"BT-738-notice","ordinal":0,"type":"date","value":"2024-10-28"},{"field_id":"BT-757-notice","is_ref":false,"ordinal":0,"scheme":null,"type":"id","value":"01"},{"field_id":"BT-767-Lot","ordinal":0,"type":"integer","value":0},{"field_id":"BT-99-Lot","lang":"DEU","ordinal":0,"type":"text","value":"Beantragt ein Unternehmen die Einleitung eines Nachprüfungsverfahrens, ist der Antrag gemäß § 160 Abs. 3 GWB unzulässig, soweit \n- der Antragsteller den gerügten Verstoß gegen Vergabevorschriften im Vergabeverfahren erkannt und gegenüber dem Auftraggeber nicht unverzüglich gerügt hat,\n- Verstöße gegen Vergabevorschriften, die aufgrund der Bekanntmachung benannten Frist nicht spätestens bis Ablauf der in der Bekanntmachung benannten Frist zur Angebotsabgabe oder zur Bewerbung gegenüber dem Auftraggeber gerügt werden,\n- Verstöße gegen Vergabevorschriften, die erst in den Vergabeunterlagen erkennbar sind, nicht spätestens bis zum Ablauf der in der Bekanntmachung benannten Frist zur Angebotsabgabe oder zur Bewerbung gegenüber dem Auftraggeber gerügt werden oder\n- mehr als 15 Kalendertage nach Eingang der Mitteilung des Auftraggebers, einer Rüge nicht abhelfen zu wollen, vergangen sind."},{"field_id":"OPP-010-notice","is_ref":false,"ordinal":0,"scheme":"ojs-notice-id","type":"id","value":"00657362-2024"},{"field_id":"OPP-011-notice","is_ref":false,"ordinal":0,"scheme":"ojs-id","type":"id","value":"211/2024"},{"field_id":"OPP-012-notice","ordinal":0,"type":"date","value":"2024-10-29"},{"code":"29","field_id":"OPP-070-notice","list":"notice-subtype","ordinal":0,"type":"code"},{"field_id":"OPT-001-notice","is_ref":false,"ordinal":0,"scheme":null,"type":"id","value":"2.3"},{"field_id":"OPT-002-notice","is_ref":false,"ordinal":0,"scheme":null,"type":"id","value":"eforms-sdk-1.7"},{"field_id":"OPT-301-Lot-Mediator","is_ref":true,"ordinal":0,"scheme":"organization","type":"id","value":"ORG-0006"},{"field_id":"OPT-301-Lot-ReviewInfo","is_ref":true,"ordinal":0,"scheme":"organization","type":"id","value":"ORG-0004"},{"field_id":"OPT-301-Lot-ReviewOrg","is_ref":true,"ordinal":0,"scheme":"organization","type":"id","value":"ORG-0005"},{"field_id":"OPT-999","ordinal":0,"type":"date","value":"2000-01-01"}]},{"kind":"LotResult","parent_section_id":"PROCEDURE","section_id":"RES-0001","values":[{"field_id":"BT-119-LotResult","ordinal":0,"type":"integer","value":0},{"field_id":"BT-13713-LotResult","is_ref":true,"ordinal":0,"scheme":"Lot","type":"id","value":"LOT-0001"},{"code":"selec-w","field_id":"BT-142-LotResult","list":"winner-selection-status","ordinal":0,"type":"code"},{"cents":8687000,"currency":"EUR","field_id":"BT-710-LotResult","ordinal":0,"type":"amount"},{"cents":11305000,"currency":"EUR","field_id":"BT-711-LotResult","ordinal":0,"type":"amount"},{"code":"false","field_id":"BT-717-Lot","list":"cvd-scope","ordinal":0,"type":"code"},{"field_id":"OPT-315-LotResult","is_ref":true,"ordinal":0,"scheme":"contract","type":"id","value":"CON-0001"},{"field_id":"OPT-320-LotResult","is_ref":true,"ordinal":0,"scheme":"tender","type":"id","value":"TEN-0001"},{"field_id":"OPT-322-LotResult","is_ref":false,"ordinal":0,"scheme":null,"type":"id","value":"RES-0001"}]},{"kind":"LotTender","parent_section_id":"PROCEDURE","section_id":"TEN-0001","va