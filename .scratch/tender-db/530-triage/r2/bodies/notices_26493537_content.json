E1-Organizations-Organization-ListedOnRegulatedMarketIndicator","ordinal":0,"type":"integer","value":0}]},{"kind":"Notice","parent_section_id":null,"section_id":"PROCEDURE","values":[{"field_id":"DE1-ContractFolderID","is_ref":false,"ordinal":0,"scheme":null,"type":"id","value":"e9b9cd28-4eb1-489a-98f7-6205b9f9f4d4"},{"field_id":"DE1-CustomizationID","is_ref":false,"ordinal":0,"scheme":null,"type":"id","value":"eforms-de-1.1"},{"field_id":"DE1-ID","is_ref":false,"ordinal":0,"scheme":"notice-id","type":"id","value":"30b7cf10-e897-41b8-86d4-52bb2c00274d"},{"field_id":"DE1-IssueDate","ordinal":0,"type":"date","value":"2024-10-30T07:22:11+01:00"},{"code":"DEU","field_id":"DE1-NoticeLanguageCode","list":"eu-official-language","ordinal":0,"type":"code"},{"cents":109369400,"currency":"EUR","field_id":"DE1-NoticeResult-TotalAmount","ordinal":0,"type":"amount"},{"code":"29","field_id":"DE1-NoticeSubType-SubTypeCode","list":"notice-subtype","ordinal":0,"type":"code"},{"code":"can-standard","field_id":"DE1-NoticeTypeCode","list":"result","ordinal":0,"type":"code"},{"field_id":"DE1-ProcurementProject-ContractExtension-MaximumNumberNumeric","ordinal":0,"type":"number","unit":null,"value":3.0},{"field_id":"DE1-ProcurementProject-ContractExtension-Renewal-Period-Description","lang":"DEU","ordinal":0,"type":"text","value":"3-malige Verlängerungsoption um 1 Jahr. Vertrags-/Leistungsende spätestens (inkl. Verlängerungsoptionen): 31.07.2030"},{"field_id":"DE1-ProcurementProject-Description","lang":"DEU","ordinal":0,"type":"text","value":"UHR: Erreichung einer definierten Qualität in der Unterhaltsreinigung unter wirtschaftlichen Gesichtspunkten. Zur Erreichung dieser Qualität sind u.a. Schulungen etc. erforderlich (vgl. insbes. Nr. 6.4 der Leistungsbeschreibung zur UHR). Diese Leistungen sind in die Preise des Leistungsverzeichnisses mit ein zu kalkulieren und werden nicht gesondert vergütet. \nDie Ausschreibung der externen Qualitätskontrolle für diese Leistung erfolgte in einer gesonderten Ausschreibung. Eine gleichzeitige Beauftragung von Leistungen der Unterhaltsreinigung und der externen Qualitätskontrolle für die gleichen Objekte wird ausgeschlossen."},{"field_id":"DE1-ProcurementProject-ID","is_ref":false,"ordinal":0,"scheme":"internalID","type":"id","value":"100-24-00074"},{"code":"90911200","field_id":"DE1-ProcurementProject-MainCommodityClassification-ItemClassificationCode","ordinal":0,"scheme":"cpv","type":"classification"},{"field_id":"DE1-ProcurementProject-Name","lang":"DEU","ordinal":0,"type":"text","value":"BLB /Z /NL Düsseldorf/Infrastrukturelle Gebäudedienstleistungen/Unterhaltsreinigung/Los 1.26_100-24-00074"},{"field_id":"DE1-ProcurementProject-Note","lang":"DEU","ordinal":0,"type":"text","value":"Bekanntmachungs-ID: CXS7YYXY11YL2RMU\n\n\nUnter https://evergabe.blb.nrw.de/Vergabe/company/welcome.do finden Sie weitere Informationen zum Verfahren. Dort können Sie die Vergabeunterlagen kostenlos herunterladen und Nachrichten der Vergabestelle einsehen. Um am Verfahren vollumfänglich teilnehmen zu können sind ein Login und eine vorherige Registrierung erforderlich, soweit das Unternehmen nicht bereits registriert ist.\n\nDas Vergabeverfahren wird über den Vergabemarktplatz NRW (VMP NRW) abgewickelt. Unternehmen erhalten bei der Registrierung auf dem VMP NRW einen individuellen Unternehmensaccount. Der Austausch zwischen der Vergabestelle und dem Unternehmen erfolgt elektronisch über diesen Account und dem für dieses Vergabeverfahren angelegten Projektraum im Modul \"Kommunikation\". Nur das Unternehmen hat Zugriff auf die über den Unternehmensaccount im Modul \"Kommunikation\" des Projektraums eingegangenen und ausgehenden Nachrichten. Dem Unternehmen werden hierüber auch rechtserhebliche Erklärungen im Vergabeverfahren zugestellt. Innerhalb des Unternehmensaccounts können mehrere Nutzerkonten angelegt werden. Bei der Anlage wird die Verwendung funktionsbezogener E-Mail-Adressen empfohlen. Weitere Informationen und Hilfestellungen zum VMP NRW sowie Anleitungen zum Bietertool für die Angebotsabgabe finden Sie auf der Internetseite des Betreibers cosinex GmbH unter folgendem Link: https://support.cosinex.de/unternehmen/pages/viewpage.action?pageId=28115008\n\nVom BLB NRW wird eine digitale Bieteroberfläche zur Verfügung gestellt, die Sie bei der Erstellung Ihres bepreisten Leistungsverzeichnisses, als Bestandteil des elektronischen Angebotes, im Rahmen der Ausschreibung der Infrastrukturellen Gebäudedienstleistungen unterstützt. Hierzu nutzen Sie bitte den Link: \n\nDer vollständige \"Finale Ausdruck\" (NICHT ENTWURF) aus der digitalen Bieteroberfläche ist dem elektronischen Angebot zwingend als Anhang in Dateiform (pdf) beizufügen.\n\nIm Falle der Unterschreitung von Leistungskennwerten beachten Sie bitte den Hinweis in Kapitel 5.1.5 des Leitfadens digitale Bieteroberfläche zur Angebotsbearbeitung. Sollte eine Unterschreitung der Leistungskennwerte bei Angebotsprüfung seitens AG festgestellt werden, hat der Bieter auf besondere Anforderung des Auftraggebers eine Erläuterung einzureichen.\n\nDie Vertragsbedingungen sind Bestandteil der Vergabeunterlagen. Mit der Zuschlagserteilung wird der Vertrag mit allen Anlagen wirksam.\nLeistungsbeginn: abweichend vom Vertragsbeginn am 01.03.2025\n\nWird der Auftrag einer Bietergemeinschaft erteilt, so ist diese in eine gesamtschuldnerisch haftende Arbeitsgemeinschaft mit bevollmächtigtem Vertreter zu überführen.\n\nBesichtigung der Objekte: Keine Referenzobjekte für Besichtigungen vorgesehen, keine verpflichtenden Objektbesichtigungen vorgesehen.\n\nEs sind ggf. die Bemerkungen und die Hinweise auf erhöhte Sicherheitsbestimmungen in den Liegenschaftsübersichten/Gebäudesteckbriefen ggf. mit Ergänzungsdateien dringend zu beachten.\n\nDie Ausschreibung der externen Qualitätskontrolle für diese Leistung erfolgte in einer gesonderten Ausschreibung. Eine gleichzeitige Beauftragung von Leistungen der Unterhaltsreinigung und der externen Qualitätskontrolle für die gleichen Objekte wird ausgeschlossen."},{"field_id":"DE1-ProcurementProject-PlannedPeriod-EndDate","ordinal":0,"type":"date","value":"2027-07-31"},{"field_id":"DE1-ProcurementProject-PlannedPeriod-StartDate","ordinal":0,"type":"date","value":"2025-01-01"},{"code":"services","field_id":"DE1-ProcurementProject-ProcurementTypeCode","list":"contract-nature","ordinal":0,"type":"code"},{"field_id":"DE1-RegulatoryDomain","lang":null,"ordinal":0,"type":"text","value":"32014L0024"},{"field_id":"DE1-RequestedPublicationDate","ordinal":0,"type":"date","value":"2024-10-30"},{"field_id":"DE1-TenderResult-AwardDate","ordinal":0,"type":"date","value":"2000-01-01"},{"field_id":"DE1-TenderingProcess-AuctionTerms-AuctionConstraintIndicator","ordinal":0,"type":"integer","value":0},{"code":"open","field_id":"DE1-TenderingProcess-ProcedureCode","list":"procurement-procedure-type","ordinal":0,"type":"code"},{"field_id":"DE1-TenderingTerms-AppealTerms-AppealReceiverParty-PartyIdentification-ID","is_ref":true,"ordinal":0,"scheme":"organization","type":"id","value":"ORG-0003"},{"field_id":"DE1-TenderingTerms-AppealTerms-PresentationPeriod-Description","lang":"DEU","ordinal":0,"type":"text","value":"Der Antrag auf Einleitung eines Nachprüfungsverfahrens vor der Vergabekammer ist unzulässig, soweit:\n\n1. der Antragsteller den gerügten Verstoß gegen Vergabevorschriften im Vergabeverfahren erkannt und gegenüber dem Auftraggeber nicht innerhalb von zehn Kalendertagen nach Absendung der Information per Fax oder auf elektronischem Wege bzw. 15 Kalendertagen nach einer Versendung mit anderen Kommunikationsmitteln gerügt hat,\n\n2. Verstöße gegen Vergabevorschriften, die aufgrund der Bekanntmachung erkennbar sind, nicht spätestens bis Ablauf der in der Bekanntmachung benannten Frist zur Angebotsabgabe oder zur Bewerbung gegenüber dem Auftraggeber gerügt werden,\n\n3. Verstöße gegen Vergabevorschriften, die erst in den Vergabeunterlagen erkennbar sind, nicht spätestens bis zum Ablauf der in der Bekanntmachung benannten Frist zur Angebotsabgabe oder zur Bewerbung gegenüber dem Auftraggeber gerügt werden,\n\n4. mehr als 15 Kalendertage nach Eingang der Mitteilung des Auftraggebers, einer Rüge nicht abhelfen zu wollen, vergangen sind.\n\nDies gilt nicht bei einem Antrag auf Feststellung der Unwirksamkeit des Vertrages nach § 135 Abs. 1 Nr. 2 GWB. § 134 Abs. 1 Satz 2 GWB bleibt unberührt."},{"code":"no-eu-funds","field_id":"DE1-TenderingTerms-FundingProgramCode","list":"eu-funded","ordinal":0,"type":"code"},{"field_id":"DE1-UBLVersionID","is_ref":false,"ordinal":0,"scheme":null,"type":"id","value":"2.3"},{"field_id":"DE1-VersionID","is_ref":false,"ordinal":0,"scheme":null,"type":"id","value":"01"}]},{"kind":"LotResult","parent_section_id":"PROCEDURE","section_id":"RES-0001","values":[{"field_id":"DE1-NoticeResult-LotResult-DPSTerminationIndicator","ordinal":0,"type":"integer","value":0},{"field_id":"DE1-NoticeResult-LotResult-ID","is_ref":false,"ordinal":0,"scheme":null,"type":"id","value":"RES-0001"},{"field_id":"DE1-NoticeResult-LotResult-TenderLot-ID","is_ref":false,"ordinal":0,"scheme":"Lot","type":"id","value":"LOT-0001"},{"code":"selec-w","field_id":"DE1-NoticeResult-LotResult-TenderResultCode","list":"winner-selection-status","ordinal":0,"type":"code"}]},{"kind":"LotTender","parent_section_id":"PROCEDURE","section_id":"TEN-0001","values":[{"field_id":"DE1-NoticeResult-LotTender-ID","is_ref":false,"ordinal":0,"scheme":"tender","type":"id","value":"TEN-0001"},{"cents":109369400,"currency":"EUR","field_id":"DE1-NoticeResult-LotTender-LegalMonetaryTotal-PayableAmount","ordinal":0,"type":"amount"},{"field_id":"DE1-NoticeResult-LotTender-TenderLot-ID","is_ref":false,"ordinal":0,"scheme":"Lot","type":"id","value":"LOT-0001"},{"field_id":"DE1-NoticeResult-LotTender-TenderVariantIndicator","ordinal":0,"type":"integer","value":0},{"field_id":"DE1-NoticeResult-LotTender-TenderingParty-ID","is_ref":false,"ordinal":0,"scheme":"tenderingparty","type":"id","value":"T