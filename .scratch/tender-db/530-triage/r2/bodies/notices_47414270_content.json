mkeit des Vertrags nach § 135 Absatz 1 Nummer 2. § 134 Absatz 1 Satz 2 GWB bleibt unberührt."},{"field_id":"OPT-301-Lot-AddInfo","is_ref":true,"ordinal":0,"scheme":null,"type":"id","value":"ORG-0001"},{"field_id":"OPT-301-Lot-ReviewInfo","is_ref":true,"ordinal":0,"scheme":"organization","type":"id","value":"ORG-0002"},{"field_id":"OPT-301-Lot-ReviewOrg","is_ref":true,"ordinal":0,"scheme":"organization","type":"id","value":"ORG-0003"}]},{"kind":"Lot","parent_section_id":"PROCEDURE","section_id":"LOT-0002","values":[{"field_id":"BT-115-Lot","ordinal":0,"type":"integer","value":1},{"field_id":"BT-137-Lot","is_ref":false,"ordinal":0,"scheme":"Lot","type":"id","value":"LOT-0002"},{"field_id":"BT-21-Lot","lang":"DEU","ordinal":0,"type":"text","value":"Miete von einem Mikromüllwagen einschl. Service-Leistungen"},{"field_id":"BT-22-Lot","is_ref":false,"ordinal":0,"scheme":"internalID","type":"id","value":"02"},{"code":"services","field_id":"BT-23-Lot","list":"contract-nature","ordinal":0,"type":"code"},{"field_id":"BT-24-Lot","lang":"DEU","ordinal":0,"type":"text","value":"Miete von einem Mikromüllwagen einschl. Service-Leistungen"},{"code":"90500000","field_id":"BT-262-Lot","ordinal":0,"scheme":"cpv","type":"classification"},{"cents":45210000,"currency":"EUR","field_id":"BT-27-Lot","ordinal":0,"type":"amount"},{"field_id":"BT-536-Lot","ordinal":0,"type":"date","value":"2026-02-01"},{"field_id":"BT-537-Lot","ordinal":0,"type":"date","value":"2031-01-31"},{"field_id":"BT-57-Lot","lang":"DEU","ordinal":0,"type":"text","value":"einjährige Verlängerungsoption"},{"field_id":"BT-58-Lot","ordinal":0,"type":"integer","value":1},{"code":"no-eu-funds","field_id":"BT-60-Lot","list":"eu-funded","ordinal":0,"type":"code"},{"code":"false","field_id":"BT-681-Lot","list":"fsr","ordinal":0,"type":"code"},{"code":"false","field_id":"BT-684-Lot","list":"ipi-scope","ordinal":0,"type":"code"},{"code":"false","field_id":"BT-717-Lot","list":"cvd-scope","ordinal":0,"type":"code"},{"code":"none","f