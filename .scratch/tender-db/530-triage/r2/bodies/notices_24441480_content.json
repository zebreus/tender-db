er Vertrag kann sich einmalig um ein weiteres Jahr verlängern. Er verlängert sich einmalig um ein weiteres Jahr, sofern eine der Vertragsparteien der Verlängerung spätestens 6 Monate vor Ablauf der Vertragslaufzeit schriftlich zustimmt und zuvor Einvernehmen über die nach der Vertragsverlängerung zu zahlenden zusätzlichen Entgelte gem. § 8 Abs. 4e des Vertrages erzielt wird. Der Vertrag endet spätestens am 31.12.2027."},{"field_id":"BT-58-Lot","ordinal":0,"type":"integer","value":1},{"code":"no-eu-funds","field_id":"BT-60-Lot","list":"eu-funded","ordinal":0,"type":"code"},{"code":"false","field_id":"BT-717-Lot","list":"cvd-scope","ordinal":0,"type":"code"},{"code":"none","field_id":"BT-765-Lot","list":"framework-agreement","ordinal":0,"type":"code"},{"code":"none","field_id":"BT-766-Lot","list":"dps-usage","ordinal":0,"type":"code"},{"field_id":"BT-767-Lot","ordinal":0,"type":"integer","value":0},{"field_id":"OPT-301-Lot-AddInfo","is_ref":true,"ordinal":0,"scheme":null,"type":"id","value":"ORG-0001"},{"field_id":"OPT-301-Lot-ReviewOrg","is_ref":true,"ordinal":0,"scheme":"organization","type":"id","value":"ORG-0002"}]},{"kind":"ContractingParty","parent_section_id":"PROCEDURE","section_id":"ND-ContractingParty#0","values":[{"code":"gen-pub","field_id":"BT-10-Procedure-Buyer","list":"authority-activity","ordinal":0,"type":"code"},{"code":"pub-undert","field_id":"BT-11-Procedure-Buyer","list":"buyer-legal-type","ordinal":0,"type":"code"},{"field_id":"OPT-300-Procedure-Buyer","is_ref":true,"ordinal":0,"scheme":null,"type":"id","value":"ORG-0001"}]},{"kind":"LocalLegalBasisWithID","parent_section_id":"PROCEDURE","section_id":"ND-LocalLegalBasisWithID#0","values":[{"field_id":"BT-01(c)-Procedure","is_ref":false,"ordinal":0,"scheme":null,"type":"id","value":"vgv"}]},{"kind":"LotAdditionalClassification","parent_section_id":"LOT-0001","section_id":"ND-LotAdditionalClassification#0","values":[{"code":"90520000","field_id":"BT-263-Lot","ordinal":0,"scheme":"cpv","type":"class