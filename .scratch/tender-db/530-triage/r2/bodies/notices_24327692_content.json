ganization-Company","is_ref":false,"ordinal":0,"scheme":"organization","type":"id","value":"ORG-0006"}]},{"kind":"Notice","parent_section_id":null,"section_id":"PROCEDURE","values":[{"code":"32014L0024","field_id":"BT-01-notice","list":null,"ordinal":0,"type":"code"},{"code":"cn-standard","field_id":"BT-02-notice","list":"competition","ordinal":0,"type":"code"},{"field_id":"BT-04-notice","is_ref":false,"ordinal":0,"scheme":null,"type":"id","value":"51f93fb3-f661-46fc-a89e-1503709c2602"},{"field_id":"BT-05(a)-notice","ordinal":0,"type":"date","value":"2024-10-30T00:00:11+01:00"},{"code":"open","field_id":"BT-105-Procedure","list":"procurement-procedure-type","ordinal":0,"type":"code"},{"code":"false","field_id":"BT-106-Procedure","list":"accelerated-procedure","ordinal":0,"type":"code"},{"field_id":"BT-124-Lot","lang":null,"ordinal":0,"type":"text","value":"https://www.vergaben-wirtschaftsregion-aachen.de/VMPSatellite/notice/CXT2YYBY1WG76DU8"},{"code":"non-restricted-document","field_id":"BT-14-Lot","list":null,"ordinal":0,"type":"code"},{"field_id":"BT-21-Procedure","lang":"DEU","ordinal":0,"type":"text","value":"Schlosser-Metallbau - Rhein-Maas-Gymnasium 0715 EG-OG"},{"field_id":"BT-22-Procedure","is_ref":false,"ordinal":0,"scheme":"internalID","type":"id","value":"FB60/310-2024/917-BC"},{"code":"works","field_id":"BT-23-Lot","list":"contract-nature","ordinal":0,"type":"code"},{"field_id":"BT-24-Procedure","lang":"DEU","ordinal":0,"type":"text","value":"Schlosser-Metallbau"},{"field_id":"BT-300-Procedure","lang":"DEU","ordinal":0,"type":"text","value":"Bekanntmachungs-ID: CXT2YYBY1WG76DU8\n\n\n1. Es gilt die Lohngleitklausel:                                                                                         \nnein\n\n2. Es besteht eine Bauleistungsversicherung durch die Stadt Aachen:                  \nja  \n\n3. Lage der Baustelle:\nRhein-Maas-Gymnasium\nRhein-Maas-Str. 2\n52066 Aachen\n\n4. Lager- u. Arbeitsplätze:\n./.\n\n5. Verkehrswege innerhalb des Baugeländes:\n./.\n\n6. Wasseranschluss:\nja\n\n7. Stromanschlüsse/Spannung:\nja\n\n8. Die Rechnung ist in  ./.-facher Ausfertigung einzureichen.\n- Den Abrechnungen der Neu- / Umbaumaßnahmen sind Zeichnungen im Maßstab 1:50 bis 1:100 zweifach beizufügen.\n\n9. Die Maßnahme ist auf Abruf gem. § 5 Abs 2 VOB/B zu beginnen (W+M Planung ca. 22.02.2025, Montage Stahlrahmen ca. 31.03.2025).\n\n10. Die Arbeiten sind innerhalb von 10 Werktagen nach Beginn der Ausführung fertigzustellen.\n\n11. Folgende Einzelfristen (die in Fällen gemäß § 9 Abs. 1 Nr. 2 VOB / A vereinbart werden) sind Vertragsfristen:\n./.\n\n12. Für die Überschreitung der Fertigstellungsfrist gem. Ziffer 8 bzw. der vereinbarten Einzelfristen gem. Ziffer 9 wird eine / keine Vertragsstrafe vereinbart.\n\n13. Für das Gewerk Schlosser-Metallbau wird eine Gewährleistungsfrist von 4 Jahren vereinbart.\n\n14. Die Mindestdeckungssumme der Haftpflichtversicherung für Personen- und Sachschäden beträgt abweichend von Ziffer 8 der Bewerbungsbedingungen ./. Millionen EUR\n\n15. Die Unterlagen stehen ausschließlich als kostenloser Download unter http://www.vergaben-wirtschaftsregion-aachen.de/VMPSatellite/company/welcome.do zur Verfügung. Die Weitergabe der Ausschreibungsunterlagen an Dritte sowie die gewerbliche Nutzung der Ausschreibungsunterlagen sind nicht gestattet.\n\n16. Auskünfte über die Vergabeunterlagen sind bis 25.11.2024 schriftlich über das Vergabeportal der Wirtschaftsregion Aachen zu beantragen!\n\n17. Hinweis: Das Submissionsergebnis wird ausschließlich über das Vergabeportal der Wirtschaftsregion Aachen zur Verfügung gestellt"},{"field_id":"BT-536-Lot","ordinal":0,"type":"date","value":"2025-02-22"},{"field_id":"BT-537-Lot","ordinal":0,"type":"date","value":"2025-03-31"},{"field_id":"BT-58-Lot","ordinal":0,"type":"integer","value":0},{"code":"no-eu-funds","field_id":"BT-60-Lot","list":"eu-funded","ordinal":0,"type":"code"},{"field_id":"BT-701-notice","is_ref":false,"ordinal":0,"scheme":"notice-id","type":"i