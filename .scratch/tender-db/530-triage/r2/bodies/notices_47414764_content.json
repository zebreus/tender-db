g":null,"ordinal":0,"type":"text","value":"53123"},{"field_id":"BT-513-Organization-Company","lang":null,"ordinal":0,"type":"text","value":"Bonn"},{"code":"DEU","field_id":"BT-514-Organization-Company","list":"country","ordinal":0,"type":"code"},{"field_id":"BT-739-Organization-Company","lang":null,"ordinal":0,"type":"text","value":"+49 2289499-163"},{"field_id":"OPT-200-Organization-Company","is_ref":false,"ordinal":0,"scheme":null,"type":"id","value":"ORG-0002"}]},{"kind":"Notice","parent_section_id":null,"section_id":"PROCEDURE","values":[{"code":"32014L0024","field_id":"BT-01-notice","list":null,"ordinal":0,"type":"code"},{"code":"cn-standard","field_id":"BT-02-notice","list":"competition","ordinal":0,"type":"code"},{"field_id":"BT-04-notice","is_ref":false,"ordinal":0,"scheme":null,"type":"id","value":"621f1018-41da-4a60-940f-ba185133bd18"},{"field_id":"BT-05(a)-notice","ordinal":0,"type":"date","value":"2026-10-16T16:17:51+02:00"},{"code":"open","field_id":"BT-105-Procedure","list":"procurement-procedure-type","ordinal":0,"type":"code"},{"code":"false","field_id":"BT-106-Procedure","list":"accelerated-procedure","ordinal":0,"type":"code"},{"field_id":"BT-124-Lot","lang":null,"ordinal":0,"type":"text","value":"https://www.dtvp.de/Satellite/notice/CXVHY5UYTP44KW6K"},{"code":"non-restricted-document","field_id":"BT-14-Lot","list":null,"ordinal":0,"type":"code"},{"field_id":"BT-21-Procedure","lang":"DEU","ordinal":0,"type":"text","value":"Röntgenscanner"},{"field_id":"BT-22-Procedure","is_ref":false,"ordinal":0,"scheme":"internalID","type":"id","value":"SPK-2026-00051"},{"code":"supplies","field_id":"BT-23-Lot","list":"contract-nature","ordinal":0,"type":"code"},{"field_id":"BT-24-Procedure","lang":"DEU","ordinal":0,"type":"text","value":"Lieferung und Inbetriebnahme eines offenen, räumlich hochaufgelösten Mikro-Röntgenfluoreszenz-Spektrometersystems (µ-RFA)"},{"code":"33111800","field_id":"BT-262-Procedure","ordinal":0,"scheme":"cpv","type":"classification"},{"field_id":"BT-300-Procedure","lang":"DEU","ordinal":0,"type":"text","value":"#Bekanntmachungs-ID: CXVHY5UYTP44KW6K#\n\n\nDas Wertungsschema ist in folgendem Dokument der Vergabeunterlagen zu entnehmen:\nFragebogen zur Leistungsbewertung.xlsx\n\nEs wird darum gebeten, Bieterfragen möglichst frühzeitig zu stellen, auch als Einzelfragen und nicht erst gebündelt, um eine schnelle und für das Vergabeverfahren günstige Beantwortung zu organisieren.  \n\nEin angebotenes Skonto wird in der Wertung nur berücksichtigt, wenn das Zahlungsziel mindestens 14 Tage beträgt.\n\nDie Zentrale Vergabestelle (ZVS) der Stiftung Preußischer Kulturbesitz führt eine interne Unternehmensdatenbank für die Durchführung von Vergabeverfahren. Unternehmen können sich dort durch Abgabe der beigefügten \"Eigenerklärung zur Eignung (SPK-Präqualifizierung)\" erfasst werden, um in nichtöffentlichen Vergabeverfahren zur Abgabe eines Angebotes/Teilnahmeantrages aufgefordert zu werden und nicht wiederholend erneut eine Eigenerklärung nach §§ 123, 124 GWB abgeben zu müssen.\nDie Zentrale Vergabestelle (ZVS) der Stiftung Preußischer Kulturbesitz führt eine interne Unternehmensdatenbank für die Durchführung von Vergabeverfahren. Unternehmen können sich dort durch Abgabe der beigefügten \"Eigenerklärung zur Eignung (SPK-Präqualifizierung)\" erfasst werden, um in nichtöffentlichen Vergabeverfahren zur Abgabe eines Angebotes/Teilnahmeantrages aufgefordert zu werden und nicht wiederholend erneut eine Eigenerklärung nach §§ 123, 124 GWB abgeben zu müssen."},{"code":"no-eu-funds","field_id":"BT-60-Lot","list":"eu-funded","ordinal":0,"type":"code"},{"field_id":"BT-701-notice","is_ref":false,"ordinal":0,"scheme":"notice-id","type":"id","value":"6147816a-b0f6-410f-aa73-9f55f584287a"},{"code":"DEU","field_id":"BT-702(a)-notice","list":"eu-official-language","ordinal":0,"type":"code"},{"code":"DEU","field_id":"BT-708-Lot","list":null,"ordinal":0,"type":"code"},{"code":"false","field_id":"BT-717-Lot","list":"cvd-scope","ordinal":0,"type":"code"},{"field_id":"BT-738-notice","ordinal":0,"type":"date","value":"2026-10-16"},{"code":"false","field_id":"BT-751-Lot","list":"tender-guarantee-required","ordinal":0,"type":"code"},{"field_id":"BT-757-notice","is_ref":false,"ordinal":0,"scheme":null,"type":"id","value":"01"},{"field_id":"BT-767-Lot","ordinal":0,"type":"integer","value":0},{"code":"false","field_id":"BT-810-Lot","list":"eed-scope","ordinal":0,"type":"code"},{"code":"DEU","field_id":"BT-97-Lot","list":null,"ordinal":0,"type":"code"},{"field_id":"BT-99-Lot","lang":"DEU","ordinal":0,"type":"text","value":"Unternehmen haben einen Anspruch auf Einhaltung der bieter- und bewerberschützenden Bestimmungen über das Vergabeverfahren gegenüber dem öffentlichen Auftraggeber, Stiftung Preußischer Kulturbesitz (SPK). Die Zentrale Vergabestelle (ZVS) weist auf die zulässigen Rechtsbehelfe und einzuhaltenden Fristen hin.\n---\nStatthafte Rechtsbehelfe sind gem. §§ 160 ff. GWB die Rüge sowie der Antrag auf Einleitung eines Nachprüfungsverfahrens vor der zuständigen Vergabekammer. Eine Rüge ist an die  Vergabestelle zu richten. \n----\nStatthafter Rechtsbehelf ist gem. §§ 160 ff. GWB der Antrag auf Einleitung eines Nachprüfungsverfahrens vor der zuständigen Vergabekammer.\n---\nDer Antrag ist unzulässig, soweit\n1. der Antragsteller den gerügten Verstoß gegen Vergabevorschriften im Vergabeverfahren erkannt und gegenüber dem Auftraggeber nicht innerhalb einer Frist von zehn Kalendertagen gerügt hat; der Ablauf der Frist nach § 134 Abs. 2 GWB bleibt unberührt,\n2. Verstöße gegen Vergabevorschriften, die aufgrund der Bekanntmachung erkennbar sind, nicht spätestens bis zum Ablauf der in der Bekanntmachung benannten Frist zur Bewerbung oder zur Angebotsabgabe gegenüber dem Auftraggeber gerügt werden,\n3. Verstöße gegen Vergabevorschriften, die erst in den Vergabeunterlagen erkennbar sind, nicht spätestens bis zum Ablauf der Frist zur Bewerbung oder zur Angebotsabgabe gegenüber dem Auftraggeber gerügt werden,\n4. mehr als 15 Kalendertage nach Eingang der Mitteilung des Auftraggebers, einer Rüge nicht abhelfen zu wollen, vergangen sind.\nSatz 1 gilt nicht bei einem Antrag auf Feststellung der Unwirksamkeit des Vertrages nach § 135 Abs. 1 Nr. 2 GWB.\n§ 134 Abs. 1 Satz 1 GWB bleibt unberührt.\n---\nEin Antrag auf Nachprüfung ist schriftlich an die Vergabekammern des Bundes beim Bundeskartellamt, Villemombler Straße 76, 53123 Bonn zu richten. Soll ein Nachprüfungsantrag (§ 107 Abs. 1 GWB) per E-Mail eingereicht werden, so ist dies nur mit qualifizierter elektronischer Signatur an die E-Mail-Adresse vk@bundeskartellamt.bund.de möglich.\n---\nHinweis:\nDie SPK ist im Falle eines Nachprüfungsantrags verpflichtet, die Vergabeakten, die auch die abgegebenen Angebote enthalten, an die Vergabekammer weiterzuleiten. Die Beteiligten haben ein Recht auf Akteneinsicht. Um Betriebs- und Geschäftsgeheimnisse zu wahren, teilen Sie uns konkret mit Bezug auf die entsprechenden Dokumente des Angebotes mit, welche Informationen als Betriebs- und Geschäftsgeheimnisse zu behandeln sind."},{"code":"16","field_id":"OPP-070-notice","list":"notice-subtype","ordinal":0,"type":"code"},{"field_id":"OPT-001-notice","is_ref":false,"ordinal":0,"scheme":null,"type":"id","value":"2.3"},{"field_id":"OPT-002-notice","is_ref":false,"ordinal":0,"scheme":null,"type":"id","value":"eforms-de-2.1"},{"field_id":"OPT-002-notice-DET","is_ref":false,"ordinal":0,"scheme":null,"type":"id","value":"eforms-sdk-1.13"},{"field_id":"OPT-140-Lot","is_ref":false,"ordinal":0,"scheme":null,"type":"id","value":"SomeTenderDocID1"},{"field_id":"OPT-301-Lot-ReviewOrg","is_ref":true,"ordinal":0,"scheme":"organization","type":"id","value":"ORG-0002"},{"field_id":"OPT-301-Lot-TenderReceipt","is_ref":true,"ordinal":0,"scheme":null,"type":"id","value":"ORG-0001"}]}]}