ld_id":"OPT-140-Lot","is_ref":false,"ordinal":0,"scheme":null,"type":"id","value":"SomeTenderDocID1"}]},{"kind":"ProcedureMainClassification","parent_section_id":"PROCEDURE","section_id":"ND-ProcedureMainClassification#0","values":[{"code":"79340000","field_id":"BT-262-Procedure","ordinal":0,"scheme":"cpv","type":"classification"}]},{"kind":"ProcedurePlacePerformanceAdditionalInformation","parent_section_id":"PROCEDURE","section_id":"ND-ProcedurePlacePerformanceAdditionalInformation#0","values":[{"code":"DE600","field_id":"BT-5071-Procedure","ordinal":0,"scheme":"nuts","type":"classification"},{"field_id":"BT-5101(a)-Procedure","lang":null,"ordinal":0,"type":"text","value":"Hamburg Messe und Congress GmbH"},{"field_id":"BT-5101(b)-Procedure","lang":null,"ordinal":0,"type":"text","value":"Messeplatz 1"},{"field_id":"BT-5121-Procedure","lang":null,"ordinal":0,"type":"text","value":"20357"},{"field_id":"BT-5131-Procedure","lang":null,"ordinal":0,"type":"text","value":"Hamburg"},{"code":"DEU","field_id":"BT-5141-Procedure","list":null,"ordinal":0,"type":"code"}]},{"kind":"SelectionCriteria","parent_section_id":"LOT-0001","section_id":"ND-SelectionCriteria#0","values":[{"code":"ef-stand","field_id":"BT-747-Lot","list":"selection-criterion","ordinal":0,"type":"code"},{"field_id":"BT-750-Lot","lang":"DEU","ordinal":0,"type":"text","value":"- Vorlage einer aktuellen Bankauskunft zur Bonität des Bieters, nicht älter als 6 Monate\n- Eigenerklärung zum Umsatz der letzten drei abgeschlossenen Geschäftsjahre insgesamt sowie zum Umsatz der letzten drei abgeschlossenen Geschäftsjahre bezüglich solcher Leistungen, die mit der zu vergebenen Leistung vergleichbar sind, auf dem beigefügten \"Formblatt Eigenerklärung zur Eignung Liefer-_Dienstleistungen\"\n- Eigenerklärung Betriebshaftpflichtversicherung (mit dem Angebot mittels Eigenerklärung vorzulegen): Sollte die Betriebshaftpflichtversicherung zum Zeitpunkt der Einreichung des Angebotes noch nicht bestehen, ist mit dem Angebot, neben der Vorlage des Nachweiseses der bestehenden Versicherung in Kopie, zusätzlich eine unterschriebene Erklärung des Bewerbers einzureichen, wonach dieser sich im Falle der Auftragserteilung zum Abschluss einer der vorstehenden Anforderungen entsprechenden Versicherung verpflichtet."},{"field_id":"UBL-SelectionCriterionName","lang":"DEU","ordinal":0,"type":"text","value":"Wirtschaftliche und finanzielle Leistungsfähigkeit"}]},{"kind":"SelectionCriteria","parent_section_id":"LOT-0001","section_id":"ND-SelectionCriteria#1","values":[{"code":"other","field_id":"BT-747-Lot","list":"selection-criterion","ordinal":0,"type":"code"},{"field_id":"BT-750-Lot","lang":"DEU","ordinal":0,"type":"text","value":"Angebotsdeckblatt (mit dem Angebot vollständig ausgefüllt und unterschrieben vorzulegen)"},{"field_id":"UBL-SelectionCriterionName","lang":"DEU","ordinal":0,"type":"text","value":"Sonstiges"}]},{"kind":"SelectionCriteria","parent_section_id":"LOT-0001","section_id":"ND-SelectionCriteria#2","values":[{"code":"sui-act","field_id":"BT-747-Lot","list":"selection-criterion","ordinal":0,"type":"code"},{"field_id":"BT-750-Lot","lang":"DEU","ordinal":0,"type":"text","value":"- Vorlage eines den Stand der letzten Änderung berücksichtigenden Handelsregisterauszuges im Falle einer Kommanditgesellschaft auch der entsprechende Nachweis der Komplementärgesellschaft (soweit im Handelsregister eingetragen)\n- Vorlage einer Gewerbeanmeldung oder vergleichbaren Nachweises (nicht erforderlich bei Vorlage eines Handelsregisterauszuges)\n- Nachweis einer Betriebshaftpflichtversicherung mit den geforderten Deckungssummen: \nDie Betriebshaftpflichtversicherung muss mindestens einen marktüblichen Deckungsumfang und mindestens folgende Versicherungssummen vorsehen:\n(a)  5.000.000,00 Euro für Personen-, Sach- oder sich daraus ergebende Vermögensschäden \n(b) 100.000,00 Euro für reine Vermögensschäden, die im Zusammenhang mit der Erfüllung der Pflichten nach Maßgabe des abzuschließenden Vertrages entstehen. \nAlle Versicherungssummen müssen je Schadensfall und 2-fach für die Betriebshaftpflicht sowie auf das 1-fache für die Umwelthaftpflichtbasisversicherung für alle Schäden je Versicherungsjahr zur Verfügung stehen.\n- Unbedenklichkeitsbescheinigung des zuständigen Finanzamtes, mindestens einer Krankenversicherung und der Berufsgenossenschaft, nicht älter als 6 Monate\n- Erklärung des Unternehmens, dass die in §48 VgV i.V.m. § 123 und 124 GWB genannten Ausschlussgründe nicht vorliegen, durch die unterzeichnete Eigenerklärung auf dem beigefügten \"Formblatt Eigenerklärung zu § 48 VgV i.V.m. § 123 und 124 GWB\".\n- Eigenerklärung des Unternehmens zum Mindestlohn und durch unterzeichnete Eigenerklärung auf dem beigefügten \"Formblatt Eigenerklärung zum Mindestlohn\"."},{"field_id":"UBL-SelectionCriterionName","lang":"DEU","ordinal":0,"type":"text","value":"Eignung zur Berufsausübung"}]},{"kind":"SelectionCriteria","parent_section_id":"LOT-0001","section_id":"ND-SelectionCriteria#3","values":[{"code":"tp-abil","field_id":"BT-747-Lot","list":"selection-criterion","ordinal":0,"type":"code"},{"field_id":"BT-750-Lot","lang":"DEU","ordinal":0,"type":"text","value":"- Eigenerklärung Bietergemeinschaft (mit dem Angebot mittels Eigenerklärung vorzulegen): Bei Bedarf.\n- Darstellung der Zahl, der in den letzten drei abgeschlossenen Geschäftsjahren durchschnittlich beschäftigten Arbeitskräfte, gegliedert nach Berufsgruppen unter Verwendung des beigefügten \"Formblatt Personelle Ausstattung\"\n- Mindestens 2 Referenzen bei unterschiedlichen Veranstaltungen und Veranstaltungsorten, die mit den ausgeschriebenen Leistungen vergleichbar sind, mit jeweils einer Laufzeit von mind. 24 Monaten. Das Vertragsende darf nicht älter als 12 Monate sein. \n- Nachweis, dass geschultes Personal eingesetzt wird, die Aus- und Weiterbildung erfolgt und die Qualität der Leistung überprüft und sichergestellt wird.   \n- Nachweis, dass der Projektleiter die notwendige Erfahrung/Qualifizierung hat."},{"field_id":"UBL-SelectionCriterionName","lang":"DEU","ordinal":0,"type":"text","value":"Technische und berufliche Leistungsfähigkeit"}]},{"kind":"ServiceProviderParty","parent_section_id":"ND-ContractingParty#0","section_id":"ND-ServiceProviderParty#0","values":[{"code":"ted-esen","field_id":"OPT-030-Procedure-SProvider","list":"organisation-role","ordinal":0,"type":"code"},{"field_id":"OPT-300-Procedure-SProvider","is_ref":true,"ordinal":0,"scheme":"organization","type":"id","value":"ORG-0006"}]},{"kind":"StrategicProcurementType","parent_section_id":"LOT-0001","section_id":"ND-StrategicProcurementType#0","values":[{"code":"none","field_id":"BT-06-Lot","list":"strategic-procurement","ordinal":0,"type":"code"}]},{"kind":"Organization","parent_section_id":"PROCEDURE","section_id":"ORG-0001","values":[{"field_id":"BT-500-Organization-Company","lang":"DEU","ordinal":0,"type":"text","value":"Hamburg Messe und Congress GmbH"},{"field_id":"BT-501-Organization-Company","is_ref":false,"ordinal":0,"scheme":null,"type":"id","value":"528bf83f-c854-4ddd-8d4f-36ec1af2ae49"},{"field_id":"BT-502-Organization-Company","lang":null,"ordinal":0,"type":"text","value":"Abteilung Einkauf"},{"field_id":"BT-503-Organization-Company","lang":null,"ordinal":0,"type":"text","value":"+49 4035692354"},{"field_id":"BT-506-Organization-Company","lang":null,"ordinal":0,"type":"text","value":"ausschreibungen@hamburg-messe.de"},{"code":"DE600","field_id":"BT-507-Organization-Company","ordinal":0,"scheme":"nuts","type":"classification"},{"field_id":"BT-510(a)-Organization-Company","lang":null,"ordinal":0,"type":"text","value":"Messeplatz 1"},{"field_id":"BT-512-Organization-Company","lang":null,"ordinal":0,"type":"text","value":"20357"},{"field_id":"BT-513-Organization-Company","lang":null,"ordinal":0,"type":"text","value":"Hamburg"},{"code":"DEU","field_id":"BT-514-Organization-Company","list":null,"ordinal":0,"type":"code"},{"field_id":"OPT-200-Organization-Company","is_ref":false,"ordinal":0,