tionDocumentReference","parent_section_id":"PROCEDURE","section_id":"ND-ProcurementLegislationDocumentReference#0","values":[{"field_id":"DE1-TenderingTerms-ProcurementLegislationDocumentReference-ID","is_ref":false,"ordinal":0,"scheme":null,"type":"id","value":"vgv"}]},{"kind":"ProcurementLegislationDocumentReference","parent_section_id":"LOT-0001","section_id":"ND-ProcurementLegislationDocumentReference#1","values":[{"field_id":"DE1-TenderingTerms-ProcurementLegislationDocumentReference-ID","is_ref":false,"ordinal":0,"scheme":null,"type":"id","value":"vgv"}]},{"kind":"RealizedLocation","parent_section_id":"PROCEDURE","section_id":"ND-RealizedLocation#0","values":[{"field_id":"DE1-ProcurementProject-RealizedLocation-Address-AdditionalStreetName","lang":null,"ordinal":0,"type":"text","value":"Allmandring 30a"},{"field_id":"DE1-ProcurementProject-RealizedLocation-Address-CityName","lang":null,"ordinal":0,"type":"text","value":"Stuttgart"},{"code":"DEU","field_id":"DE1-ProcurementProject-RealizedLocation-Address-Country-IdentificationCode","list":null,"ordinal":0,"type":"code"},{"code":"DE111","field_id":"DE1-ProcurementProject-RealizedLocation-Address-CountrySubentityCode","ordinal":0,"scheme":"nuts","type":"classification"},{"field_id":"DE1-ProcurementProject-RealizedLocation-Address-PostalZone","lang":null,"ordinal":0,"type":"text","value":"70569"},{"field_id":"DE1-ProcurementProject-RealizedLocation-Address-StreetName","lang":null,"ordinal":0,"type":"text","value":"Universität Stuttgart - TIK"}]},{"kind":"RealizedLocation","parent_section_id":"LOT-0001","section_id":"ND-RealizedLocation#1","values":[{"field_id":"DE1-ProcurementProject-RealizedLocation-Address-AdditionalStreetName","lang":null,"ordinal":0,"type":"text","value":"Allmandring 30a"},{"field_id":"DE1-ProcurementProject-RealizedLocation-Address-CityName","lang":null,"ordinal":0,"type":"text","value":"Stuttgart"},{"code":"DEU","field_id":"DE1-ProcurementProject-RealizedLocation-Address-Country-IdentificationCode","list":null,"ordinal":0,"type":"code"},{"code":"DE111","field_id":"DE1-ProcurementProject-RealizedLocation-Address-CountrySubentityCode","ordinal":0,"scheme":"nuts","type":"classification"},{"field_id":"DE1-ProcurementProject-RealizedLocation-Address-PostalZone","lang":null,"ordinal":0,"type":"text","value":"70569"},{"field_id":"DE1-ProcurementProject-RealizedLocation-Address-StreetName","lang":null,"ordinal":0,"type":"text","value":"Universität Stuttgart - TIK"}]},{"kind":"SelectionCriteria","parent_section_id":"LOT-0001","section_id":"ND-SelectionCriteria#0","values":[{"field_id":"DE1-TenderingTerms-SelectionCriteria-Description","lang":"DEU","ordinal":0,"type":"text","value":"gemäß Bewerbungsbedingungen, sowie dem Anhang 1 - Angebotsformular\nEigenerklärung über den Gesamtumsatz des Unternehmens sowie Angabe des Umsatzes in den letzten 3 abgeschlossenen Geschäftsjahren, soweit er Leistungen betrifft, die mit der zu vergebenden Leistung vergleichbar sind unter Einschluss des Anteils bei gemeinsam mit anderen Unternehmen ausgeführten Leistungen,\nEigenerklärung aus der die durchschnittliche jährliche Beschäftigtenzahl in den letzten drei Geschäftsjahren (2021, 2022, 2023) ersichtlich sind."},{"field_id":"UBL-SelectionCriterionName","lang":"DEU","ordinal":0,"type":"text","value":"Wirtschaftliche und finanzielle Leistungsfähigkeit"},{"code":"ef-stand","field_id":"UBL-SelectionCriterionType","list":"selection-criterion","ordinal":0,"type":"code"}]},{"kind":"SelectionCriteria","parent_section_id":"LOT-0001","section_id":"ND-SelectionCriteria#1","values":[{"field_id":"DE1-TenderingTerms-SelectionCriteria-Description","lang":"DEU","ordinal":0,"type":"text","value":"Eigenerklärung zu Ausschlussgründen gemäß § 123 GWB, \nEigenerklärung zu Ausschlussgründen gemäß § 124 GWB,\nEigenerklärung gemäß § 19 Abs. 3 Mindestlohngesetz (MiLoG),\nEigenerklärung EU RUS Sanktionen\n\nWenn nach dem Recht des Herkunftsstaates des Bewerbers/Bieters für die Ausübung der ausgeschriebenen Tätigkeit eine Zulassung (Erlaubnis, Genehmigung, Konzession, oder Eintragung in einem Register) erforderlich ist,\nist dies mit dem Teilnahmeantrag/Angebot mitzuteilen. Der entsprechende Nachweis ist nach der Wahl des Bewerbers/Bieters mit einer Eigenerklärung oder dem nach dem Recht des Herkunftsstaates des Unternehmens maßgeblichen Dokument zu führen (z. B. Eintragung des Unternehmens in das Berufs- oder Handelsregister)."},{"field_id":"UBL-SelectionCriterionName","lang":"DEU","ordinal":0,"type":"text","value":"Eignung zur Berufsausübung"},{"code":"sui-act","field_id":"UBL-SelectionCriterionType","list":"selection-criterion","ordinal":0,"type":"code"}]},{"kind":"SelectionCriteria","parent_section_id":"LOT-0001","section_id":"ND-SelectionCriteria#2","values":[{"field_id":"DE1-TenderingTerms-SelectionCriteria-Description","lang":"DEU","ordinal":0,"type":"text","value":"gemäß Bewerbungsbedingungen, sowie dem Anhang 2 - Leistungsbeschreibung\nEigenerklärung über erbrachte Leistungen, die mit der zu vergebenden Leistung vergleichbar sind aus den letzten drei Geschäftsjahren\nDie Erklärung über Referenzleistungen muss jeweils folgende Angaben enthalten:\n- Bezeichnung des Auftrags\n- Auftraggeber (Anschrift, Kontaktmöglichkeit, Funktionsmail)\n- Kurze Beschreibung des Leistungsumfangs\n- Leistungszeitraum\n- Auftragssumme\nDie Vorlage von mehr als drei Referenzen ist nicht erwünscht."},{"field_id":"UBL-SelectionCriterionName","lang":"DEU","ordinal":0,"type":"text","value":"Technische und berufliche Leistungsfähigkeit"},{"code":"tp-abil","field_id":"UBL-SelectionCriterionType","list":"selection-criterion","ordinal":0,"type":"code"}]},{"kind":"SpecificTendererRequirement","parent_section_id":"ND-TendererQualificationRequest#0","section_id":"ND-SpecificTendererRequirement#0","values":[{"field_id":"DE1-TenderingTerms-TendererQualificationRequest-SpecificTendererRequirement-Description","lang":"DEU","ordinal":0,"type":"text","value":"Zwingende bzw. fakultative Ausschlu