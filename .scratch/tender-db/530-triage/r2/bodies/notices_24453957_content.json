xt","value":"50170"},{"field_id":"BT-5131-Lot","lang":null,"ordinal":0,"type":"text","value":"Kerpen"},{"code":"DEU","field_id":"BT-5141-Lot","list":null,"ordinal":0,"type":"code"}]},{"kind":"LotProcurementDocument","parent_section_id":"LOT-0001","section_id":"ND-LotProcurementDocument#0","values":[{"code":"non-restricted-document","field_id":"BT-14-Lot","list":null,"ordinal":0,"type":"code"},{"field_id":"BT-15-Lot","lang":null,"ordinal":0,"type":"text","value":"https://www.vmp-rheinland.de/VMPSatellite/notice/CXT2YY4Y1T2PCR12/documents"},{"code":"DEU","field_id":"BT-708-Lot","list":null,"ordinal":0,"type":"code"},{"field_id":"OPT-140-Lot","is_ref":false,"ordinal":0,"scheme":null,"type":"id","value":"SomeTenderDocID1"}]},{"kind":"ProcedureAdditionalCommodityClassification","parent_section_id":"PROCEDURE","section_id":"ND-ProcedureAdditionalCommodityClassification#0","values":[{"code":"79710000","field_id":"BT-263-Procedure","ordinal":0,"scheme":"cpv","type":"classification"}]},{"kind":"ProcedureAdditionalCommodityClassification","parent_section_id":"PROCEDURE","section_id":"ND-ProcedureAdditionalCommodityClassification#1","values":[{"code":"79714000","field_id":"BT-263-Procedure","ordinal":0,"scheme":"cpv","type":"classification"}]},{"kind":"ProcedureMainClassification","parent_section_id":"PROCEDURE","section_id":"ND-ProcedureMainClassification#0","values":[{"code":"79700000","field_id":"BT-262-Procedure","ordinal":0,"scheme":"cpv","type":"classification"}]},{"kind":"ProcedurePlacePerformanceAdditionalInformation","parent_section_id":"PROCEDURE","section_id":"ND-ProcedurePlacePerformanceAdditionalInformation#0","values":[{"code":"DEA27","field_id":"BT-5071-Procedure","ordinal":0,"scheme":"nuts","type":"classification"},{"field_id":"BT-5101(a)-Procedure","lang":null,"ordinal":0,"type":"text","value":"Bruchhöhe 22"},{"field_id":"BT-5121-Procedure","lang":null,"ordinal":0,"type":"text","value":"50170"},{"field_id":"BT-5131-Procedure","lang":null,"ordinal":0,"type":"text","value":"Kerpen"},{"code":"DEU","field_id":"BT-5141-Procedure","list":null,"ordinal":0,"type":"code"}]},{"kind":"SelectionCriteria","parent_section_id":"LOT-0001","section_id":"ND-SelectionCriteria#0","values":[{"code":"ef-stand","field_id":"BT-747-Lot","list":"selection-criterion","ordinal":0,"type":"code"},{"field_id":"BT-750-Lot","lang":"DEU","ordinal":0,"type":"text","value":"Einzureichende Unterlagen:\n- Eigenerklärung über den Gesamtumsatz sowie den Umsatz zu mit dem zu vergebenden Auftrag vergleichbaren Leistungen des Unternehmens, jeweils bezogen auf die letzten drei abgeschlossenen Geschäftsjahre (2021, 2022, 2023); (Vordruck Angebotsformblatt)\n\nMindestanforderung:\nDer Bieter muss im Durchschnitt der letzten drei abgeschlossenen Geschäftsjahre (2021, 2022, 2023) einen Nettojahresgesamtumsatz von 300.000 EUR erzielt haben)\n\n- Unbedenklichkeitsbescheinigung der Berufsgenossenschaft (auf Anforderung der Vergabestelle mittels Dritterklärung vorzulegen): Die Bescheinigung muss zum Zeitpunkt der Vorlage gültig sein. Sofern kein Datum vorgegeben ist, darf die Bescheinigung nicht älter als ein Jahr sein."},{"field_id":"UBL-SelectionCriterionName","lang":"DEU","ordinal":0,"type":"text","value":"Wirtschaftliche und finanzielle Leistungsfähigkeit"}]},{"kind":"SelectionCriteria","parent_section_id":"LOT-0001","section_id":"ND-SelectionCriteria#1","values":[{"code":"other","field_id":"BT-747-Lot","list":"selection-criterion","ordinal":0,"type":"code"},{"field_id":"BT-750-Lot","lang":"DEU","ordinal":0,"type":"text","value":"Einzureichende Unterlagen:\n    - inhaltliches Angebot (LV mit Angebotspreisen als PDF) (mit dem Angebot vorzulegen)"},{"field_id":"UBL-SelectionCriterionName","lang":"DEU","ordinal":0,"type":"text","value":"Sonstiges"}]},{"kind":"SelectionCriteria","parent_section_id":"LOT-0001","section_id":"ND-SelectionCriteria#2","values":[{"code":"sui-act","field_id":"BT-747-Lot","list":"selection-criterion","ordinal":0,"type":"code"},{"field_id":"BT-750-Lot","lang":"DEU","ordinal":0,"type":"text","value":"Einzureichende Unterlagen:\n    - Angebotsformblatt (mit dem Angebot mittels Eigenerklärung vorzulegen): - Allgemeine Unternehmensdarstellung / Firmenprofil"},{"field_id":"UBL-SelectionCriterionName","lang":"DEU","ordinal":0,"type":"text","value":"Eignung zur Berufsausübung"}]},{"kind":"SelectionCriteria","parent_section_id":"LOT-0001","section_id":"ND-SelectionCriteria#3","values":[{"code":"tp-abil","field_id":"BT-747-Lot","list":"selection-criterion","ordinal":0,"type":"code"},{"field_id":"BT-750-Lot","lang":"DEU","ordinal":0,"type":"text","value":"- Der Auftragnehmer weist vor Vertragsabschluss für sich und die in seinem Gewerbebetrieb beschäftigten Personen zur Deckung der Schäden, die dem Auftraggeber oder Dritten bei der Durchführung der Sicherheitsdienstleistungen entstehen, das Bestehen einer Betriebshaftpflichtversicherung nach. Für die Dauer der Vertragslaufzeit muss diese aufrechterhalten werden. \nDie Betriebshaftpflichtversicherung ist mit folgenden Mindestdeckungssummen abzuschließen:\n3.000.000 EUR Personenschäden\n   500.000 EUR sonstige Schäden\n\n- Erlaubnis zur Ausübung des Bewachungsgewerbes im Sinne des § 34a GewO (Bieter mit Sitz außerhalb Deutschlands haben eine gleichwertige Bescheinigung oder Urkunde einer zuständigen Gerichts- oder Verwaltungsbehörde des Herkunftslandes beizufügen.).\n\n- Nachweis des Auftragnehmers, dass eine Zertifizierung nach Qualitätsmanagement ISO 9001 sowie der DIN 77200 vorliegt (oder gleichwertig)\n\n- Mindestens zwei Referenzen aus den letzten drei Kalenderjahren (2021, 2022, 2023) oder dem Jahr 2024 über die Erbringung von vergleichbaren Sicherheitsdienstleistungen (Vordruck Angebotsformblatt)\nDie Vergleichbarkeit der erbrachten Sicherheitsdienstleistungen setzt voraus, dass der Bieter dort hauptverantwortlich die Sicherheitsdienstleistungen für mindestens 6 Monaten (zum Zeitpunkt Ablauf der Angebotsfrist) organisiert/e und erbringt/erbrachte (kein Nachunternehmen eines anderen Sicherheitsdienstleisters. Es werden nur Referenzen für Sicherheitsdienstleistungen in Einrichtungen zur Unterbringung von Asylbewerbern mit mindestens 100 Personen (Regelbelegung) berücksichtigt.\n\n- Angabe der Anzahl der aktuell bei Ablauf der Angebotsfrist fest angestellten Beschäftigten in der Sicherheits- und Bewachungssparte, aufgegliedert nach Berufsgruppen (Meister für Schutz und Sicherheit, Fachkraft für Schutz und Sicherheit, Geprüfte Schutz und Sicherheitskraft, Personen mit Sachkundeprüfung im Bewachungsgewerbe gem. § 34a GewO, sonstige Sicherheitsmitarbeiter, Auszubildende, kaufm. Angestellte, sonstige Angestellte) (Vordruck Angebotsformblatt)\n\nMindestanforderungen:\nDer Bieter muss bei Ablauf der Angebotsfrist über mindestens 20 Beschäftigte, die mindestens über eine der nachfolgenden Qualifikationen aufweist, verfügen: Meister für Schutz und Sicherheit, Fachkraft für Schutz und Sicherheit, geprüfte Schutzund Sicherheitskraft, Sachkundeprüfung im Bewachungsgewerbe gem. § 34a GewO (oder gleichwertiger Abschluss)."},{"field_id":"UBL-SelectionCriterionName","lang":"DEU","ordinal":0,"type":"text","value":"Technische und berufliche Leistungsfähigkeit"}]},{"kind":"ServiceProviderParty","parent_section_id":"ND-ContractingParty#0","section_id":"ND-ServiceProviderParty#0","values":[{"code":"ted-esen","field_id":"OPT-030-Procedure-SProvider","list":"organisation-role","ordinal":0,"type":"code"},{"field_id":"OPT-300-Procedure-SProvider","is_ref":true,"ordinal":0,"scheme":"organization","type":"id","value":"ORG-0007"}]},{"kind":"StrategicProcurementType","parent_section_id":"LOT-0001","section_id":"ND-StrategicProcurementType#0","values":[{"code":"none","field_id":"BT-06-Lot","list":"strategic-procurement","ordinal":0,"type":"code"}]},{"kind":"Organization","parent_section_id":"PROCEDURE","section_id":"ORG-0001","values":[{"field_id":"BT-500-Organization-Company","lang":"DEU","ordinal":0,"type":"text","value":"Kolpingstadt Kerpen"},{"field_i