e","list":"eu-official-language","ordinal":0,"type":"code"},{"code":"16","field_id":"DE1-NoticeSubType-SubTypeCode","list":"notice-subtype","ordinal":0,"type":"code"},{"code":"cn-standard","field_id":"DE1-NoticeTypeCode","list":"competition","ordinal":0,"type":"code"},{"field_id":"DE1-ProcurementProject-ContractExtension-MaximumNumberNumeric","ordinal":0,"type":"number","unit":null,"value":2.0},{"field_id":"DE1-ProcurementProject-ContractExtension-Renewal-Period-Description","lang":"DEU","ordinal":0,"type":"text","value":"Die Vertragslaufzeit kann optional zwei Mal um jeweils 12 Monate oder einmal um 24 Monate (insgesamt max. 48 Monate Vertragslaufzeit) verlängert werden."},{"field_id":"DE1-ProcurementProject-Description","lang":"DEU","ordinal":0,"type":"text","value":"Rahmenvertrag für Lieferungen von Arbeitsplatzendgeräten (Clients)."},{"field_id":"DE1-ProcurementProject-ID","is_ref":false,"ordinal":0,"scheme":"internalID","type":"id","value":"2024 Dez03 - 030"},{"code":"30000000","field_id":"DE1-ProcurementProject-MainCommodityClassification-ItemClassificationCode","ordinal":0,"scheme":"cpv","type":"classification"},{"field_id":"DE1-ProcurementProject-Name","lang":"DEU","ordinal":0,"type":"text","value":"Ausschreibung eines Rahmenvertrages für Clients"},{"field_id":"DE1-ProcurementProject-Note","lang":"DEU","ordinal":0,"type":"text","value":"Bekanntmachungs-ID: CXS0YDGY1V9VZKV9\n\n\nEs erfolgt keine postalische oder elektronische Übersendung der Vergabeunterlagen. Sie stehen im Portal zum Download bereit.\nFragen zum Verfahren werden ausschließlich schriftlich über das Kommunikationsforum in diesem Portal unter Wahrung der Anonymität des Fragestellers, allen Bewerbern/Bietern\nbeantwortet. Es gelten die Vertragsbedingungen des Landes NRW.\n\nDer Auftraggeber behält sich vor, Teststellungen durchzuführen.\n\nBei elektronischen Angeboten ist die durch das Vergaberecht geforderte Vertraulichkeit durch Verschlüsselung sicherzustellen. Ein unverschlüsselt eingereichtes elektronisches Angebot ist zwingend vom Vergabeverfahren auszuschließen.\nEine Angebotsabgabe per E-Mail wird nicht akzeptiert.\n\nSeit dem 01.01.2023 gilt das Lieferkettensorgfaltspflichtengesetz (LkSG). Dieses verpflichtet Unternehmen ab 1000 Mitarbeitenden zur Umsetzung der dort genannten Vorgaben. Diese umfassen unter anderem die Einhaltung von Menschen- und Umweltrechten in der Lieferkette. D.h., unmittelbare Zulieferer (dies können auch Dienstleister sein) müssen so ausgewählt werden, dass diese keine der im LkSG benannten Rechte beeinträchtigen.\n\nDie Zuschlagserteilung erfolgt vorbehaltlich der Verfügbarkeit der erforderlichen Mittel."},{"field_id":"DE1-ProcurementProject-PlannedPeriod-DurationMeasure","ordinal":0,"type":"number","unit":"MONTH","value":24.0},{"code":"supplies","field_id":"DE1-ProcurementProject-ProcurementTypeCode","list":"contract-nature","ordinal":0,"type":"code"},{"field_id":"DE1-ProcurementProject-SMESuitableIndicator","ordinal":0,"type":"integer","value":1},{"field_id":"DE1-RegulatoryDomain","lang":null,"ordinal":0,"type":"text","value":"32014L0024"},{"field_id":"DE1-RequestedPublicationDate","ordinal":0,"type":"date","value":"2024-10-29"},{"field_id":"DE1-TenderingProcess-AccessToolsURI","lang":null,"ordinal":0,"type":"text","value":"https://www.evergabe.nrw.de/VMPSatellite/notice/CXS0YDGY1V9VZKV9"},{"field_id":"DE1-TenderingProcess-AuctionTerms-AuctionConstraintIndicator","ordinal":0,"type":"integer","value":0},{"field_id":"DE1-TenderingProcess-FrameworkAgreement-Justification","lang":"DEU","ordinal":0,"type":"text","value":"..."},{"field_id":"DE1-TenderingProcess-FrameworkAgreement-MaximumOperatorQuantity","ordinal":0,"type":"number","unit":null,"value":1.0},{"code":"open","field_id":"DE1-TenderingProcess-ProcedureCode","list":"procurement-procedure-type","ordinal":0,"type":"code"},{"field_id":"DE1-TenderingTerms-AppealTerms-AppealReceiverParty-PartyIdentification-ID","is_ref":true,"ordinal":0,"scheme":"organization","type":"id","value":"ORG-0003"},{"field_id":"DE1-TenderingTerms-CallForTendersDocumentReference-DocumentType","lang":null,"ordinal":0,"type":"text","value":"non-restricted-document"},{"field_id":"DE1-TenderingTerms-CallForTendersDocumentReference-ID","is_ref":false,"ordinal":0,"scheme":null,"type":"id","value":"SomeTenderDocID1"},{"field_id":"DE1-TenderingTerms-CallForTendersDocumentReference-LanguageID","is_ref":false,"ordinal":0,"scheme":null,"type":"id","value":"DEU"},{"code":"no-eu-funds","field_id":"DE1-TenderingTerms-FundingProgramCode","list":"eu-funded","ordinal":0,"type":"code"},{"code":"false","field_id":"DE1-TenderingTerms-RequiredFinancialGuarantee-GuaranteeTypeCode","list":"tender-guarantee-required","ordinal":0,"type":"code"},{"field_id":"DE1-TenderingTerms-TenderRecipientParty-PartyIdentification-ID","is_ref":true,"ordinal":0,"scheme":null,"type":"id","value":"ORG-0004"},{"field_id":"DE1-TenderingTerms-TenderValidityPeriod-DurationMeasure","ordinal":0,"type":"number","unit":"DAY","value":51.0},{"field_id":"DE1-UBLVersionID","is_ref":false,"ordinal":0,"scheme":null,"type":"id","value":"2.3"},{"field_id":"DE1-VersionID","is_ref":false,"ordinal":0,"scheme":null,"type":"id","value":"01"}]}]}