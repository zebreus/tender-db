ization","ordinal":0,"type":"integer","value":0},{"field_id":"OPT-200-Organization-Company","is_ref":false,"ordinal":0,"scheme":"organization","type":"id","value":"ORG-7001"}]},{"kind":"Organization","parent_section_id":"PROCEDURE","section_id":"ORG-7004","values":[{"field_id":"BT-500-Organization-Company","lang":"DEU","ordinal":0,"type":"text","value":"Vergabekammer des Bundes beim Bundeskartellamt"},{"field_id":"BT-505-Organization-Company","lang":null,"ordinal":0,"type":"text","value":"https://www.bundeskartellamt.de/DE/Vergaberecht/vergaberecht_node.html"},{"field_id":"BT-506-Organization-Company","lang":null,"ordinal":0,"type":"text","value":"vk@bundeskartellamt.bund.de"},{"code":"DEA22","field_id":"BT-507-Organization-Company","ordinal":0,"scheme":"nuts","type":"classification"},{"field_id":"BT-510(a)-Organization-Company","lang":null,"ordinal":0,"type":"text","value":"Villemombler Straße 76"},{"field_id":"BT-512-Organization-Company","lang":null,"ordinal":0,"type":"text","value":"53123"},{"field_id":"BT-513-Organization-Company","lang":null,"ordinal":0,"type":"text","value":"Bonn"},{"code":"DEU","field_id":"BT-514-Organization-Company","list":"country","ordinal":0,"type":"code"},{"field_id":"OPT-200-Organization-Company","is_ref":false,"ordinal":0,"scheme":"organization","type":"id","value":"ORG-7004"}]},{"kind":"Part","parent_section_id":"PROCEDURE","section_id":"PAR-0000","values":[{"field_id":"BT-115-Part","ordinal":0,"type":"integer","value":1},{"field_id":"BT-137-Part","is_ref":false,"ordinal":0,"scheme":"Part","type":"id","value":"PAR-0000"},{"field_id":"BT-21-Part","lang":"DEU","ordinal":0,"type":"text","value":"Parkplatzsteuerung Lkw-Kolonnenparken"},{"code":"services","field_id":"BT-23-Part","list":"contract-nature","ordinal":0,"type":"code"},{"field_id":"BT-24-Part","lang":"DEU","ordinal":0,"type":"text","value":"Das Bundesministerium für Verkehr (BMV) und die Autobahn GmbH des Bundes verfolgen das Ziel, die Verfügbarkeit von Lastkraftwagen (Lkw)-Parkständen an Autobahnrastanlagen durch den verstärkten Einsatz telematischer Parkverfahren auf 50 Rastanlagen weiter zu erhöhen. Gegenstand der mit dieser Vorinformation angekündigten Ausschreibung ist die Bereitstellung der dafür benötigten Soft- und Hardware und deren Betrieb."},{"code":"72260000","field_id":"BT-262-Part","ordinal":0,"scheme":"cpv","type":"classification"},{"cents":300000000,"currency":"EUR","field_id":"BT-27-Part","ordinal":0,"type":"amount"},{"field_id":"BT-300-Part","lang":"DEU","ordinal":0,"type":"text","value":"#Besonders auch geeignet für:other-sme#Wegen des anspruchsvollen Zeitplans (10 Rastanlagen bereits in 2027) und zur Qualität der Leistungserbringung werden die Bieter bereits im Vergabeverfahren aufgefordert werden, praktisch nutzbare Algorithmen sowie eine Entwurfsfassung ihrer Software zu Wertungszwecken vorzulegen. Interessenten werden gebeten, dies für ihre Verfahrensbeteiligung einzuplanen. Weitergehende Informationen zu den Anforderungen an die zu Wertungszwecken im Vergabeverfahren vorzulegende Software erhalten an der Ausschreibung interessierte Unternehmen unter der Funktionsadresse kctp@autobahn.de bis zum Zeitpunkt der Bekanntmachung des Vergabeverfahrens."},{"field_id":"BT-36-Part","ordinal":0,"type":"number","unit":"MONTH","value":90.0},{"field_id":"BT-726-Part","ordinal":0,"type":"integer","value":1},{"code":"no","field_id":"BT-736-Part","list":"reserved-execution","ordinal":0,"type":"code"},{"code":"fa-wo-rc","field_id":"BT-765-Part","list":"framework-agreement","ordinal":0,"type":"code"},{"code":"none","field_id":"BT-766-Part","list":"dps-usage","ordinal":0,"type":"code"},{"field_id":"OPT-301-Part-AddInfo","is_ref":true,"ordinal":0,"scheme":"organization","type":"id","value":"ORG-7001"},{"field_id":"OPT-301-Part-ReviewOrg","is_ref":true,"ordinal":0,"scheme":"organization","type":"id","value":"ORG-7004"},{"field_id":"OPT-301-Part-TenderReceipt","is_ref":true,"ordinal":0,"scheme":"organization","type":"id","value":"ORG-7001"}]},{"kind":"Notice","parent_section_id":null,"section_id":"PROCEDURE","values":[{"code":"32014L0024","field_id":"BT-01-notice","list":null,"ordinal":0,"type":"code"},{"code":"pin-only","field_id":"BT-02-notice","list":"planning","ordinal":0,"type":"code"},{"field_id":"BT-05(a)-notice","ordinal":0,"type":"date","value":"2026-10-16T17:28:28+02:00"},{"field_id":"BT-127-notice","ordinal":0,"type":"date","value":"2026-11-17"},{"field_id":"BT-21-Procedure","lang":"DEU","ordinal":0,"type":"text","value":"Parkplatzsteuerung Lkw-Kolonnenparken"},{"field_id":"BT-22-Procedure","is_ref":false,"ordinal":0,"scheme":null,"type":"id","value":"BEK-2026-0083"},{"code":"services","field_id":"BT-23-Lot","list":"contract-nature","ordinal":0,"type":"code"},{"field_id":"BT-24-Procedure","lang":"DEU","ordinal":0,"type":"text","value":"Das Bundesministerium für Verkehr (BMV) und die Autobahn GmbH des Bundes verfolgen das Ziel, die Verfügbarkeit von Lastkraftwagen (Lkw)-Parkständen an Autobahnrastanlagen durch den verstärkten Einsatz telematischer Parkverfahren auf bis zu 50 Rastanlagen weiter zu erhöhen. Gegenstand der angekündigten Ausschreibung ist die Erstellung und der Betrieb der Übergeordneten Parkplatzsteuerung (Hard- und Software). Geplant ist, im Jahr 2027 10 Rastanlagen, im Jahr 2028 und 2029 je 20 Rastanlagen auf Kolonnenparken umzustellen. Diese Planzahlen sind unverbindlich; Änderungen bleiben vorbehalten."},{"code":"72260000","field_id":"BT-262-Procedure","ordinal":0,"scheme":"cpv","type":"classification"},{"cents":300000000,"currency":"EUR","field_id":"BT-27-Procedure","ordinal":0,"type":"amount"},{"field_id":"BT-300-Procedure","lang":"DEU","ordinal":0,"type":"text","value":"Das Vergabeverfahren wird voraussichtlich als Verhandlungsverfahren mit Teilnahmewettbewerb durchgeführt (§ 17 VgV i. V. m. § 119 GWB). Die Bekanntmachung wird voraussichtlich am 17.11.2026 veröffentlicht."},{"field_id":"BT-701-notice","is_ref":false,"ordinal":0,"scheme":"notice-id","type":"id","value":"01c73b20-1ea0-4e8e-91b5-ef66d98035a5"},{"code":"DEU","field_id":"BT-702(a)-notice","list":"language","ordinal":0,"type":"code"},{"field_id":"BT-738-notice","ordinal":0,"type":"date","value":"2026-10-16"},{"field_id":"BT-757-notice","is_ref":false,"ordinal":0,"scheme":null,"type":"id","value":"01"},{"code":"4","field_id":"OPP-070-notice","list":"notice-subtype","ordinal":0,"type":"code"},{"field_id":"OPT-001-notice","is_ref":false,"ordinal":0,"scheme":null,"type":"id","value":"2.3"},{"field_id":"OPT-002-notice","is_ref":false,"ordinal":0,"scheme":null,"type":"id","value":"eforms-de-2.1"},{"field_id":"OPT-002-notice-DET","is_ref":false,"ordinal":0,"scheme":null,"type":"id","value":"eforms-sdk-1.13"}]}]}