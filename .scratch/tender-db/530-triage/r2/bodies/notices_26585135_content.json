anizations-Organization-Company-PostalAddress-StreetName","lang":null,"ordinal":0,"type":"text","value":"Balhorner Feld 18"},{"field_id":"DE1-Organizations-Organization-ListedOnRegulatedMarketIndicator","ordinal":0,"type":"integer","value":0}]},{"kind":"Notice","parent_section_id":null,"section_id":"PROCEDURE","values":[{"field_id":"DE1-ContractFolderID","is_ref":false,"ordinal":0,"scheme":null,"type":"id","value":"6a3c568f-6e52-460a-8a4f-005c762435c7"},{"field_id":"DE1-CustomizationID","is_ref":false,"ordinal":0,"scheme":null,"type":"id","value":"eforms-de-1.1"},{"field_id":"DE1-ID","is_ref":false,"ordinal":0,"scheme":"notice-id","type":"id","value":"9f11a6b8-a894-4aa8-a307-fdbc55258aef"},{"field_id":"DE1-IssueDate","ordinal":0,"type":"date","value":"2025-02-24T15:46:54+01:00"},{"code":"DEU","field_id":"DE1-NoticeLanguageCode","list":"eu-official-language","ordinal":0,"type":"code"},{"cents":95282840,"currency":"EUR","field_id":"DE1-NoticeResult-TotalAmount","ordinal":0,"type":"amount"},{"code":"29","field_id":"DE1-NoticeSubType-SubTypeCode","list":"notice-subtype","ordinal":0,"type":"code"},{"code":"can-standard","field_id":"DE1-NoticeTypeCode","list":"result","ordinal":0,"type":"code"},{"field_id":"DE1-ProcurementProject-ContractExtension-MaximumNumberNumeric","ordinal":0,"type":"number","unit":null,"value":0.0},{"field_id":"DE1-ProcurementProject-Description","lang":"DEU","ordinal":0,"type":"text","value":"Heizung - Kälte"},{"field_id":"DE1-ProcurementProject-ID","is_ref":false,"ordinal":0,"scheme":"internalID","type":"id","value":"DMT-BAC-0007"},{"code":"45331000","field_id":"DE1-ProcurementProject-MainCommodityClassification-ItemClassificationCode","ordinal":0,"scheme":"cpv","type":"classification"},{"field_id":"DE1-ProcurementProject-Name","lang":"DEU","ordinal":0,"type":"text","value":"Heizung - Kälte"},{"field_id":"DE1-ProcurementProject-Note","lang":"DEU","ordinal":0,"type":"text","value":"Bekanntmachungs-ID: CXVHYYJYTHXRJWCL\n\n\nZu Auskünften zum Vergabeverfahren:\n-------------------------------------------------------\nBitte beachten Sie, dass die Vergabestelle Anfragen per Email oder Fax nicht berücksichtigt oder per Email beantwortet. Die Vergabestelle wickelt all ihre Vergaben über die Vergabeplattform ab. Um die Unversehrtheit, die Vertraulichkeit und die Echtheit der Daten zu gewährleisten, verwendet die Vergabestelle für das Senden, Empfangen, Weiterleiten und Speichern von Daten in allen Vergabeverfahren  ausschließlich die Kommunikationsfunktion des Vergabemarktplatz Westfalen (§ 11a EU VOB/A). Siehe auch \"Kommunikation\" in VVB 211 - Aufforderung zur Abgabe eines Angebots. Auskünfte werden bis zur Frist zur Einreichung von Aufklärungsfragen angenommen.\nAlle Bieterfragen die bis zum 02.12.2024 bei uns eingehen werden rechtzeitig vor Angebotsfrist beantwortet.\nEs wird an der Kommunikation über die Funktion des Vergabemarktplatzes bis zur Zuschlagerteilung festgehalten. Insofern muss der Bewerber/Bieter auch nach Angebotsabgabe die Nachrichten des Vergabemarktplatzes über den Eingang von Nachrichten auf dem Vergabemarktplatz beachten.\n\nForm der Angebote:\n-------------------------------------------------------\nNeben den Bestimmungen des § 13 EU Abs. 1 Nr. 6 VOB/A sind die Angebot in einem allgemeingültigen Format einzureichen. Die Allgemeingültigkeit wird erfüllt mit folgenden Formaten:\nPDF-Datei: Portable Document Format, plattformunabhängiges Dateiformat für Dokumente\nGAEB-X84-Datei: X84 Angebotsabgabe - Die Bieter, die sich an dem Angebotsverfahren beteiligen, ergänzen das Leistungsverzeichnis mit ihren Preisen und Bietertextergänzungen\nGEAB DA84-Datei: D84 wie vor, jedoch älteres Format."},{"field_id":"DE1-ProcurementProject-PlannedPeriod-EndDate","ordinal":0,"type":"date","value":"2026-09-08"},{"field_id":"DE1-ProcurementProject-PlannedPeriod-StartDate","ordinal":0,"type":"date","value":"2025-03-01"},{"code":"works","field_id":"DE1-ProcurementProject-ProcurementTypeCode","list":"contract-nature","ordinal":0,"type":"code"},{"cents":125015565,"currency":"EUR","field_id":"DE1-ProcurementProject-RequestedTenderTotal-EstimatedOverallContractAmount","ordinal":0,"type":"amount"},{"field_id":"DE1-RegulatoryDomain","lang":null,"ordinal":0,"type":"text","value":"32014L0024"},{"field_id":"DE1-RequestedPublicationDate","ordinal":0,"type":"date","value":"2025-02-24"},{"field_id":"DE1-TenderResult-AwardDate","ordinal":0,"type":"date","value":"2000-01-01"},{"field_id":"DE1-TenderingProcess-AuctionTerms-AuctionConstraintIndicator","ordinal":0,"type":"integer","value":0},{"code":"open","field_id":"DE1-TenderingProcess-ProcedureCode","list":"procurement-procedure-type","ordinal":0,"type":"code"},{"field_id":"DE1-TenderingTerms-AppealTerms-AppealInformationParty-PartyIdentification-ID","is_ref":true,"ordinal":0,"scheme":"organization","type":"id","value":"ORG-0004"},{"field_id":"DE1-TenderingTerms-AppealTerms-AppealReceiverParty-PartyIdentification-ID","is_ref":true,"ordinal":0,"scheme":"organization","type":"id","value":"ORG-0005"},{"field_id":"DE1-TenderingTerms-AppealTerms-MediationParty-PartyIdentification-ID","is_ref":true,"ordinal":0,"scheme":"organization","type":"id","value":"ORG-0006"},{"field_id":"DE1-TenderingTerms-AppealTerms-PresentationPeriod-Description","lang":"DEU","ordinal":0,"type":"text","value":"Nach § 160 Abs. 3 Nr. 1 bis 4 GWB ist ein Antrag auf Einleitung eines Nachprüfungsverfahrens unzulässig, soweit:\n1) der Antragsteller den geltend gemachten Verstoß gegen Vergabevorschriften vor Einreichen des Nachprüfungsantrags erkannt und gegenüber dem Auftraggeber nicht innerhalb einer Frist von zehn Kalendertagen gerügt hat; der Ablauf der Frist nach § 134 Absatz 2 bleibt unberührt,\n2) Verstöße gegen Vergabevorschriften, die aufgrund der Bekanntmachung erkennbar sind, nicht spätestens bis zum Ablauf der in der Bekanntmachung benannten Frist zur Bewerbung oder zur Angebotsabgabe gegenüber dem Auftraggeber gerügt werden,\n3) Verstöße gegen Vergabevorschriften, die erst in den Vergabeunterlagen erkennbar sind, nicht spätestens bis zum Ablauf der Frist zur Bewerbung oder zur Angebotsabgabe gegenüber dem Auftraggeber gerügt werden,\n4) mehr als 15 Kalendertage nach Eingang der Mitteilung des Auftraggebers, einer Rüge nicht abhelfen zu wollen, vergangen sind.\nSatz 1 gilt nicht bei einem Antrag auf Feststellung der Unwirksamkeit des Vertrags nach § 135 Absatz 1 Nummer 2. § 134 Absatz 1 Satz 2 bleibt unberührt."},{"code":"no-eu-funds","field_id":"DE1-TenderingTerms-FundingProgramCode","list":"eu-funded","ordinal":0,"type":"code"},{"field_id":"DE1-UBLVersionID","is_ref":false,"ordinal":0,"scheme":null,"type":"id","value":"2.3"},{"field_id":"DE1-VersionID","is_ref":false,"ordinal":0,"scheme":null,"type":"id","value":"01"}]},{"kind":"LotResult","parent_section_id":"PROCEDURE","section_id":"RES-0001","values":[{"field_id":"DE1-NoticeResult-LotResult-DPSTerminationIndicator","ordinal":0,"type":"integer","value":0},{"cents":134672173,"currency":"EUR","field_id":"DE1-NoticeResult-LotResult-HigherTenderAmount","ordinal":0,"type":"amount"},{"field_id":"DE1-NoticeResult-LotResult-ID","is_ref":false,"ordinal":0,"scheme":null,"type":"id","value":"RES-0001"},{"cents":95282840,"currency":"EUR","field_id":"DE1-NoticeResult-LotResult-LowerTenderAmount","ordinal":0,"type":"amount"},{"field_id":"DE1-NoticeResult-LotResult-TenderLot-ID","is_ref":false,"ordinal":0,"scheme":"Lot","type":"id","value":"LOT-0001"},{"code":"selec-w","field_id":"DE1-NoticeResult-LotResult-TenderResultCode","list":"winner-selection-status","ordinal":0,"type":"code"}]},{"kind":"LotTender","parent_section_id":"PROCEDURE","section_id":"TEN-0001","values":[{"field_id":"DE1-NoticeResult-LotTender-ID","is_ref":false,"ordinal":0,"scheme":"tender","type":"id","value":"TEN-0001"},{"cents":95282840,"currency":"EUR","field_id":"DE1-NoticeResult-LotTender-LegalMonetaryTotal-PayableAmount","ordinal":0,"type":"amount"},{"code":"not-known","field_id":"DE1-NoticeResult-LotTender-Su