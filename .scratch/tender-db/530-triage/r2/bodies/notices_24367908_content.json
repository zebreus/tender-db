ext","value":"https://www.vergaben-wirtschaftsregion-aachen.de/VMPSatellite/notice/CXVHYY5Y1PZ1GRMQ/documents"},{"code":"DEU","field_id":"BT-708-Lot","list":null,"ordinal":0,"type":"code"},{"field_id":"OPT-140-Lot","is_ref":false,"ordinal":0,"scheme":null,"type":"id","value":"SomeTenderDocID1"}]},{"kind":"ProcedureMainClassification","parent_section_id":"PROCEDURE","section_id":"ND-ProcedureMainClassification#0","values":[{"code":"71240000","field_id":"BT-262-Procedure","ordinal":0,"scheme":"cpv","type":"classification"}]},{"kind":"ProcedurePlacePerformanceAdditionalInformation","parent_section_id":"PROCEDURE","section_id":"ND-ProcedurePlacePerformanceAdditionalInformation#0","values":[{"code":"DEA26","field_id":"BT-5071-Procedure","ordinal":0,"scheme":"nuts","type":"classification"},{"field_id":"BT-5101(a)-Procedure","lang":null,"ordinal":0,"type":"text","value":"Verwaltung Düren"},{"field_id":"BT-5101(b)-Procedure","lang":null,"ordinal":0,"type":"text","value":"Eisenbahnstraße 5"},{"field_id":"BT-5121-Procedure","lang":null,"ordinal":0,"type":"text","value":"52352"},{"field_id":"BT-5131-Procedure","lang":null,"ordinal":0,"type":"text","value":"Düren"},{"code":"DEU","field_id":"BT-5141-Procedure","list":null,"ordinal":0,"type":"code"}]},{"kind":"SelectionCriteria","parent_section_id":"LOT-0001","section_id":"ND-SelectionCriteria#0","values":[{"code":"ef-stand","field_id":"BT-747-Lot","list":"selection-criterion","ordinal":0,"type":"code"},{"field_id":"BT-750-Lot","lang":"DEU","ordinal":0,"type":"text","value":"Einzureichende Unterlagen:\n    - Betriebshaftpflichtversicherung 3,0 Mio. EUR (mit dem Angebot mittels Dritterklärung vorzulegen): gültige Betriebshaftpflichtversicherung mit einer Deckungssumme von mind. 3,0 Mio. EUR. Der Auftragnehmer ist verpflichtet, zur Abdeckung seiner Haftung eine ausreichende Versicherung für Personen-, Sach- und Vermögensschäden abzuschließen und diese während der gesamten Laufzeit des zu schließenden Vertrages aufrecht zu erhalten.\nWährend der Vertragslaufzeit hat der Auftragnehmer dem Auftraggeber den Fortbestand der Versicherung jederzeit auf Verlangen nachzuweisen.\nDie v. g.  Deckungssumme bezieht sich auf die Höhe je Schadensfall und Abdeckung von mindestens 2 Schadenfällen je Jahr.\nDer Auftragnehmer hat sicherzustellen und auf Verlangen des Auftraggebers nachzuweisen, dass auch für die von Unterauftragnehmern durchgeführten Tätigkeiten der vorgenannte Versicherungsschutz besteht.\n\n\nDer Nachweis / die Erklärung sollte nicht älter als ein Jahr sein\n\n- Steuern, Abgaben & Sozialversicherungsbeiträge (DL) (mit dem Angebot mittels Dritterklärung vorzulegen): Nachweis, dass Steuern, Abgaben & Beiträge zur Sozialversicherung gezahlt wurden \n\nDie Nachweise / Erklärungen sollten nicht älter als ein Jahr sein\n\nBei Bietern, die in einem amtlichen Verzeichnis der Industrie- und Handelskammer eingetragen sind, wird gemäß § 35 Abs. 6 UVgO bzw. § 48 Abs. 8 VgV auf die Vorlage der vorgenannten Nachweise verzichtet, sofern in dem Angebotsschreiben (unter Nr. 3) die entsprechende Nummer und PIN angegeben wird und die v. g. Nachweise dort auch entsprechend hinterlegt sind."},{"field_id":"UBL-SelectionCriterionName","lang":"DEU","ordinal":0,"type":"text","value":"Wirtschaftliche und finanzielle Leistungsfähigkeit"}]},{"kind":"SelectionCriteria","parent_section_id":"LOT-0001","section_id":"ND-SelectionCriteria#1","values":[{"code":"other","field_id":"BT-747-Lot","list":"selection-criterion","ordinal":0,"type":"code"},{"field_id":"BT-750-Lot","lang":"DEU","ordinal":0,"type":"text","value":"Einzureichende Unterlagen:\n    - AVPQ-Nummer (EU) (mit dem Angebot mittels Eigenerklärung vorzulegen): Angabe der AVPQ-Nummer inkl. Zugangs-PIN im Angebotsschreiben (unter Nr. 3) oder Einheitliche Europäische Eigenerklärung\n- Schwere Verfehlung nach §§123, 124 GWB (mit dem Angebot mittels Eigenerklärung vorzulegen): Angabe, dass nachweislich keine schweren Verfehlungen gemäß §§ 123, 124 GWB begangen wurden, die die Zuverlässigkeit als Bewerber in Frage stellt und kein Ausschussgrund nach § 22 LkSG (Lieferkettensorgfaltspflichtengesetz) vorliegt."},{"field_id":"UBL-SelectionCriterionName","lang":"DEU","ordinal":0,"type":"text","value":"Sonstiges"}]},{"kind":"SelectionCriteria","parent_section_id":"LOT-0001","section_id":"ND-SelectionCriteria#2","values":[{"code":"tp-abil","field_id":"BT-747-Lot","list":"selection-criterion","ordinal":0,"type":"code"},{"field_id":"BT-750-Lot","lang":"DEU","ordinal":0,"type":"text","value":"Einzureichende Unterlagen:\n    - Beschäftigtenzahl (DL) (mit dem Angebot mittels Eigenerklärung vorzulegen): Anzahl der durchschnittlich jährlichen Beschäftigtenzahl inkl. Zahl der Führungskräfte der letzten 3 Jahre\n\nBei Bietern, die in einem amtlichen Verzeichnis der Industrie- und Handelskammer eingetragen sind, wird gemäß § 35 Abs. 6 UVgO bzw. § 48 Abs. 8 VgV auf die Vorlage der vorgenannten Nachweise verzichtet, sofern in dem Angebotsschreiben (unter Nr. 3) die entsprechende Nummer und PIN angegeben wird und die v. g. Nachweise dort auch entsprechend hinterlegt sind.\n- Referenzliste (mit dem Angebot vorzulegen): Referenzliste für Planung von Hochwasserschutzanlagen (besonders von Hochwasserschutzmauern) und Brückenbauwerken der letzten 5 Jahre"},{"field_id":"UBL-SelectionCriterionName","lang":"DEU","ordinal":0,"type":"text","value":"Technische und berufliche Leistungsfähigkeit"}]},{"kind":"ServiceProviderParty","parent_section_id":"ND-ContractingParty#0","section_id":"ND-ServiceProviderParty#0","values":[{"code":"ted-esen","field_id":"OPT-030-Procedure-SProvider","list":"organisation-role","ordinal":0,"type":"code"},{"field_id":"OPT-300-Procedure-SProvider","is_ref":true,"ordinal":0,"scheme":"organization","type":"id","value":"ORG-0006"}]},{"kind":"StrategicProcurementType","parent_section_id":"LOT-0001","section_id":"ND-StrategicProcurementType#0","values":[{"code":"none","field_id":"BT-06-Lot","list":"strategic-procurement","ordinal":0,"type":"c