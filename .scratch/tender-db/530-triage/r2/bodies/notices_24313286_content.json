:"BT-262-Procedure","ordinal":0,"scheme":"cpv","type":"classification"}]},{"kind":"ProcedurePlacePerformanceAdditionalInformation","parent_section_id":"PROCEDURE","section_id":"ND-ProcedurePlacePerformanceAdditionalInformation#0","values":[{"code":"DEA12","field_id":"BT-5071-Procedure","ordinal":0,"scheme":"nuts","type":"classification"},{"field_id":"BT-5101(a)-Procedure","lang":null,"ordinal":0,"type":"text","value":"Universität Duisburg-Essen"},{"field_id":"BT-5121-Procedure","lang":null,"ordinal":0,"type":"text","value":"47057"},{"field_id":"BT-5131-Procedure","lang":null,"ordinal":0,"type":"text","value":"Duisburg"},{"code":"DEU","field_id":"BT-5141-Procedure","list":null,"ordinal":0,"type":"code"}]},{"kind":"SelectionCriteria","parent_section_id":"LOT-0001","section_id":"ND-SelectionCriteria#0","values":[{"code":"ef-stand","field_id":"BT-747-Lot","list":"selection-criterion","ordinal":0,"type":"code"},{"field_id":"BT-750-Lot","lang":"DEU","ordinal":0,"type":"text","value":"Der Bieter hat mit dem Angebot einen Nachweis über den Abschluss einer Berufshaftpflichtversicherung\nmit folgenden Deckungssummen nachzuweisen:\n\nPersonenschäden, Sachschäden und Vermögensschäden 5 Mio. EUR je Schadensfall \n\nEs genügt die Vorlage einer Bescheinigung einer Versicherung, dass diese bereit ist, im Auftragsfall eine Versicherung mit den entsprechenden Deckungssummen mit dem Bewerber abzuschließen."},{"field_id":"UBL-SelectionCriterionName","lang":"DEU","ordinal":0,"type":"text","value":"Wirtschaftliche und finanzielle Leistungsfähigkeit"}]},{"kind":"SelectionCriteria","parent_section_id":"LOT-0001","section_id":"ND-SelectionCriteria#1","values":[{"code":"other","field_id":"BT-747-Lot","list":"selection-criterion","ordinal":0,"type":"code"},{"field_id":"BT-750-Lot","lang":"DEU","ordinal":0,"type":"text","value":"Eine Ortsbesichtigung ist zwingend erforderlich, um die Preise realistisch kalkulieren zu können. Das Formular Anlage 5: \"Besichtigung Duisburg\" muss bei der Besichtigung ausgefüllt und vom Vertreter der Hochschule und Vertreter des Unternehmens unterschrieben werden. Das unterschriebene Dokument ist mit dem Angebot einzureichen.\n\nDie Besichtigungen finden in der KW 42 statt. Die Terminabfrage erfolgt über den Vergabemarktplatz. Der Treffpunkt und  Besichtigungszeit wird bei der Terminabgabe genannt.\n\nAngebote von Unternehmen, die nicht an der Besichtigung teilgenommen haben, werden von Wertung ausgeschlossen."},{"field_id":"UBL-SelectionCriterionName","lang":"DEU","ordinal":0,"type":"text","value":"Sonstiges"}]},{"kind":"SelectionCriteria","parent_section_id":"LOT-0001","section_id":"ND-SelectionCriteria#2","values":[{"code":"tp-abil","field_id":"BT-747-Lot","list":"selection-criterion","ordinal":0,"type":"code"},{"field_id":"BT-750-Lot","lang":"DEU","ordinal":0,"type":"text","value":"a) Bitte reichen Sie zwei Referenzen aus den letzten drei Jahren ein, welche vergleichbar zur ausgeschriebenen Leistung sind. Die Vergleichbarkeit liegt dann vor, wenn es sich um die Erbringung von Glas- und Rahmenreinigung in vergleichbaren Objekten z:B Hochschulen, Verwaltungsgebäude, Sportstätten in zusammenhängende Flächen der vergleichbaren Größenordnung (mindestens 13.000 qm), handelt.\n\nDie Angaben zu den Referenzen beinhalten:\n\n- Bezeichnung und Beschreibung der ausgeführten Leistungen,\n\n- zusammenhängende gereinigte Fläche (Fläche einmalige Reinigung, nicht Fläche/Jahr),\n\n- Ausführungszeitraum,\n\n- Angabe zur vertraglichen Bindung (Hauptauftragnehmer, ARGE-Partner, Unterauftrag-nehmer),\n\n- Auftraggeber mit Kontaktdaten (E-Mail, Telefon) eines Ansprechpartners bei Auftrag-geber.\n\n Die personenbezogenen Kontaktdaten sind nur mit dem Einverständnis der Referenzgeber einzureichen. Ansonsten hinterlegen Sie bitte nur das Unternehmen und die entsprechende Abteilung. Sofern die angegebenen Referenzen im Rahmen der Überprüfung negativ auffallen, wird das Angebot nicht berücksichtigt. Die Anlage 4 Referenzbogen ist auszufüllen.\n\nb) Angabe der Anzahl der in den letzten drei abgeschlossenen Geschäftsjahren beschäftigten (festangestellten) Reinigungskräfte. Es müssen mindestens sechs Reinigungskräfte festangestellt sein."},{"field_id":"UBL-SelectionCriterionName","lang":"DEU","ordinal":0,"type":"text","value":"Technische und berufliche Leistungsfähigkeit"}]},{"kind":"ServiceProviderParty","parent_section_id":"ND-ContractingParty#0","section_id":"ND-ServiceProviderParty#0","values":[{"code":"ted-esen","field_id":"OPT-030-Procedure-SProvider","list":"organisation-role","ordinal":0,"type":"code"},{"field_id":"OPT-300-Procedure-SProvider","is_ref":true,"ordinal":0,"scheme":"organization","type":"id","value":"ORG-0005"}]},{"kind":"StrategicProcurementType","parent_section_id":"LOT-0001","section_id":"ND-StrategicProcurementType#0","values":[{"code":"none","field_id":"BT-06-Lot","list":"strategic-procurement","ordinal":0,"type":"code"}]},{"kind":"Organization","parent_section_id":"PROCEDURE","section_id":"ORG-0001","values":[{"field_id":"BT-500-Organization-Company","lang":"DEU","ordinal":0,"type":"text","value":"Universität Duisburg-Essen"},{"field_id":"BT-501-Organization-Company","is_ref":false,"ordinal":0,"scheme":null,"type":"id","value":"8a6e638f-b80f-4a95-a6fe-baf52a4459a3"},{"field_id":"BT-502-Organization-Company","lang":null,"ordinal":0,"type":"text","value":"Sachgebiet Einkauf"},{"field_id":"BT-503-Organization-Company","lang":null,"ordinal":0,"type":"text","value":"+49 2033790"},{"field_id":"BT-506-Organization-Company","lang":null,"ordinal":0,"type":"text","value":"einkauf@uni-due.de"},{"code":"DEA12","field_id":"BT-507-Organization-Company","ordinal":0,"scheme":"nuts","type":"classification"},{"field_id":"BT-510(a)-Organization-Company","lang":null,"ordinal":0,"type":"text","value":"Forsthausweg 2"},{"field_id":"BT-512-Organization-Company","lang":null,"ordinal":0,"type":"text","value":"47057"},{"field_id":"BT-513-Organization-Company","lang":null,"ordinal":0,"type":"text","value":"Du