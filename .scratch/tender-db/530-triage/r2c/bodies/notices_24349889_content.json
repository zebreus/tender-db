eld_id":"BT-58-Lot","ordinal":0,"type":"integer","value":0},{"code":"no-eu-funds","field_id":"BT-60-Lot","list":"eu-funded","ordinal":0,"type":"code"},{"code":"not-allowed","field_id":"BT-63-Lot","list":"permission","ordinal":0,"type":"code"},{"field_id":"BT-70-Lot","lang":"DEU","ordinal":0,"type":"text","value":"513 EU Vertragsbedingungen gemäß TVgG NRW\nVVB 214 Besondere Vertragsbedingungen."},{"code":"false","field_id":"BT-717-Lot","list":"cvd-scope","ordinal":0,"type":"code"},{"field_id":"BT-726-Lot","ordinal":0,"type":"integer","value":1},{"code":"no","field_id":"BT-736-Lot","list":"reserved-execution","ordinal":0,"type":"code"},{"code":"required","field_id":"BT-743-Lot","list":"einvoicing","ordinal":0,"type":"code"},{"field_id":"BT-75-Lot","lang":"DEU","ordinal":0,"type":"text","value":"Sicherheit für die Vertragserfüllung ist in Höhe von 5 v.H. der Auftragssumme zu leisten, sofern die Auftragssumme mindestens 250.000 Euro ohne Umsatzsteuer beträgt. \n\nDie für Mängelansprüche zu leistende Sicherheit  beträgt drei Prozent der Summe der Abschlagszahlungen zum Zeitpunkt der Abnahme (vorläufige Abrechnungssumme)."},{"code":"true","field_id":"BT-751-Lot","list":"tender-guarantee-required","ordinal":0,"type":"code"},{"field_id":"BT-76-Lot","lang":"DEU","ordinal":0,"type":"text","value":"Gesamtschuldnerisch haftend mit bevollmächtigtem Vertreter"},{"code":"true","field_id":"BT-761-Lot","list":"required","ordinal":0,"type":"code"},{"code":"not-allowed","field_id":"BT-764-Lot","list":"ecatalog-submission","ordinal":0,"type":"code"},{"code":"none","field_id":"BT-765-Lot","list":"framework-agreement","ordinal":0,"type":"code"},{"code":"none","field_id":"BT-766-Lot","list":"dps-usage","ordinal":0,"type":"code"},{"field_id":"BT-767-Lot","ordinal":0,"type":"integer","value":0},{"code":"not-allowed","field_id":"BT-769-Lot","list":"permission","ordinal":0,"type":"code"},{"field_id":"BT-77-Lot","lang":"DEU","ordinal":0,"type":"text","value":"siehe Besondere Vertragsbedingungen"},{"code":"late-all","field_id":"BT-771-Lot","list":"missing-info-submission","ordinal":0,"type":"code"},{"field_id":"BT-772-Lot","lang":"DEU","ordinal":0,"type":"text","value":"keine"},{"code":"clim-adapt","field_id":"BT-774-Lot","list":"environmental-impact","ordinal":0,"type":"code"},{"code":"clim-mitig","field_id":"BT-774-Lot","list":"environmental-impact","ordinal":1,"type":"code"},{"code":"pollu-prev","field_id":"BT-774-Lot","list":"environmental-impact","ordinal":2,"type":"code"},{"code":"work-cond","field_id":"BT-775-Lot","list":"social-objective","ordinal":0,"type":"code"},{"code":"not-requ","field_id":"BT-79-Lot","list":"requirement-stage","ordinal":0,"type":"code"},{"code":"DEU","field_id":"BT-97-Lot","list":null,"ordinal":0,"type":"code"},{"field_id":"BT-98-Lot","ordinal":0,"type":"number","unit":"DAY","value":53.0},{"field_id":"BT-99-Lot","lang":"DEU","ordinal":0,"type":"text","value":"Ein zulässiger Nachprüfungsantrag bei der zuständigen Vergabekammer kann bis zur wirksamen Zuschlagserteilung gestellt werden. Diese ist erst möglich, wenn die/der Auftraggeber/in die unterlegenen Bieter/innen über den Grund der vorgesehenen Nichtberücksichtigung ihres Angebots und den Namen der/des Bieters/in, deren/dessen Angebot angenommen werden soll, in Textform informiert hat und seit der Absendung dieser Information zehn (10) Kalendertage (bei Versand auf elektronischem Weg oder per Fax) vergangen sind (§ 134 Abs. 2 GWB).\nEin Nachprüfungsantrag ist unzulässig, soweit\n- die/der Antragsteller/in den geltend gemachten Verstoß gegen Vergaberechtsvorschriften schon vor Einreichen des Nachprüfungsantrages erkannt und gegenüber der/dem Auftraggeber/in nicht innerhalb einer Frist von zehn (10) Kalendertagen gerügt hat\noder\n- Verstöße gegen Vergaberechtsvorschriften, die aufgrund dieser Bekanntmachung oder erst in den Vergabeunterlagen erkennbar sind, nicht spätestens bis zum Ablauf der Frist zur Bewerbung oder zur Angebotsabgabe gerügt werden.\nTeilt die/der Auftraggeber/in einer/m Bewerber/in oder Bieter/in mit, dass sie/er einer Rüge nicht abhelfen will, so kann die/der betroffene Bewerber/in oder Bieter/in wegen dieser Rüge nur innerhalb von fünfzehn (15) Kalendertagen nach Eingang dieser Mitteilung einen zulässigen Nachprüfungsantrag stellen."},{"code":"performance","field_id":"OPT-060-Lot","list":"conditions","ordinal":0,"type":"code"},{"field_id":"OPT-301-Lot-AddInfo","is_ref":true,"ordinal":0,"scheme":null,"type":"id","value":"ORG-0002"},{"field_id":"OPT-301-Lot-ReviewInfo","is_ref":true,"ordinal":0,"scheme":"organization","type":"id","value":"ORG-0003"},{"field_id":"OPT-301-Lot-ReviewOrg","is_ref":true,"ordinal":0,"scheme":"organization","type":"id","value":"ORG-0004"},{"field_id":"OPT-301-Lot-TenderReceipt","is_ref":true,"ordinal":0,"scheme":null,"type":"id","value":"ORG-0005"},{"field_id":"UBL-ElectronicOrderUsage","ordinal":0,"type":"integer","value":1},{"field_id":"UBL-ElectronicPaymentUsage","ordinal":0,"type":"integer","value":1}]},{"kind":"ContractingParty","parent_section_id":"PROCEDURE","section_id":"ND-ContractingParty#0","values":[{"code":"gen-pub","field_id":"BT-10-Procedure-Buyer","list":"authority-activity","ordinal":0,"type":"code"},{"code":"la","field_id":"BT-11-Procedure-Buyer","list":"buyer-legal-type","ordinal":0,"type":"code"},{"field_id":"OPT-300-Procedure-Buyer","is_ref":true,"ordinal":0,"scheme":null,"type":"id","value":"ORG-0001"}]},{"kind":"ExclusionGrounds","parent_section_id":"PROCEDURE","section_id":"ND-ExclusionGrounds#0","values":[{"code":"bankr-nat","field_id":"BT-67(a)-Procedure","list":"exclusion-ground","ordinal":0,"type":"code"},{"field_id":"BT-772-Lot","lang":"DEU","ordinal":0,"type":"text","value":"Zwingende bzw. fakultative Ausschlussgründe nach §§ 123 bis 126 GWB"}]},{"kind":"ExclusionGrounds","parent_section_id":"PROCEDURE","section_id":"ND-ExclusionGrounds#1","values":[{"code":"bankruptcy","field_id":"BT-67(a)-Procedure","list":"exclusion-ground","ordinal":0,"type":"code"},{"fiel