01-notice","list":null,"ordinal":0,"type":"code"},{"code":"cn-standard","field_id":"BT-02-notice","list":"competition","ordinal":0,"type":"code"},{"field_id":"BT-04-notice","is_ref":false,"ordinal":0,"scheme":null,"type":"id","value":"07518e19-86f5-4c48-9caf-68989fb8ff89"},{"field_id":"BT-05(a)-notice","ordinal":0,"type":"date","value":"2024-11-21T20:20:24+01:00"},{"code":"open","field_id":"BT-105-Procedure","list":"procurement-procedure-type","ordinal":0,"type":"code"},{"code":"false","field_id":"BT-106-Procedure","list":"accelerated-procedure","ordinal":0,"type":"code"},{"field_id":"BT-124-Lot","lang":null,"ordinal":0,"type":"text","value":"https://www.evergabe.nrw.de/VMPSatellite/notice/CXS0YD8Y1WST66UY"},{"code":"non-restricted-document","field_id":"BT-14-Lot","list":null,"ordinal":0,"type":"code"},{"field_id":"BT-21-Procedure","lang":"DEU","ordinal":0,"type":"text","value":"174 - Sukzessivleistungsvertrag Büromaterialien 2025"},{"field_id":"BT-22-Procedure","is_ref":false,"ordinal":0,"scheme":"internalID","type":"id","value":"10035310"},{"code":"supplies","field_id":"BT-23-Lot","list":"contract-nature","ordinal":0,"type":"code"},{"field_id":"BT-24-Procedure","lang":"DEU","ordinal":0,"type":"text","value":"Es soll ein Rahmenvertrag über Büromaterialien für den Zeitraum 01.06.2025 - 31.05.2029 für die RWTH Aachen abgeschlossen werden."},{"field_id":"BT-300-Procedure","lang":"DEU","ordinal":0,"type":"text","value":"Bekanntmachungs-ID: CXS0YD8Y1WST66UY\n\n\nMehrere Bieter können sich zu einer Bietergemeinschaft zusammenschließen. In diesem Fall hat die Bietergemeinschaft mit Einreichung des Angebots (i) sämtliche Mitglieder der an der Bietergemeinschaft beteiligten Bieter namentlich mit Anschrift, Telefon-/Telefaxnummer sowie E-Mail-Adresse zu benennen; (ii) einen bevollmächtigten Vertreter für das Vergabeverfahren sowie den Abschluss und die Durchführung des Vertrages zu bezeichnen und; (iii) eine von allen Mitgliedern unterschriebene Vollmacht mittels einer Bietergemeinschaftserklärung vorzulegen, in der die gesamtschuldnerische Haftung aller Mitglieder erklärt wird; (iv) eine detaillierte Übersicht einreichen, die darstellt, welches Mitglied für die Erbringung welcher Leistungen/Dienstleistungen verantwortlich ist."},{"field_id":"BT-536-Lot","ordinal":0,"type":"date","value":"2025-06-01"},{"field_id":"BT-537-Lot","ordinal":0,"type":"date","value":"2027-05-31"},{"field_id":"BT-57-Lot","lang":"DEU","ordinal":0,"type":"text","value":"Die RWTH hat die Option, diesen SL-Vertrag zweimal um je ein weiteres Jahr zu verlängern. Der SL-Vertrag kann bis zum 01.12.2027 um 12 Monate verlängert werden und endet dann spätestens am 31.05.2028. Danach kann der SL-Vertrag bis zum 01.12.2028 um 12 Monate verlängert werden und endet dann spätestens am: 31.05.2029."},{"field_id":"BT-58-Lot","ordinal":0,"type":"integer","value":2},{"code":"no-eu-funds","field_id":"BT-60-Lot","list":"eu-funded","ordinal":0,"type":"code"},{"field_id":"BT-701-notice","is_ref":false,"ordinal":0,"scheme":"notice-id","type":"id","value":"487d23a0-2ab1-405a-aedf-d95ff1e41b00"},{"code":"DEU","field_id":"BT-702(a)-notice","list":"eu-official-language","ordinal":0,"type":"code"},{"code":"DEU","field_id":"BT-708-Lot","list":null,"ordinal":0,"type":"code"},{"field_id":"BT-726-Lot","ordinal":0,"type":"integer","value":1},{"code":"no","field_id":"BT-736-Lot","list":"reserved-execution","ordinal":0,"type":"code"},{"field_id":"BT-738-notice","ordinal":0,"type":"date","value":"2024-11-21"},{"code":"false","field_id":"BT-751-Lot","list":"tender-guarantee-required","ordinal":0,"type":"code"},{"field_id":"BT-757-notice","is_ref":false,"ordinal":0,"scheme":null,"type":"id","value":"01"},{"code":"not-allowed","field_id":"BT-764-Lot","list":"ecatalog-submission","ordinal":0,"type":"code"},{"field_id":"BT-767-Lot","ordinal":0,"type":"integer","value":0},{"field_id":"BT-94-Lot","ordinal":0,"type":"integer","value":1},{"field_id":"BT-95-Lot","lang":"DEU","ordinal":0,"type":"text","value":"2029"},{"code":"DEU","field_id":"BT-97-Lot","list":null,"ordinal":0,"type":"code"},{"field_id":"BT-98-Lot","ordinal":0,"type":"number","unit":"DAY","value":55.0},{"field_id":"BT-99-Lot","lang":"DEU","ordinal":0,"type":"text","value":"Die Vergabe unterliegt der Nachprüfung durch die zuständige Nachprüfungsbehörde Vergabekammer Rheinland (vgl. §§ 155 ff. GWB). Nach § 160 Abs. 3 GWB ist ein Nachprüfungsantrag unzulässig, soweit (Nr. 1) der Antragsteller den geltend gemachten Verstoß gegen Vergabevorschriften vor Einreichen des Nachprüfungsantrags erkannt und gegenüber dem Auftraggeber nicht innerhalb einer Frist von zehn Kalendertagen gerügt hat; der Ablauf der Frist nach § 134 Abs. 2 GWB bleibt unberührt, (Nr. 2) Verstöße gegen Vergabevorschriften, die aufgrund der Bekanntmachung erkennbar sind, nicht spätestens bis zum Ablauf der in der Bekanntmachung benannten Frist zur Bewerbung oder zur Angebotsabgabe gegenüber dem Auftraggeber gerügt werden, (Nr. 3) Verstöße gegen Vergabevorschriften, die erst in den Vergabeunterlagen erkennbar sind, nicht spätestens bis zum Ablauf der Frist zur Bewerbung oder zur Angebotsabgabe gegenüber dem Auftraggeber gerügt werden, (Nr. 4) mehr als 15 Kalendertage nach Eingang der Mitteilung des Auftraggebers, einer Rüge nicht abhelfen zu wollen, vergangen sind. § 160 Abs. 3 Satz 1 GWB gilt nicht bei einem Antrag auf Feststellung der Unwirksamkeit des Vertrags nach § 135 Abs. 1 Nr. 2 GWB. § 134 Abs. 1 Satz 2 GWB bleibt unberührt."},{"field_id":"OPP-010-notice","is_ref":false,"ordinal":0,"scheme":"ojs-notice-id","type":"id","value":"00717861-2024"},{"field_id":"OPP-011-notice","is_ref":false,"ordinal":0,"scheme":"ojs-id","type":"id","value":"229/2024"},{"field_id":"OPP-012-notice","ordinal":0,"type":"date","value":"2024-11-25"},{"code":"16","field_id":"OPP-070-notice","list":"notice-subtype","ordinal":0,"type":"code"},{"field_id":"OPT-001-notice","is_ref":false,"ordinal":0,"scheme":null,"type":"id","value":"2.3"},{"field_id":"OPT-002-notice","is_ref":false,"ordinal":0,"scheme":null,"type":"id","value":"eforms-sdk-1.7"},{"field_id":"OPT-140-Lot","is_ref":false,"ordinal":0,"scheme":null,"type":"id","value":"SomeTenderDocID1"},{"field_id":"OPT-301-Lot-ReviewInfo","is_ref":true,"ordinal":0,"scheme":"organization","type":"id","value":"ORG-0003"},{"field_id":"OPT-301-Lot-ReviewOrg","is_ref":true,"ordinal":0,"scheme":"organization","type":"id","value":"ORG-0004"},{"field_id":"OPT-301-Lot-TenderReceipt","is_ref":true,"ordinal":0,"scheme":null,"type":"id","value":"ORG-0005"}]}]}