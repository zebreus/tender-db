{"notice_id":26502152,"sections":[{"kind":"SettledContract","parent_section_id":"PROCEDURE","section_id":"CON-0001","values":[{"field_id":"DE1-NoticeResult-SettledContract-ContractReference-ID","is_ref":false,"ordinal":0,"scheme":null,"type":"id","value":"1"},{"field_id":"DE1-NoticeResult-SettledContract-ID","is_ref":false,"ordinal":0,"scheme":"contract","type":"id","value":"CON-0001"},{"field_id":"DE1-NoticeResult-SettledContract-Title","lang":"DEU","ordinal":0,"type":"text","value":"Behrens GmbH&Co.KG, 59229 Ahlen"}]},{"kind":"ProcurementProjectLot","parent_section_id":"PROCEDURE","section_id":"LOT-0001","values":[{"field_id":"DE1-ProcurementProject-ContractExtension-MaximumNumberNumeric","ordinal":0,"type":"number","unit":null,"value":0.0},{"field_id":"DE1-ProcurementProject-Description","lang":"DEU","ordinal":0,"type":"text","value":"Rückbau Glas-Alu-Gauben 5 St.\nRückbau Abklebung und Dämmung auch Dachterrassen 190 m2\nRückbau Dachflächenfenster und andere Einbauten 20 St.\nRückbau Dachrinnen, Fallrohre, Blech-Anschlüsse 370 m\nRückbau Dacheindeckung 100 m2\nHerstellen von Gauben, Holztragwerk mit Flachdach und Fassadenbekleidung aus\nFaserzementplatten 5 St.\nAnpassen des bestehenden Dachstuhls im Bereich der Gauben, Bauholz 10 m3\nDachaufbau mit Kunststoff Dach- und Dichtungsbahn auf Gaubendach 5 St.\nDachaufbau mit Bitumenabdichtung auf Dachterrassen 45 m2\nDachaufbau mit Kunststoffdachbahn auf Dachterrassen 140 m2\nBetonbeläge für Dachterrassen 185 m2\nDachflächenfenster Kunststoff 20 St.\nPrüfen der Dachflächen im Bestand Falzziegel und Bieberschwanzdeckung und\nAustausch von defekten Dachziegeln 1.300 m2\nReinigen der Dachfläche im Bestand 1.300 m2\nDachrinnen und Fallrohre Kupfer 260 m\nAttikaabdeckungen Kupfer 50 m"},{"field_id":"DE1-ProcurementProject-ID","is_ref":false,"ordinal":0,"scheme":"internalID","type":"id","value":"060-24-00488"},{"code":"45261210","field_id":"DE1-ProcurementProject-MainCommodityClassification-ItemClassificationCode","ordinal"