ordinal":0,"scheme":"notice-id","type":"id","value":"fee0647d-8d4c-420d-ae25-724ea78b3e68"},{"field_id":"DE1-IssueDate","ordinal":0,"type":"date","value":"2024-11-11T14:26:40+01:00"},{"code":"DEU","field_id":"DE1-NoticeLanguageCode","list":"eu-official-language","ordinal":0,"type":"code"},{"code":"29","field_id":"DE1-NoticeSubType-SubTypeCode","list":"notice-subtype","ordinal":0,"type":"code"},{"code":"can-standard","field_id":"DE1-NoticeTypeCode","list":"result","ordinal":0,"type":"code"},{"field_id":"DE1-ProcurementProject-ContractExtension-MaximumNumberNumeric","ordinal":0,"type":"number","unit":null,"value":0.0},{"field_id":"DE1-ProcurementProject-Description","lang":"DEU","ordinal":0,"type":"text","value":"Dachdecker- und Zimmerarbeiten"},{"field_id":"DE1-ProcurementProject-ID","is_ref":false,"ordinal":0,"scheme":"internalID","type":"id","value":"060-24-00488"},{"code":"45261210","field_id":"DE1-ProcurementProject-MainCommodityClassification-ItemClassificationCode","ordinal":0,"scheme":"cpv","type":"classification"},{"field_id":"DE1-ProcurementProject-Name","lang":"DEU","ordinal":0,"type":"text","value":"BLB NRW Münster / Universität Münster - Sanierung Hüfferstiftung / Dachdecker- und Zimmerarbeiten"},{"field_id":"DE1-ProcurementProject-Note","lang":"DEU","ordinal":0,"type":"text","value":"Bekanntmachungs-ID: CXS7YYXY11QCG4AB\n\n\nDas Vergabeverfahren wird über den Vergabemarktplatz NRW (VMP NRW) abgewickelt. Unternehmen erhalten bei der Registrierung auf dem VMP NRW einen individuellen Unternehmensaccount. Der Austausch zwischen der Vergabestelle und dem Unternehmen erfolgt elektronisch über diesen Account und den für dieses Vergabeverfahren angelegten Projektraum im Modul \"Kommunikation\". Nur das Unternehmen hat Zugriff auf die über den Unternehmensaccount im Modul \"Kommunikation\" des Projektraums eingegangenen und ausgehenden Nachrichten. Dem Unternehmen werden hierüber auch rechtserhebliche Erklärungen im Vergabeverfahren zugestellt.  \n\nInnerhalb des Unternehmensaccounts können mehrere Nutzerkonten angelegt werden. Bei der Anlage wird die Verwendung funktionsbezogener E-Mail-Adressen empfohlen. \nWeitere Informationen und Hilfestellungen zum VMP NRW sowie Anleitungen zum Bietertool für die Angebotsabgabe finden Sie auf der Internetseite des Betreibers cosinex GmbH unter folgendem Link: https://support.cosinex.de/unternehmen/pages/viewpage.action?pageId=28115008."},{"code":"works","field_id":"DE1-ProcurementProject-ProcurementTypeCode","list":"contract-nature","ordinal":0,"type":"code"},{"field_id":"DE1-RegulatoryDomain","lang":null,"ordinal":0,"type":"text","value":"32014L0024"},{"field_id":"DE1-RequestedPublicationDate","ordinal":0,"type":"date","value":"2024-11-11"},{"field_id":"DE1-TenderResult-AwardDate","ordinal":0,"type":"date","value":"2000-01-01"},{"field_id":"DE1-TenderingProcess-AuctionTerms-AuctionConstraintIndicator","ordinal":0,"type":"integer","value":0},{"code":"open","field_id":"DE1-TenderingProcess-ProcedureCode","list":"procurement-procedure-type","ordinal":0,"type":"code"},{"field_id":"DE1-TenderingTerms-AppealTerms-AppealReceiverParty-PartyIdentification-ID","is_ref":true,"ordinal":0,"scheme":"organization","type":"id","value":"ORG-0003"},{"code":"no-eu-funds","field_id":"DE1-TenderingTerms-FundingProgramCode","list":"eu-funded","ordinal":0,"type":"code"},{"field_id":"DE1-UBLVersionID","is_ref":false,"ordinal":0,"scheme":null,"type":"id","value":"2.3"},{"field_id":"DE1-VersionID","is_ref":false,"ordinal":0,"scheme":null,"type":"id","value":"01"}]},{"kind":"LotResult","parent_section_id":"PROCEDURE","section_id":"RES-0001","values":[{"field_id":"DE1-NoticeResult-LotResult-DPSTerminationIndicator","ordinal":0,"type":"integer","value":0},{"cents":72382024,"currency":"EUR","field_id":"DE1-NoticeResult-LotResult-HigherTenderAmount","ordinal":0,"type":"amount"},{"field_id":"DE1-NoticeResult-LotResult-ID","is_ref":false,"ordinal":0,"scheme":null,"type":"id","value":"RES-0001"},{"cents":47713978,"cu