ield_id":"BT-739-Organization-Company","lang":null,"ordinal":0,"type":"text","value":"07643 - 933 69-55"},{"field_id":"BT-746-Organization","ordinal":0,"type":"integer","value":0},{"field_id":"OPT-200-Organization-Company","is_ref":false,"ordinal":0,"scheme":null,"type":"id","value":"ORG-0005"},{"field_id":"OPT-302-Organization","is_ref":true,"ordinal":0,"scheme":null,"type":"id","value":"UBO-0001"}]},{"kind":"Organization","parent_section_id":"PROCEDURE","section_id":"ORG-0006","values":[{"field_id":"BT-500-Organization-Company","lang":"DEU","ordinal":0,"type":"text","value":"Datenservice Öffentlicher Einkauf (in Verantwortung des Beschaffungsamts des BMI)"},{"field_id":"BT-501-Organization-Company","is_ref":false,"ordinal":0,"scheme":"002","type":"id","value":"0204:994-DOEVD-83"},{"field_id":"BT-503-Organization-Company","lang":null,"ordinal":0,"type":"text","value":"+49228996100"},{"field_id":"BT-506-Organization-Company","lang":null,"ordinal":0,"type":"text","value":"noreply.esender_hub@bescha.bund.de"},{"code":"DEA22","field_id":"BT-507-Organization-Company","ordinal":0,"scheme":"nuts","type":"classification"},{"field_id":"BT-512-Organization-Company","lang":null,"ordinal":0,"type":"text","value":"53119"},{"field_id":"BT-513-Organization-Company","lang":null,"ordinal":0,"type":"text","value":"Bonn"},{"code":"DEU","field_id":"BT-514-Organization-Company","list":"country","ordinal":0,"type":"code"},{"field_id":"OPT-200-Organization-Company","is_ref":false,"ordinal":0,"scheme":"organization","type":"id","value":"ORG-0006"}]},{"kind":"Notice","parent_section_id":null,"section_id":"PROCEDURE","values":[{"code":"32014L0024","field_id":"BT-01-notice","list":null,"ordinal":0,"type":"code"},{"code":"can-standard","field_id":"BT-02-notice","list":"result","ordinal":0,"type":"code"},{"field_id":"BT-04-notice","is_ref":false,"ordinal":0,"scheme":null,"type":"id","value":"14a5bb98-78a4-4b6f-abb8-34bd7c75b5f1"},{"field_id":"BT-05(a)-notice","ordinal":0,"type":"date","value":"2024-11-20T13:46:03+01:00"},{"code":"open","field_id":"BT-105-Procedure","list":"procurement-procedure-type","ordinal":0,"type":"code"},{"code":"false","field_id":"BT-106-Procedure","list":"accelerated-procedure","ordinal":0,"type":"code"},{"field_id":"BT-21-Procedure","lang":"DEU","ordinal":0,"type":"text","value":"FW Westerwalsede (SG Bothel) - Lieferung TSF-W"},{"field_id":"BT-22-Procedure","is_ref":false,"ordinal":0,"scheme":"internalID","type":"id","value":"2024-029"},{"code":"supplies","field_id":"BT-23-Lot","list":"contract-nature","ordinal":0,"type":"code"},{"field_id":"BT-24-Procedure","lang":"DEU","ordinal":0,"type":"text","value":"Lieferung eines TSF-W an die Freiwillige Feuerwehr Westerwalsede (Samtgemeinde Bothel)."},{"field_id":"BT-300-Procedure","lang":"DEU","ordinal":0,"type":"text","value":"Bekanntmachungs-ID: CXVHYD2Y1TB92UEV\n\n\nDie BBS Gefahrenabwehrplanung GmbH führt dieses Verfahren im Namen und im Auftrag der auffordernden Stelle durch. Auftraggeberin ist die auffordernde Stelle. \n\nÄnderung an den Vergabeunterlagen können in Form von Bieterfragen eingereicht werden. Die Auftraggeberin prüft die Anfragen und trifft Einzelfallentscheidungen. Sie behält sich das Recht vor, Anfragen negativ zu beantworten. Bieterfragen sind ausschließlich über die Vergabeplattform einzureichen und werden ausschließlich über diese beantwortet. Wir bitten beim Stellen der Bieterfragen darauf zu achten, dass keine Rückschlüsse auf den stellenden Bieter sind. \n\nFragen zu technischem Support sind an den Kundendienst der Vergabeplattform zu stellen. \n\nDie Kommunikation erfolgt ausschließlich über die Vergabeplattform.\n\nBieter sind für die fristgerechte Abgabe der Angebote selbst verantwortlich. Nicht fristgerecht eingereichte Angebote werden ausgeschlossen, es sei denn,  der Bieter hat dies nicht zu vertreten. Der Bieter ist in der Nachweispflicht, dass er das Versäumnis nicht zu vertreten hat.\n\nGem. DSGVO Art. 6 Abs. 1 b werden im Rahmen des Vergabeverfahrens zur Verfügung gestellte, auch personenbezogene Informationen und Daten erfasst, organisiert, gespeichert, verwendet und gelöscht. Nach Abschluss des Vergabeverfahrens, des Förder- und Rechnungsprüfungsverfahrens und nach Ablauf der gesetzlichen Aufbewahrungsfrist werden die Daten gelöscht."},{"field_id":"BT-36-Lot","ordinal":0,"type":"number","unit":"MONTH","value":30.0},{"field_id":"BT-58-Lot","ordinal":0,"type":"integer","value":0},{"code":"no-eu-funds","field_id":"BT-60-Lot","list":"eu-funded","ordinal":0,"type":"code"},{"field_id":"BT-701-notice","is_ref":false,"ordinal":0,"scheme":"notice-id","type":"id","value":"12db62ea-a532-4985-9230-28654f0630e9"},{"code":"DEU","field_id":"BT-702(a)-notice","list":"eu-official-language","ordinal":0,"type":"code"},{"field_id":"BT-738-notice","ordinal":0,"type":"date","value":"2024-11-20"},{"field_id":"BT-757-notice","is_ref":false,"ordinal":0,"scheme":null,"type":"id","value":"01"},{"field_id":"BT-767-Lot","ordinal":0,"type":"integer","value":0},{"field_id":"BT-99-Lot","lang":"DEU","ordinal":0,"type":"text","value":"Die Zulässigkeit von Nachprüfungsanträgen richtet sich nach § 160 GWB. Nach § 160 Abs. 3 GWB ist ein Nachprüfungsantrag unzulässig, soweit\n1. der Antragsteller den geltend gemachten Verstoß gegen Vergabevorschriften vor Einreichen des Nachprüfungsantrags erkannt und gegenüber dem AG nicht innerhalb einer Frist von zehn Kalendertagen gerügt hat; der Ablauf der Frist nach § 134 Absatz 2 GWB bleibt unberührt,\n2. Verstöße gegen Vergabevorschriften, die aufgrund der Bekanntmachung erkennbar sind, nicht spätestens bis zum Ablauf der in der Bekanntmachung benannten Frist zur Bewerbung oder zur Angebotsabgabe gegenüber dem AG gerügt werden,\n3. Verstöße gegen Vergabevorschriften, die erst in den Vergabeunterlagen erkennbar sind, nicht spätestens bis zum Ablauf der Frist zur Bewerbung oder zur Angebotsabgabe gegenüber dem AG gerügt werden,\n4. mehr als 15 Kalendertage nach Eingang der Mitteilung des AG, einer Rüge nicht abhelfen zu wollen, vergangen sind.\nDies gilt nicht bei einem Antrag auf Feststellung der Unwirksamkeit des Vertrags nach § 135 Absatz 1 Nr. 2 GWB. § 134 Absatz 1 Satz 2 GWB bleibt unberührt.\n\nFristen für die Einlegung von Rechtsbehelfen und Rügen ergeben sich insbesondere aus § 160 Abs. 3 GWB. Für die Einlegung von Rechtsbehelfen gelten im Übrigen die Regelungen der §§ 134, 135, 160 GWB (vgl. vorstehend).\nDer AG ist im Falle eines Nachprüfungsantrags verpflichtet, die Vergabeakten, die auch die abgegebenen Teilnahmeanträge und Angebote enthalten, an die Vergabekammer weiterzuleiten. Gemäß § 165 GWB haben die Verfahrensbeteiligten unter Umständen Anspruch auf Akteneinsicht und können sich ggf. Ausfertigungen, Auszüge oder Abschriften erteilen lassen. Die Vergabekammer hat die Einsicht in die Unterlagen zu versagen, soweit dies aus wichtigen Gründen, insbesondere des Geheimschutzes oder zur Wahrung von Fabrikations-, Betriebs- oder Geschäftsgeheimnissen geboten ist. Es ist daher im Interesse des Bieters/der Bietergemeinschaft, bereits mit der Abgabe des Teilnahmeantrags oder Angebots eine entsprechende Kennzeichnung der Stellen vorzunehmen, die Betriebs-, Fabrikations- oder Geschäftsgeheimnisse enthalten."},{"field_id":"OPP-010-notice","is_ref":false,"ordinal":0,"scheme":"ojs-notice-id","type":"id","value":"00711006-2024"},{"field_id":"OPP-011-notice","is_ref":false,"ordinal":0,"scheme":"ojs-id","type":"id","value":"227/2024"},{"field_id":"OPP-012-notice","ordinal":0,"type":"date","value":"2024-11-21"},{"code":"29","field_id":"OPP-070-notice","list":"notice-subtype","ordinal":0,"type":"code"},{"field_id":"OPT-001-notice","is_ref":false,"ordinal":0,"scheme":null,"type":"id","value":"2.3"},{"field_id":"OPT-002-notice","is_ref":false,"ordinal":0,"scheme":null,"type":"id","value":"eforms-sdk-1.7"},{"field_id":"OPT-301-Lot-ReviewOrg","is_ref":true,"ordinal":0,"scheme":"organization","type":"id","value":"ORG-0004"},{"field_id":"OPT-999","ordinal":0,"type":"date","v