nststoff 20 St.\nPrüfen der Dachflächen im Bestand Falzziegel und Bieberschwanzdeckung und\nAustausch von defekten Dachziegeln 1.300 m2\nReinigen der Dachfläche im Bestand 1.300 m2\nDachrinnen und Fallrohre Kupfer 260 m\nAttikaabdeckungen Kupfer 50 m"},{"field_id":"BT-58-Lot","ordinal":0,"type":"integer","value":0},{"code":"no-eu-funds","field_id":"BT-60-Lot","list":"eu-funded","ordinal":0,"type":"code"},{"code":"false","field_id":"BT-717-Lot","list":"cvd-scope","ordinal":0,"type":"code"},{"code":"none","field_id":"BT-765-Lot","list":"framework-agreement","ordinal":0,"type":"code"},{"code":"none","field_id":"BT-766-Lot","list":"dps-usage","ordinal":0,"type":"code"},{"field_id":"BT-767-Lot","ordinal":0,"type":"integer","value":0},{"field_id":"OPT-301-Lot-AddInfo","is_ref":true,"ordinal":0,"scheme":null,"type":"id","value":"ORG-0002"},{"field_id":"OPT-301-Lot-ReviewOrg","is_ref":true,"ordinal":0,"scheme":"organization","type":"id","value":"ORG-0003"}]},{"kind":"ContractingParty","parent_section_id":"PROCEDURE","section_id":"ND-ContractingParty#0","values":[{"code":"econ-aff","field_id":"BT-10-Procedure-Buyer","list":"authority-activity","ordinal":0,"type":"code"},{"code":"pub-undert","field_id":"BT-11-Procedure-Buyer","list":"buyer-legal-type","ordinal":0,"type":"code"},{"field_id":"OPT-300-Procedure-Buyer","is_ref":true,"ordinal":0,"scheme":null,"type":"id","value":"ORG-0001"}]},{"kind":"LocalLegalBasisWithID","parent_section_id":"PROCEDURE","section_id":"ND-LocalLegalBasisWithID#0","values":[{"field_id":"BT-01(c)-Procedure","is_ref":false,"ordinal":0,"scheme":null,"type":"id","value":"vob-a-eu"}]},{"kind":"LotAwardCriterion","parent_section_id":"LOT-0001","section_id":"ND-LotAwardCriterion#0","values":[{"code":"price","field_id":"BT-539-Lot","list":"award-criterion-type","ordinal":0,"type":"code"},{"field_id":"BT-734-Lot","lang":"DEU","ordinal":0,"type":"text","value":"Preis"}]},{"kind":"LotAwardCriterionParameter","parent_section_id":"ND-LotAwardCriterion#0","secti