nization-Company","lang":"DEU","ordinal":0,"type":"text","value":"Datenservice Öffentlicher Einkauf (in Verantwortung des Beschaffungsamts des BMI)"},{"field_id":"BT-501-Organization-Company","is_ref":false,"ordinal":0,"scheme":"002","type":"id","value":"0204:994-DOEVD-83"},{"field_id":"BT-503-Organization-Company","lang":null,"ordinal":0,"type":"text","value":"+49228996100"},{"field_id":"BT-506-Organization-Company","lang":null,"ordinal":0,"type":"text","value":"noreply.esender_hub@bescha.bund.de"},{"code":"DEA22","field_id":"BT-507-Organization-Company","ordinal":0,"scheme":"nuts","type":"classification"},{"field_id":"BT-512-Organization-Company","lang":null,"ordinal":0,"type":"text","value":"53119"},{"field_id":"BT-513-Organization-Company","lang":null,"ordinal":0,"type":"text","value":"Bonn"},{"code":"DEU","field_id":"BT-514-Organization-Company","list":"country","ordinal":0,"type":"code"},{"field_id":"OPT-200-Organization-Company","is_ref":false,"ordinal":0,"scheme":"organization","type":"id","value":"ORG-0006"}]},{"kind":"Notice","parent_section_id":null,"section_id":"PROCEDURE","values":[{"code":"32014L0024","field_id":"BT-01-notice","list":null,"ordinal":0,"type":"code"},{"code":"cn-standard","field_id":"BT-02-notice","list":"competition","ordinal":0,"type":"code"},{"field_id":"BT-04-notice","is_ref":false,"ordinal":0,"scheme":null,"type":"id","value":"05c39546-77eb-40ee-ab21-9c59d0581dff"},{"field_id":"BT-05(a)-notice","ordinal":0,"type":"date","value":"2024-10-18T00:00:00+02:00"},{"code":"open","field_id":"BT-105-Procedure","list":"procurement-procedure-type","ordinal":0,"type":"code"},{"code":"false","field_id":"BT-106-Procedure","list":"accelerated-procedure","ordinal":0,"type":"code"},{"field_id":"BT-124-Lot","lang":null,"ordinal":0,"type":"text","value":"https://evergabe-mv.de/Satellite/notice/CXVHYDNY12KEN28X"},{"code":"non-restricted-document","field_id":"BT-14-Lot","list":null,"ordinal":0,"type":"code"},{"field_id":"BT-21-Procedure","lang":"DEU","ordinal":0,"type":"text","value":"Einsteinstraße 21-23 Los 5 - Dachdecker"},{"field_id":"BT-22-Procedure","is_ref":false,"ordinal":0,"scheme":"internalID","type":"id","value":"070/2024/10/02-08/24_VST"},{"code":"works","field_id":"BT-23-Lot","list":"contract-nature","ordinal":0,"type":"code"},{"field_id":"BT-24-Procedure","lang":"DEU","ordinal":0,"type":"text","value":"Mittlere Instandhaltung und Sanierung der Einsteinstr. 21-23 in Neubrandenburg - Los 5 Dachdecker"},{"field_id":"BT-300-Procedure","lang":"DEU","ordinal":0,"type":"text","value":"Bekanntmachungs-ID: CXVHYDNY12KEN28X\n\n\nDie gesamte Kommunikation ist ausschließlich über die Vergabeplattform zu\nführen.\nTelefonische Anfragen werden nicht bearbeitet.\nDie Angebote sind elektronisch in Textform einzureichen.\nDie Unterlagen sind vollständig einzureichen. Inhaltliche Änderungen sind nicht\nzulässig.\nBitte beachten: Um einen eventuellen Ausschluss des Angebotes zu vermeiden,\nlegen Sie bitte die geforderten Nachweise und Erklärungen dem Angebot unbedingt\nvollständig bei.\n\nDie Bildung von Bewerber-/Bietergemeinschaften (nachfolgend: \"Bietergemeinschaft(en)\" [BG], im Auftragsfalle\nArbeitsgemeinschaft(en) [AG]) ist zulässig. BG müssen sich bereits als solche bewerben. Die nachträgliche Bildung ist\ngrundsätzlich nicht möglich. Die BG hat mit dem Angebot eine von allen Mitgliedern rechtsverbindlich unterschriebene\nErklärung abzugeben,\n- in der die Bildung einer AG im Auftragsfall erklärt ist,\n- in der alle Mitglieder aufgeführt sind und eines der Mitglieder als bevollmächtigter Vertreter für den Abschluss und die\nDurchführung des Vertrages bezeichnet ist,\n- in der bestätigt wird, dass der bevollmächtigte Vertreter alle Mitglieder der BG/AG gegenüber dem Auftraggeber\nrechtsverbindlich vertritt,\n- in der erklärt wird, dass alle Mitglieder für die Erfüllung des Vertrages gesamtschuldnerisch haften,\n- in der angegeben wird, welches Mitglied welche Leistungen ausführt.\nWeiter ist in einer kurzen Begründung (Form: Eigenerklärung) anzugeben, aus welchem (kaufmännischen odertechnischen)\nGrund eine BG eingegangen wird.\nEs ist grundsätzlich nicht zulässig, dass ein Mitglied einer BG parallel ein eigenes Angebot abgibt bzw. parallel an einer\nanderen BG teilnimmt."},{"field_id":"BT-536-Lot","ordinal":0,"type":"date","value":"2025-05-26"},{"field_id":"BT-537-Lot","ordinal":0,"type":"date","value":"2025-07-10"},{"field_id":"BT-58-Lot","ordinal":0,"type":"integer","value":0},{"code":"no-eu-funds","field_id":"BT-60-Lot","list":"eu-funded","ordinal":0,"type":"code"},{"field_id":"BT-701-notice","is_ref":false,"ordinal":0,"scheme":"notice-id","type":"id","value":"b6e17533-b051-47d2-b47f-87c605809b2f"},{"code":"DEU","field_id":"BT-702(a)-notice","list":"eu-official-language","ordinal":0,"type":"code"},{"code":"DEU","field_id":"BT-708-Lot","list":null,"ordinal":0,"type":"code"},{"field_id":"BT-726-Lot","ordinal":0,"type":"integer","value":1},{"code":"no","field_id":"BT-736-Lot","list":"reserved-execution","ordinal":0,"type":"code"},{"field_id":"BT-738-notice","ordinal":0,"type":"date","value":"2024-10-18"},{"code":"false","field_id":"BT-751-Lot","list":"tender-guarantee-required","ordinal":0,"type":"code"},{"field_id":"BT-757-notice","is_ref":false,"ordinal":0,"scheme":null,"type":"id","value":"01"},{"code":"not-allowed","field_id":"BT-764-Lot","list":"ecatalog-submission","ordinal":0,"type":"code"},{"field_id":"BT-767-Lot","ordinal":0,"type":"integer","value":0},{"code":"DEU","field_id":"BT-97-Lot","list":null,"ordinal":0,"type":"code"},{"field_id":"BT-98-Lot","ordinal":0,"type":"number","unit":"DAY","value":54.0},{"field_id":"BT-99-Lot","lang":"DEU","ordinal":0,"type":"text","value":"Es wird verwiesen auf § 160 GWB:\n(1) Die Vergabekammer leitet ein Nachprüfungsverfahren nur auf Antrag ein.\n(2) Antragsbefugt ist jedes Unternehmen, das ein Interesse an dem öffentlichen Auftrag oder der Konzession hat und eine Verletzung in seinen Rechten nach § 97 Absatz 6 durch Nichtbeachtung von Vergabevorschriften geltend macht. Dabei ist darzulegen, dass dem Unternehmen durch die behauptete Verletzung der Vergabevorschriften ein Schaden entstanden ist oder zu entstehen droht.\n(3) Der Antrag ist unzulässig, soweit:\n1. der Antragsteller den geltend gemachten Verstoß gegen Vergabevorschriften vor Einreichen des Nachprüfungsantrags erkannt und gegenüber dem Auftraggeber nicht innerhalb einer Frist von 10 Kalendertagen gerügt hat; der Ablauf der Frist nach § 134 Absatz 2 bleibt unberührt,\n2. Verstöße gegen Vergabevorschriften, die aufgrund der Bekanntmachung erkennbar sind, nicht spätestens bis zum Ablauf der in der Bekanntmachung benannten Frist zur Bewerbung oder zur Angebotsabgabe gegenüber dem Auftraggeber gerügt werden,\n3. Verstöße gegen Vergabevorschriften, die erst in den Vergabeunterlagen erkennbar sind, nicht spätestens bis zum Ablauf der Frist zur Bewerbung oder zur Angebotsabgabe gegenüber dem Auftraggeber gerügt werden,\n4. mehr als 15 Kalendertage nach Eingang der Mitteilung des Auftraggebers, einer Rüge nicht abhelfen zu wollen, vergangen sind. Satz 1 gilt nicht bei einem Antrag auf Feststellung der Unwirksamkeit des Vertrags nach § 135 Absatz 1 Nummer 2. § 134 Absatz 1 Satz 2 bleibt unberührt."},{"field_id":"OPP-010-notice","is_ref":false,"ordinal":0,"scheme":"ojs-notice-id","type":"id","value":"00636665-2024"},{"field_id":"OPP-011-notice","is_ref":false,"ordinal":0,"scheme":"ojs-id","type":"id","value":"205/2024"},{"field_id":"OPP-012-notice","ordinal":0,"type":"date","value":"2024-10-21"},{"code":"16","field_id":"OPP-070-notice","list":"notice-subtype","ordinal":0,"type":"code"},{"field_id":"OPT-001-notice","is_ref":false,"ordinal":0,"scheme":null,"type":"id","value":"2.3"},{"field_id":"OPT-002-notice","is_ref":false,"ordinal":0,"scheme":null,"type":"id","value":"eforms-sdk-1.7"},{"field_id":"OPT-140-Lot","is_ref":false,"ordinal":0,"scheme":null,"type":"id","value":"SomeTenderDocID1"},{"field_id":"OPT-301-Lot-ReviewInfo","is_ref":true,"ordinal":0,"scheme":"organization","type":"id","value":"ORG-0003"},{"field_id":"OPT-301-Lot-ReviewOrg","is_ref":true,"ordinal":0,"scheme":"organization","type":"id","value":"ORG-0004"},{"field_id":"OPT-301-Lot-TenderReceipt","is_ref":true,"ordinal":0,"scheme":null,"type":"id","value":"ORG-0005"}]}]}