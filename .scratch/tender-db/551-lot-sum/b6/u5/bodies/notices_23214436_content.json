ските характеристики, посочени в Приложение № 1 от Техническата спецификация."},{"field_id":"TED-TITLE","lang":"BG","ordinal":0,"type":"text","value":"Доставка на комплектоващи елементи за лагерни възли"},{"cents":3000000,"currency":"BGN","field_id":"TED-VAL_OBJECT","ordinal":0,"type":"amount"}]},{"kind":"Organization","parent_section_id":"PROCEDURE","section_id":"ORG-1","values":[{"field_id":"TED-ADDRESS","lang":"BG","ordinal":0,"type":"text","value":"ул. МОСКОВСКА №33"},{"field_id":"TED-CONTACT_POINT","lang":"BG","ordinal":0,"type":"text","value":"Елена Димитрова Калафатева"},{"code":"BG","field_id":"TED-COUNTRY","list":null,"ordinal":0,"type":"code"},{"field_id":"TED-E_MAIL","lang":"BG","ordinal":0,"type":"text","value":"e.anastasova@sofia.bg"},{"field_id":"TED-FAX","lang":"BG","ordinal":0,"type":"text","value":"+359 29861221"},{"field_id":"TED-NATIONALID","is_ref":false,"ordinal":0,"scheme":"national","type":"id","value":"000696327"},{"code":"BG411","field_id":"TED-NUTS","ordinal":0,"scheme":"nuts","type":"classification"},{"field_id":"TED-OFFICIALNAME","lang":"BG","ordinal":0,"type":"text","value":"СТОЛИЧНА ОБЩИНА"},{"field_id":"TED-PHONE","lang":"BG","ordinal":0,"type":"text","value":"+359 29377246"},{"field_id":"TED-POSTAL_CODE","lang":"BG","ordinal":0,"type":"text","value":"1000"},{"field_id":"TED-TOWN","lang":"BG","ordinal":0,"type":"text","value":"гр.София"},{"field_id":"TED-URL_BUYER","lang":"BG","ordinal":0,"type":"text","value":"https://app.eop.bg/buyer/1240"},{"field_id":"TED-URL_GENERAL","lang":"BG","ordinal":0,"type":"text","value":"https://www.sofia.bg/"}]},{"kind":"Organization","parent_section_id":"PROCEDURE","section_id":"ORG-2","values":[{"field_id":"TED-ADDRESS","lang":"BG","ordinal":0,"type":"text","value":"бул. Витоша № 18"},{"code":"BG","field_id":"TED-COUNTRY","list":null,"ordinal":0,"type":"code"},{"field_id":"TED-E_MAIL","lang":"BG","ordinal":0,"type":"text","value":"delovodstvo@cpc.bg"},{"field_id":"TED-FAX","lang":"BG","ordinal":0,"type":"text","value":"+359 29807315"},{"field_id":"TED-OFFICIALNAME","lang":"BG","ordinal":0,"type":"text","value":"Комисия за защита на конкуренцията"},{"field_id":"TED-PHONE","lang":"BG","ordinal":0,"type":"text","value":"+359 29356113"},{"field_id":"TED-POSTAL_CODE","lang":"BG","ordinal":0,"type":"text","value":"1000"},{"field_id":"TED-TOWN","lang":"BG","ordinal":0,"type":"text","value":"София"},{"field_id":"TED-URL","lang":"BG","ordinal":0,"type":"text","value":"http://www.cpc.bg"}]},{"kind":"Notice","parent_section_id":null,"section_id":"PROCEDURE","values":[{"code":"3","field_id":"TED-AA_AUTHORITY_TYPE","list":null,"ordinal":0,"type":"code"},{"field_id":"TED-AA_NAME","lang":"BG","ordinal":0,"type":"text","value":"СТОЛИЧНА ОБЩИНА"},{"code":"1","field_id":"TED-AC_AWARD_CRIT","list":null,"ordinal":0,"type":"code"},{"field_id":"TED-ADDRESS_CONTRACTING_BODY","is_ref":true,"ordinal":0,"scheme":null,"type":"id","value":"ORG-1"},{"field_id":"TED-ADDRESS_FURTHER_INFO_IDEM","ordinal":0,"type":"integer","value":1},{"field_id":"TED-ADDRESS_REVIEW_BODY","is_ref":true,"ordinal":0,"scheme":null,"type":"id","value":"ORG-2"},{"code":"GENERAL_PUBLIC_SERVICES","field_id":"TED-CA_ACTIVITY","list":null,"ordinal":0,"type":"code"},{"code":"BG411","field_id":"TED-CA_CE_NUTS","ordinal":0,"scheme":"nuts","type":"classification"},{"code":"REGIONAL_AUTHORITY","field_id":"TED-CA_TYPE","list":null,"ordinal":0,"type":"code"},{"code":"S","field_id":"TED-COLL_OJ","list":null,"ordinal":0,"type":"code"},{"code":"44440000","field_id":"TED-CPV_CODE","ordinal":0,"scheme":"cpv","type":"classification"},{"field_id":"TED-DATE_DISPATCH_NOTICE","ordinal":0,"type":"date","value":"2023-06-20"},{"field_id":"TED-DATE_OPENING_TENDERS","ordinal":0,"type":"date","value":"2023-07-21T15:00:00+00:00"},{"field_id":"TED-DATE_PUB","ordinal":0,"type":"date","value":"2023-06-22"},{"field_id":"TED-DATE_RECEIPT_TENDERS","ordinal":0,"type":"date","value":"2023-07-20T23:59:00+00:00"},{"field_id":"TED-DOCUMENT_FULL","ordinal":0,"type":"integer","value":1},{"field_id":"TED-DS_DATE_DISPATCH","ordinal":0,"type":"date","value":"2023-06-20"},{"field_id":"TED-DT_DATE_FOR_SUBMISSION","ordinal":0,"type":"date","value":"2023-07-20T23:59:00+00:00"},{"field_id":"TED-DURATION_TENDER_VALID","ordinal":0,"type":"number","unit":"MONTH","value":6.0},{"field_id":"TED-ECONOMIC_FINANCIAL_INFO","lang":"BG","ordinal":0,"type":"text","value":"В настоящата обществена поръчка няма поставени изисквания за годност (правоспособност) за упражняване на професионална дейност."},{"code":"F02","field_id":"TED-FORM","list":null,"ordinal":0,"type":"code"},{"code":"01B02","field_id":"TED-HEADING","list":null,"ordinal":0,"type":"code"},{"field_id":"TED-IA_URL_ETENDERING","lang":null,"ordinal":0,"type":"text","value":"https://app.eop.bg/today/308083"},{"field_id":"TED-IA_URL_GENERAL","lang":null,"ordinal":0,"type":"text","value":"https://www.sofia.bg/"},{"field_id":"TED-INFO_ADD","lang":"BG","ordinal":0,"type":"text","value":"Получените оферти се отварят в ЦАИС в посочените в Обявлението дата и час."},{"field_id":"TED-INFO_ADD","lang":"BG","ordinal":1,"type":"text","value":"1. За участниците в процедурата не трябва да са на лице основанията за отстраняване, посочени в чл.54, ал.1, т.1,т. 2, т.3, т. 4, т.5, т.6 и т.7 от ЗОП ,чл.55, ал.1, т.1 и т.4 и чл.107 от ЗОП."},{"field_id":"TED-INFO_ADD","lang":"BG","ordinal":2,"type":"text","value":"2. За участниците не трябва да важат забраните, посочени в чл. 3, т. 8 от Закона за икономическите и финансовите отношения с дружествата, регистрирани в юрисдикции с преференциален данъчен режим,контролираните от тях лица и техните действителни собственици, както и обстоятелства по чл.69 от Закона за противодействие на корупцията и за отнемане на незаконно придобитото имущество (ЗПКОНПИ)."},{"field_id":"TED-INFO_ADD","lang":"BG","ordinal":3,"type":"text","value":"3. Свързани лица по смисъла на §2, т.45 от Допълнителните разпоредби на ЗОП не могат да бъдат самостоятелни участници в една и съща обособена позиция от процедурата."},{"field_id":"TED-INFO_ADD","lang":"BG","ordinal":4,"type":"text","value":"4. При подаване на офертата участникът декларира липсата на основанията а отстраняване и съответствието с критериите за подбор чрез предоставяне на ЕЕДОП. Съгласно чл. 67, ал. 4 от ЗОП, ЕЕДОП се представя в електронен вид, като трябва да бъде подписан с квалифициран електронен подпис от съответните задължени лица по чл. 54, ал. 2 от ЗОП, във връзка с чл. 40 от ППЗОП."},{"field_id":"TED-INFO_ADD","lang":"BG","ordinal":5,"type":"text","value":"5. В случай, че участникът е обединение, което не е юридическо лице, към заявлението за участие се представя копие от документ за създаване на обединението, както и следната информация във връзка с настоящата обществена поръчка:"},{"field_id":"TED-INFO_ADD","lang":"BG","ordinal":6,"type":"text","value":"- правата и задълженията на участниците в обединението;"},{"field_id":"TED-INFO_ADD","lang":"BG","ordinal":7,"type":"text","value":"- уговаряне на солидарна отговорност, когато такава не е предвидена съгласно приложимото законодателство."},{"field_id":"TED-INFO_ADD","lang":"BG","ordinal":8,"type":"text","value":"- дейностите, които ще изпълнява всеки член на обединението;"},{"field_id":"TED-INFO_ADD","lang":"BG","ordinal":9,"type":"text","value":"- лицето, което е упълномощено да представлява обединението;"},{"field_id":"TED-INFO_ADD","lang":"BG","ordinal":10,"type":"text","value":"6. Лице, което участва в обединение или е дало съгласие и фигурира като подизпълнител в офертата на друг участник, не може да представя самостоятелна оферта.(прилага се отделно за всяка от обособените позиции)."},{"field_id":"TED-INFO_ADD","lang":"BG","ordinal":11,"type":"text","value":"7.  В съответствие с чл. 67, ал. 5 от ЗОП възложителят може да изиска от участниците по всяко време след отварянето на офертите да представят всички или част от документите, чрез които се доказва информацията, посочена в ЕЕДОП, когато това е необходимо за законосъобразното възлагане на поръчката."},{"field_id":"TED-INFO_ADD","lang":"BG","ordinal":12,"type":"text","value":"8. При подписване на договора определения изпълнител е длъжен да представи документи в съответствие с чл.112 ал. 1 от ЗОП."},{"field_id":"TED-INFO_ADD","lang":"BG","ordinal":13,"type":"text","value":"9. На оценка подлежи посочената в ценовото предложение обща стойност формирана на база предложените единични цени и посочените прогнозни количества за 24 месеца."},{"code":"01","field_id":"TED-INITIATOR","list":null,"ordinal":0,"type":"code"},{"code":"BG","field_id":"TED-ISO_COUNTRY","list":null,"ordinal":0,"type":"code"},{"code":"BG","field_id":"TED-LANGUAGE","list":null,"ordinal":0,"type":"code"},{"code":"32014L0024","field_id":"TED-LEGAL_BASIS","list":null,"ordinal":0,"type":"code"},{"code":"BG","field_id":"TED-LG_ORIG","list":null,"ordinal":0,"type":"code"},{"field_id":"TED-LOT_ALL","ordinal":0,"type":"integer","value":1},{"field_id":"TED-LOT_DIVISION","ordinal":0,"type":"integer","value":1},{"code":"S","field_id":"TED-MA_MAIN_ACTIVITIES","list":null,"ordinal":0,"type":"code"},{"code":"2","field_id":"TED-NC_CONTRACT_NATURE","list":null,"ordinal":0,"type":"code"},{"field_id":"TED-NO_CONTRACT_COVERED_GPA","ordinal":0,"type":"integer","value":1},{"field_id":"TED-NO_DOC_OJS","is_ref":false,"ordinal":0,"scheme":null,"type":"id","value":"2023/S 119-374339"},{"field_id":"TED-NO_OJ","ordinal":0,"type":"integer","value":119},{"field_id":"TED-NO_RECURRENT_PROCUREMENT","ordinal":0,"type":"integer","value":1},{"code":"44440000","field_id":"TED-ORIGINAL_CPV","ordinal":0,"scheme":"cpv","type":"classification"},{"code":"34312700","field_id":"TED-ORIGINAL_CPV","ordinal":1,"scheme":"cpv","type":"classification"},{"field_id":"TED-PERFORMANCE_CONDITIONS","lang":"BG","ordinal":0,"type":"text","value":"1. Гаранцията за изпълнение е в размер на 3 % от прогнозната стойност на договора без ДДС и се освобождава съгласно условията в проекта на договор. Гаранцията се предоставят под формата на парична сума, банкова гаранция или застраховка, която обезпечава изпълнението. Прогнозната стойност на договора е прогнозната стойност на съответната обособена позиция."},{"code":"BG411","field_id":"TED-PERFORMANCE_NUTS","ordinal":0,"scheme":"nuts","type":"classification"},{"field_id":"TED-PLACE","lang":"BG","ordinal":0,"type":"text","value":"В системата"},{"code":"1","field_id":"TED-PR_PROC","list":null,"ordinal":0,"type":"code"},{"field_id":"TED-PT_OPEN","ordinal":0,"type":"integer","value":1},{"field_id":"TED-RECEPTION_ID","is_ref":false,"ordinal":0,"scheme":null,"type":"id","value":"23-383010-001"},{"field_id":"TED-REVIEW_PROCEDURE","lang":"BG","ordinal":0,"type":"text","value":"Съгласно чл.197, ал.1, т.1 от ЗОП."},{"code":"4","field_id":"TED-RP_REGULATION","list":null,"ordinal":0,"type":"code"},{"field_id":"TED-SHORT_DESCR","lang":"BG","ordinal":0,"type":"text","value":"„Доставка на лагери и комплектоващи елементи за лагерни възли за нуждите ОП „Столично предприятие за третиране на отпадъци“ (ОП СПТО)“ по две обособени позиции\""},{"field_id":"TED-SUITABILITY","lang":"BG","ordinal":0,"type":"text","value":"В настоящата обществена поръчка няма поставени изисквания за годност (правоспособност) за упражняване на професионална дейност."},{"code":"3","field_id":"TED-TD_DOCUMENT_TYPE","list":null,"ordinal":0,"type":"code"},{"field_id":"TED-TECHNICAL_PROFESSIONAL_INFO","lang":"BG","ordinal":0,"type":"text","value":"1. Всеки участник трябва да има опит за изпълнение на поръчката."},{"field_id":"TED-TECHNICAL_PROFESSIONAL_INFO","lang":"BG","ordinal":1,"type":"text","value":"През последните 3 години, считано от датата на подаване на офертата да е изпълнил дейности с предмет, идентичен или сходен с този на поръчка."},{"field_id":"TED-TECHNICAL_PROFESSIONAL_INFO","lang":"BG","ordinal":2,"type":"text","value":"За „сходни с предмета на поръчката“ се приемат дейности както следва:"},{"field_id":"TED-TECHNICAL_PROFESSIONAL_INFO","lang":"BG","ordinal":3,"type":"text","value":"Обособена позиция №1:  доставка на лагери;"},{"field_id":"TED-TECHNICAL_PROFESSIONAL_INFO","lang":"BG","ordinal":4,"type":"text","value":"Обособена позиция №2:  доставка на ремъци и семеринги."},{"field_id":"TED-TECHNICAL_PROFESSIONAL_INFO","lang":"BG","ordinal":5,"type":"text","value":"1.1. При подаване на оферта, съответствието с изискването по т.1, участникът декларира в Част IV: Критерии за подбор, буква В: Технически и професионални способности на Единния европейски документ за обществени поръчки (ЕЕДОП), като посочва стойностите, датите и получателите на изпълнените дейности."},{"field_id":"TED-TECHNICAL_PROFESSIONAL_INFO","lang":"BG","ordinal":6,"type":"text","value":"1.2. Доказването на съответствието с изискването по т.1. става със списък на дейностите, които са идентични или сходни с предмета на обособената позиция, с посочване на стойностите, датите и получателите, заедно с документи, които доказват извършената доставка, съгласно чл. 64, ал. 1, т. 2 от ЗОП."},{"field_id":"TED-TECHNICAL_PROFESSIONAL_INFO","lang":"BG","ordinal":7,"type":"text","value":"Документите могат да бъдат удостоверения, издадени от получателя или от компетентен орган и други по преценка на участника."},{"field_id":"TED-TITLE","lang":"BG","ordinal":0,"type":"text","value":"„Доставка на лагери и комплектоващи елементи за лагерни възли за нуждите ОП „Столично предприятие за третиране на отпадъци“ (ОП СПТО)“ по две обособени позиции\""},{"field_id":"TED-TI_CY","lang":"BG","ordinal":0,"type":"text","value":"България"},{"field_id":"TED-TI_CY","lang":"CS","ordinal":1,"type":"text","value":"Bulharsko"},{"field_id":"TED-TI_CY","lang":"DA","ordinal":2,"type":"text","value":"Bulgarien"},{"field_id":"TED-TI_CY","lang":"DE","ordinal":3,"type":"text","value":"Bulgarien"},{"field_id":"TED-TI_CY","lang":"EL","ordinal":4,"type":"text","value":"Βουλγαρία"},{"field_id":"TED-TI_CY","lang":"EN","ordinal":5,"type":"text","value":"Bulgaria"},{"field_id":"TED-TI_CY","lang":"ES","ordinal":6,"t