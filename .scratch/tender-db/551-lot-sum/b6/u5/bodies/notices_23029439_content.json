{"notice_id":23029439,"sections":[{"kind":"Lot","parent_section_id":"PROCEDURE","section_id":"LOT-1","values":[{"code":"45210000","field_id":"TED-CPV_CODE","ordinal":0,"scheme":"cpv","type":"classification"},{"code":"45215100","field_id":"TED-CPV_CODE","ordinal":1,"scheme":"cpv","type":"classification"},{"field_id":"TED-DURATION","ordinal":0,"type":"number","unit":"MONTH","value":4.0},{"field_id":"TED-EU_PROGR_RELATED","lang":"HU","ordinal":0,"type":"text","value":"EFOP-2.2.0-16-2016-00008 ”Pszichiátriai és addiktológiai gondozóhálózat fejlesztése”"},{"field_id":"TED-LOT_NO","is_ref":false,"ordinal":0,"scheme":null,"type":"id","value":"7"},{"field_id":"TED-MAIN_SITE","lang":"HU","ordinal":0,"type":"text","value":"7100 Szekszárd Béri Balogh Ádám utca 5-7."},{"code":"HU23","field_id":"TED-NUTS","ordinal":0,"scheme":"nuts","type":"classification"},{"field_id":"TED-SHORT_DESCR","lang":"HU","ordinal":0,"type":"text","value":"Építési beruházás az ÁEEK fenntartása alá tartozó épületek vonatkozásában."},{"field_id":"TED-SHORT_DESCR","lang":"HU","ordinal":1,"type":"text","value":"Tolna Megyei Balassa János Kórház"},{"field_id":"TED-SHORT_DESCR","lang":"HU","ordinal":2,"type":"text","value":"7100 Szekszárd, Béri Balogh Ádám utca 5."},{"field_id":"TED-SHORT_DESCR","lang":"HU","ordinal":3,"type":"text","value":"Épület: Pszichiátria , Emelet: Földszint."},{"field_id":"TED-SHORT_DESCR","lang":"HU","ordinal":4,"type":"text","value":"Helyrajzi szám: 4727/7"},{"field_id":"TED-SHORT_DESCR","lang":"HU","ordinal":5,"type":"text","value":"Hasznos nettó alapterület: 363,69 m2"},{"field_id":"TED-SHORT_DESCR","lang":"HU","ordinal":6,"type":"text","value":"Építési engedélyköteles: nem"},{"field_id":"TED-SHORT_DESCR","lang":"HU","ordinal":7,"type":"text","value":"Főbb munkanemek felsorolása:"},{"field_id":"TED-SHORT_DESCR","lang":"HU","ordinal":8,"type":"text","value":"- padlócsatorna felbontása, csatornában lévő vezetékek cseréje, közlekedők álmennyezeteinek bontása,"},{"field_id":"TED-SHORT_DESCR","lang":"HU","ordinal":9,"type":"text","value":"- épületszárny külső nyílászáróinak (18 db) és belső ajtók (37 db) cseréje, meglévő műanyag ablakok felújítása (12 db),"},{"field_id":"TED-SHORT_DESCR","lang":"HU","ordinal":10,"type":"text","value":"- új padlóburkolat és vakolatjavítás, glettelés és festés valamint burkolatcsere,"},{"field_id":"TED-SHORT_DESCR","lang":"HU","ordinal":11,"type":"text","value":"- vizesblokkok teljes körű felújítása,"},{"field_id":"TED-SHORT_DESCR","lang":"HU","ordinal":12,"type":"text","value":"- beépített szekrények felújítása, új szekrényajtó gyártása konszignációs terv szerint,"},{"field_id":"TED-SHORT_DESCR","lang":"HU","ordinal":13,"type":"text","value":"- új teakonyha kiépítése, vizes blokkok teljes felújítása,"},{"field_id":"TED-SHORT_DESCR","lang":"HU","ordinal":14,"type":"text","value":"- split rendszerű berendezések telepítése,"},{"field_id":"TED-SHORT_DESCR","lang":"HU","ordinal":15,"type":"text","value":"- fűtőtestek áthelyezése az ablakok alá, illetve a vizes terek szellőztetésének megoldása páraszabályozott szellőztető rendszerekel,"},{"field_id":"TED-SHORT_DESCR","lang":"HU","ordinal":16,"type":"text","value":"- belső világításkorszerűsítés LED lámpatestekkel,"},{"field_id":"TED-SHORT_DESCR","lang":"HU","ordinal":17,"type":"text","value":"- klíma kültéri és beltéri egységek részére erőátviteli betáplálás kiépítése."},{"field_id":"TED-SHORT_DESCR","lang":"HU","ordinal":18,"type":"text","value":"A részletes feladatok leírását az ajánlati felhívást kiegészítő közbeszerzési dokumentumok tartalmazzák, melynek részét képezi a külön elektronikus mellékletben rendelkezésre bocsátott - helyszínenkénti bontású - Komplett kiviteli tervdokumentáció."},{"field_id":"TED-TITLE","lang":"HU","ordinal":0,"type":"text","value":"Szekszárd"}]},{"kind":"Modification","parent_section_id":"PROCEDURE","section_id":"MOD-1","values":[{"field_id":"TED-DESCRIPTION_PROCUREMENT.ADDRESS_CONTRACTOR","is_ref":true,"ordinal":0,"scheme":null,"type":"