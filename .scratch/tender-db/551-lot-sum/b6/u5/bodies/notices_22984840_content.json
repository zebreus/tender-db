múltával kezdődhetett meg, így jelentős késedelemmel tudta Vállalkozó a kivitelezési feladatokat megkezdeni."},{"field_id":"TED-INFO_MODIFICATIONS.UNFORESEEN_CIRCUMSTANCE","lang":"HU","ordinal":1,"type":"text","value":"Kbt. 141.§ (4) c) alapján történt a módosítás"},{"code":"YES","field_id":"TED-INFO_MODIFICATIONS.VALUES.PUBLICATION","list":null,"ordinal":0,"type":"code"},{"cents":6281763000,"currency":"HUF","field_id":"TED-INFO_MODIFICATIONS.VAL_TOTAL_AFTER","ordinal":0,"type":"amount"},{"cents":6281763000,"currency":"HUF","field_id":"TED-INFO_MODIFICATIONS.VAL_TOTAL_BEFORE","ordinal":0,"type":"amount"}]},{"kind":"Organization","parent_section_id":"PROCEDURE","section_id":"ORG-1","values":[{"field_id":"TED-ADDRESS","lang":"HU","ordinal":0,"type":"text","value":"Diós árok 3"},{"field_id":"TED-CONTACT_POINT","lang":"HU","ordinal":0,"type":"text","value":"Erdei Csaba"},{"code":"HU","field_id":"TED-COUNTRY","list":null,"ordinal":0,"type":"code"},{"field_id":"TED-E_MAIL","lang":"HU","ordinal":0,"type":"text","value":"erdei.csaba@aeek.hu"},{"field_id":"TED-FAX","lang":"HU","ordinal":0,"type":"text","value":"+36 13757253"},{"field_id":"TED-NATIONALID","is_ref":false,"ordinal":0,"scheme":"national","type":"id","value":"EKRSZ_22462134"},{"code":"HU110","field_id":"TED-NUTS","ordinal":0,"scheme":"nuts","type":"classification"},{"field_id":"TED-OFFICIALNAME","lang":"HU","ordinal":0,"type":"text","value":"Országos Kórházi Főigazgatóság"},{"field_id":"TED-PHONE","lang":"HU","ordinal":0,"type":"text","value":"+36 13561522"},{"field_id":"TED-POSTAL_CODE","lang":"HU","ordinal":0,"type":"text","value":"1125"},{"field_id":"TED-TOWN","lang":"HU","ordinal":0,"type":"text","value":"Budapest"},{"field_id":"TED-URL_GENERAL","lang":"HU","ordinal":0,"type":"text","value":"http://www.aeek.hu"}]},{"kind":"Organization","parent_section_id":"RES-1","section_id":"ORG-2","values":[{"field_id":"TED-ADDRESS","lang":"HU","ordinal":0,"type":"text","value":"Hrsz. 0138/1.  hrsz. 0138/1."},{"code":"HU"