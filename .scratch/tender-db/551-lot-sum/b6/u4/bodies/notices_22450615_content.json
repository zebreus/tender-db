n. El adjudicatario también elaborará y se hará cargo de los gastos que originen cuantos estudios, informes técnicos y/o proyectos propuestos por la propiedad sean necesarios para el desarrollo de los trabajos objeto del contrato, según se detalla en el Pliego de Prescripciones Técnicas."},{"code":"7","field_id":"TED-TD_DOCUMENT_TYPE","list":null,"ordinal":0,"type":"code"},{"code":"ES300","field_id":"TED-TENDERER_NUTS","ordinal":0,"scheme":"nuts","type":"classification"},{"field_id":"TED-TITLE","lang":"ES","ordinal":0,"type":"text","value":"SERVICIO DE AYUDAS A LA REPARACIÓN, CONSERVACIÓN Y MANTENIMIENTO DE LOS EDIFICIOS, BIENES, ENSERES Y ÁREAS EXTERIORES DEL COMPLEJO SANITARIO DEL HOSPITAL UNIVERSITARIO 12 DE OCTUBRE Y DE LOS CENTROS A"},{"field_id":"TED-TI_CY","lang":"BG","ordinal":0,"type":"text","value":"Иcпaния"},{"field_id":"TED-TI_CY","lang":"CS","ordinal":1,"type":"text","value":"Španělsko"},{"field_id":"TED-TI_CY","lang":"DA","ordinal":2,"type":"text","value":"Spanien"},{"field_id":"TED-TI_CY","lang":"DE","ordinal":3,"type":"text","value":"Spanien"},{"field_id":"TED-TI_CY","lang":"EL","ordinal":4,"type":"text","value":"Ισπανία"},{"field_id":"TED-TI_CY","lang":"EN","ordinal":5,"type":"text","value":"Spain"},{"field_id":"TED-TI_CY","lang":"ES","ordinal":6,"type":"text","value":"España"},{"field_id":"TED-TI_CY","lang":"ET","ordinal":7,"type":"text","value":"Hispaania"},{"field_id":"TED-TI_CY","lang":"FI","ordinal":8,"type":"text","value":"Espanja"},{"field_id":"TED-TI_CY","lang":"FR","ordinal":9,"type":"text","value":"Espagne"},{"field_id":"TED-TI_CY","lang":"GA","ordinal":10,"type":"text","value":"Spáinn, an"},{"field_id":"TED-TI_CY","lang":"HR","ordinal":11,"type":"text","value":"Španjolska"},{"field_id":"TED-TI_CY","lang":"HU","ordinal":12,"type":"text","value":"Spanyolország"},{"field_id":"TED-TI_CY","lang":"IT","ordinal":13,"type":"text","value":"Spagna"},{"field_id":"TED-TI_CY","lang":"LT","ordinal":14,"type":"text","value":"Ispanija"},{"field_id":"TED-