g":"PL","ordinal":0,"type":"text","value":"02-676"},{"field_id":"TED-TOWN","lang":"PL","ordinal":0,"type":"text","value":"Warszawa"},{"field_id":"TED-URL","lang":"PL","ordinal":0,"type":"text","value":"www.gov.pl/web/uzp/krajowa-izba-odwolawcza"}]},{"kind":"Notice","parent_section_id":null,"section_id":"PROCEDURE","values":[{"code":"8","field_id":"TED-AA_AUTHORITY_TYPE","list":null,"ordinal":0,"type":"code"},{"field_id":"TED-AA_NAME","lang":"PL","ordinal":0,"type":"text","value":"Województwo Mazowieckie"},{"code":"2","field_id":"TED-AC_AWARD_CRIT","list":null,"ordinal":0,"type":"code"},{"field_id":"TED-ADDRESS_CONTRACTING_BODY","is_ref":true,"ordinal":0,"scheme":null,"type":"id","value":"ORG-1"},{"field_id":"TED-ADDRESS_MEDIATION_BODY","is_ref":true,"ordinal":0,"scheme":null,"type":"id","value":"ORG-4"},{"field_id":"TED-ADDRESS_REVIEW_BODY","is_ref":true,"ordinal":0,"scheme":null,"type":"id","value":"ORG-3"},{"field_id":"TED-ADDRESS_REVIEW_INFO","is_ref":true,"ordinal":0,"scheme":null,"type":"id","value":"ORG-5"},{"code":"GENERAL_PUBLIC_SERVICES","field_id":"TED-CA_ACTIVITY","list":null,"ordinal":0,"type":"code"},{"code":"PL9","field_id":"TED-CA_CE_NUTS","ordinal":0,"scheme":"nuts","type":"classification"},{"field_id":"TED-CA_TYPE_OTHER","lang":"PL","ordinal":0,"type":"text","value":"administracja samorządowa"},{"code":"S","field_id":"TED-COLL_OJ","list":null,"ordinal":0,"type":"code"},{"code":"79822500","field_id":"TED-CPV_CODE","ordinal":0,"scheme":"cpv","type":"classification"},{"field_id":"TED-DATE_DISPATCH_NOTICE","ordinal":0,"type":"date","value":"2023-11-23"},{"field_id":"TED-DATE_PUB","ordinal":0,"type":"date","value":"2023-11-28"},{"field_id":"TED-DS_DATE_DISPATCH","ordinal":0,"type":"date","value":"2023-11-23"},{"code":"F03","field_id":"TED-FORM","list":null,"ordinal":0,"type":"code"},{"code":"01C03","field_id":"TED-HEADING","list":null,"ordinal":0,"type":"code"},{"field_id":"TED-IA_URL_GENERAL","lang":null,"ordinal":0,"type":"text","value":"http://www.mazovia.pl"},{"field_id":"TED-INFO_ADD","lang":"PL","ordinal":0,"type":"text","value":"1. Komunikacja między Zamawiającym a Wykonawcami, w tym składanie oświadczeń, wniosków, zawiadomień oraz informacji odbywa się elektronicznie za pośrednictwem Platformy Zakupowej https://platformazakupowa.pl/pn/mazovia."},{"field_id":"TED-INFO_ADD","lang":"PL","ordinal":1,"type":"text","value":"2. Wykonawca składa ofertę w formie elektronicznej za pośrednictwem Platformy Zakupowej wraz z załącznikami:"},{"field_id":"TED-INFO_ADD","lang":"PL","ordinal":2,"type":"text","value":"1) wstępne oświadczenie o niepodleganiu wykluczeniu oraz spełnianiu warunków udziału w postępowaniu-JEDZ;"},{"field_id":"TED-INFO_ADD","lang":"PL","ordinal":3,"type":"text","value":"2) gdy Wykonawcę reprezentuje pełnomocnik - pełnomocnictwo w formie elektronicznej."},{"field_id":"TED-INFO_ADD","lang":"PL","ordinal":4,"type":"text","value":"3. .Zalecenie w odniesieniu do kwalifikowanego podpisu elektronicznego:"},{"field_id":"TED-INFO_ADD","lang":"PL","ordinal":5,"type":"text","value":"1)do danych zawierających dokumenty tekstowe, tekstowo-graficzne lub multimedialne zaleca się przede wszystkim stosowanie formatu danych .pdf,"},{"field_id":"TED-INFO_ADD","lang":"PL","ordinal":6,"type":"text","value":"2)dokumenty w formacie innym niż .pdf zaleca się, w miarę możliwości, konwertować do formatu .pdf,"},{"field_id":"TED-INFO_ADD","lang":"PL","ordinal":7,"type":"text","value":"3)dla dokumentów w formacie .pdf zaleca się podpis w formacie PAdES,"},{"field_id":"TED-INFO_ADD","lang":"PL","ordinal":8,"type":"text","value":"4)w przypadku składania dokumentów w formacie innym niż .pdf (np. .doc, .docx), zaleca się stosować podpis w formacie XAdES o typie zewnętrznym. W takim wypadku należy przekazać Zamawiającemu plik z podpisywaną treścią oraz plik z rozszerzeniem XAdES o tej samej nazwie (2 pliki),"},{"field_id":"TED-INFO_ADD","lang":"PL","ordinal":9,"type":"text","value":"5)kwalifikowany podpis elektroniczny oznacza zaawansowany podpis elektroniczny, składany za pomocą kwalifikowanego urządzenia do składania podpisu elektronicznego i który opiera się na kwalifikowanym certyfikacie podpisu elektronicznego; ePUAP (podpis zaufany) nie jest certyfikowanym podpisem kwalifikowanym i nie ma zastosowania w przedmiotowym postępowaniu."},{"field_id":"TED-INFO_ADD","lang":"PL","ordinal":10,"type":"text","value":"6.Wykonawca ma prawo zastrzec, wraz z ich przekazaniem, informacje stanowiące tajemnicę przedsiębiorstwa. Do skutecznego objęcia określonych informacji tajemnicą przedsiębiorstwa wymagane jest, aby Wykonawca określił jaki zakres informacji objętych jest klauzulą poufności i uzasadnił, że zastrzegane informacje stanowią tajemnicę."},{"field_id":"TED-INFO_ADD","lang":"PL","ordinal":11,"type":"text","value":"7. Wykonawcy mogą wspólnie ubiegać się o udzielenie zamówienia; w tym przypadku ustanawiają pełnomocnika do reprezentowania ich w postępowaniu o udzielenie zamówienia albo do reprezentowania w postępowaniu i zawarcia umowy."},{"code":"01","field_id":"TED-INITIATOR","list":null,"ordinal":0,"type":"code"},{"code":"PL","field_id":"TED-ISO_COUNTRY","list":null,"ordinal":0,"type":"code"},{"code":"32014L0024","field_id":"TED-LEGAL_BASIS","list":null,"ordinal":0,"type":"code"},{"code":"PL","field_id":"TED-LG_ORIG","list":null,"ordinal":0,"type":"code"},{"field_id":"TED-LOT_DIVISION","ordinal":0,"type":"integer","value":1},{"code":"S","field_id":"TED-MA_MAIN_ACTIVITIES","list":null,"ordinal":0,"type":"code"},{"code":"4","field_id":"TED-NC_CONTRACT_NATURE","list":null,"ordinal":0,"type":"code"},{"field_id":"TED-NOTICE_NUMBER_OJ","is_ref":true,"ordinal":0,"scheme":"ojs","type":"id","value":"2023/S 132-420106"},{"code":"THIS_PROCEDURE","field_id":"TED-NOTICE_NUMBER_OJ.PREV_KIND","list":null,"ordinal":0,"type":"code"},{"field_id":"TED-NO_CONTRACT_COVERED_GPA","ordinal":0,"type":"integer","value":1},{"field_id":"TED-NO_DOC_OJS","is_ref":false,"ordinal":0,"scheme":null,"type":"id","value":"2023/S 