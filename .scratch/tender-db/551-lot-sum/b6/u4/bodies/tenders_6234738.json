ion_name":"SEL-TECH","role":"winner"}]},{"awarded":{"cents":2493000,"currency":"EUR"},"decided":"2018-08-06","decision":"selec-w","key":"RES-1","lot":"LOT-1","notice_id":20033617,"reason":null,"statistics":{"tenders":2},"statistics_withheld":0,"winners":[{"organization_id":1182648,"organization_name":"Léon Noël Sas","role":"winner"}]}],"lots":2,"notice_subtype":null,"original_lang":"FRA","parties":[{"lot":null,"mention_name":"UDAP de la Marne","organization_id":11761953,"organization_name":"UDAP de la Marne","role":"buyer"},{"lot":null,"mention_name":"Tribunal administratif de Châlons-en-Champagne","organization_id":1163650,"organization_name":"Tribunal administratif de Châlons-en-Champagne","role":"review-body"},{"lot":"LOT-1","mention_name":"Léon Noël SAS","organization_id":1182648,"organization_name":"Léon Noël Sas","role":"winner"},{"lot":"LOT-2","mention_name":"SEL-TECH","organization_id":12222184,"organization_name":"SEL-TECH","role":"winner"}],"procedure_key":"ojs:2018-272233","procedure_type":"open","publication_id":"417856-2018","published_at":"2018-09-26","source":"ted","submission_deadline":"2018-07-25T17:30:00+00:00","submission_deadline_scope":"procedure","texts":[{"field":"description","lang":"FRA","lot":null,"value":"La première travée de la nef, derrière le grand pignon du Gloria entre les 2 tours occidentales, est couverte par une terrasse en béton armé réalisée en 1906 lors de la campagne de restauration de la rose occidentale. Cette terrasse desservie par les tours occidentales est empruntée par le public lors des visites guidées. La surface de la dalle, très peu exposée au soleil et soumise aux salissures constantes des oiseaux, devient trop souvent glissante et la dalle pourtant de forte épaisseur, mais légèrement fissurée, est devenue fuyarde au cours du temps. L'objet des travaux est de répondre à ces 2 inconvénients en mettant en place une étanchéité antidérapante sur cette dalle de béton armé."},{"field":"title","lang":"FRA","lot":null,"value":"Cathédrale Notre-Dame de Reims — Étanchéité de la terrasse entre les 2 tours occidentales"},{"field":"description","lang":"FRA","lot":"LOT-1","value":"— Réalisation d'une dalle en béton armé de 16 cm d'épaisseur, en remplacement des lanterneaux en briques de verre précédemment déposés."},{"field":"description","lang":"FRA","lot":"LOT-1","value":"— nettoyage de la dalle béton,"},{"field":"description","lang":"FRA","lot":"LOT-1","value":"— ragréage,"},{"field":"title","lang":"FRA","lot":"LOT-1","value":"Maçonnerie"},{"field":"description","lang":"FRA","lot":"LOT-2","value":"Fourniture et mise en œuvre d'une étanchéité liquide avec charge minérale."},{"field":"description","lang":"FRA","lot":"LOT-2","value":"Fourniture et pose de bandes antidérapantes reprenant le dessin du labyrinthe de Reims."},{"field":"title","lang":"FRA","lot":"LOT-2","value":"Étanchéité"}],"title":"Cathédrale Notre-Dame de Reims — Étanchéité de la terrasse entre les 2 tours occidentales","value":{"cents":2493000,"currency":"EUR"},"value_derivation":null,"version":3,"versions":[{"caused_by_notice_id":19893804,"dispatched_at":"2018-06-22","notice_subtype":null,"original_lang":"FRA","publication_id":"272233-2018","published_at":"2018-06-26","seq":1},{"caused_by_notice_id":20033615,"dispatched_at":"2018-09-24","notice_subtype":null,"original_lang":"FRA","publication_id":"417854-2018","published_at":"2018-09-26","seq":2},{"caused_by_notice_id":20033617,"dispatched_at":"2018-09-24","notice_subtype":null,"original_lang":"FRA","publication_id":"417856-2018","published_at":"2018-09-26","seq":3}]}