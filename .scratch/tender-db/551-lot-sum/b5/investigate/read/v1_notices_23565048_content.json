":"text","value":"7241CJ"},{"field_id":"BT-513-Organization-Company","lang":null,"ordinal":0,"type":"text","value":"LOCHEM"},{"code":"NLD","field_id":"BT-514-Organization-Company","list":"country","ordinal":0,"type":"code"},{"field_id":"OPT-200-Organization-Company","is_ref":false,"ordinal":0,"scheme":"organization","type":"id","value":"ORG-0001"}]},{"kind":"Notice","parent_section_id":null,"section_id":"PROCEDURE","values":[{"code":"32014L0024","field_id":"BT-01-notice","list":null,"ordinal":0,"type":"code"},{"code":"cn-standard","field_id":"BT-02-notice","list":"competition","ordinal":0,"type":"code"},{"field_id":"BT-04-notice","is_ref":false,"ordinal":0,"scheme":null,"type":"id","value":"422f6867-3b9a-4179-abe7-ab56c5293de3"},{"field_id":"BT-05(a)-notice","ordinal":0,"type":"date","value":"2023-11-27T10:16:20+01:00"},{"code":"open","field_id":"BT-105-Procedure","list":"procurement-procedure-type","ordinal":0,"type":"code"},{"code":"false","field_id":"BT-106-Procedure","list":"accelerated-procedure","ordinal":0,"type":"code"},{"field_id":"BT-21-Procedure","lang":"NLD","ordinal":0,"type":"text","value":"Drukwerk"},{"code":"supplies","field_id":"BT-23-Lot","list":"contract-nature","ordinal":0,"type":"code"},{"field_id":"BT-24-Procedure","lang":"NLD","ordinal":0,"type":"text","value":"De aan te besteden opdracht betreft het drukwerk voor Zone.college conform de gevraagde specificaties. Daarnaast wenst Opdrachtgever een webbased systeem (DTPsysteem) dat Zone.college in staat stelt om het druk- en printwerk, in de breedste zin van het woord, eenvoudig en digitaal te creëren en beheren. Indien noodzakelijk, kan er ook voor Groei.zone (onderdeel van Zone.college) drukwerk afgenomen worden. De Opdrachtnemer adviseert doorlopend en proactief en treedt tevens op als partner op het gebied van communicatiemiddelontwikkelingen.\n\nDe opdracht is verdeeld in twee percelen. \nPerceel 1: Kantoordrukwerk (huisstijldruk en briefpapier) \nPerceel 2: Wervings- en voorlichtingsdruk- en printwerk \n\nInschrijvers kunnen inschrijven op beide percelen. Het is mogelijk om in beide percelen gecontracteerd te worden. De maximale omvang van de opdracht is bij benadering als volgt:\n-\tPerceel 1: € 160.000 inclusief btw\n-\tPerceel 2: € 200.000 inclusief btw\n\nAan deze bedragen kunnen geen rechten worden ontleend. De omvang van de gevraagde dienstverlening zal afhangen van de behoeft van Zone.college en kan per jaar verschillen. Dit is mede afhankelijk van het aantal leerlingen en studenten.\n\nDe omvang van de opdracht is zo nauwkeurig mogelijk bepaald. Indien de opgegeven omvang eerder wordt gerealiseerd dan de einddatum van de raamovereenkomst wordt de opdracht (voortijdig) opnieuw aanbesteed."},{"field_id":"BT-701-notice","is_ref":false,"ordinal":0,"scheme":"notice-id","type":"id","value":"18470e06-e023-4bad-afd7-885ba8223787"},{"code":"NLD","field_id":"BT-702(a)-notice","list":"language","ordinal":0,"type":"code"},{"field_id":"BT-757-notice","is_ref":false,"ordinal":0,"scheme":null,"type":"id","value":"01"},{"code":"all","field_id":"BT-763-Procedure","list":"tenderlot-presentation","ordinal":0,"type":"code"},{"field_id":"OPP-010-notice","is_ref":false,"ordinal":0,"scheme":"ojs-notice-id","type":"id","value":"00721645-2023"},{"field_id":"OPP-011-notice","is_ref":false,"ordinal":0,"scheme":"ojs-id","type":"id","value":"229/2023"},{"field_id":"OPP-012-notice","ordinal":0,"type":"date","value":"2023-11-28"},{"code":"16","field_id":"OPP-070-notice","list":"notice-subtype","ordinal":0,"type":"code"},{"field_id":"OPT-001-notice","is_ref":false,"ordinal":0,"scheme":null,"type":"id","value":"2.3"},{"field_id":"OPT-002-notice","is_ref":false,"ordinal":0,"scheme":null,"type":"id","value":"eforms-sdk-1.7"}]},{"kind":"Touchpoint","parent_section_id":"ORG-0001","section_id":"TPO-0001","values":[{"field_id":"BT-500-Organization-TouchPoint","lang":"NLD","ordinal":0,"type":"text","value":"Rechtbank Gelderland Arrondissement Zutphen"},{"field_id":"BT-503-Organizati