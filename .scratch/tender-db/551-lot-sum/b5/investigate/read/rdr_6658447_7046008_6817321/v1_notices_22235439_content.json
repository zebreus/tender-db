ükséges tolmács költsége az ajánlattevőt terheli. Az ajánlatkérő a nem magyar nyelven benyújtott dokumentumok ajánlattevő általi fordítását is elfogadja, a Kbt. 47. § (2) bek. szerint."},{"field_id":"TED-REVIEW_PROCEDURE","lang":"HU","ordinal":3,"type":"text","value":"A közbeszerzési dokumentumokban megadott valamennyi határidő közép-európai (CET) idő szerint értendő."},{"code":"4","field_id":"TED-RP_REGULATION","list":null,"ordinal":0,"type":"code"},{"code":"K","field_id":"TED-TD_DOCUMENT_TYPE","list":null,"ordinal":0,"type":"code"},{"code":"HU331","field_id":"TED-TENDERER_NUTS","ordinal":0,"scheme":"nuts","type":"classification"},{"field_id":"TED-TITLE","lang":"HU","ordinal":0,"type":"text","value":"Élelmiszer-alapanyagok beszerzése 24 hónapra"},{"field_id":"TED-TI_CY","lang":"BG","ordinal":0,"type":"text","value":"Унгapия"},{"field_id":"TED-TI_CY","lang":"CS","ordinal":1,"type":"text","value":"Maďarsko"},{"field_id":"TED-TI_CY","lang":"DA","ordinal":2,"type":"text","value":"Ungarn"},{"field_id":"TED-TI_CY","lang":"DE","ordinal":3,"type":"text","value":"Ungarn"},{"field_id":"TED-TI_CY","lang":"EL","ordinal":4,"type":"text","value":"Ουγγαρία"},{"field_id":"TED-TI_CY","lang":"EN","ordinal":5,"type":"text","value":"Hungary"},{"field_id":"TED-TI_CY","lang":"ES","ordinal":6,"type":"text","value":"Hungría"},{"field_id":"TED-TI_CY","lang":"ET","ordinal":7,"type":"text","value":"Ungari"},{"field_id":"TED-TI_CY","lang":"FI","ordinal":8,"type":"text","value":"Unkari"},{"field_id":"TED-TI_CY","lang":"FR","ordinal":9,"type":"text","value":"Hongrie"},{"field_id":"TED-TI_CY","lang":"GA","ordinal":10,"type":"text","value":"Ungáir, an"},{"field_id":"TED-TI_CY","lang":"HR","ordinal":11,"type":"text","value":"Mađarska"},{"field_id":"TED-TI_CY","lang":"HU","ordinal":12,"type":"text","value":"Magyarország"},{"field_id":"TED-TI_CY","lang":"IT","ordinal":13,"type":"text","value":"Ungheria"},{"field_id":"TED-TI_CY","lang":"LT","ordinal":14,"type":"text","value":"Vengrija"},{"field_id":"