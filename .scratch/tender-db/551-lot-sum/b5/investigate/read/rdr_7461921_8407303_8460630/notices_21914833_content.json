-DESCRIPTION_PROCUREMENT.NUTS","ordinal":0,"scheme":"nuts","type":"classification"},{"field_id":"TED-DESCRIPTION_PROCUREMENT.SHORT_DESCR","lang":"ES","ordinal":0,"type":"text","value":"SUMINISTRO DE ENERGÍA ELÉCTRICA DURANTE LOS AÑOS 2021 Y 2022 EN LOS PUNTOS DE SUMINISTRO TELEMEDIDOS GESTIONADOS POR ADIF-ALTA VELOCIDAD CORRESPONDIENTE A ALCÁZAR DE SAN JUAN - LEVANTE"},{"code":"YES","field_id":"TED-DESCRIPTION_PROCUREMENT.VALUES.PUBLICATION","list":null,"ordinal":0,"type":"code"},{"cents":1122367430,"currency":"EUR","field_id":"TED-DESCRIPTION_PROCUREMENT.VAL_TOTAL","ordinal":0,"type":"amount"},{"field_id":"TED-INFO_MODIFICATIONS.SHORT_DESCR","lang":"ES","ordinal":0,"type":"text","value":"La motivación de la presente modificación viene determinada por el cambio de la estructura del impuesto eléctrico. Para poder repercutir correctamente dicho impuesto, es necesario revisar tanto las constantes aditivas Ve y Vf como las constantes multiplicadoras Ke y Kf, ya contempladas en el Pliego de Prescripciones Técnicas Particulares, matizando la forma en que las repercusiones de los cambios regulatorios sobre el citado impuesto eléctrico deben trasladarse a los precios del contrato con el único objetivo de que los importes que deben ser repercutidos por los adjudicatarios y trasladados a la AEAT se puedan calcular de forma puntual, inequívoca e independiente del precio del mercado."},{"field_id":"TED-INFO_MODIFICATIONS.SHORT_DESCR","lang":"ES","ordinal":1,"type":"text","value":"Por ello, a través de la presente modificación, se procede al cambio en la redacción del apartado 2, del capítulo 3 del Pliego de Prescripciones Técnicas Particulares del contratoprincipal, en los siguientes términos, permaneciendo inalterable el resto del mencionado Pliego de Prescripciones Técnicas Particulares"},{"field_id":"TED-INFO_MODIFICATIONS.UNFORESEEN_CIRCUMSTANCE","lang":"ES","ordinal":0,"type":"text","value":"La modificación propuesta, basada en el supuesto b) del artículo 111 del Real Decreto Ley 3/2020, se deriva de circunstancias sobrevenidas e imprevisibles como consecuencia del cambio en la estructura del impuesto eléctrico sin que, en ese momento, estuviera prevista una modificación legislativa que incorporase el citado beneficio fiscal convirtiendo dicha estructura en un concepto aditivo sobre el precio."},{"code":"YES","field_id":"TED-INFO_MODIFICATIONS.VALUES.PUBLICATION","list":null,"ordinal":0,"type":"code"},{"cents":1122367430,"currency":"EUR","field_id":"TED-INFO_MODIFICATIONS.VAL_TOTAL_AFTER","ordinal":0,"type":"amount"},{"cents":1169783170,"currency":"EUR","field_id":"TED-INFO_MODIFICATIONS.VAL_TOTAL_BEFORE","ordinal":0,"type":"amount"}]},{"kind":"Organization","parent_section_id":"PROCEDURE","section_id":"ORG-1","values":[{"field_id":"TED-ADDRESS","lang":"ES","ordinal":0,"type":"text","value":"C/ Sor Ángela de la Cruz, 3"},{"code":"ES","field_id":"TED-COUNTRY","list":null,"ordinal":0,"type":"code"},{"field_id":"TED-E_MAIL","lang":"ES","ordinal":0,"type":"text","value":"mfantequera@adif.es"},{"field_id":"TED-NATIONALID","is_ref":false,"ordinal":0,"scheme":"national","type":"id","value":"Q-2802152-E"},{"code":"ES30","field_id":"TED-NUTS","ordinal":0,"scheme":"nuts","type":"classification"},{"field_id":"TED-OFFICIALNAME","lang":"ES","ordinal":0,"type":"text","value":"ADIF ALTA VELOCIDAD"},{"field_id":"TED-PHONE","lang":"ES","ordinal":0,"type":"text","value":"+34 913007264"},{"field_id":"TED-POSTAL_CODE","lang":"ES","ordinal":0,"type":"text","value":"28020"},{"field_id":"TED-TOWN","lang":"ES","ordinal":0,"type":"text","value":"MADRID"},{"field_id":"TED-URL_BUYER","lang":"ES","ordinal":0,"type":"text","value":"https://contrataciondelestado.es/wps/portal/perfilContratante"},{"field_id":"TED-URL_GENERAL","lang":"ES","ordinal":0,"type":"text","value":"https://WWW.adifaltavelocidad.es"}]},{"kind":"Organization","parent_section_id":"RES-1","section_id":"ORG-2","values":[{"code":"ES","field_id":"TED-COUNTRY","list":null,"ordinal":0,"type":"code"}