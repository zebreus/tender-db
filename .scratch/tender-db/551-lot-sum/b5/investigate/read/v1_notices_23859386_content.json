t","lang":"NLD","ordinal":0,"type":"text","value":"Perceel 2: Wervings- en voorlichtingsdruk- en printwerk \n-\tErvaring met het leveren van Wervings- en voorlichtingsdrukwerk voor een organisatie met een minimale opdrachtwaarde van € 30.000 per jaar.\n-\tErvaring met het implementeren en beheren van een webbased systeem met ten minste 9  gebruikers binnen één organisatie. De maximale omvang van de opdracht is bij benadering als volgt:\n-\tPerceel 2: € 200.000 inclusief btw"},{"field_id":"BT-36-Lot","ordinal":0,"type":"number","unit":"MONTH","value":48.0},{"code":"no-eu-funds","field_id":"BT-60-Lot","list":"eu-funded","ordinal":0,"type":"code"},{"code":"fa-wo-rc","field_id":"BT-765-Lot","list":"framework-agreement","ordinal":0,"type":"code"},{"code":"none","field_id":"BT-766-Lot","list":"dps-usage","ordinal":0,"type":"code"},{"field_id":"BT-767-Lot","ordinal":0,"type":"integer","value":0},{"field_id":"OPT-301-Lot-AddInfo","is_ref":true,"ordinal":0,"scheme":null,"type":"id","value":"ORG-0001"},{"field_id":"OPT-301-Lot-ReviewInfo","is_ref":true,"ordinal":0,"scheme":null,"type":"id","value":"ORG-0001"},{"field_id":"OPT-301-Lot-ReviewOrg","is_ref":true,"ordinal":0,"scheme":null,"type":"id","value":"TPO-0001"}]},{"kind":"ContractingParty","parent_section_id":"PROCEDURE","section_id":"ND-ContractingParty#0","values":[{"code":"education","field_id":"BT-10-Procedure-Buyer","list":"authority-activity","ordinal":0,"type":"code"},{"code":"body-pl","field_id":"BT-11-Procedure-Buyer","list":"buyer-legal-type","ordinal":0,"type":"code"},{"field_id":"OPT-300-Procedure-Buyer","is_ref":true,"ordinal":0,"scheme":"organization","type":"id","value":"ORG-0001"}]},{"kind":"LotAwardCriterion","parent_section_id":"LOT-0001","section_id":"ND-LotAwardCriterion#0","values":[{"code":"quality","field_id":"BT-539-Lot","list":"award-criterion-type","ordinal":0,"type":"code"},{"field_id":"BT-540-Lot","lang":"NLD","ordinal":0,"type":"text","value":"Inschrijver geeft antwoord op de open vragen."},{"