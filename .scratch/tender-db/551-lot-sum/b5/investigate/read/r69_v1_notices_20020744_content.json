dásra, a szerződés keretében beszerzett mennyiségek ezen tapasztalati adatoktól eltérhetnek. Ajánlattevőnek az előzőek ismeretében kell benyújtania ajánlatát. A megkötésre kerülő szerződés mellékletében csak az egységárak kerülnek feltüntetésre."},{"code":"2","field_id":"TED-TD_DOCUMENT_TYPE","list":null,"ordinal":0,"type":"code"},{"field_id":"TED-TITLE","lang":"HU","ordinal":0,"type":"text","value":"Járművillamossági alkatrészek beszerzése (buszok)"},{"field_id":"TED-TI_CY","lang":"BG","ordinal":0,"type":"text","value":"Унгapия"},{"field_id":"TED-TI_CY","lang":"CS","ordinal":1,"type":"text","value":"Maďarsko"},{"field_id":"TED-TI_CY","lang":"DA","ordinal":2,"type":"text","value":"Ungarn"},{"field_id":"TED-TI_CY","lang":"DE","ordinal":3,"type":"text","value":"Ungarn"},{"field_id":"TED-TI_CY","lang":"EL","ordinal":4,"type":"text","value":"Ουγγαρία"},{"field_id":"TED-TI_CY","lang":"EN","ordinal":5,"type":"text","value":"Hungary"},{"field_id":"TED-TI_CY","lang":"ES","ordinal":6,"type":"text","value":"Hungría"},{"field_id":"TED-TI_CY","lang":"ET","ordinal":7,"type":"text","value":"Ungari"},{"field_id":"TED-TI_CY","lang":"FI","ordinal":8,"type":"text","value":"Unkari"},{"field_id":"TED-TI_CY","lang":"FR","ordinal":9,"type":"text","value":"Hongrie"},{"field_id":"TED-TI_CY","lang":"GA","ordinal":10,"type":"text","value":"Ungáir, an"},{"field_id":"TED-TI_CY","lang":"HR","ordinal":11,"type":"text","value":"Mađarska"},{"field_id":"TED-TI_CY","lang":"HU","ordinal":12,"type":"text","value":"Magyarország"},{"field_id":"TED-TI_CY","lang":"IT","ordinal":13,"type":"text","value":"Ungheria"},{"field_id":"TED-TI_CY","lang":"LT","ordinal":14,"type":"text","value":"Vengrija"},{"field_id":"TED-TI_CY","lang":"LV","ordinal":15,"type":"text","value":"Ungārija"},{"field_id":"TED-TI_CY","lang":"MT","ordinal":16,"type":"text","value":"l-Ungerija"},{"field_id":"TED-TI_CY","lang":"NL","ordinal":17,"type":"text","value":"Hongarije"},{"field_id":"TED-TI_CY","lang":"PL","ordinal":18,"type":"text",