l":0,"type":"amount"},{"field_id":"TED-INFO_MODIFICATIONS.SHORT_DESCR","lang":"BG","ordinal":0,"type":"text","value":"Естеството на изменение на поръчката е доставка на допълнително количество черни метали."},{"field_id":"TED-INFO_MODIFICATIONS.UNFORESEEN_CIRCUMSTANCE","lang":"BG","ordinal":0,"type":"text","value":"На основание чл. 116, ал. 1, т. 3 във връзка с ал. 2 и ал. 6 от ЗОП се налага доставка на допълнителни количества материали по обособена позиция № 2 на обществена поръчка с предмет: „Доставка на материали и консумативи за рехабилитация на котлоагрегати на „Брикел“ ЕАД, по 12 обособени позиции“ с реф. № 12004/2016 г. Доставката се налага поради възникнала необходимост от допълнителни материали по време на изпълнение на рехабилитацията на котлоагрегатите на дружеството. Поради характера и спецификите на извършвания ремонт възложителят не е в състояние да предвиди допълнително възлаганите с настоящия анекс към Договор за обществена поръчка № 12004-2/10.08.2016 количества."},{"cents":14643946,"currency":"BGN","field_id":"TED-INFO_MODIFICATIONS.VAL_TOTAL_AFTER","ordinal":0,"type":"amount"},{"cents":12442275,"currency":"BGN","field_id":"TED-INFO_MODIFICATIONS.VAL_TOTAL_BEFORE","ordinal":0,"type":"amount"}]},{"kind":"Organization","parent_section_id":"PROCEDURE","section_id":"ORG-1","values":[{"field_id":"TED-ADDRESS","lang":"BG","ordinal":0,"type":"text","value":"извън града"},{"field_id":"TED-CONTACT_POINT","lang":"BG","ordinal":0,"type":"text","value":"инж. Красимира Димитрова"},{"code":"BG","field_id":"TED-COUNTRY","list":null,"ordinal":0,"type":"code"},{"field_id":"TED-E_MAIL","lang":"BG","ordinal":0,"type":"text","value":"market@brikel-bg.com"},{"field_id":"TED-FAX","lang":"BG","ordinal":0,"type":"text","value":"+359 41862393"},{"field_id":"TED-NATIONALID","is_ref":false,"ordinal":0,"scheme":"national","type":"id","value":"123526494"},{"code":"BG344","field_id":"TED-NUTS","ordinal":0,"scheme":"nuts","type":"classification"},{"field_id":"TED-OFFICIALNAME","