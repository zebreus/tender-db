id":"TED-DATE_DISPATCH_NOTICE","ordinal":0,"type":"date","value":"2016-06-14"},{"field_id":"TED-DATE_OPENING_TENDERS","ordinal":0,"type":"date","value":"2016-06-30T10:00:00+00:00"},{"field_id":"TED-DATE_PUB","ordinal":0,"type":"date","value":"2016-06-16"},{"field_id":"TED-DATE_RECEIPT_TENDERS","ordinal":0,"type":"date","value":"2016-06-29T15:00:00+00:00"},{"field_id":"TED-DEPOSIT_GUARANTEE_REQUIRED","lang":"BG","ordinal":0,"type":"text","value":"Гаранция за изпълнение 4 % от стойността на всяка обособена позиция."},{"code":"2014/25/EU","field_id":"TED-DIRECTIVE","list":null,"ordinal":0,"type":"code"},{"field_id":"TED-DOCUMENT_FULL","ordinal":0,"type":"integer","value":1},{"field_id":"TED-DS_DATE_DISPATCH","ordinal":0,"type":"date","value":"2016-06-14"},{"field_id":"TED-DT_DATE_FOR_SUBMISSION","ordinal":0,"type":"date","value":"2016-06-29T15:00:00+00:00"},{"field_id":"TED-DURATION_TENDER_VALID","ordinal":0,"type":"number","unit":"MONTH","value":5.0},{"field_id":"TED-ECONOMIC_FINANCIAL_INFO","lang":"BG","ordinal":0,"type":"text","value":"Няма."},{"field_id":"TED-ECONOMIC_FINANCIAL_MIN_LEVEL","lang":"BG","ordinal":0,"type":"text","value":"Няма."},{"code":"F05","field_id":"TED-FORM","list":null,"ordinal":0,"type":"code"},{"code":"01F05","field_id":"TED-HEADING","list":null,"ordinal":0,"type":"code"},{"field_id":"TED-IA_URL_ETENDERING","lang":null,"ordinal":0,"type":"text","value":"http://www.brikel-bg.com"},{"field_id":"TED-IA_URL_GENERAL","lang":null,"ordinal":0,"type":"text","value":"http://www.brikel-bg.com"},{"field_id":"TED-INFO_ADD","lang":"BG","ordinal":0,"type":"text","value":"На публично заседание при отваряне на офертите могат да присъстват кандидатите или участниците в процедурата или техни упълномощени представители, както и представители на средствата за масово осведомяване."},{"field_id":"TED-INFO_ADD","lang":"BG","ordinal":1,"type":"text","value":"Обстоятелства, изискващи спешно провеждане на открита процедура по възлагане на обществена поръчка с предмет: „Доставка на материали и консумативи за рехабилитация на котлоагрегати на „Брикел“ ЕАД, по 12 обособени позиции“, предвид на които спазването на 35 дневният срок по чл. 133, ал. 1 от ЗОП, за получаването на оферти се явява невъзможно и е необходимо приложението на ал. 4 от същата разпоредба, за получаването на оферти в срок 15 дни от датата на изпращане на обявлението за обществена поръчка за публикуване:"},{"field_id":"TED-INFO_ADD","lang":"BG","ordinal":2,"type":"text","value":"— Зачестилите аварийни ситуации по котлите в ТЕЦ и внезапно повишилата се обща аварийност по котлоагрегатите, водят до риск от занижаване на безопасността при работа и на КПД на централата. Това налага спешно заместване на работещ понастоящем котел с изведения от експлоатация, за планова рехабилитация, четвърти котел (КА 4) и рехабилитация и на останалите котли."},{"field_id":"TED-INFO_ADD","lang":"BG","ordinal":3,"type":"text","value":"— Влошаващото се техническо състояние на котлите води до опасност от спиране на котел или до едновременното спиране на 2 котела и до преустановяване на работа."},{"field_id":"TED-INFO_ADD","lang":"BG","ordinal":4,"type":"text","value":"— Без спешно довършване на рехабилитацията на КА 4 и въвеждането му в експлоатация, дружеството няма да е в състояние да поддържа в годност за работа, изискващите се поне 4 енергийни котела."},{"field_id":"TED-INFO_ADD","lang":"BG","ordinal":5,"type":"text","value":"— Ако преди началото на отоплителния сезон не се въведе в експлоатация рехабилитиран котел, дружеството може да бъде затруднено да изпълнява задълженията си по чл. 105 от ЗЕ към оператора на електропреносната мрежа за осигуряване на студен резерв, както и задълженията си към обществото по чл. 69 и чл. 84, ал. 4 от ЗЕ за сигурност на топлоснабдяването и на енергоснабдяването и за надеждност на произвежданата електрическа енергия с оглед гарантиране на сигурността на електроенергийната система."},{"code":"01","field_id":"TED-INITIATOR","list":null,"ordinal":0,"type":"code"},{"code":"BG","field_id":"TED-ISO_COUNTRY","list":null,"ordinal":0,"type":"code"},{"code":"BG","field_id":"TED-LANGUAGE","list":null,"ordinal":0,"type":"code"},{"field_id":"TED-LEGAL_FORM","lang":"BG","ordinal":0,"type":"text","value":"Не се изисква."},{"code":"BG","field_id":"TED-LG_ORIG","list":null,"ordinal":0,"type":"code"},{"field_id":"TED-LOT_ALL","ordinal":0,"type":"integer","value":1},{"field_id":"TED-LOT_DIVISION","ordinal":0,"type":"integer","value":1},{"field_id":"TED-MAIN_FINANCING_CONDITION","lang":"BG","ordinal":0,"type":"text","value":"Сроковете за плащане са съобразени с чл. 303а, ал. 2 от ТЗ засягаща възложителите. Конкретната заявка се заплаща в срок до 30 дни след извършване на доставката, представяне на двустранно подписан приемо-предавателен протокол и фактура-оригинал издадена съгласно чл. 113 от ЗДДС. Срокът за плащане тече от датата на последно представения документ."},{"code":"N","field_id":"TED-MA_MAIN_ACTIVITIES","list":null,"ordinal":0,"type":"code"},{"code":"2","field_id":"TED-NC_CONTRACT_NATURE","list":null,"ordinal":0,"type":"code"},{"field_id":"TED-NO_CONTRACT_COVERED_GPA","ordinal":0,"type":"integer","value":1},{"field_id":"TED-NO_DOC_OJS","is_ref":false,"ordinal":0,"scheme":null,"type":"id","value":"2016/S 115-204462"},{"field_id":"TED-NO_OJ","ordinal":0,"type":"integer","value":115},{"field_id":"TED-NO_RECURRENT_PROCUREMENT","ordinal":0,"type":"integer","value":1},{"code":"44000000","field_id":"TED-ORIGINAL_CPV","ordinal":0,"scheme":"cpv","type":"classification"},{"code":"44531400","field_id":"TED-ORIGINAL_CPV","ordinal":1,"scheme":"cpv","type":"classification"},{"code":"44531600","field_id":"TED-ORIGINAL_CPV","ordinal":2,"scheme":"cpv","type":"classification"},{"code":"44334000","field_id":"TED-ORIGINAL_CPV","ordinal":3,"scheme":"cpv","type":"classification"},{"code":"44162000","field_id":"TED-ORIGINAL_CPV","ordinal":4,"scheme":"cpv","type":"classification"},{"code":"42131270","field_id":"TED-ORIGINAL_CPV","ordinal":5,"scheme":"cpv","type":"classification"},{"code":"44440000","field_id":"TED-ORIGINAL_CPV","ordinal":6,"scheme":"cpv","type":"classification"},{"code":"31711140","field_id":"TED-ORIGINAL_CPV","ordinal":7,"scheme":"cpv","type":"classification"},{"code":"35121500","field_id":"TED-ORIGINAL_CPV","ordinal":8,"scheme":"cpv","type":"classification"},{"code":"44111520","field_id":"TED-ORIGINAL_CPV","ordinal":9,"scheme":"cpv","type":"classification"},{"code":"44100000","field_id":"TED-ORIGINAL_CPV","ordinal":10,"scheme":"cpv","type":"classification"},{"code":"44321000","field_id":"TED-ORIGINAL_CPV","ordinal":11,"scheme":"cpv","type":"classification"},{"code":"44111100","field_id":"TED-ORIGINAL_CPV","ordinal":12,"scheme":"cpv","type":"classification"},{"code":"BG344","field_id":"TED-ORIGINAL_NUTS","ordinal":0,"scheme":"nuts","type":"classification"},{"field_id":"TED-PERFORMANCE_CONDITIONS","lang":"BG","ordinal":0,"type":"text","value":"Всички доставени консумативи и материали трябва да бъдат снабдени със сертификати за произход и качество."},{"field_id":"TED-PLACE","lang":"BG","ordinal":0,"type":"text","value":"„Брикел“ ЕАД, Заседателна зала."},{"code":"1","field_id":"TED-PR_PROC","list":null,"ordinal":0,"type":"code"},{"field_id":"TED-PT_OPEN","ordinal":0,"type":"integer","value":1},{"field_id":"TED-RECEPTION_ID","is_ref":false,"ordinal":0,"scheme":null,"type":"id","value":"16-219060-001"},{"field_id":"TED-REFERENCE_NUMBER","is_ref":false,"ordinal":0,"scheme":null,"type":"id","value":"12004"},{"field_id":"TED-REVIEW_PROCEDURE","lang":"BG","ordinal":0,"type":"text","value":"Съгласно правилата на гл. 27 от ЗОП (чл. 196 и следващите от ЗОП)."},{"code":"4","field_id":"TED-RP_REGULATION","list":null,"ordinal":0,"type":"code"},{"field_id":"TED-RULES_CRITERIA","lang":"BG","ordinal":0,"type":"text","value":"1. За участниците не трябва да са налице обстоятелствата по чл. 54, ал. 1 от ЗОП."},{"field_id":"TED-RULES_CRITERIA","lang":"BG","ordinal":1,"type":"text","value":"Участник, за когото са налице основание по чл. 54, ал. 1 от ЗОП, има право да представи доказателства, в съответствие с чл. 56, ал. 1, т. 1, 2 и 3 от ЗОП, че е предприел мерки, които гарантират неговата надеждност, въпреки наличието на съответното основание за отстраняване. Участниците декларират обстоятелствата в ЕЕДОП."},{"field_id":"TED-RULES_CRITERIA","lang":"BG","ordinal":2,"type":"text","value":"2. Не се допуска пряко или косвено участие в настоящата поръчка на дружествата, регистрирани в юрисдикции с преференциален данъчен режим и на свързаните с тях лица, включително и чрез гражданско дружество/консорциум в което участва дружество, регистрирано в юрисдикция с преференциален данъчен режим, освен при наличие на изключенията по смисъла на чл. 4 от Закона за икономическите и финансовите отношения с дружества, регистрирани в юрисдикции с преференциален данъчен режим, свързаните с тях лица и техните действителни собственици."},{"field_id":"TED-RULES_CRITERIA","lang":"BG","ordinal":3,"type":"text","value":"Участниците представят декларация по образец."},{"field_id":"TED-SHORT_DESCR","lang":"BG","ordinal":0,"type":"text","value":"Предмет на настоящата обществена поръчка е:„Доставка на материали и консумативи за рехабилитация на котлоагрегати на „Брикел“ ЕАД, по 12 обособени позиции“, с технически характеристики, посочени в техническите спецификации:"},{"field_id":"TED-SHORT_DESCR","lang":"BG","ordinal":1,"type":"text","value":"Обособена позиция (ОП) № 1: „Доставка на крепежни материали“,"},{"field_id":"TED-SHORT_DESCR","lang":"BG","ordinal":2,"type":"text","value":"ОП № 2: „Доставка на черни метали“,"},{"field_id":"TED-SHORT_DESCR","lang":"BG","ordinal":3,"type":"text","value":"ОП № 3: „Доставка на неръждаеми и цветни метали“,"},{"field_id":"TED-SHORT_DESCR","lang":"BG","ordinal":4,"type":"text","value":"ОП № 4: „Доставка на спирателна арматура“,"},{"field_id":"TED-SHORT_DESCR","lang":"BG","ordinal":5,"type":"text","value":"ОП № 5: „Доставка на лагери с общо предназначение“,"},{"field_