etroffenen Wintermonaten ausreichend Schutz zu gewähren und dabei gleichzeitig ein erneutes flächendeckendes Betretungsverbot von Pflegeheimen und Schulen so lange wie möglich zu vermeiden, ist die kurzfristige Bevorratung mit einer entsprechenden Zahl von FFP2-Masken unerlässlich. Nur mit einer Verkürzung der Angebotsfrist kann erreicht werden, dass die Versorgung mit einer ausreichenden Anzahl von FFP2-Masken noch im Dezember 2020 erfolgen kann."},{"code":"1","field_id":"TED-AC_AWARD_CRIT","list":null,"ordinal":0,"type":"code"},{"field_id":"TED-ADDRESS_CONTRACTING_BODY","is_ref":true,"ordinal":0,"scheme":null,"type":"id","value":"ORG-1"},{"field_id":"TED-ADDRESS_REVIEW_BODY","is_ref":true,"ordinal":0,"scheme":null,"type":"id","value":"ORG-5"},{"field_id":"TED-ADDRESS_REVIEW_INFO","is_ref":true,"ordinal":0,"scheme":null,"type":"id","value":"ORG-6"},{"code":"GENERAL_PUBLIC_SERVICES","field_id":"TED-CA_ACTIVITY","list":null,"ordinal":0,"type":"code"},{"code":"DE212","field_id":"TED-CA_CE_NUTS","ordinal":0,"scheme":"nuts","type":"classification"},{"code":"REGIONAL_AUTHORITY","field_id":"TED-CA_TYPE","list":null,"ordinal":0,"type":"code"},{"code":"S","field_id":"TED-COLL_OJ","list":null,"ordinal":0,"type":"code"},{"field_id":"TED-CONTRACT_COVERED_GPA","ordinal":0,"type":"integer","value":1},{"code":"35113000","field_id":"TED-CPV_CODE","ordinal":0,"scheme":"cpv","type":"classification"},{"field_id":"TED-DATE_DISPATCH_NOTICE","ordinal":0,"type":"date","value":"2021-02-01"},{"field_id":"TED-DATE_PUB","ordinal":0,"type":"date","value":"2021-02-05"},{"field_id":"TED-DS_DATE_DISPATCH","ordinal":0,"type":"date","value":"2021-02-01"},{"code":"F03","field_id":"TED-FORM","list":null,"ordinal":0,"type":"code"},{"code":"01B03","field_id":"TED-HEADING","list":null,"ordinal":0,"type":"code"},{"field_id":"TED-IA_URL_GENERAL","lang":null,"ordinal":0,"type":"text","value":"https://www.lgl.bayern.de/index.htm"},{"field_id":"TED-INFO_ADD","lang":"DE","ordinal":0,"type":"text","value":"Ei