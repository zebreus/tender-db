dienen de Natuurpakket Westerschelde(NPW) maatregelen te worden uitgevoerd. Zie de volledige beschrijving van het werk in de aanbestedingsleidraad."},{"code":"7","field_id":"TED-TD_DOCUMENT_TYPE","list":null,"ordinal":0,"type":"code"},{"code":"NL","field_id":"TED-TENDERER_NUTS","ordinal":0,"scheme":"nuts","type":"classification"},{"field_id":"TED-TITLE","lang":"NL","ordinal":0,"type":"text","value":"31088465: ontwerpen en uitvoeren vooroeververdediging Oosterschelde en Westerschelde"},{"field_id":"TED-TI_CY","lang":"BG","ordinal":0,"type":"text","value":"Холандия"},{"field_id":"TED-TI_CY","lang":"CS","ordinal":1,"type":"text","value":"Nizozemsko"},{"field_id":"TED-TI_CY","lang":"DA","ordinal":2,"type":"text","value":"Nederlandene"},{"field_id":"TED-TI_CY","lang":"DE","ordinal":3,"type":"text","value":"die Niederlande"},{"field_id":"TED-TI_CY","lang":"EL","ordinal":4,"type":"text","value":"Κάτω Χώρες"},{"field_id":"TED-TI_CY","lang":"EN","ordinal":5,"type":"text","value":"Netherlands"},{"field_id":"TED-TI_CY","lang":"ES","ordinal":6,"type":"text","value":"Países Bajos"},{"field_id":"TED-TI_CY","lang":"ET","ordinal":7,"type":"text","value":"Madalmaad"},{"field_id":"TED-TI_CY","lang":"FI","ordinal":8,"type":"text","value":"Alankomaat"},{"field_id":"TED-TI_CY","lang":"FR","ordinal":9,"type":"text","value":"Pays-Bas"},{"field_id":"TED-TI_CY","lang":"GA","ordinal":10,"type":"text","value":"Ísiltír, an"},{"field_id":"TED-TI_CY","lang":"HR","ordinal":11,"type":"text","value":"Nizozemska"},{"field_id":"TED-TI_CY","lang":"HU","ordinal":12,"type":"text","value":"Hollandia"},{"field_id":"TED-TI_CY","lang":"IT","ordinal":13,"type":"text","value":"Paesi Bassi"},{"field_id":"TED-TI_CY","lang":"LT","ordinal":14,"type":"text","value":"Nyderlandai, Olandija"},{"field_id":"TED-TI_CY","lang":"LV","ordinal":15,"type":"text","value":"Nīderlande"},{"field_id":"TED-TI_CY","lang":"MT","ordinal":16,"type":"text","value":"in-Netherlands"},{"field_id":"TED-TI_CY","lang":"NL","ordinal":17,"type