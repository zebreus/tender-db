il","organization_id":30914625,"organization_name":"Blaenau Gwent County Borough Council","role":"Procedure-Buyer"},{"lot":"1","mention_name":"Equal Education Partners ","organization_id":30914626,"organization_name":"Torfaen County Borough Council","role":"Tenderer"}],"procedure_key":"ocds-h6vhtk-069a13","procedure_type":null,"publication_id":"093096-2026","published_at":"2026-10-02T08:53:02+01:00","source":"fts","submission_deadline":"2026-06-19T12:00:00+01:00","submission_deadline_scope":"procedure","texts":[{"field":"description","lang":"ENG","lot":null,"value":"The Local Authority is responsible for ensuring that pupils with health needs are not at home or in hospital for more than 15 working days without access to education: this may be consecutive or cumulative with the same medical condition. If the pupil is a patient at hospital, they will usually receive education on the ward from the onsite Hospital Teacher as soon as they are fit enough to do so. Effective liaison with medical professionals will ensure that there is a minimum of delay in starting appropriate support for those pupils not admitted to hospital.\nThe Local Authority will arrange suitable education for children of compulsory school age who, because of illness or other reasons e.g. exclusions, would otherwise not receive suitable education at school."},{"field":"title","lang":"ENG","lot":null,"value":"The Provision of Home Tuition/Online Teaching Services within Blaenau Gwent "}],"title":"The Provision of Home Tuition/Online Teaching Services within Blaenau Gwent ","value":{"cents":15000000,"currency":"GBP"},"value_derivation":null,"version":2,"versions":[{"caused_by_notice_id":46819116,"dispatched_at":null,"notice_subtype":"UK4","original_lang":"ENG","publication_id":"044939-2026","published_at":"2026-05-15T13:58:33+01:00","seq":1},{"caused_by_notice_id":47293389,"dispatched_at":null,"notice_subtype":"UK7","original_lang":"ENG","publication_id":"093096-2026","published_at":"2026-10-02T08:53:0