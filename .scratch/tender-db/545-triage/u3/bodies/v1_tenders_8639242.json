lot":null,"mention_name":"London Borough of Islington","organization_id":30913699,"organization_name":"London Borough of Islington","role":"Procedure-Buyer"},{"lot":"1","mention_name":"TYCO FIRE & INTEGRATED SOLUTIONS (UK) LIMITED","organization_id":31561090,"organization_name":"TYCO FIRE & INTEGRATED SOLUTIONS (UK) LIMITED","role":"Tenderer"}],"procedure_key":"refused:ocds-h6vhtk-05570f:GB:national:GBPPONPBMD2513CWJJ","procedure_type":"open","publication_id":"008522-2026","published_at":"2026-01-30T14:38:11+00:00","source":"fts","submission_deadline":"2025-07-28T12:00:00+01:00","submission_deadline_scope":"procedure","texts":[{"field":"description","lang":"ENG","lot":null,"value":"The Islington Council is to procure a single supplier framework agreement to enable delivery of high-quality CCTV supply, installation and maintenance services, including three other boroughs.\nThe network of CCTV cameras operating in public areas is an integral part of the council's approach to crime detection and prevention, and community safety. It protects the council's assets and the wider community, as well as being used by the Metropolitan Police and other agencies for policing and counter-terrorism purposes.\n'A Safe Place to Call Home' is one of the five missions of the council's 'Vision 2030' strategy. Therefore, it is essential that the CCTV system be of a high quality, as well as reliable, to successfully achieve these aims.\nA maximum of one supplier will be party to the framework agreement.  Call-off contracts from the framework agreement shall follow the terms of the framework agreement including how a call-off contract is concluded.  How a call-off contract is concluded is explained within the invitation to tender documentation.\nThe services will be required by Islington Council and other organisations who may access the framework agreement. Those organisations are:\n•\tLondon Borough of Ealing\n•\tLondon Borough of Hounslow\n•\tLondon Borough of Southwark"},{"field":"title","lang":"ENG","lot":null,"value":"2425-0045 The Supply, Installation and Maintenance of CCTV Equipment"}],"title":"2425-0045 The Supply, Installation and Maintenance of CCTV Equipment","value":{"cents":1600000000,"currency":"GBP"},"value_derivation":null,"version":4,"versions":[{"caused_by_notice_id":46725671,"dispatched_at":null,"notice_subtype":"UK3","original_lang":"ENG","publication_id":"036550-2025","published_at":"2025-07-01T17:00:09+01:00","seq":1},{"caused_by_notice_id":46725815,"dispatched_at":null,"notice_subtype":"UK4","original_lang":"ENG","publication_id":"036694-2025","published_at":"2025-07-02T11:07:57+01:00","seq":2},{"caused_by_notice_id":46726445,"dispatched_at":null,"notice_subtype":"UK4","original_lang":"ENG","publication_id":"037328-2025","published_at":"2025-07-04T10:26:00+01:00","seq":3},{"caused_by_notice_id":46783889,"dispatched_at":null,"notice_subtype":"UK6","original_lang":"ENG","publication_id":"008522-2026","published_at":"2026-01-30T14:38:11+00:00","seq":4}]}