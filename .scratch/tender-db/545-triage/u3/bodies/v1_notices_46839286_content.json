otice","parent_section_id":null,"section_id":"PROCEDURE","values":[{"code":"2023/54","field_id":"BT-01-notice","list":"UKPGA","ordinal":0,"type":"code"},{"field_id":"BT-04-notice","is_ref":false,"ordinal":0,"scheme":null,"type":"id","value":"ocds-h6vhtk-06c8ec"},{"field_id":"BT-21-Procedure","lang":"en","ordinal":0,"type":"text","value":"Masters in Public health Qualification - North"},{"field_id":"BT-24-Procedure","lang":"en","ordinal":0,"type":"text","value":"Health Education and Improvement Wales (HEIW) intends to award a contract to the University of Liverpool for the provision of a Master of Public Health (MPH) qualification for resident doctors undertaking the Public Health Specialty Training Scheme in Wales. The MPH qualification is a mandatory component of specialty training and enables trainees to achieve curriculum learning outcomes, meet regulatory requirements, and progress towards a Certificate of Completion of Training (CCT). The University of Liverpool is the only appropriate provider for trainees appointed to Public Health Training Scheme posts based in North Wales. No suitable alternative provider offering an equivalent in-person programme within a suitable geographical location has been identified. The direct award is therefore justified on technical grounds, as only the University of Liverpool can meet the specific educational, curriculum and geographical requirements of this training programme.\nThis Agreement is non‑committal and does not guarantee any maximum level of spend."},{"code":"en","field_id":"BT-702(a)-notice","list":null,"ordinal":0,"type":"code"},{"field_id":"OPP-012-notice","ordinal":0,"type":"date","value":"2026-07-10T16:45:48+01:00"},{"code":"UK6","field_id":"OPP-070-notice","list":null,"ordinal":0,"type":"code"},{"field_id":"OPT-300-Procedure-Buyer","is_ref":true,"ordinal":0,"scheme":null,"type":"id","value":"ORG-GB-PPON-PRNH-7564-JLCQ"},{"field_id":"OPT-300-Procedure-Buyer","is_ref":true,"ordinal":1,"scheme":null,"type":"id","va