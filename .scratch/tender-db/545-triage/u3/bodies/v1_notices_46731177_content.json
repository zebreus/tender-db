ind":"Notice","parent_section_id":null,"section_id":"PROCEDURE","values":[{"code":"2023/54","field_id":"BT-01-notice","list":"UKPGA","ordinal":0,"type":"code"},{"field_id":"BT-04-notice","is_ref":false,"ordinal":0,"scheme":null,"type":"id","value":"ocds-h6vhtk-04f831"},{"field_id":"BT-21-Procedure","lang":"en","ordinal":0,"type":"text","value":"Insight Framework for Customer Intelligent and Strategic Insight"},{"field_id":"BT-24-Procedure","lang":"en","ordinal":0,"type":"text","value":"Ordnance Survey Ltd (OS) is Britain's mapping agency and is responsible for the surveying, production, maintenance and marketing of a wide range of geographic information, relied on by government, business and individuals. OS is looking to partner with suppliers to increase our customer and market intelligence using a variety of qualitative and quantitative research techniques and to answer specific business questions about current or potential customers. OS are seeking suppliers that can help drive customer centricity throughout OS enabling employees to connect, understand and act upon customer insights. The requirement has been split into two lots. This Contract Award Notice is for Lot 2 is for Leisure Customer Insights with the supplier helping OS grow in more destinations through deepening our understanding of new and existing customers who want to be active outdoors, and by assessing products and consumers' needs, wants and expectations. Lot 2 covers tactical research with outdoor active consumers in Great Britain; to improve the customers experience, increase customer understanding, grow the user base for existing product types and enhance or improve existing products."},{"code":"en","field_id":"BT-702(a)-notice","list":null,"ordinal":0,"type":"code"},{"field_id":"OPP-012-notice","ordinal":0,"type":"date","value":"2025-07-22T16:08:53+01:00"},{"code":"UK6","field_id":"OPP-070-notice","list":null,"ordinal":0,"type":"code"},{"field_id":"OPT-300-Procedure-Buyer","is_ref":true,"ordin