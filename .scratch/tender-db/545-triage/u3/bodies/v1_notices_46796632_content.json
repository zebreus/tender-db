{"notice_id":46796632,"sections":[{"kind":"Lot","parent_section_id":"PROCEDURE","section_id":"1","values":[{"code":"79100000","field_id":"BT-262-Lot","ordinal":0,"scheme":"cpv","type":"classification"},{"code":"79111000","field_id":"BT-263-Lot","ordinal":0,"scheme":"cpv","type":"classification"},{"code":"79112000","field_id":"BT-263-Lot","ordinal":1,"scheme":"cpv","type":"classification"},{"code":"UKH12","field_id":"BT-5071-Lot","ordinal":0,"scheme":"nuts","type":"classification"},{"field_id":"BT-536-Lot","ordinal":0,"type":"date","value":"2026-10-01T00:00:00+01:00"},{"field_id":"BT-537-Lot","ordinal":0,"type":"date","value":"2027-09-30T23:59:59+01:00"}]},{"kind":"Organization","parent_section_id":"PROCEDURE","section_id":"ORG-GB-PPON-PPCP-8863-HDGN","values":[{"field_id":"BT-500-Organization-Company","lang":"en","ordinal":0,"type":"text","value":"Cambridge University Hospitals NHS Foundation Trust"},{"field_id":"BT-501-Organization-Company","is_ref":false,"ordinal":0,"scheme":"GB-PPON","type":"id","value":"GB-PPON-PPCP-8863-HDGN"},{"code":"GB","field_id":"BT-514-Organization-Company","list":null,"ordinal":0,"type":"code"}]},{"kind":"Organization","parent_section_id":"PROCEDURE","section_id":"ORG-GB-PPON-PXMB-9766-NLTH","values":[{"field_id":"BT-500-Organization-Company","lang":"en","ordinal":0,"type":"text","value":"East Of England NHS Collaborative Hub c/o West Suffolk NHS Foundation Trust"},{"field_id":"BT-501-Organization-Company","is_ref":false,"ordinal":0,"scheme":"GB-PPON","type":"id","value":"GB-PPON-PXMB-9766-NLTH"},{"code":"GB","field_id":"BT-514-Organization-Company","list":null,"ordinal":0,"type":"code"}]},{"kind":"Notice","parent_section_id":null,"section_id":"PROCEDURE","values":[{"code":"2023/54","field_id":"BT-01-notice","list":"UKPGA","ordinal":0,"type":"code"},{"field_id":"BT-04-notice","is_ref":false,"ordinal":0,"scheme":null,"type":"id","value":"ocds-h6vhtk-0666c1"},{"field_id":"BT-21-Procedure","lang":"en","ordinal":0,"type":"text","value":"Patient Welfare and Signposting Support Bedside Services for Major Trauma and Vulnerable, Critically Ill Patients"},{"code":"services","field_id":"BT-23-Procedure","list":"contract-nature","ordinal":0,"type":"code"},{"field_id":"BT-24-Procedure","lang":"en","ordinal":0,"type":"text","value":"Cambridge University Hospitals NHS Foundation Trust (CUHFT) is a designated Major Trauma Centre (MTC) within a large regional trauma network. The MTC provides care for over 2,000 major trauma patients per year, serving a diverse population across a wide geographic region. Patients often present with complex injuries and require multidisciplinary care, including support for psychological, social, financial, and legal challenges that fall outside routine NHS clinical provision.\nTo meet these needs, CUHFT seeks to commission a comprehensive Patient Welfare and Signposting Support Service to provide integrated non-clinical support to major trauma and critically ill patients, including children and adults. \nThis service will operate a “bedside” service within critical care and ward environments. Support will be provided to adult and paediatric patients, and to their families or carers."},{"cents":0,"currency":"GBP","field_id":"BT-27-Procedure","ordinal":0,"type":"amount"},{"code":"en","field_id":"BT-702(a)-notice","list":null,"ordinal":0,"type":"code"},{"field_id":"OPP-012-notice","ordinal":0,"type":"date","value":"2026-03-10T17:11:09+00:00"},{"code":"UK2","field_id":"OPP-070-notice","list":null,"ordinal":0,"type":"code"},{"field_id":"OPT-300-Procedure-Buyer","is_ref":true,"ordinal":0,"scheme":null,"type":"id","value":"ORG-GB-PPON-PPCP-8863-HDGN"},{"field_id":"OPT-300-Procedure-Buyer","is_ref":true,"ordinal":1,"scheme":null,"type":"id","value":"ORG-GB-PPON-PXMB-9766-NLTH"},{"code":"excl","field_id":"TED-VAL_TOTAL_TAX_BASIS","list":null,"ordinal":0,"type":"code"}]}]}