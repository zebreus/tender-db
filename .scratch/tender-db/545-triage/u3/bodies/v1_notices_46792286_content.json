nts."},{"code":"66170000","field_id":"BT-262-Procedure","ordinal":0,"scheme":"cpv","type":"classification"},{"code":"en","field_id":"BT-702(a)-notice","list":null,"ordinal":0,"type":"code"},{"field_id":"OPP-012-notice","ordinal":0,"type":"date","value":"2026-02-25T15:59:49+00:00"},{"code":"award+contract","field_id":"OPP-070-notice","list":null,"ordinal":0,"type":"code"},{"field_id":"OPT-300-Procedure-Buyer","is_ref":true,"ordinal":0,"scheme":null,"type":"id","value":"ORG-GB-COH-04546648"},{"field_id":"OPT-301-Lot-ReviewOrg","is_ref":true,"ordinal":0,"scheme":null,"type":"id","value":"ORG-GB-FTS-38715"}]},{"kind":"LotResult","parent_section_id":"PROCEDURE","section_id":"RES-017045-2026-1-1","values":[{"field_id":"BT-13713-LotResult","is_ref":false,"ordinal":0,"scheme":null,"type":"id","value":"1"},{"code":"selec-w","field_id":"BT-142-LotResult","list":null,"ordinal":0,"type":"code"},{"field_id":"OPT-315-LotResult","is_ref":true,"ordinal":0,"scheme":null,"type":"id","value":"CON-017045-2026-1"},{"field_id":"OPT-320-LotResult","is_ref":true,"ordinal":0,"scheme":null,"type":"id","value":"TEN-017045-2026-1-0"}]},{"kind":"ReceivedSubmissions","parent_section_id":"RES-017045-2026-1-1","section_id":"STAT-1","values":[{"field_id":"BT-759-LotResult","ordinal":0,"type":"number","unit":null,"value":1.0},{"code":"tenders","field_id":"BT-760-LotResult","list":null,"ordinal":0,"type":"code"}]},{"kind":"LotTender","parent_section_id":"PROCEDURE","section_id":"TEN-017045-2026-1-0","values":[{"field_id":"BT-13714-Tender","is_ref":false,"ordinal":0,"scheme":null,"type":"id","value":"1"},{"field_id":"OPT-310-Tender","is_ref":true,"ordinal":0,"scheme":null,"type":"id","value":"TPA-017045-2026-1-0"}]},{"kind":"TenderingParty","parent_section_id":"PROCEDURE","section_id":"TPA-017045-2026-1-0","values":[{"field_id":"OPT-300-Tenderer","is_ref":true,"ordinal":0,"scheme":null,"type":"id","value":"ORG-GB-COH-02933191"}]}]}