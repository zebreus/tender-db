,"type":"code"}]},{"kind":"Notice","parent_section_id":null,"section_id":"PROCEDURE","values":[{"code":"2023/54","field_id":"BT-01-notice","list":"UKPGA","ordinal":0,"type":"code"},{"field_id":"BT-04-notice","is_ref":false,"ordinal":0,"scheme":null,"type":"id","value":"ocds-h6vhtk-05e153"},{"field_id":"BT-21-Procedure","lang":"en","ordinal":0,"type":"text","value":"BT1810 - Infrastructure Strategy Study"},{"field_id":"BT-24-Procedure","lang":"en","ordinal":0,"type":"text","value":"The planning policy team is seeking a consultant to produce an Infrastructure Strategy Study (ISS)\nto provide evidence to support the development and future growth of the town. The ISS will establish\nan up-to-date baseline of existing infrastructure provision by type, and current capacity, setting out\nthe quantity of new or expanded infrastructure that will be needed to serve any additional population\nand housing development within Luton as well as commercial and employment allocations. The\nrange of infrastructure providers and types will include: -\n• Utilities Infrastructure\n• Community and Health Facilities\n• Leisure, tourism & Culture Facilities\n• Education Facilities\n• Transport Infrastructure"},{"code":"en","field_id":"BT-702(a)-notice","list":null,"ordinal":0,"type":"code"},{"field_id":"OPP-012-notice","ordinal":0,"type":"date","value":"2025-11-14T11:54:04+00:00"},{"code":"UK7","field_id":"OPP-070-notice","list":null,"ordinal":0,"type":"code"},{"field_id":"OPT-300-Procedure-Buyer","is_ref":true,"ordinal":0,"scheme":null,"type":"id","value":"ORG-GB-PPON-PWCV-4283-GVPW"}]},{"kind":"LotResult","parent_section_id":"PROCEDURE","section_id":"RES-1-1","values":[{"field_id":"BT-13713-LotResult","is_ref":false,"ordinal":0,"scheme":null,"type":"id","value":"1"},{"code":"selec-w","field_id":"BT-142-LotResult","list":null,"ordinal":0,"type":"code"},{"field_id":"OPT-315-LotResult","is_ref":true,"ordinal":0,"scheme":null,"type":"id","value":"CON-1"},{"field_id":"OPT-320-LotResult","is_re