ization-Company","list":"country","ordinal":0,"type":"code"},{"field_id":"OPT-200-Organization-Company","is_ref":false,"ordinal":0,"scheme":"organization","type":"id","value":"ORG-0001"},{"code":"1","field_id":"UBL-AddressFormatCode","list":null,"ordinal":0,"type":"code"},{"field_id":"UBL-CountryName","lang":null,"ordinal":0,"type":"text","value":"España"},{"field_id":"UBL-CountrySubentity","lang":null,"ordinal":0,"type":"text","value":"Madrid"}]},{"kind":"Notice","parent_section_id":null,"section_id":"PROCEDURE","values":[{"code":"32014L0024","field_id":"BT-01-notice","list":null,"ordinal":0,"type":"code"},{"code":"pin-rtl","field_id":"BT-02-notice","list":"planning","ordinal":0,"type":"code"},{"field_id":"BT-05(a)-notice","ordinal":0,"type":"date","value":"2026-10-16T10:42:22+02:00"},{"code":"update-add","field_id":"BT-140-notice","list":"change-corrig-justification","ordinal":0,"type":"code"},{"field_id":"BT-21-Procedure","lang":"SPA","ordinal":0,"type":"text","value":"Contrato mixto de servicios y suministro para el mantenimiento, soporte y evolución de la plataforma de gestión de servicios públicos urbanos de Madrid (4 lotes)"},{"field_id":"BT-22-Procedure","is_ref":false,"ordinal":0,"scheme":null,"type":"id","value":"300/2026/01506"},{"code":"services","field_id":"BT-23-Lot","list":"contract-nature","ordinal":0,"type":"code"},{"field_id":"BT-24-Procedure","lang":"SPA","ordinal":0,"type":"text","value":"Contratación de los servicios y suministro de tecnologías de la información necesarios para la operación, mantenimiento, evolución y gobierno de la Plataforma tecnológica MiNT del Ayuntamiento de Madrid, así como de los sistemas asociados a la gestión de activos urbanos, la relación con la ciudadanía y la explotación de la información, y una oficina orientada al control del servicio.\r\nEl objeto del contrato comprende el suministro y el conjunto de servicios dirigidos a asegurar el funcionamiento continuo de la plataforma MiNT, su adaptación a las necesidades funcionales de los servicios municipales, la integración con el ecosistema de sistemas corporativos y la incorporación de capacidades avanzadas de analítica y soporte a la toma de decisiones.\r\nEn particular, el alcance incluye:\r\n* La gestión funcional y técnica de los sistemas asociados a los servicios públicos urbanos, incluyendo inventarios, actuaciones y procesos operativos.\r\n* La provisión y operación del sistema de avisos e interacción con la ciudadanía, así como su integración con los sistemas de gestión.\r\n* La disponibilidad de capacidades de analítica y explotación de la información, con especial atención a la componente geoespacial y a la construcción de cuadros de mando.\r\n* La administración, operación y evolución de las plataformas tecnológicas que soportan estos servicios, incluidas las infraestructuras y entornos cloud asociados.\r\n* La definición y ejecución de mecanismos de gobierno, calidad, seguimiento, planificación evolutiva e innovación sobre el conjunto del servicio.\r\nEl conjunto de servicios se presta sobre una arquitectura tecnológica basada en entornos distribuidos y modelos cloud, e integra componentes propios del Ayuntamiento y servicios proporcionados por terceros, requiriendo un alto grado de coordinación entre los distintos ámbitos funcionales y técnicos.\r\nEl contrato se estructura en varios lotes, correspondientes a ámbitos de servicio diferenciados, que responden a necesidades específicas y a distintos niveles de especialización técnica. No obstante, dichos ámbitos presentan una elevada interdependencia al compartir información, procesos y base tecnológica, por lo que se articulan bajo un único marco contractual que asegura su coordinación, coherencia y funcionamiento conjunto.\r\nLos servicios incluidos comprenden tanto actividades de mantenimiento -correctivo, adaptativo, evolutivo y perfectivo- como tareas de operación, administración, soporte, analítica, integración y mejora continua, necesarias para garantizar la adecuada prestación de los servicios digitales municipales soportados por la plataforma MiNT.\r\nEl suministro contratado incluye infraestructura y recursos tecnológicos en la nube donde prestará servicio la plataforma, así como las licencias de los productos necesarios para poder prestar el servicio."},{"code":"72262000","field_id":"BT-262-Procedure","ordinal":0,"scheme":"cpv","type":"classification"},{"cents":4442067747,"currency":"EUR","field_id":"BT-27-Procedure","ordinal":0,"type":"amount"},{"field_id":"BT-36-Lot","ordinal":0,"type":"number","unit":"MONTH","value":36.0},{"field_id":"BT-536-Lot","ordinal":0,"type":"date","value":"2027-03-01"},{"code":"no-eu-funds","field_id":"BT-60-Lot","list":"eu-funded","ordinal":0,"type":"code"},{"field_id":"BT-701-notice","is_ref":false,"ordinal":0,"scheme":"notice-id","type":"id","value":"2ed5347e-c5d6-48d3-a53b-b49d32899e90"},{"code":"SPA","field_id":"BT-702(a)-notice","list":null,"ordinal":0,"type":"code"},{"field_id":"BT-757-notice","is_ref":false,"ordinal":0,"scheme":null,"type":"id","value":"01"},{"field_id":"BT-758-notice","is_ref":false,"ordinal":0,"scheme":null,"type":"id","value":"511c1641-636e-4c02-aa17-bde1d6c81e20-01"},{"field_id":"OPP-010-notice","is_ref":false,"ordinal":0,"scheme":"ojs-notice-id","type":"id","value":"00720743-2026"},{"field_id":"OPP-011-notice","is_ref":false,"ordinal":0,"scheme":"ojs-id","type":"id","value":"202/2026"},{"field_id":"OPP-012-notice","ordinal":0,"type":"date","value":"2026-10-19"},{"code":"7","field_id":"OPP-070-notice","list":"notice-subtype","ordinal":0,"type":"code"},{"field_id":"OPT-001-notice","is_ref":false,"ordinal":0,"scheme":null,"type":"id","value":"2.3"},{"field_id":"OPT-002-notice","is_ref":false,"ordinal":0,"scheme":null,"type":"id","value":"eforms-sdk-1.13"},{"field_id":"UBL-TendererRequirementDescription","lang":"SPA","ordinal":0,"type":"text","value":"Motivos de exclusión exclusivamente nacionales"}]},{"kind":"Touchpoint","parent_section_id":"ORG-0001","section_id":