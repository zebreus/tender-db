g gemäß §§ 21 bzw. 194 Abs. 1 des Bundesvergabegesetzes 2018 wird ausdrücklich hingewiesen. §§ 21 bzw. 194 Abs. 1 des Bundesvergabegesetzes 2018 verpflichtet Bewerber oder Bieter, die im Gebiet einer anderen Vertragspartei des EWR-Abkommens oder in der Schweizerischen Eidgenossenschaft (Schweiz) ansässig sind und die für die Ausübung einer Tätigkeit in Österreich eine behördliche Entscheidung betreffend ihre Berufsqualifikation einholen müssen, ein darauf gerichtetes Verfahren möglichst umgehend, jedenfalls aber vor Ablauf der Angebotsfrist einzuleiten. Für reglementierte Gewerbe (§ 94 der Gewerbeordnung 1994) wird diesbezüglich auf die §§ 373a bis 373e der Gewerbeordnung 1994 hingewiesen."},{"field_id":"BT-701-notice","is_ref":false,"ordinal":0,"scheme":"notice-id","type":"id","value":"0e48b9f1-a98f-49d6-bab0-7d9b92abea41"},{"code":"DEU","field_id":"BT-702(a)-notice","list":"language","ordinal":0,"type":"code"},{"field_id":"BT-757-notice","is_ref":false,"ordinal":0,"scheme":null,"type":"id","value":"01"},{"field_id":"OPP-010-notice","is_ref":false,"ordinal":0,"scheme":"ojs-notice-id","type":"id","value":"00712835-2026"},{"field_id":"OPP-011-notice","is_ref":false,"ordinal":0,"scheme":"ojs-id","type":"id","value":"200/2026"},{"field_id":"OPP-012-notice","ordinal":0,"type":"date","value":"2026-10-15"},{"code":"29","field_id":"OPP-070-notice","list":"notice-subtype","ordinal":0,"type":"code"},{"field_id":"OPT-001-notice","is_ref":false,"ordinal":0,"scheme":null,"type":"id","value":"2.3"},{"field_id":"OPT-002-notice","is_ref":false,"ordinal":0,"scheme":null,"type":"id","value":"eforms-sdk-1.12"},{"field_id":"OPT-999","ordinal":0,"type":"date","value":"2000-01-01"}]},{"kind":"LotResult","parent_section_id":"PROCEDURE","section_id":"RES-4762","values":[{"field_id":"BT-13713-LotResult","is_ref":true,"ordinal":0,"scheme":null,"type":"id","value":"LOT-1478"},{"code":"selec-w","field_id":"BT-142-LotResult","list":"winner-selection-status","ordinal":0,"type":"code"},{"field_i