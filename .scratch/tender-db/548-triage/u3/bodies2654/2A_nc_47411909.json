nost za 13.400,00 EUR brez DDV in se podaljša rok izvedbe del tako, da se dok za oddajo PZI določi do 30 dni po pridobitvi pravnomočnege gradbenega dovoljenja."}]},{"kind":"ContractingParty","parent_section_id":"PROCEDURE","section_id":"ND-ContractingParty#0","values":[{"field_id":"OPT-300-Procedure-Buyer","is_ref":true,"ordinal":0,"scheme":"organization","type":"id","value":"ORG-0001"}]},{"kind":"LotPlacePerformance","parent_section_id":"LOT-0000","section_id":"ND-LotPlacePerformance#0","values":[{"code":"SI042","field_id":"BT-5071-Lot","ordinal":0,"scheme":"nuts","type":"classification"},{"code":"SVN","field_id":"BT-5141-Lot","list":"country","ordinal":0,"type":"code"}]},{"kind":"LotResultContractReference","parent_section_id":"RES-0000","section_id":"ND-LotResultContractReference#0","values":[{"field_id":"OPT-315-LotResult","is_ref":true,"ordinal":0,"scheme":"contract","type":"id","value":"CON-0000"}]},{"kind":"LotResultTenderReference","parent_section_id":"RES-0000","section_id":"ND-LotResultTenderReference#0","values":[{"cents":122890000,"currency":"EUR","field_id":"BT-720-Tender","ordinal":0,"type":"amount"},{"field_id":"OPT-320-LotResult","is_ref":true,"ordinal":0,"scheme":"tender","type":"id","value":"TEN-0000"}]},{"kind":"ProcedureAdditionalCommodityClassification","parent_section_id":"PROCEDURE","section_id":"ND-ProcedureAdditionalCommodityClassification#0","values":[{"code":"71220000","field_id":"BT-263-Procedure","ordinal":0,"scheme":"cpv","type":"classification"}]},{"kind":"ProcedureAdditionalCommodityClassification","parent_section_id":"PROCEDURE","section_id":"ND-ProcedureAdditionalCommodityClassification#1","values":[{"code":"71222000","field_id":"BT-263-Procedure","ordinal":0,"scheme":"cpv","type":"classification"}]},{"kind":"ProcedureAdditionalCommodityClassification","parent_section_id":"PROCEDURE","section_id":"ND-ProcedureAdditionalCommodityClassification#2","values":[{"code":"71221000","field_id":"BT-263-Procedure","ordinal":0,"scheme":"cpv","t