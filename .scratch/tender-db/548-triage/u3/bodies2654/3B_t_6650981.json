"mention_name":"Clinic Service Vorarlberg GmbH","organization_id":15501193,"organization_name":"Clinic Service Vorarlberg GmbH","role":"winner"}],"procedure_key":"ojs:2019-527783","procedure_type":"neg-w-call","publication_id":"321797-2020","published_at":"2020-07-09","source":"ted","submission_deadline":"2019-12-06T12:00:00+00:00","submission_deadline_scope":"procedure","texts":[{"field":"description","lang":"DEU","lot":null,"value":"Rahmenvereinbarung mit einer Partei für Dienstleistungen des Patientenmanagements in Krankenhäusern der Steiermark."},{"field":"title","lang":"DEU","lot":null,"value":"KAGes Patientenmanagement"},{"field":"description","lang":"DEU","lot":"LOT-1","value":"Die unternehmerische Kernaufgabe der Auftraggeberin umfasst insbesondere das Errichten und den Betrieb von Landeskrankenanstalten im Land Steiermark sowie deren Führung. Das Ausschreibungsziel des vorliegenden Vergabeverfahrens besteht im Abschluss einer Rahmenvereinbarung für die Erbringung von Dienstleistungen für das ausschreibungsgegenständliche Patientenmanagement. Davon umfasst sind insbesondere Abteilungshilfsdienste und hauswirtschaftliche Tätigkeiten zur entlastenden Unterstützung der Pflegepersonen im patientennahen Bereich. Mit dem vorliegenden Beschaffungsvorhaben soll sichergestellt werden, dass der jeweilige Bedarf der Auftraggeberin an den erforderlichen Dienstleistungen für das Patientenmanagement in den ausschreibungsgegenständlichen Landeskrankenhäusern gedeckt werden kann."}],"title":"KAGes Patientenmanagement","value":{"cents":68079570,"currency":"EUR"},"value_derivation":null,"version":2,"versions":[{"caused_by_notice_id":20718387,"dispatched_at":"2019-11-05","notice_subtype":null,"original_lang":"DEU","publication_id":"527783-2019","published_at":"2019-11-07","seq":1},{"caused_by_notice_id":21136186,"dispatched_at":"2020-07-07","notice_subtype":null,"original_lang":"DEU","publication_id":"321797-2020","published_at":"2020-07-09","seq":2}]}