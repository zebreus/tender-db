ultatif interrégional de règlement amiable des litiges en matière de marchés publics","organization_id":1178255,"organization_name":"Comité consultatif interrégional de règlement amiable des litiges en matière de marchés publics","role":"mediation-body"},{"lot":null,"mention_name":"Tribunal administratif de Montpellier","organization_id":1163864,"organization_name":"Tribunal administratif de Montpellier","role":"review-body"},{"lot":"LOT-1","mention_name":"Mandataire: Cazal SAS","organization_id":14259882,"organization_name":"CAZAL","role":"winner"},{"lot":"LOT-1","mention_name":"Lavoye","organization_id":14259883,"organization_name":"Lavoye","role":"winner"},{"lot":"LOT-2","mention_name":"Mandataire: Cazal SAS","organization_id":14259882,"organization_name":"CAZAL","role":"winner"},{"lot":"LOT-2","mention_name":"Lavoye","organization_id":14259883,"organization_name":"Lavoye","role":"winner"}],"procedure_key":"ojs:2019-493345","procedure_type":"open","publication_id":"493345-2019","published_at":"2019-10-21","source":"ted","submission_deadline":null,"submission_deadline_scope":null,"texts":[{"field":"description","lang":"FRA","lot":null,"value":"Le présent marché concerne les travaux de confortement et de protection des digues de l'Aude, tant en rive droite en rive gauche du fleuve, sur les communes de Sallèles-d'Aude, Narbonne, Cuxac-d'Aude et Coursan. Les travaux sont situés entre l'ouvrage de prise du Gailhousty sur le canal de jonction en amont, et la confluence du chenal de Coursan et de l'Aude en aval sur les tronçons définis au CCTP. L'objectif de l'opération est d'assurer un fonctionnement contrôlé du fleuve dans la basse plaine par la pérennisation du système de protection qui régule l'écoulement de l'Aude en crue en aval du seuil de Moussoulens. Il s'agit principalement de conforter les endiguements existants vis-à-vis des risques de rupture et d'assurer le fonctionnement correct des déversoirs de sécurité."},{"field":"title","lang":"FRA","lot":null,"value":"Confortement des digues et déversoirs de l'Aude — travaux"},{"field":"description","lang":"FRA","lot":"LOT-1","value":"Amont de Cuxac-d'Aude."},{"field":"title","lang":"FRA","lot":"LOT-1","value":"Amont Cuxac-d'Aude"},{"field":"description","lang":"FRA","lot":"LOT-2","value":"Aval Cuxac-d'Aude."},{"field":"title","lang":"FRA","lot":"LOT-2","value":"Aval Cuxac-d'Aude"}],"title":"Confortement des digues et déversoirs de l'Aude — travaux","value":null,"value_derivation":null,"version":1,"versions":[{"caused_by_notice_id":20703036,"dispatched_at":"2019-10-16","notice_subtype":null,"original_lang":"FRA","publication_id":"493345-2019","published_at":"2019-10-21","seq":1}]}