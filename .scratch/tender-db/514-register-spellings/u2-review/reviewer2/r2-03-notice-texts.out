{"columns":["notice_id","section_id","field_id","ordinal","value"],"row_count":129,"rows":[[46731924,"1","BT-21-Lot",0,"VCFSE Led Projects to enable delivery partnerships"],[46731924,"1","BT-24-Lot",0,"Lots are invited to support initiatives to align with the themes identified during the market engagement event"],[46731924,"2","BT-21-Lot",0,"Community Partnership Lead"],[46731924,"2","BT-24-Lot",0,"The provision of a Community Partnership Lead who will play a key role in supporting the establishment of a Community Partnership Collective of local grassroot organisations through the effective identification and engagement of local community partners"],[46731924,"3","BT-21-Lot",0,"Establishment of a Community Collective"],[46731924,"3","BT-24-Lot",0,"The establishment of community partners or groups of partners to develop and host a Community Partners' Collective. The purpose of this collective is to provide shared infrastructure, coordination, and support to grassroots organisations in the NMHC catchment area"],[46731924,"ORG-GB-CHC-Charity Registration Number 1107830","BT-500-Organization-Company",0,"Citizens Advice Mid Mercia"],[46731924,"ORG-GB-CHC-Charity number: 1205036","BT-500-Organization-Company",0,"Ghamkol Sharif Central Jamia Charity"],[46731924,"ORG-GB-CHC-no. 1153202","BT-500-Organization-Company",0,"Saheli Hub"],[46731924,"ORG-GB-COH-Company number 02897250","BT-500-Organization-Company",0,"BIRMINGHAM DISABILITY RESOURCE CENTRE"],[46731924,"ORG-GB-COH-Company number 11053889","BT-500-Organization-Company",0,"Power of Change CIC"],[46731924,"ORG-GB-COH-Company number 11619728","BT-500-Organization-Company",0,"Dream Chaser Youth Club CIC"],[46731924,"ORG-GB-COH-Company number 11619728","BT-500-Organization-Company",1,"DREAM CHASER YOUTH CLUB CIC"],[46731924,"ORG-GB-COH-Company number 13057625","BT-500-Organization-Company",0,"Hope Inspired CIC"],[46731924,"ORG-GB-COH-Company number 14651450","BT-500-Organization-Company",0,"UPLIFT ADULT AND YOUTH C.I.C."],