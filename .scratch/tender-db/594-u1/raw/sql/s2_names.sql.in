SELECT * FROM (SELECT 'jA' AS arm, o.id AS id, o.name AS name, o.identifier AS ident, o.identifier_kind AS kind, o.country AS cc, o.provisional AS prov, (SELECT count(*) FROM organization_mentions m WHERE m.organization_id = o.id) AS mentions FROM organizations o WHERE o.name_norm >= 'junta de andalucía' AND o.name_norm < 'junta de andalucíb' ORDER BY o.name_norm, o.id LIMIT 120) UNION ALL SELECT * FROM (SELECT 'ja' AS arm, o.id AS id, o.name AS name, o.identifier AS ident, o.identifier_kind AS kind, o.country AS cc, o.provisional AS prov, (SELECT count(*) FROM organization_mentions m WHERE m.organization_id = o.id) AS mentions FROM organizations o WHERE o.name_norm >= 'junta de andalucia' AND o.name_norm < 'junta de andalucib' ORDER BY o.name_norm, o.id LIMIT 120) UNION ALL SELECT * FROM (SELECT 'tarc' AS arm, o.id AS id, o.name AS name, o.identifier AS ident, o.identifier_kind AS kind, o.country AS cc, o.provisional AS prov, (SELECT count(*) FROM organization_mentions m WHERE m.organization_id = o.id) AS mentions FROM organizations o WHERE o.name_norm >= 'tribunal administrativo de recursos contractuales' AND o.name_norm < 'tribunal administrativo de recursos contractualet' ORDER BY o.name_norm, o.id LIMIT 150) UNION ALL SELECT * FROM (SELECT 'trc' AS arm, o.id AS id, o.name AS name, o.identifier AS ident, o.identifier_kind AS kind, o.country AS cc, o.provisional AS prov, (SELECT count(*) FROM organization_mentions m WHERE m.organization_id = o.id) AS mentions FROM organizations o WHERE o.name_norm >= 'tribunal de recursos contractuales' AND o.name_norm < 'tribunal de recursos contractualet' ORDER BY o.name_norm, o.id LIMIT 60) UNION ALL SELECT * FROM (SELECT 'adm' AS arm, o.id AS id, o.name AS name, o.identifier AS ident, o.identifier_kind AS kind, o.country AS cc, o.provisional AS prov, (SELECT count(*) FROM organization_mentions m WHERE m.organization_id = o.id) AS mentions FROM organizations o WHERE o.name_norm >= 'administración de la junta de andalucía' AND o.name_norm < 'administración de la junta de andalucíb' ORDER BY o.name_norm, o.id LIMIT 30) UNION ALL SELECT * FROM (SELECT 'TA' AS arm, o.id AS id, o.name AS name, o.identifier AS ident, o.identifier_kind AS kind, o.country AS cc, o.provisional AS prov, (SELECT count(*) FROM organization_mentions m WHERE m.organization_id = o.id) AS mentions FROM organizations o WHERE o.name_norm >= 'tarc' AND o.name_norm < 'tard' ORDER BY o.name_norm, o.id LIMIT 30) UNION ALL SELECT 'count-jA' AS arm, count(*) AS id, NULL AS name, NULL AS ident, NULL AS kind, NULL AS cc, NULL AS prov, NULL AS mentions FROM organizations o WHERE o.name_norm >= 'junta de andalucía' AND o.name_norm < 'junta de andalucíb' UNION ALL SELECT 'count-ja' AS arm, count(*) AS id, NULL AS name, NULL AS ident, NULL AS kind, NULL AS cc, NULL AS prov, NULL AS mentions FROM organizations o WHERE o.name_norm >= 'junta de andalucia' AND o.name_norm < 'junta de andalucib' UNION ALL SELECT 'count-tarc' AS arm, count(*) AS id, NULL AS name, NULL AS ident, NULL AS kind, NULL AS cc, NULL AS prov, NULL AS mentions FROM organizations o WHERE o.name_norm >= 'tribunal administrativo de recursos contractuales' AND o.name_norm < 'tribunal administrativo de recursos contractualet'
