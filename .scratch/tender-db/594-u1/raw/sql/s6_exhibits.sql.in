WITH q AS (SELECT DISTINCT p.tender_id AS tid, p.mention_notice_id AS nid FROM tender_version_parties p WHERE p.organization_id = 2660 AND p.role = 'Procedure-Buyer' ORDER BY p.tender_id DESC LIMIT 6) SELECT q.tid AS tid, q.nid AS nid, m.section_id AS sid, m.organization_id AS org, m.name AS name, m.raw_identifier AS raw_id, m.scheme AS scheme FROM q CROSS JOIN organization_mentions m ON m.notice_id = q.nid
