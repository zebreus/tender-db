SELECT p.role AS role, m.name AS name, count(*) AS n, count(DISTINCT p.tender_id) AS t, sum(CASE WHEN p.seq = t.current_seq THEN 1 ELSE 0 END) AS cur_rows FROM tender_version_parties p CROSS JOIN organization_mentions m ON m.notice_id = p.mention_notice_id AND m.section_id = p.mention_section_id CROSS JOIN tenders t ON t.id = p.tender_id WHERE p.organization_id = 2660 AND p.role = 'Procedure-Buyer' GROUP BY p.role, m.name UNION ALL SELECT p.role AS role, m.name AS name, count(*) AS n, count(DISTINCT p.tender_id) AS t, sum(CASE WHEN p.seq = t.current_seq THEN 1 ELSE 0 END) AS cur_rows FROM tender_version_parties p CROSS JOIN organization_mentions m ON m.notice_id = p.mention_notice_id AND m.section_id = p.mention_section_id CROSS JOIN tenders t ON t.id = p.tender_id WHERE p.organization_id = 2660 AND p.role = 'buyer' GROUP BY p.role, m.name
