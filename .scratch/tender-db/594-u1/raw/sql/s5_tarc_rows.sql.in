2 FROM tender_version_parties p WHERE p.organization_id = 3231 GROUP BY p.role UNION ALL SELECT 'on' AS arm, n.org_id AS org, n.lang AS s1, n.name AS s2, NULL AS s3, NULL AS n1, NULL AS n2 FROM organization_names n WHERE n.org_id = 2660
