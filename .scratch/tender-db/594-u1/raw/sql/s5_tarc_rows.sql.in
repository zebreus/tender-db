SELECT * FROM (SELECT 'pfx' AS arm, o.id AS org, o.name AS s1, o.identifier AS s2, o.identifier_kind AS s3, o.provisional AS n1, (SELECT count(*) FROM organization_mentions m WHERE m.organization_id = o.id) AS n2 FROM organizations o WHERE o.name_norm >= 'tribunal administrativo de recursos contractuales de la f' AND o.name_norm < 'tribunal administrativo de recursos contractualet' ORDER BY o.name_norm, o.id LIMIT 250) UNION ALL SELECT * FROM (SELECT 'nm' AS arm, m.organization_id AS org, m.name AS s1, m.raw_identifier AS s2, m.scheme AS s3, count(*) AS n1, min(m.notice_id) AS n2 FROM organization_mentions m WHERE m.organization_id = 22235590 GROUP BY m.name, m.raw_identifier, m.scheme ORDER BY n1 DESC LIMIT 25) UNION ALL SELECT 'rl' AS arm, p.organization_id AS org, p.role AS s1, NULL AS s2, NULL AS s3, count(*) AS n1, count(DISTINCT p.tender_id) AS n2 FROM tender_version_parties p WHERE p.organization_id = 22235590 GROUP BY p.role UNION ALL SELECT * FROM (SELECT 'nm' AS arm, m.organization_id AS org, m.name AS s1, m.raw_identifier AS s2, m.scheme AS s3, count(*) AS n1, min(m.notice_id) AS n2 FROM organization_mentions m WHERE m.organization_id = 2720543 GROUP BY m.name, m.raw_identifier, m.scheme ORDER BY n1 DESC LIMIT 25) UNION ALL SELECT 'rl' AS arm, p.organization_id AS org, p.role AS s1, NULL AS s2, NULL AS s3, count(*) AS n1, count(DISTINCT p.tender_id) AS n2 FROM tender_version_parties p WHERE p.organization_id = 2720543 GROUP BY p.role UNION ALL SELECT * FROM (SELECT 'nm' AS arm, m.organization_id AS org, m.name AS s1, m.raw_identifier AS s2, m.scheme AS s3, count(*) AS n1, min(m.notice_id) AS n2 FROM organization_mentions m WHERE m.organization_id = 22419088 GROUP BY m.name, m.raw_identifier, m.scheme ORDER BY n1 DESC LIMIT 25) UNION ALL SELECT 'rl' AS arm, p.organization_id AS org, p.role AS s1, NULL AS s2, NULL AS s3, count(*) AS n1, count(DISTINCT p.tender_id) AS n2 FROM tender_version_parties p WHERE p.organization_id = 22419088 GROUP BY p.role UNION A