":"eforms-de-1.1"},{"field_id":"DE1-ID","is_ref":false,"ordinal":0,"scheme":"notice-id","type":"id","value":"9b32ca8e-e267-4b14-98aa-3c60d83cc4bd"},{"field_id":"DE1-IssueDate","ordinal":0,"type":"date","value":"2025-04-30T16:25:06+02:00"},{"code":"DEU","field_id":"DE1-NoticeLanguageCode","list":"eu-official-language","ordinal":0,"type":"code"},{"cents":3754074,"currency":"EUR","field_id":"DE1-NoticeResult-TotalAmount","ordinal":0,"type":"amount"},{"code":"29","field_id":"DE1-NoticeSubType-SubTypeCode","list":"notice-subtype","ordinal":0,"type":"code"},{"code":"can-standard","field_id":"DE1-NoticeTypeCode","list":"result","ordinal":0,"type":"code"},{"field_id":"DE1-ProcurementProject-Description","lang":"DEU","ordinal":0,"type":"text","value":"Planungsleistung Technische Gebäudeausrüstung - Anlagengruppen 1-5, LP 1-9 (stufenweise)"},{"field_id":"DE1-ProcurementProject-ID","is_ref":false,"ordinal":0,"scheme":"internalID","type":"id","value":"Lottenhof_TGA"},{"code":"71000000","field_id":"DE1-ProcurementProject-MainCommodityClassification-ItemClassificationCode","ordinal":0,"scheme":"cpv","type":"classification"},{"field_id":"DE1-ProcurementProject-Name","lang":"DEU","ordinal":0,"type":"text","value":"Sanierung und Modernisierung Lottenhof - Planungsleistung Technische Gebäudeausrüstung für die Anlagengruppen 1-5,gemäß § 53 - 56 HOAI"},{"field_id":"DE1-ProcurementProject-Note","lang":"DEU","ordinal":0,"type":"text","value":"Bekanntmachungs-ID: CXT8YY5YTBB3JVE0\n\n\n1) Das Angebot ist ausschließlich in elektronischer Form und als pdf-Dateien einzureichen. 2) Unter http://vergabemarktplatz.brandenburg.de/VMPCenter/ finden Sie weitere Informationen zum Verfahren. Sie können dort Vergabeunterlagen kostenlos herunterladen und Nachrichten der Vergabestelle einsehen. Die Bieterkommunikation hat ausschließlich über den Vergabemarktplatz Brandenburg zu erfolgen. Es wird eine Registrierung empfohlen."},{"code":"services","field_id":"DE1-ProcurementProject-ProcurementTypeCode","list":"contract-nature","ordinal":0,"type":"code"},{"field_id":"DE1-RegulatoryDomain","lang":null,"ordinal":0,"type":"text","value":"32014L0024"},{"field_id":"DE1-RequestedPublicationDate","ordinal":0,"type":"date","value":"2025-04-30"},{"field_id":"DE1-TenderResult-AwardDate","ordinal":0,"type":"date","value":"2000-01-01"},{"field_id":"DE1-TenderingProcess-AuctionTerms-AuctionConstraintIndicator","ordinal":0,"type":"integer","value":0},{"code":"neg-w-call","field_id":"DE1-TenderingProcess-ProcedureCode","list":"procurement-procedure-type","ordinal":0,"type":"code"},{"field_id":"DE1-TenderingTerms-AppealTerms-AppealInformationParty-PartyIdentification-ID","is_ref":true,"ordinal":0,"scheme":"organization","type":"id","value":"ORG-0002"},{"field_id":"DE1-TenderingTerms-AppealTerms-AppealReceiverParty-PartyIdentification-ID","is_ref":true,"ordinal":0,"scheme":"organization","type":"id","value":"ORG-0003"},{"field_id":"DE1-TenderingTerms-AppealTerms-PresentationPeriod-Description","lang":"DEU","ordinal":0,"type":"text","value":"Verstöße gegen Vergabevorschriften müssen innerhalb einer Frist von zehn Kalendertagen nach Kenntniserlangung gerügt werden (§ 160 Abs. 3 Nr. 1 GWB). Bei Verstößen, die aus der Bekanntmachung oder den Vergabeunterlagen erkennbar sind, hat die Rüge gegenüber der Vergabestelle bis spätestens zum Ablauf der Angebots- oder Bewerbungsfrist zu erfolgen (§ 160 Abs. 3 Nr. 2 und 3 GWB). Teilt die Vergabestelle mit, dass der Rüge nicht abgeholfen wird, kann innerhalb von 15 Kalendertagen ein Nachprüfungsantrag bei der oben genannten Vergabekammer schriftlich gestellt werden (§§ 160 Abs. 3 Nr. 4, 161 Abs. 1 GWB). Ein Nachprüfungsantrag ist zudem unzulässig, soweit der Nachprüfungsantrag der Vergabestelle erst nach Zuschlagserteilung zugestellt wird (§ 168 Abs. 2 GWB). Die Zuschlagserteilung ist möglich 10 Tage nach Absendung (per Fax oder elektronisch) der Bekanntgabe der Vergabeentscheidung (§ 134 Abs. 2 GWB)."},{"code":"no-eu-funds","field_id":"DE1-TenderingTerms-FundingProgramCode","list":"eu-funded","ordinal":0,"type":"code"},{"field_id":"DE1-UBLVersionID","is_ref":false,"ordinal":0,"scheme":null,"type":"id","value":"2.3"},{"field_id":"DE1-VersionID","is_ref":false,"ordinal":0,"scheme":null,"type":"id","value":"01"}]},{"kind":"LotResult","parent_section_id":"PROCEDURE","section_id":"RES-0001","values":[{"cents":4135620,"currency":"EUR","field_id":"DE1-NoticeResult-LotResult-HigherTenderAmount","ordinal":0,"type":"amount"},{"field_id":"DE1-NoticeResult-LotResult-ID","is_ref":false,"ordinal":0,"scheme":null,"type":"id","value":"RES-0001"},{"cents":3754074,"currency":"EUR","field_id":"DE1-NoticeResult-LotResult-LowerTenderAmount","ordinal":0,"type":"amount"},{"field_id":"DE1-NoticeResult-LotResult-TenderLot-ID","is_ref":false,"ordinal":0,"scheme":"Lot","type":"id","value":"LOT-0001"},{"code":"selec-w","field_id":"DE1-NoticeResult-LotResult-TenderResultCode","list":"winner-selection-status","ordinal":0,"type":"code"}]},{"kind":"LotResult","parent_section_id":"PROCEDURE","section_id":"RES-0002","values":[{"code":"all-rej","field_id":"DE1-NoticeResult-LotResult-DecisionReason-DecisionReasonCode","list":"non-award-justification","ordinal":0,"type":"code"},{"field_id":"DE1-NoticeResult-LotResult-ID","is_ref":false,"ordinal":0,"scheme":null,"type":"id","value":"RES-0002"},{"field_id":"DE1-NoticeResult-LotResult-TenderLot-ID","is_ref":false,"ordinal":0,"scheme":"Lot","type":"id","value":"LOT-0002"},{"code":"clos-nw","field_id":"DE1-NoticeResult-LotResult-TenderResultCode","list":"winner-selection-status","ordinal":0,"type":"code"}]},{"kind":"LotTender","parent_section_id":"PROCEDURE","section_id":"TEN-0001","values":[{"field_id":"DE1-NoticeResult-LotTender-ID","is_ref":false,"ordinal":0,"scheme":"tender","type":"id","value":"TEN-0001"},{"cents":3754074,"currency":"EUR","field_id":"DE1-NoticeResult-LotTender-LegalMonetaryTotal-PayableAmount","ordinal":0,"type":"amount"},{"code":"not-known","field_id":"DE1-NoticeResult-LotTend