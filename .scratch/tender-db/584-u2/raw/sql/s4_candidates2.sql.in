SELECT * FROM (SELECT 'novum' AS tag, o.id AS id, o.country AS cc, o.identifier_kind AS kind, o.identifier AS ident, o.provisional AS prov, o.name AS name, (SELECT count(*) FROM organization_mentions m WHERE m.organization_id = o.id) AS mentions FROM organizations o WHERE o.name_norm >= 'novum s' AND o.name_norm < 'novum t' ORDER BY o.name_norm, o.id LIMIT 30) UNION ALL SELECT * FROM (SELECT 'zarys_g' AS tag, o.id AS id, o.country AS cc, o.identifier_kind AS kind, o.identifier AS ident, o.provisional AS prov, o.name AS name, (SELECT count(*) FROM organization_mentions m WHERE m.organization_id = o.id) AS mentions FROM organizations o WHERE o.name_norm >= 'zarys international group' AND o.name_norm < 'zarys international grouq' ORDER BY o.name_norm, o.id LIMIT 40) UNION ALL SELECT * FROM (SELECT 'zarys_sp' AS tag, o.id AS id, o.country AS cc, o.identifier_kind AS kind, o.identifier AS ident, o.provisional AS prov, o.name AS name, (SELECT count(*) FROM organization_mentions m WHERE m.organization_id = o.id) AS mentions FROM organizations o WHERE o.name_norm >= 'zarys international sp' AND o.name_norm < 'zarys international sq' ORDER BY o.name_norm, o.id LIMIT 10) UNION ALL SELECT * FROM (SELECT 'jm_i' AS tag, o.id AS id, o.country AS cc, o.identifier_kind AS kind, o.identifier AS ident, o.provisional AS prov, o.name AS name, (SELECT count(*) FROM organization_mentions m WHERE m.organization_id = o.id) AS mentions FROM organizations o WHERE o.name_norm >= 'i&m engineers' AND o.name_norm < 'i&m engineert' ORDER BY o.name_norm, o.id LIMIT 10) UNION ALL SELECT * FROM (SELECT 'jm_i2' AS tag, o.id AS id, o.country AS cc, o.identifier_kind AS kind, o.identifier AS ident, o.provisional AS prov, o.name AS name, (SELECT count(*) FROM organization_mentions m WHERE m.organization_id = o.id) AS mentions FROM organizations o WHERE o.name_norm >= 'i & m engineers' AND o.name_norm < 'i & m engineert' ORDER BY o.name_norm, o.id LIMIT 10) UNION ALL SELECT * FROM (SELECT 'jm_jm' AS tag, o.id AS id, o.country AS cc, o.identifier_kind AS kind, o.identifier AS ident, o.provisional AS prov, o.name AS name, (SELECT count(*) FROM organization_mentions m WHERE m.organization_id = o.id) AS mentions FROM organizations o WHERE o.name_norm >= 'jm engineers' AND o.name_norm < 'jm engineert' ORDER BY o.name_norm, o.id LIMIT 10) UNION ALL SELECT * FROM (SELECT 'jm_mal' AS tag, o.id AS id, o.country AS cc, o.identifier_kind AS kind, o.identifier AS ident, o.provisional AS prov, o.name AS name, (SELECT count(*) FROM organization_mentions m WHERE m.organization_id = o.id) AS mentions FROM organizations o WHERE o.name_norm >= 'malewicz' AND o.name_norm < 'malewic{' ORDER BY o.name_norm, o.id LIMIT 10) UNION ALL SELECT * FROM (SELECT 'pro3d_a' AS tag, o.id AS id, o.country AS cc, o.identifier_kind AS kind, o.identifier AS ident, o.provisional AS prov, o.name AS name, (SELECT count(*) FROM organization_mentions m WHERE m.organization_id = o.id) AS mentions FROM organizations o WHERE o.name_norm >= 'pro 3d' AND o.name_norm < 'pro 3e' ORDER BY o.name_norm, o.id LIMIT 10) UNION ALL SELECT * FROM (SELECT 'pro3d_b' AS tag, o.id AS id, o.country AS cc, o.identifier_kind AS kind, o.identifier AS ident, o.provisional AS prov, o.name AS name, (SELECT count(*) FROM organization_mentions m WHERE m.organization_id = o.id) AS mentions FROM organizations o WHERE o.name_norm >= 'pro-3d' AND o.name_norm < 'pro-3e' ORDER BY o.name_norm, o.id LIMIT 10) UNION ALL SELECT * FROM (SELECT 'pro3d_c' AS tag, o.id AS id, o.country AS cc, o.identifier_kind AS kind, o.identifier AS ident, o.provisional AS prov, o.name AS name, (SELECT count(*) FROM organization_mentions m WHERE m.organization_id = o.id) AS mentions FROM organizations o WHERE o.name_norm >= 'pro3d' AND o.name_norm < 'pro3e' ORDER BY o.name_norm, o.id LIMIT 10) UNION ALL SELECT * FROM (SELECT 'terra_b' AS tag, o.id AS id, o.country AS cc, o.identifier_kind AS kind, o.identifier AS ident, o.provisional AS prov, o.name AS name, (SELECT count(*) FROM organization_mentions m WHERE m.organization_id = o.id) AS mentions FROM organizations o WHERE o.name_norm >= 'terra-mota' AND o.name_norm < 'terra-motb' ORDER BY o.name_norm, o.id LIMIT 10) UNION ALL SELECT * FROM (SELECT 'terra_c' AS tag, o.id AS id, o.country AS cc, o.identifier_kind AS kind, o.identifier AS ident, o.provisional AS prov, o.name AS name, (SELECT count(*) FROM organization_mentions m WHERE m.organization_id = o.id) AS mentions FROM organizations o WHERE o.name_norm >= 'terramota' AND o.name_norm < 'terramotb' ORDER BY o.name_norm, o.id LIMIT 10)