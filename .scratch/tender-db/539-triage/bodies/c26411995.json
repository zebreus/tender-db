TypeCode","list":null,"ordinal":0,"type":"code"},{"code":"cn-standard","field_id":"DE1-NoticeTypeCode","list":"competition","ordinal":0,"type":"code"},{"field_id":"DE1-ProcurementProject-Description","lang":"DEU","ordinal":0,"type":"text","value":"Liefern und Einbau von Fensterelementen Holz-Alu für den Neubau einer 2 stöckigen Kindertagesstätte, nicht unterkellert.- zweigeschoßiges Gebäude mit einer Grundfläche von ca. 1.400 m²  und einer Kubatur von ca. 10.500 m³- Rechteckiger Baukörper mit Länge x Breite = ca. 65 x 21 m;- Baukonstruktion: Massivbau mit Stb.-Decken und gemauerten Außen- und Innenwänden;- Stb.-Boden- und Deckenplatten; mit extensiv begrüntem Stb.-Flachdach, auf Stb.-Streifen- und Einzelfundamenten gegründet;- Außenwände z.T. aus kerngedämmtem monolithischem Mauerwerk (D = 42,5 cm), z. T. aus Mauerwerk (D = 24 cm) mit einer hinterlüfteten, holzverschalten Außenwanddämmung; Überschlägige Massen: - ca. 1.150 m³ Stb.-Decken und Bodenplatten;- ca. 630 m³ Mauerwerk (außen und innen in unterschiedlichen Mauerstärken)"},{"field_id":"DE1-ProcurementProject-ID","is_ref":false,"ordinal":0,"scheme":"InternalID","type":"id","value":"6210.111.47/26a"},{"code":"45214100","field_id":"DE1-ProcurementProject-MainCommodityClassification-ItemClassificationCode","ordinal":0,"scheme":"cpv","type":"classification"},{"field_id":"DE1-ProcurementProject-Name","lang":"DEU","ordinal":0,"type":"text","value":"26a_Fenster Holz-Alu"},{"field_id":"DE1-ProcurementProject-Note","lang":"DEU","ordinal":0,"type":"text","value":"Der Bieter hat anzugeben inwieweit sein Unternehmen einen Bezug zu Russland hat. Dafür ist die “Eigenerklärung Bezug Russland“ (FB 127/L127/III.127) auszufüllen und als Teil des Angebotes abzugeben. Diese Erklärung ist auch für Unterauftragnehmer, Lieferanten oder Eignungsverleiher gem. den Bedingungen der Erklärung abzugeben.Angebote können ausschließlich von registrierten Bewerbern über die Vergabeplattform (www.staatsanzeiger-eservices.de) in Textform eingereicht werden.Die Kommunikation (Fragen, Auskünfte) erfolgt ausschließlich über die Vergabeplattform."},{"code":"works","field_id":"DE1-ProcurementProject-ProcurementTypeCode","list":"contract-nature","ordinal":0,"type":"code"},{"field_id":"DE1-Publication-GazetteID","is_ref":false,"ordinal":0,"scheme":"ojs-id","type":"id","value":"999/1900"},{"field_id":"DE1-Publication-NoticePublicationID","is_ref":false,"ordinal":0,"scheme":"ojs-notice-id","type":"id","value":"00000000-1900"},{"field_id":"DE1-Publication-PublicationDate","ordinal":0,"type":"date","value":"2023-12-19"},{"field_id":"DE1-RegulatoryDomain","lang":null,"ordinal":0,"type":"text","value":"32014L0024"},{"field_id":"DE1-RequestedPublicationDate","ordinal":0,"type":"date","value":"2024-07-25"},{"code":"open","field_id":"DE1-TenderingProcess-ProcedureCode","list":"procurement-procedure-type","ordinal":0,"type":"code"},{"field_id":"DE1-TenderingProcess-ProcedureRelaunchIndicator","ordinal":0,"type":"integer","value":0},{"field_id":"DE1-TenderingTerms-LotDistribution-MaximumLotsAwardedNumeric","ordinal":0,"type":"number","unit":null,"value":1.0},{"field_id":"DE1-TenderingTerms-LotDistribution-MaximumLotsSubmittedNumeric","ordinal":0,"type":"number","unit":null,"value":1.0},{"field_id":"DE1-UBLVersionID","is_ref":false,"ordinal":0,"scheme":null,"type":"id","value":"2.3"},{"field_id":"DE1-VersionID","is_ref":false,"ordinal":0,"scheme":null,"type":"id","value":"01"}]}]}