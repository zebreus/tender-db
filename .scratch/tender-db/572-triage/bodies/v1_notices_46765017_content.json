lue":"ocds-h6vhtk-05e689"},{"field_id":"BT-21-Procedure","lang":"en","ordinal":0,"type":"text","value":"Welsh Local Government Association (WLGA) Leadership Programme"},{"code":"services","field_id":"BT-23-Procedure","list":"contract-nature","ordinal":0,"type":"code"},{"field_id":"BT-24-Procedure","lang":"en","ordinal":0,"type":"text","value":"The leadership programme for councillors in Wales is a place where leaders, and those in leadership positions, can explore the latest thinking in political leadership, and equip themselves with the knowledge and skills they need to rise to these challenges.\nThe WLGA Leadership Programme has been delivered for some 25 years, primarily through the LGA and latterly with Academi Wales. From 2026 it will be delivered solely by the WLGA and funded by the Welsh Government. \nThe aim of this procurement is to appoint a single supplier to design and deliver the leadership programme for councillors during the period October 2026 – December 2029. No programme will be required April to June 2027 due to local elections. \nThere is scope for the contract to be extended for a further year for 2 additional programmes to be delivered starting in April and October 2030.\nThe main aim of the programme is to increase the political leadership capacity of Welsh councils.\nPlease note that this procurement will be run through Proactis. To participate in the PME and subsequent tender, please ensure you are registered at: https://supplierlive.proactisp2p.com. \nProactis Reference: ERFX1008722"},{"cents":25000000,"currency":"GBP","field_id":"BT-27-Procedure","ordinal":0,"type":"amount"},{"code":"en","field_id":"BT-702(a)-notice","list":null,"ordinal":0,"type":"code"},{"field_id":"OPP-012-notice","ordinal":0,"type":"date","value":"2025-11-21T15:37:36+00:00"},{"code":"UK2","field_id":"OPP-070-notice","list":null,"ordinal":0,"type":"code"},{"field_id":"OPT-300-Procedure-Buyer","is_ref":true,"ordinal":0,"scheme":null,"type":"id","value":"ORG-GB-PPON-PDJQ-5588-HWLY"},{"field_id":"OPT-300-Procedure-Buyer","is_ref":true,"ordinal":1,"scheme":null,"type":"id","value":"ORG-GB-PPON-PVHP-5769-YHRQ"},{"code":"excl","field_id":"TED-VAL_TOTAL_TAX_BASIS","list":null,"ordinal":0,"type":"code"}]}]}