:[{"code":"2023/54","field_id":"BT-01-notice","list":"UKPGA","ordinal":0,"type":"code"},{"field_id":"BT-04-notice","is_ref":false,"ordinal":0,"scheme":null,"type":"id","value":"ocds-h6vhtk-05a1db"},{"field_id":"BT-21-Procedure","lang":"en","ordinal":0,"type":"text","value":"Independent Specialist Education and Inclusion Framework"},{"code":"services","field_id":"BT-23-Procedure","list":"contract-nature","ordinal":0,"type":"code"},{"field_id":"BT-24-Procedure","lang":"en","ordinal":0,"type":"text","value":"All Local Authorities (LA) have a requirement to ensure that all Children and Young People (CYP) have access to Education Provision. Leicester City Council is committed to finding placements for CYP with Special Educational Needs and Disabilities (SEND) within Leicester City. The provision is maintained by the Local Authority or Local Academies. At times, the Local Authority does need to source provision from Independent Providers. This transparency notice is to inform about the LA’s strategy towards commissioning High Needs placements from Independent Providers from 2026 onwards. This includes processes for Commissioning and Procurement, Funding, and Sufficiency.\nThe proposed SCE0043 Independent Specialist Education and Inclusion Framework will comprise of five lots: Lot 1, School-Based Specialist Provision (INMSS); Lot 2, Specialist Post-16 Provision; Lot 3, Online-Only Provision; Lot 4, Alternative Provision (AP); and Lot 5, Tuition and Inclusion Services.\nThis proposed lot structure remains subject to further development, refinement and approval."},{"cents":100000000,"currency":"GBP","field_id":"BT-27-Procedure","ordinal":0,"type":"amount"},{"code":"en","field_id":"BT-702(a)-notice","list":null,"ordinal":0,"type":"code"},{"field_id":"OPP-012-notice","ordinal":0,"type":"date","value":"2026-07-28T13:24:44+01:00"},{"code":"UK1","field_id":"OPP-070-notice","list":null,"ordinal":0,"type":"code"},{"field_id":"OPT-300-Procedure-Buyer","is_ref":true,"ordinal":0,"scheme":null,"type":"id","value":"ORG-GB-PPON-PXRT-5737-VBQD"},{"field_id":"OPT-300-Procedure-Buyer","is_ref":true,"ordinal":1,"scheme":null,"type":"id","value":"ORG-GB-PPON-PNHT-9235-VXDV"},{"field_id":"OPT-300-Procedure-Buyer","is_ref":true,"ordinal":2,"scheme":null,"type":"id","value":"ORG-GB-PPON-PVMQ-1845-NYPP"},{"code":"excl","field_id":"TED-VAL_TOTAL_TAX_BASIS","list":null,"ordinal":0,"type":"code"}]}]}