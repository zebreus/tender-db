ype":"classification"},{"code":"66517300","field_id":"BT-263-Lot","ordinal":1,"scheme":"cpv","type":"classification"},{"code":"66518300","field_id":"BT-263-Lot","ordinal":2,"scheme":"cpv","type":"classification"},{"code":"UK","field_id":"BT-5071-Lot","ordinal":0,"scheme":"nuts","type":"classification"},{"field_id":"BT-536-Lot","ordinal":0,"type":"date","value":"2025-11-08T00:00:00+00:00"},{"field_id":"BT-537-Lot","ordinal":0,"type":"date","value":"2028-10-30T23:59:59+00:00"}]},{"kind":"Organization","parent_section_id":"PROCEDURE","section_id":"ORG-GB-PPON-PGGV-7645-JTDL","values":[{"field_id":"BT-500-Organization-Company","lang":"en","ordinal":0,"type":"text","value":"Marsh"},{"field_id":"BT-501-Organization-Company","is_ref":false,"ordinal":0,"scheme":"GB-PPON","type":"id","value":"GB-PPON-PGGV-7645-JTDL"},{"code":"GB","field_id":"BT-514-Organization-Company","list":null,"ordinal":0,"type":"code"}]},{"kind":"Organization","parent_section_id":"PROCEDURE","section_id":"ORG-GB-PPON-PGJB-3773-RCMH","values":[{"field_id":"BT-500-Organization-Company","lang":"en","ordinal":0,"type":"text","value":"English Rural Housing Association"},{"field_id":"BT-501-Organization-Company","is_ref":false,"ordinal":0,"scheme":"GB-PPON","type":"id","value":"GB-PPON-PGJB-3773-RCMH"},{"code":"GB","field_id":"BT-514-Organization-Company","list":null,"ordinal":0,"type":"code"}]},{"kind":"Notice","parent_section_id":null,"section_id":"PROCEDURE","values":[{"code":"2023/54","field_id":"BT-01-notice","list":"UKPGA","ordinal":0,"type":"code"},{"field_id":"BT-04-notice","is_ref":false,"ordinal":0,"scheme":null,"type":"id","value":"ocds-h6vhtk-05155a"},{"field_id":"BT-21-Procedure","lang":"en","ordinal":0,"type":"text","value":"Provision of Insurance and Related Services to English Rural Housing Association"},{"field_id":"BT-24-Procedure","lang":"en","ordinal":0,"type":"text","value":"English Rural Housing Association are looking to appoint one or more providers to deliver their Insurance and related services for Property, legal liability and other general (non-life) insurable risks.  \nThe programme will require Insurance and related services for risks that may include but not be limited to: property damage and business interruption, employers, public, products and property owners liability, business combined/office, money, all risks, computer, contract works, group personal accident and employment practices liability. This list is to be decided at the sole discretion of English Rural Housing Association.\nSuppliers will be required to have the financial ability to deliver the programme, including Insurers with a minimum rating of ‘BBB’ from standard and poor, 'B++' from AM Best, or an equivalent rating by an independent and reputable credit rating agency and approved by the bidder’s market security committee. In the case of any rating less than A-, the contracting authority will evaluate and accept the nominated insurer(s) at its sole discretion, subject to disclosure and acceptance prior to the ITT bid deadline of the bidder’s market security committee’s latest report, including written recommendation from the bidder’s market security committee.\nSuppliers will be assessed but not limited to the following high level criterion: \n- The ability to provide the Contracting Authority with a choice of suitable insurers and/or suitable cover options\n- A skilled and competent service team, being Client Relationship Management, Insurance Claims management, Insurance Broking / underwriting and insurable risk managers\n- The delivery of quality service to the Contracting Authority and our clients, including that provided to us by any third-party contractor employed by you or by the Insurer(s) you propose\nPlease note the contract will commence as expected on the 31st October\nTo view this notice, please click here: \nhttps://www.delta-esourcing.com/delta/viewNotice.html?noticeId=989638243"},{"code":"en","field_id":"BT-702(a)-notice","list":null,"ordinal":0,"type":"code"},{"field_id":"OPP-012-notice","ordinal":0,"type":"date","value":"2025-10-27T10:05:11+00:00"},{"code":"UK6","field_id":"OPP-070-notice","list":null,"ordinal":0,"type":"code"},{"field_id":"OPT-300-Procedure-Buyer","is_ref":true,"ordinal":0,"scheme":null,"type":"id","value":"ORG-GB-PPON-PGJB-3773-RCMH"}]},{"kind":"LotResult","parent_section_id":"PROCEDURE","section_id":"RES-1-1","values":[{"field_id":"BT-13713-LotResult","is_ref":false,"ordinal":0,"scheme":null,"type":"id","value":"1"},{"code":"selec-w","field_id":"BT-142-LotResult","list":null,"ordinal":0,"type":"code"},{"field_id":"BT-1451-LotResult","ordinal":0,"type":"date","value":"2025-10-02T00:00:00+01:00"},{"field_id":"OPT-320-LotResult","is_ref":true,"ordinal":0,"scheme":null,"type":"id","value":"TEN-1-0"}]},{"kind":"LotResult","parent_section_id":"PROCEDURE","section_id":"RES-2-2","values":[{"field_id":"BT-13713-LotResult","is_ref":false,"ordinal":0,"scheme":null,"type":"id","value":"2"},{"code":"selec-w","field_id":"BT-142-LotResult","list":null,"ordinal":0,"type":"code"},{"field_id":"BT-1451-LotResult","ordinal":0,"type":"date","value":"2025-10-02T00:00:00+01:00"},{"field_id":"OPT-320-LotResult","is_ref":true,"ordinal":0,"scheme":null,"type":"id","value":"TEN-2-0"}]},{"kind":"LotResult","parent_section_id":"PROCEDURE","section_id":"RES-3-3","values":[{"field_id":"BT-13713-LotResult","is_ref":false,"ordinal":0,"scheme":null,"type":"id","value":"3"},{"code":"selec-w","field_id":"BT-142-LotResult","list":null,"ordinal":0,"type":"code"},{"field_id":"BT-1451-LotResult","ordinal":0,"type":"date","value":"2025-10-02T00:00:00+01:00"},{"field_id":"OPT-320-LotResult","is_ref":true,"ordinal":0,"scheme":null,"type":"id","value":"TEN-3-0"}]},{"kind":"ReceivedSubmissions","parent_section_id":"RES-1-1","section_id":"STAT-1","values":[{"field_id":"BT-759-LotResult","ordinal":0,"type":"number","unit":null,"value":3.0},{"code":"tenders","field_id":"BT-760-LotResult","list":null,"ordinal":0,"type":"code"}]},{"kind":"Rec