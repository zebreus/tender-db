:0,"type":"date","value":"2026-06-01T12:00:00+01:00"},{"field_id":"BT-131(d)-Procedure","ordinal":0,"type":"date","value":"2026-06-04T12:00:00+01:00"},{"field_id":"BT-21-Procedure","lang":"en","ordinal":0,"type":"text","value":"Framework Agreement for the Provision of Leadership, Governance and Development Services"},{"code":"services","field_id":"BT-23-Procedure","list":"contract-nature","ordinal":0,"type":"code"},{"field_id":"BT-24-Procedure","lang":"en","ordinal":0,"type":"text","value":"Aneurin Bevan University Health Board (ABUHB) intends to establish a framework of suitably experienced providers to support the delivery of leadership, governance, and development activities for Board members, Executives, and senior leaders. ABUHB plans to appoint six providers to this framework. \nThe framework is intended to provide ABUHB with flexible access to a range of development expertise, recognising that specific requirements may evolve over the life of the framework and may be commissioned on a planned or ad‑hoc basis.\nProviders appointed to the framework will be required to demonstrate proven experience of delivering high‑quality leadership and governance development within the public sector, ideally within NHS or other complex, regulated environments."},{"cents":11000000,"currency":"GBP","field_id":"BT-27-Procedure","ordinal":0,"type":"amount"},{"code":"en","field_id":"BT-702(a)-notice","list":null,"ordinal":0,"type":"code"},{"field_id":"OPP-012-notice","ordinal":0,"type":"date","value":"2026-05-08T15:04:53+01:00"},{"code":"UK4","field_id":"OPP-070-notice","list":null,"ordinal":0,"type":"code"},{"field_id":"OPT-300-Procedure-Buyer","is_ref":true,"ordinal":0,"scheme":null,"type":"id","value":"ORG-GB-PPON-PVLN-4733-WJBQ"},{"field_id":"OPT-300-Procedure-Buyer","is_ref":true,"ordinal":1,"scheme":null,"type":"id","value":"ORG-GB-PPON-PXWV-6492-CGMN"},{"code":"excl","field_id":"TED-VAL_TOTAL_TAX_BASIS","list":null,"ordinal":0,"type":"code"}]}]}