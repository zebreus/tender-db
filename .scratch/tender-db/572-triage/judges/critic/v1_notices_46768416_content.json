ection_id":null,"section_id":"PROCEDURE","values":[{"code":"2023/54","field_id":"BT-01-notice","list":"UKPGA","ordinal":0,"type":"code"},{"field_id":"BT-04-notice","is_ref":false,"ordinal":0,"scheme":null,"type":"id","value":"ocds-h6vhtk-05e811"},{"field_id":"BT-21-Procedure","lang":"en","ordinal":0,"type":"text","value":"(MAINTENANCE OF) SUPPORT OF CELLMA SYSTEMS"},{"field_id":"BT-24-Procedure","lang":"en","ordinal":0,"type":"text","value":"This is a renewal of the maintenance and support contract for the Cellma Systems with Riomed Ltd, located at Neath Port Talbot Hospital within Swansea Bay University Health Board. The contract covers the Rheumatology, CMATS, and Chronic Pain Clinic departments and provides an exclusive Cellma Corporate Package Annual Maintenance cover for a 12 Month period for Rheumatology and five years for CMATS and Chronic Pain. The Cellma system is an essential clinical management platform that supports the efficient operation of these services by ensuring the secure, accurate, and continuous management of patient data and care pathways. This contract ensures access to comprehensive system maintenance, software updates, technical support, and ongoing optimisation from the original system provider, Riomed Ltd, to maintain service reliability and minimise disruption to patient care."},{"code":"en","field_id":"BT-702(a)-notice","list":null,"ordinal":0,"type":"code"},{"field_id":"OPP-012-notice","ordinal":0,"type":"date","value":"2025-12-04T08:37:12+00:00"},{"code":"UK6","field_id":"OPP-070-notice","list":null,"ordinal":0,"type":"code"},{"field_id":"OPT-300-Procedure-Buyer","is_ref":true,"ordinal":0,"scheme":null,"type":"id","value":"ORG-GB-PPON-PTNV-7472-GRTW"},{"field_id":"OPT-300-Procedure-Buyer","is_ref":true,"ordinal":1,"scheme":null,"type":"id","value":"ORG-GB-NHS-RQF"}]},{"kind":"LotResult","parent_section_id":"PROCEDURE","section_id":"RES-1-1","values":[{"field_id":"BT-13713-LotResult","is_ref":false,"ordinal":0,"scheme":null,"type":"id"