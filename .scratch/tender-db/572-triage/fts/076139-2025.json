                    {
                        "id": "engagement",
                        "type": "engagement",
                        "description": "The Welsh Local Government Association (WLGA) intends to procure a supplier to design and deliver a leadership development programme for councillors across Wales.\nBefore commencing the formal procurement process, WLGA is seeking market insight to understand the capability and capacity of the market. \nPlease refer to Proactis (REF: ERFX1008722), where a short set of questions have been provided to gather feedback from the market.\nTo participate in the PME and subsequent tender, please ensure you are registered at: https://supplierlive.proactisp2p.com. ",
                        "dueDate": "2025-11-28T23:59:59+00:00",
                        "status": "scheduled"
                    }
                ],
                "documents": [
