{"notice_id": 46934518, "sections": [{"kind": "Lot", "parent_section_id": "PROCEDURE", "section_id": "1", "values": [{"field_id": "BT-24-Lot", "lang": "en", "ordinal": 0, "type": "text", "value": "NHS Bath and North East Somerset Integrated Care Board (\"BSW\") is commissioning a GP with Extended role service for low risk basal cell carcinoma removal, carpal tunnel and vasectomy procedures.\nBSW is directly awarding a contract to the existing provider Salisbury Medical Practice in accordance with the criteria outlined in Regulation (9) of the Health Care Services (Provider Selection Regime) Regulations 2023. The value of the contract is \u00a3200,000 per annum.\nThe approximate lifetime value of the contract is \u00a3600,000.\nThe contract is for three years (1 April 2024 to 31 March 2027).\nConsideration has been given to non GP Practice providers that may offer these services and it has been noted that those other providers have the opportunity to apply to become an accredited provider through the Right To Choose Framework. Where those applications are successful the Integrated Care Board would award contracts under Direct Award B as aligned to the Provider Selection Regime regulations 2023."}, {"code": "UKK1", "field_id": "BT-5071-Lot", "ordinal": 0, "scheme": "nuts", "type": "classification"}]}, {"kind": "SettledContract", "parent_section_id": "PROCEDURE", "section_id": "CON-010013-2024-1", "values": [{"field_id": "BT-145-Contract", "ordinal": 0, "type": "date", "value": "2024-03-06T00:00:00+00:00"}, {"field_id": "BT-150-Contract", "is_ref": false, "ordinal": 0, "scheme": null, "type": "id", "value": "010013-2024-1"}, {"field_id": "BT-3202-Contract", "is_ref": true, "ordinal": 0, "scheme": null, "type": "id", "value": "TEN-010013-2024-1-0"}, {"cents": 60000000, "currency": "GBP", "field_id": "OCDS-ContractValue", "ordinal": 0, "type": "amount"}, {"code": "excl", "field_id": "TED-VAL_TOTAL_TAX_BASIS", "list": null, "ordinal": 0, "type": "code"}]}, {"kind": "Organization", "parent_section_id": "PROCEDURE", "section_id": "ORG-GB-FTS-109247", "values": [{"field_id": "BT-500-Organization-Company", "lang": "en", "ordinal": 0, "type": "text", "value": "NHS Bath and North East Somerset, Swindon and Wiltshire Integrated Care Board"}, {"code": "GB", "field_id": "BT-514-Organization-Company", "list": null, "ordinal": 0, "type": "code"}]}, {"kind": "Organization", "parent_section_id": "PROCEDURE", "section_id": "ORG-GB-NHS-92G", "values": [{"field_id": "BT-500-Organization-Company", "lang": "en", "ordinal": 0, "type": "text", "value": "NHS Bath and North East Somerset, Swindon and Wiltshire Integrated Care Board"}, {"field_id": "BT-501-Organization-Company", "is_ref": false, "ordinal": 0, "scheme": "GB-NHS", "type": "id", "value": "GB-NHS-92G"}, {"code": "GB", "field_id": "BT-514-Organization-Company", "list": null, "ordinal": 0, "type": "code"}]}, {"kind": "Organization", "parent_section_id": "PROCEDURE", "section_id": "ORG-GB-NHS-RNZ91", "values": [{"field_id": "BT-500-Organization-Company", "lang": "en", "ordinal": 0, "type": "text", "value": "Salisbury Medical Practice"}, {"field_id": "BT-501-Organization-Company", "is_ref": false, "ordinal": 0, "scheme": "GB-NHS", "type": "id", "value": "GB-NHS-RNZ91"}, {"code": "GB", "field_id": "BT-514-Organization-Company", "list": null, "ordinal": 0, "type": "code"}]}, {"kind": "Notice", "parent_section_id": null, "section_id": "PROCEDURE", "values": [{"code": "32014L0024", "field_id": "BT-01-notice", "list": "CELEX", "ordinal": 0, "type": "code"}, {"field_id": "BT-04-notice", "is_ref": false, "ordinal": 0, "scheme": null, "type": "id", "value": "ocds-h6vhtk-044d81"}, {"code": "neg-wo-call", "field_id": "BT-105-Procedure", "list": "procurement-procedure-type", "ordinal": 0, "type": "code"}, {"field_id": "BT-21-Procedure", "lang": "en", "ordinal": 0, "type": "text", "value": "GP with Extended Role Services"}, {"code": "services", "field_id": "BT-23-Procedure", "list": "contract-nature", "ordinal": 0, "type": "code"}, {"field_id": "BT-24-Procedure", "lang": "en", "ordinal": 0, "type": "text", "value": "NHS Bath and North East Somerset Integrated Care Board (\"BSW\") is commissioning a GP with Extended role service for low risk basal cell carcinoma removal, carpal tunnel and vasectomy procedures.\nBSW is directly awarding a contract to the existing provider Salisbury Medical Practice in accordance with the criteria outlined in Regulation (9) of the Health Care Services (Provider Selection Regime) Regulations 2023. The value of the contract is \u00a3200,000 per annum.\nThe contract will be awarded for 3 years, with a total value of \u00a3600,000.\nThe service will commence on 1st April 2024."}, {"code": "85100000", "field_id": "BT-262-Procedure", "ordinal": 0, "scheme": "cpv", "type": "classification"}, {"code": "en", "field_id": "BT-702(a)-notice", "list": null, "ordinal": 0, "type": "code"}, {"field_id": "OPP-012-notice", "ordinal": 0, "type": "date", "value": "2024-03-27T11:40:59+00:00"}, {"code": "award+contract", "field_id": "OPP-070-notice", "list": null, "ordinal": 0, "type": "code"}, {"field_id": "OPT-300-Procedure-Buyer", "is_ref": true, "ordinal": 0, "scheme": null, "type": "id", "value": "ORG-GB-NHS-92G"}, {"field_id": "OPT-301-Lot-ReviewOrg", "is_ref": true, "ordinal": 0, "scheme": null, "type": "id", "value": "ORG-GB-FTS-109247"}]}, {"kind": "LotResult", "parent_section_id": "PROCEDURE", "section_id": "RES-010013-2024-1-1", "values": [{"field_id": "BT-13713-LotResult", "is_ref": false, "ordinal": 0, "scheme": null, "type": "id", "value": "1"}, {"code": "selec-w", "field_id": "BT-142-LotResult", "list": null, "ordinal": 0, "type": "code"}, {"field_id": "OPT-315-LotResult", "is_ref": true, "ordinal": 0, "scheme": null, "type": "id", "value": "CON-010013-2024-1"}, {"field_id": "OPT-320-LotResult", "is_ref": true, "ordinal": 0, "scheme": null, "type": "id", "value": "TEN-010013-2024-1-0"}]}, {"kind": "ReceivedSubmissions", "parent_section_id": "RES