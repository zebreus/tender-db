# plan
COMPOUND QUERY
  LEFT-MOST SUBQUERY
    SCAN s
      SEARCH p USING INDEX tender_version_parties_org (organization_id=?)
      SEARCH t USING INTEGER PRIMARY KEY (rowid=?)
      USE SORTER FOR GROUP BY
      USE HASH TABLE FOR count(DISTINCT)
    USE SORTER FOR GROUP BY
  UNION ALL
    SCAN q
      SEARCH p USING INDEX tender_version_parties_org (organization_id=?)
      SEARCH t USING INTEGER PRIMARY KEY (rowid=?)
      USE HASH TABLE FOR DISTINCT
    SEARCH b USING INDEX tender_version_parties_version (tender_id=? AND seq=?)
    SEARCH o USING INTEGER PRIMARY KEY (rowid=?)
    USE SORTER FOR GROUP BY
    USE HASH TABLE FOR count(DISTINCT)
USE SORTER FOR ORDER BY
# plan_prod
COMPOUND QUERY
  LEFT-MOST SUBQUERY
    SCAN s
      SEARCH p USING INDEX tender_version_parties_org (organization_id=?)
      SEARCH t USING INTEGER PRIMARY KEY (rowid=?)
      USE SORTER FOR GROUP BY
      USE HASH TABLE FOR count(DISTINCT)
    USE SORTER FOR GROUP BY
  UNION ALL
    SCAN q
      SEARCH p USING INDEX tender_version_parties_org_role (organization_id=? AND role=?)
      SEARCH t USING INTEGER PRIMARY KEY (rowid=?)
      USE HASH TABLE FOR DISTINCT
    SEARCH b USING INDEX tender_version_parties_version (tender_id=? AND seq=?)
    SEARCH o USING INTEGER PRIMARY KEY (rowid=?)
    USE SORTER FOR GROUP BY
    USE HASH TABLE FOR count(DISTINCT)
USE SORTER FOR ORDER BY
