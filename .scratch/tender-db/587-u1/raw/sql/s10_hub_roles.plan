# plan
COMPOUND QUERY
  LEFT-MOST SUBQUERY
    SEARCH p USING INDEX tender_version_parties_org (organization_id=?)
    SEARCH t USING INTEGER PRIMARY KEY (rowid=?)
    USE SORTER FOR GROUP BY
    USE HASH TABLE FOR count(DISTINCT)
    USE HASH TABLE FOR count(DISTINCT)
  UNION ALL
    SEARCH p USING INDEX tender_version_parties_org (organization_id=?)
    SEARCH t USING INTEGER PRIMARY KEY (rowid=?)
    USE SORTER FOR GROUP BY
    USE HASH TABLE FOR count(DISTINCT)
USE SORTER FOR ORDER BY
