# plan
SCAN agg
  COMPOUND QUERY
    LEFT-MOST SUBQUERY
      SCAN q
        SEARCH p USING INDEX tender_version_parties_org (organization_id=?)
        SEARCH t USING INTEGER PRIMARY KEY (rowid=?)
        USE HASH TABLE FOR DISTINCT
      SEARCH b USING INDEX tender_version_parties_version (tender_id=? AND seq=?) LEFT-JOIN
      USE SORTER FOR GROUP BY
    UNION ALL
      SCAN q
        SEARCH p USING INDEX tender_version_parties_org (organization_id=?)
        SEARCH t USING INTEGER PRIMARY KEY (rowid=?)
        USE HASH TABLE FOR DISTINCT
      SEARCH b USING INDEX tender_version_parties_version (tender_id=? AND seq=?) LEFT-JOIN
      USE SORTER FOR GROUP BY
    UNION ALL
      SCAN q
        SEARCH p USING INDEX tender_version_parties_org (organization_id=?)
        SEARCH t USING INTEGER PRIMARY KEY (rowid=?)
        USE HASH TABLE FOR DISTINCT
      SEARCH b USING INDEX tender_version_parties_version (tender_id=? AND seq=?) LEFT-JOIN
      USE SORTER FOR GROUP BY
    UNION ALL
      SCAN q
        SEARCH p USING INDEX tender_version_parties_org (organization_id=?)
        SEARCH t USING INTEGER PRIMARY KEY (rowid=?)
        USE HASH TABLE FOR DISTINCT
      SEARCH b USING INDEX tender_version_parties_version (tender_id=? AND seq=?) LEFT-JOIN
      USE SORTER FOR GROUP BY
USE SORTER FOR GROUP BY
