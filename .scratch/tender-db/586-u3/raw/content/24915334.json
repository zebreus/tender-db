ation-Company","lang":null,"ordinal":0,"type":"text","value":"Sekretariat Biura Odwołań"},{"field_id":"BT-503-Organization-Company","lang":null,"ordinal":0,"type":"text","value":"224587801"},{"field_id":"BT-505-Organization-Company","lang":null,"ordinal":0,"type":"text","value":"https://www.uzp.gov.pl/"},{"field_id":"BT-506-Organization-Company","lang":null,"ordinal":0,"type":"text","value":"odwolania@uzp.gov.pl"},{"code":"PL911","field_id":"BT-507-Organization-Company","ordinal":0,"scheme":"nuts","type":"classification"},{"field_id":"BT-510(a)-Organization-Company","lang":null,"ordinal":0,"type":"text","value":"Postępu 17a"},{"field_id":"BT-512-Organization-Company","lang":null,"ordinal":0,"type":"text","value":"02-676"},{"field_id":"BT-513-Organization-Company","lang":null,"ordinal":0,"type":"text","value":"Warszawa"},{"code":"POL","field_id":"BT-514-Organization-Company","list":"country","ordinal":0,"type":"code"},{"field_id":"OPT-200-Organization-Company","is_ref":false,"ordinal":0,"scheme":"organization","type":"id","value":"ORG-0002"}]},{"kind":"Notice","parent_section_id":null,"section_id":"PROCEDURE","values":[{"code":"32014L0024","field_id":"BT-01-notice","list":null,"ordinal":0,"type":"code"},{"code":"cn-standard","field_id":"BT-02-notice","list":"competition","ordinal":0,"type":"code"},{"field_id":"BT-04-notice","is_ref":false,"ordinal":0,"scheme":null,"type":"id","value":"b7dcbc6e-9d9e-4039-9882-d8d3eb904fb2"},{"field_id":"BT-05(a)-notice","ordinal":0,"type":"date","value":"2025-08-26T06:26:08+00:00"},{"code":"open","field_id":"BT-105-Procedure","list":"procurement-procedure-type","ordinal":0,"type":"code"},{"code":"true","field_id":"BT-106-Procedure","list":"accelerated-procedure","ordinal":0,"type":"code"},{"field_id":"BT-1351-Procedure","lang":"POL","ordinal":0,"type":"text","value":"Zamawiający, po przeanalizowaniu całokształtu okoliczności faktycznych i prawnych towarzyszących rozpatrywanemu zamówieniu, stwierdza, że rozstrzygnięcie postępowania i zawarcie umowy w sprawie zamówienia publicznego przy zachowaniu standardowego terminu składania ofert w istotny sposób zagraża interesom Zamawiającego i może prowadzić do poważnych konsekwencji finansowych. Pilna potrzeba udzielenia zamówienia i skrócenie terminu składania ofert są konieczne z uwagi na ryzyko niezrealizowania zaplanowanej inwestycji, co mogłoby skutkować utratą finansowania w postaci dotacji budżetowej przyznanej na rok 2025. W dniu 17.07.2025 r. Zamawiający opublikował postępowanie nr DZP-OP.2610.268.2025 na Dostawę i montaż na budynkach internatowych AMW O/Reg. Poznań instalacji fotowoltaicznej - Witkowo ul. Żwirki i Wigury 2, ul. Pogodna 5A (Numer publikacji ogłoszenia: 467383-2025). Natomiast dnia 12.08.2025 r. postępowanie zostało unieważnione na podstawie art. 255 pkt 3 ustawy Pzp tj. w postępowaniu została złożona jedna oferta, Oferta z najniższą ceną przewyższa kwotę, jaką Zamawiający zamierza przeznaczyć na sfinansowanie zamówienia. Z uwagi na konieczność wykonania dokumentacji projektowej uzgodnionej z Operatorem Systemu Dystrybucyjnego oraz większy poziom skomplikowania instalacji technicznej na budynku przy ul. Pogodnej 5A, zdecydowano o skierowaniu do realizacji w roku 2025 jedynie instalacji na budynku przy ul. Żwirki i Wigury 2. Dodatkowo należy wskazać, że inwestycja polegająca na dostawie i montażu instalacji fotowoltaicznej na budynku internatu AMW O/Reg. Poznań w Witkowie przy ul. Żwirki i Wigury 2 ma na celu istotne obniżenie zużycia energii elektrycznej nabywanej od dostawcy zewnętrznego po cenie rynkowej. Brak realizacji inwestycji w zakładanym terminie wiąże się  z ponoszeniem przez Zamawiającego wyższych kosztów eksploatacyjnych, co jest szczególnie istotne w kontekście dynamicznie rosnących cen energii.\nNależy również podkreślić, że skrócenie terminu składania ofert w oparciu o art. 138 ust. 2 pkt 2 ustawy Pzp nie zostało przez ustawodawcę uzależnione od tego, czy stan pilnej potrzeby wynika z przyczyn leżących po stronie Zamawiającego, ani od tego, czy można było go wcześniej przewidzieć. Przesunięcie realizacji zamówienia na drugą połowę roku wynikało z konieczności dostosowania harmonogramu inwestycji do terminu przyznania i uruchomienia środków budżetowych, a także zakończenia niezbędnych uzgodnień technicznych i formalno-prawnych, umożliwiających przeprowadzenie procedury zgodnie z przepisami. Dodatkowo planowana inwestycja musi zostać zakończona i odebrana protokołem odbioru najpóźniej do dnia 22 grudnia 2025 r., co w praktyce wymusza maksymalne skrócenie terminów związanych z wyborem wykonawcy oraz rozpoczęciem i realizacją prac. Niedochowanie tego terminu grozi utratą pokrycia finansowania inwestycji ze środków własnych zarezerwowanych w roku 2025. Wydatkowanie środków własnych musi nastąpić do 22.12.2025 r.  W odróżnieniu od przepisu art. 209 ust. 1 pkt 4 ustawy Pzp, który uzależnia dopuszczalność zastosowania trybu negocjacji bez ogłoszenia od „pilnej potrzeby udzielenia zamówienia niewynikającej z przyczyn leżących po stronie Zamawiającego, której wcześniej nie można było przewidzieć”, art. 138 ust. 2 pkt 2 nie przewiduje tak daleko idących ograniczeń. Przesłanki wskazane w tym przepisie są mniej rygorystyczne, co jest uzasadnione tym, że jego zastosowanie prowadzi jedynie do skrócenia terminów w przetargu, a nie do wyłączenia zasady konkurencyjności. Ponadto, ze względu na charakter przedmiotu zamówienia oraz jego ponowienia, przygotowanie oferty przez wykonawców nie powinno być czasochłonne ani nadmiernie skomplikowane, wobec czego skrócenie terminu składania ofert do 15 dni nie powinno mieć negatywnego wpływu na konkurencyjność postępowania."},{"field_id":"BT-21-Procedure","lang":"POL","ordinal":0,"type":"text","value":"Dostawa i montaż instalacji fotowoltaicznej na budynku internatu AMW O/Reg. Poznań w Witkowie, ul. Żwirki i Wigury 2"},{"field_id":"BT-22-Procedure","is_ref":false,"ordinal":0,"scheme":"InternalID","type":"id","value":"DZP-OP.2610.330.2025"},{"code":"supplies","field_id":"BT-23-Lot","list":"contract-nature","ordinal":0,"type":"code"},{"field_id":"BT-24-Procedure","lang":"POL","ordinal":0,"type":"text","value":"1. Przedmiotem zamówienia jest Dostawa i montaż instalacji fotowoltaicznej na budynku internatu AMW O/Reg. Poznań w Witkowie, ul. Żwirki i Wigury 2.\n2. Szczegółowy zakres zamówienia określony został w załączniku nr 2 do SWZ - Opis przedmiotu  zamówienia oraz w Projektowanych postanowieniach umowy – stanowiących załącznik nr 4 do SWZ.\n3. Zamawiający wymaga w niniejszym postępowaniu przedmiotowych środków dowodowych umożliwiających jednoznaczną identyfikację oferowanych urządzeń. Szczegółowe informację na temat przedmiotowych środków dowodowych zawarte są w Rozdziale V SWZ.\n4. Termin wykonania zamówienia wynosi: od dnia zawarcia umowy do 22 grudnia 2025 r."},{"code":"09331200","field_id":"BT-262-Procedure","ordinal":0,"scheme":"cpv","type":"classification"},{"field_id":"BT-701-notice","is_ref":false,"ordinal":0,"scheme":"notice-id","type":"id","value":"51962ab4-aa7e-4547-b1d4-043d3c60b759"},{"code":"POL","field_id":"BT-702(a)-notice","list":"language","ordinal":0,"type":"code"},{"field_id":"BT-757-notice","is_ref":false,"ordinal":0,"scheme":null,"type":"id","value":"01"},{"field_id":"OPP-010-notice","is_ref":false,"ordinal":0,"scheme":"ojs-notice-id","type":"id","value":"00559942-2025"},{"field_id":"OPP-011-notice","is_ref":false,"ordinal":0,"scheme":"ojs-id","type":"id","value":"163/2025"},{"field_id":"OPP-012-notice","ordinal":0,"type":"date","value":"2025-08-27"},{"code":"16","field_id":"OPP-070-notice","list":"notice-subtype","ordinal":0,"type":"code"},{"field_id":"OPT-001-notice","is_ref":false,"ordinal":0,"scheme":null,"type":"id","value":"2.3"},{"field_id":"OPT-002-notice","is_ref":false,"ordinal":0,"scheme":null,"type":"id","value":"eforms-sdk-1.13"}]},{"kind":"Touchpoint","parent_section_id":"ORG-0001","section_id":"TPO-0001","values":[{"field_id":"BT-16-Organization-TouchPoint","lang":null,"ordinal":