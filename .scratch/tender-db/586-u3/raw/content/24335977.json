enia oraz warunki realizacji określają załączniki do SWZ: załącznik nr 2 – Opis przedmiotu zamówienia; załącznik nr 4 – Projektowane postanowienia umowy. \n3.\tKody CPV:  \n90500000-2 – usługi związane z odpadami,\n90511000-2 – usługi wywóz odpadów\n90512000-9 – usługa transportu odpadów \n4.\tPrzedmiot zamówienia został podzielony na części:\nCzęść 2:  \nUsługa odbioru, transportu i przekazania do przetworzenia odpadów o kodzie odpadu: \n17 01 01, 17 01 02, 17 01 03, 17 01 07"},{"code":"90500000","field_id":"BT-262-Procedure","ordinal":0,"scheme":"cpv","type":"classification"},{"cents":8712037,"currency":"PLN","field_id":"BT-27-Procedure","ordinal":0,"type":"amount"},{"field_id":"BT-701-notice","is_ref":false,"ordinal":0,"scheme":"notice-id","type":"id","value":"6050e85a-0e2c-4fe7-872c-46f0f6d5d4a8"},{"code":"POL","field_id":"BT-702(a)-notice","list":"language","ordinal":0,"type":"code"},{"field_id":"BT-757-notice","is_ref":false,"ordinal":0,"scheme":null,"type":"id","value":"01"},{"field_id":"OPP-010-notice","is_ref":false,"ordinal":0,"scheme":"ojs-notice-id","type":"id","value":"00713188-2024"},{"field_id":"OPP-011-notice","is_ref":false,"ordinal":0,"scheme":"ojs-id","type":"id","value":"228/2024"},{"field_id":"OPP-012-notice","ordinal":0,"type":"date","value":"2024-11-22"},{"code":"29","field_id":"OPP-070-notice","list":"notice-subtype","ordinal":0,"type":"code"},{"field_id":"OPT-001-notice","is_ref":false,"ordinal":0,"scheme":null,"type":"id","value":"2.3"},{"field_id":"OPT-002-notice","is_ref":false,"ordinal":0,"scheme":null,"type":"id","value":"eforms-sdk-1.12"},{"field_id":"OPT-999","ordinal":0,"type":"date","value":"2000-01-01"}]},{"kind":"LotResult","parent_section_id":"PROCEDURE","section_id":"RES-0001","values":[{"field_id":"BT-13713-LotResult","is_ref":true,"ordinal":0,"scheme":null,"type":"id","value":"LOT-0001"},{"code":"selec-w","field_id":"BT-142-LotResult","list":"winner-selection-status","ordinal":0,"type":"code"},{"cents":6584760,"currency":"PLN"