[Unit]
Description=Daily tender-db temp-directory sweep (/data/tmp)

[Timer]
# After the daily tick (09:35 Europe/Berlin: 07:35 UTC in summer time, 08:35 UTC
# in winter time) and the restarts a deploy day brings, so the steady-state single
# orphan is collected the same day it is made. OnCalendar is box-local time, and the
# box runs on Europe/Berlin (`timedatectl`), so 23:41 moves with the tick across DST.
OnCalendar=*-*-* 23:41:00
Persistent=true

[Install]
WantedBy=timers.target
