         <cbc:ItemClassificationCode listName="cpv">71240000</cbc:ItemClassificationCode>
      </cac:MainCommodityClassification>
      <cac:AdditionalCommodityClassification>
         <cbc:ItemClassificationCode listName="cpv">71240000</cbc:ItemClassificationCode>
      </cac:AdditionalCommodityClassification>
